@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject IContadorMensagens Contador
@implements IDisposable
@* Layout único das telas internas: serve às páginas do servidor (Blazor Server) e às do navegador (WebAssembly).
   Por isso não injeta serviço do servidor — o usuário vem do estado de autenticação em cascata (claims do cookie). *@

<div class="app">
    <aside class="lateral">
        <Logo />
        <div class="tema" role="group" aria-label="Tema">
            <button class="@(_tema == "claro" ? "on" : "")" @onclick='() => Tema("claro")'><Icone Nome="sol" Tam="13" /> Claro</button>
            <button class="@(_tema == "escuro" ? "on" : "")" @onclick='() => Tema("escuro")'><Icone Nome="lua" Tam="13" /> Escuro</button>
        </div>
        <nav>
            <ul class="menu">
                <li class="grupo"><NavLink href="" Match="NavLinkMatch.All"><Icone Nome="casa" /> Minhas pendências</NavLink></li>
                <li class="grupo"><NavLink href="mensagens"><Icone Nome="mensagem" /> Mensagens @if (_naoLidas > 0) { <span class="cont-menu" title="@($"{_naoLidas} conversa(s) com mensagem não lida")">@(_naoLidas > 99 ? "99+" : _naoLidas)</span> }</NavLink></li>
                <li class="grupo"><NavLink href="tarefas"><Icone Nome="lista" /> Tarefas</NavLink></li>
                <li class="grupo"><NavLink href="painel"><Icone Nome="grafico" /> Painel de indicadores</NavLink></li>
                @foreach (var g in _plataforma ? _grupos.Append(_grupoPlataforma) : _grupos)
                {
                    <li class="grupo"><a class="dobra @(Aberto(g.Id) ? "aberto" : "")" @onclick="() => Alternar(g.Id)"><Icone Nome="@g.Icone" /> @g.Titulo <span class="seta">›</span></a></li>
                    @if (Aberto(g.Id))
                    {
                        @foreach (var (href, icone, texto) in g.Itens)
                        {
                            <li class="item"><NavLink href="@href" Match="NavLinkMatch.All"><Icone Nome="@icone" Tam="16" /> @texto</NavLink></li>
                        }
                    }
                }
            </ul>
        </nav>
        <div class="usuario-box">
            <b>@_nome</b>
            @Rotulos.De(Enum.TryParse<PerfilUsuario>(_perfil, out var p) ? p : PerfilUsuario.Campo) · @_empresa
            <div class="conta-links">@if (_variasConstrutoras) { <a href="conta/construtora" data-enhance-nav="false" id="trocar-construtora"><Icone Nome="predio" Tam="14" /> Trocar construtora</a> }<a href="conta/trocar-senha" data-enhance-nav="false"><Icone Nome="cadeado" Tam="14" /> Alterar senha</a><a href="conta/sair" data-enhance-nav="false"><Icone Nome="sair" Tam="14" /> Sair</a></div>
        </div>
    </aside>
    <main class="principal">
        @if (_suporteAte is { } sa) { <div class="faixa-suporte" role="status"><Icone Nome="escudo" Tam="14" /> Suporte da plataforma em @_empresa — acesso registrado na auditoria, vale até @sa.ToLocalTime().ToString("dd/MM HH:mm").</div> }
        <div class="conteudo">
            @* Erro ao desenhar um componente fica contido aqui: menu e cabeçalho continuam e o usuário pode tentar de novo. *@
            <ErrorBoundary @ref="_limiteErro">
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="ex">
                    <div class="alerta erro" role="alert"><Icone Nome="exclamacao" />
                        <div>Não foi possível exibir esta parte da tela. O erro foi registrado.
                            <button type="button" class="btn sec pq" @onclick="Recuperar">Tentar de novo</button></div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </main>
</div>
@* Na "casca" estática (desenhada pelo servidor enquanto a tela conecta) não há avisos nem a faixa de erro do Blazor. *@
@if (RendererInfo.IsInteractive)
{
    <Toasts />
    <div id="blazor-error-ui" data-nosnippet>
        Ocorreu um erro inesperado. <a href="." class="reload">Recarregar</a>
        <span class="dismiss">🗙</span>
    </div>
}

@code {
    private ErrorBoundary? _limiteErro;
    private void Recuperar() => _limiteErro?.Recover();
    // Ao navegar para outra tela, um erro da tela anterior não deve continuar bloqueando o conteúdo.
    protected override void OnParametersSet() => _limiteErro?.Recover();

    private string _tema = "claro";
    private sealed record Grupo(string Id, string Titulo, string Icone, (string Href, string Icone, string Texto)[] Itens);
    private readonly HashSet<string> _abertos = [];
    private static readonly Grupo[] _grupos =
    [
        new("cad", "Cadastro", "cadastro", [("fornecedores", "predio", "Fornecedores"), ("fornecedores/qualificacao", "selo", "Qualificação Fornec."), ("fornecedores/documentos", "arquivo", "Docs. do Fornecedor"), ("fornecedores/exigencias", "tabela", "Matriz de Documentos"),
            ("cadastros/controlados", "escudo-check", "Materiais/Serv. Control."), ("cadastros/estabelecimentos", "predio", "Estabelecimentos (CNPJs)"), ("cadastros/centros-custo", "tabela", "Centros de Custo"), ("cadastros/produtos", "caixa", "Produtos"), ("cadastros/categorias", "lista", "Categorias de Produto")]),
        new("eng", "Engenharia", "regua", [("engenharia/obras", "predio", "Obras e Empreendimentos"), ("engenharia/tipologias", "cubo", "Tipologias"),
            ("engenharia/composicoes", "lista", "Serviços e Composições"), ("engenharia/orcamento", "calculadora", "Orçamento por Local"), ("engenharia/planejamento", "grafico", "Planejamento"), ("engenharia/diario", "calendario", "Diário de Obra (RDO)"), ("engenharia/mao-de-obra", "pessoa", "Mão de Obra Própria")]),
        new("sup", "Suprimentos", "carrinho", [("requisicoes", "prancheta", "Requisição"), ("cotacoes", "calculadora", "Orçamentos"), ("pedidos", "sacola", "Pedidos"), ("contratos", "contrato", "Contratos"),
            ("notas-fiscais", "arquivo", "Notas Fiscais (entrada)"), ("recebimentos", "caixa", "Recebimento / FVM"), ("transferencias", "enviar", "Transferências p/ Obra"), ("medicoes", "regua", "Medições"), ("pagamentos", "dinheiro", "Liberação Pagamento")]),
        new("sgq", "Qualidade", "medalha", [("sgq/documentos", "pasta", "Documentos SGQ"), ("sgq/copias", "impressora", "Cópias Controladas"), ("sgq/lista-mestra", "lista", "Lista Mestra"),
            ("sgq/externos", "livro", "Documentos Externos"), ("fornecedores/avaliacao", "grafico", "Avaliação Fornec."), ("fornecedores/planos", "alvo", "Planos de Ação"),
            ("sgq/grd", "enviar", "GRD"), ("sgq/leituras", "livro", "Leituras / Ciência"), ("sgq/registros", "arquivo-morto", "Registros (Retenção)")]),
        new("qob", "Qualidade da Obra", "escudo-check", [("obra/mapa-torre", "predio", "Mapa da Torre (FVS)"), ("obra/mapa", "tabela", "Mapa de Inspeções"), ("obra/fvs", "prancheta", "FVS – Inspeções"), ("obra/modelos/fvs", "lista", "Modelos de FVS"),
            ("obra/modelos/fvm", "caixa", "Modelos de FVM"), ("obra/rnc", "x-circulo", "Não Conformidades"), ("obra/acoes", "ferramenta", "Ações Corretivas"),
            ("obra/equipamentos", "regua", "Equip. de Medição"), ("obra/auditorias", "lupa", "Auditorias Internas")]),
        new("sst", "Segurança e Pessoas", "pessoa", [("sst/colaboradores", "pessoa", "Colaboradores"), ("sst/exigencias", "tabela", "Exigências por Função"), ("sst/documentos", "arquivo", "Docs. do Colaborador"),
            ("sst/treinamentos", "livro", "Treinamentos"), ("sst/epi", "escudo", "Entrega de EPI"), ("sst/inspecoes", "prancheta", "Inspeções de Segurança"),
            ("sst/pt", "chave", "Permissão de Trabalho"), ("sst/ocorrencias", "alerta", "Ocorrências e Acidentes"), ("sst/painel", "grafico", "Painel SST")]),
        new("sis", "Sistema", "engrenagem", [("sistema/usuarios", "pessoa", "Usuários e Alçadas"), ("sistema/parametros", "ferramenta", "Parâmetros e Notificações"),
            ("sistema/permissoes", "escudo", "Permissões SGQ"), ("sistema/log", "relogio", "Log de Auditoria")]),
    ];

    private static readonly Grupo _grupoPlataforma = new("plat", "Plataforma", "escudo", [("plataforma/construtoras", "predio", "Construtoras"), ("plataforma/usuarios", "pessoa", "Usuários e acessos"), ("plataforma/auditoria", "relogio", "Auditoria da plataforma")]);
    private bool _plataforma, _variasConstrutoras;
    private DateTimeOffset? _suporteAte;

    [Inject] private NavigationManager Nav { get; set; } = default!;

    [CascadingParameter] private Task<AuthenticationState>? Autenticacao { get; set; }
    private string _nome = "", _perfil = "", _empresa = "";

    protected override async Task OnInitializedAsync()
    {
        if (Autenticacao is not null)
        {
            var u = (await Autenticacao).User;
            _nome = u.Identity?.Name ?? "";
            _perfil = u.FindFirst("qh:perfil")?.Value ?? "";
            _empresa = u.FindFirst("qh:empresa_nome")?.Value ?? "";
            _plataforma = u.FindFirst("qh:plataforma")?.Value == "1";
            _variasConstrutoras = u.FindFirst("qh:construtoras") is not null;
            _suporteAte = DateTimeOffset.TryParse(u.FindFirst("qh:suporte")?.Value, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var sa) ? sa : null;
        }
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0];
        foreach (var g in _grupos.Append(_grupoPlataforma)) if (g.Itens.Any(i => rel.StartsWith(i.Href))) _abertos.Add(g.Id);
        if (_abertos.Count == 0) _abertos.Add("sup");
    }

    private bool Aberto(string id) => _abertos.Contains(id);
    private void Alternar(string id) { if (!_abertos.Remove(id)) _abertos.Add(id); }

    protected override async Task OnAfterRenderAsync(bool primeira)
    {
        if (!primeira) return;
        _tema = await JS.InvokeAsync<string>("qh.temaAtual");
        Contador.Mudou += AoMudar;
        // Troca entre tela do servidor e tela do navegador: recarrega direto, sem desenhar a "página não encontrada"
        // no meio (era o que deixava a tela vazia antes de recarregar). A página atual fica visível até a nova chegar.
        _troca = Nav.RegisterLocationChangingHandler(ctx =>
        {
            if (_forcando) return ValueTask.CompletedTask;
            var caminho = Nav.ToAbsoluteUri(ctx.TargetLocation).AbsolutePath;
            var aquiNavegador = RendererInfo.Name == "WebAssembly";
            if (QualyHub.Web.Client.RotasNavegador.Atende(caminho) != aquiNavegador && Nav.ToAbsoluteUri(ctx.TargetLocation).Host == new Uri(Nav.BaseUri).Host)
            {
                ctx.PreventNavigation();
                _forcando = true;
                Nav.NavigateTo(ctx.TargetLocation, forceLoad: true);
            }
            return ValueTask.CompletedTask;
        });
        await AtualizarContador();
        _ = ConsultarDeTemposEmTemposAsync();
    }

    // ───── Contador de mensagens não lidas (acende na hora no servidor; consulta a cada minuto como reserva) ─────
    private int _naoLidas;
    private readonly CancellationTokenSource _cts = new();

    private async Task AtualizarContador()
    {
        try { _naoLidas = await Contador.NaoLidasAsync(_cts.Token); } catch (Exception) { return; }
        StateHasChanged();
    }

    private void AoMudar() => _ = InvokeAsync(AtualizarContador);

    private async Task ConsultarDeTemposEmTemposAsync()
    {
        // Só no expediente: aba esquecida aberta à noite não acorda o banco (Azure SQL serverless pausa).
        using var t = new PeriodicTimer(TimeSpan.FromSeconds(90));
        try { while (await t.WaitForNextTickAsync(_cts.Token)) if (DateTime.Now.Hour is >= 6 and < 21) await InvokeAsync(AtualizarContador); }
        catch (OperationCanceledException) { }
    }

    private IDisposable? _troca;
    private bool _forcando;

    public void Dispose()
    {
        _troca?.Dispose();
        Contador.Mudou -= AoMudar;
        _cts.Cancel();
    }

    private async Task Tema(string t) { _tema = t; await JS.InvokeVoidAsync("qh.tema", t); }
}
