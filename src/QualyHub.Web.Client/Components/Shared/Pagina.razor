@* Moldura padrão das telas: título + barra de ferramentas + conteúdo + faixa informativa no rodapé. *@
<PageTitle>@Titulo · QualyHub</PageTitle>
<div class="tela">
<div class="topo">
    <h1>@Titulo</h1>
    @if (Grade is not null)
    {
        <div class="ferramentas">
            <button class="icone-btn @(Grade.Compacto ? "on" : "")" title="Modo compacto (celular)" @onclick="Grade.AlternarCompacto"><Icone Nome="celular" Tam="20" /></button>
            <button class="icone-btn" title="Expandir/recolher grupos" @onclick="Grade.AlternarGrupos"><Icone Nome="tabela" Tam="20" /></button>
            @if (AoAtualizar.HasDelegate) { <button class="icone-btn" title="Atualizar" @onclick="AoAtualizar"><Icone Nome="cubo" Tam="20" /></button> }
            <span class="sep"></span>
            @if (AoNovo.HasDelegate) { <button class="icone-btn" title="Novo" @onclick="AoNovo"><Icone Nome="mais" Tam="20" /></button> }
            <span class="sep"></span>
            <button class="icone-btn @(Grade.Filtros ? "on" : "")" title="Filtros" @onclick="Grade.AlternarFiltros"><Icone Nome="filtro" Tam="20" /></button>
            @if (AoExcluir.HasDelegate) { <button class="icone-btn" title="Excluir selecionado" disabled="@(!Grade.TemSelecionado)" @onclick="AoExcluir"><Icone Nome="lixeira" Tam="20" /></button> }
            <span class="sep"></span>
            <button class="icone-btn" title="Exportar Excel" @onclick="Grade.ExportarExcelAsync"><Icone Nome="excel" Tam="20" /></button>
            <button class="icone-btn" title="Exportar JSON" @onclick="Grade.ExportarJsonAsync"><Icone Nome="json" Tam="20" /></button>
            <button class="icone-btn" title="Imprimir" @onclick="async () => await Grade.ImprimirAsync()"><Icone Nome="impressora" Tam="20" /></button>
            <span class="sep"></span>
            <button class="icone-btn" title="Colunas" @onclick="Grade.AlternarColunas"><Icone Nome="colunas" Tam="20" /></button>
            <span class="sep"></span>
            <button class="icone-btn @(Grade.SomenteMeus ? "on" : "")" title="Somente meus registros" @onclick="Grade.AlternarSomenteMeus"><Icone Nome="usuario" Tam="20" /></button>
        </div>
    }
    else if (AoNovo.HasDelegate || AoAtualizar.HasDelegate)
    {
        <div class="ferramentas">
            @if (AoAtualizar.HasDelegate) { <button class="icone-btn" title="Atualizar" @onclick="AoAtualizar"><Icone Nome="cubo" Tam="20" /></button> }
            @if (AoNovo.HasDelegate) { <span class="sep"></span><button class="icone-btn" title="Novo" @onclick="AoNovo"><Icone Nome="mais" Tam="20" /></button> }
        </div>
    }
    @if (Direita is not null) { <div class="direita">@Direita</div> }
</div>
<div class="miolo">@ChildContent</div>
@if (Faixa is not null)
{
    <div class="faixa fixa-base">@Faixa</div>
}
</div>
@code {
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public IGrade? Grade { get; set; }
    [Parameter] public EventCallback AoNovo { get; set; }
    [Parameter] public EventCallback AoExcluir { get; set; }
    [Parameter] public EventCallback AoAtualizar { get; set; }
    [Parameter] public RenderFragment? Direita { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Faixa { get; set; }
}
