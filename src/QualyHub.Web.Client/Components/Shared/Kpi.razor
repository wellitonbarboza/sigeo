<div class="kpi @Tom">
    <div class="rot">@Rotulo</div>
    <div class="val">@Valor</div>
    @if (!string.IsNullOrEmpty(Sub)) { <div class="sub">@Sub</div> }
</div>
@code {
    [Parameter] public string Rotulo { get; set; } = "";
    [Parameter] public object? Valor { get; set; }
    [Parameter] public string? Sub { get; set; }
    [Parameter] public string Tom { get; set; } = "";
}
