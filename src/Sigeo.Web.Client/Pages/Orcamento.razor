@page "/engenharia/orcamento"
@attribute [Authorize]
@inherits TelaNavegador
@using Sigeo.Domain.Engenharia
@inject Notificacoes Notif
@* Roda no navegador (WebAssembly): a matriz serviço × local vem uma vez da API e todos os totais (serviço, condomínio,
   torre, apartamento, m²) são somados aqui. O servidor só lê, gera o orçamento, grava a célula e cria a requisição. *@

<Pagina Titulo="Orçamento por local" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="barra-filtro">
                <EscolhaObra Id="orc-obra" Valor="_obraId" ValorChanged="TrocarObra" Inicial="ObraQuery" />
                @if (_obraId is not null)
                {
                    <button class="btn prim" id="orc-gerar" disabled="@_ocupado" @onclick="Gerar"><Icone Nome="atualizar" Tam="14" /> Gerar / atualizar orçamento</button>
                    <a class="btn sec" href="@($"engenharia/tipologias?obra={_obraId}")"><Icone Nome="lista" Tam="14" /> Serviços por tipologia</a>
                    <a class="btn sec" href="engenharia/composicoes"><Icone Nome="calculadora" Tam="14" /> Composições</a>
                }
            </div>
            <AvisoFalha Mensagem="@Falha" Tecnica="FalhaTecnica" AoTentar="Carregar" />
            @if (_obraId is null) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra.</div> }
            else if (_dados is null) { @if (Carregando) { <Esqueleto Indicadores="4" Linhas="10" /> } }
            else
            {
                <div class="kpis">
                    <Kpi Rotulo="Custo orçado" Valor="@_total.ToString("C0", Br)" />
                    <Kpi Rotulo="Células serviço × local" Valor="@_cels.Count.ToString("N0", Br)" Sub="@($"{_travadas} travadas (editadas)")" />
                    <Kpi Rotulo="Área privativa" Valor="@($"{Num(_areaPriv, 0)} m²")" Tom="info" />
                    <Kpi Rotulo="R$/m² privativo" Valor="@(_areaPriv == 0 ? "—" : (_total / _areaPriv).ToString("N2", Br))" Tom="info" />
                </div>
                <Abas Itens="_abas" @bind-Ativa="_aba" />
                <div aria-live="polite">@if (_erro is not null) { <div class="alerta aviso" role="alert"><Icone Nome="exclamacao" /> @_erro</div> }</div>
                @if (_aba == "serv")
                {
                    <table class="itens" id="orc-servicos">
                        <thead><tr><th>Grupo</th><th>Serviço</th><th>Un.</th><th class="num">Quantidade</th><th class="num">Custo unit.</th><th class="num">Custo</th><th class="num">% </th><th class="num">Locais</th></tr></thead>
                        <tbody>
                            @foreach (var g in _porServico)
                            {
                                <tr @key="g.Servico"><td>@g.Grupo</td><td>@g.Servico</td><td>@g.Un</td><td class="num">@g.Qtd.ToString("N2", Br)</td><td class="num">@g.Unit.ToString("N2", Br)</td><td class="num">@g.Custo.ToString("N2", Br)</td>
                                    <td class="num">@(_total == 0 ? "" : (100 * g.Custo / _total).ToString("N1", Br))</td><td class="num">@g.N</td></tr>
                            }
                            @if (_cels.Count == 0) { <tr><td colspan="8" class="mudo">Sem orçamento. Marque os serviços nas tipologias e clique em "Gerar / atualizar orçamento".</td></tr> }
                        </tbody>
                    </table>
                }
                else if (_aba == "spe")
                {
                    <table class="itens" id="orc-spe">
                        <thead><tr><th>Condomínio / torre</th><th class="num">Custo</th><th class="num">Apartamentos</th><th class="num">Área priv. (m²)</th><th class="num">R$/m²</th></tr></thead>
                        <tbody>
                            @foreach (var c in _conds)
                            {
                                var (custo, ap, area) = Soma(c.Id);
                                <tr class="peso-600" @key="c.Id"><td>@c.Codigo – @c.Nome</td><td class="num">@custo.ToString("N2", Br)</td><td class="num">@ap</td><td class="num">@area.ToString("N2", Br)</td><td class="num">@(area == 0 ? "" : (custo / area).ToString("N2", Br))</td></tr>
                                @foreach (var t in _filhos[c.Id].Where(l => l.Tipo == GeradorEmpreendimento.TipoTorre).OrderBy(l => l.Codigo))
                                {
                                    var (ct, at, ar) = Soma(t.Id);
                                    <tr @key="t.Id"><td class="pl-24">@t.Codigo – @t.Nome</td><td class="num">@ct.ToString("N2", Br)</td><td class="num">@at</td><td class="num">@ar.ToString("N2", Br)</td><td class="num">@(ar == 0 ? "" : (ct / ar).ToString("N2", Br))</td></tr>
                                }
                                <tr><td class="mudo pl-24">Áreas comuns do condomínio (rateio pela fração ideal)</td><td class="num">@_comumCond.GetValueOrDefault(c.Id).ToString("N2", Br)</td><td></td><td></td><td></td></tr>
                            }
                        </tbody>
                    </table>
                }
                else if (_aba == "apto")
                {
                    <div class="barra-filtro"><label>Torre <select @bind="_fTorre"><option value="">Selecione…</option>@foreach (var t in _torres) { <option @key="t.Id" value="@t.Id">@t.Codigo – @t.Nome</option> }</select></label></div>
                    @if (_fTorre is { } ft)
                    {
                        <table class="itens" id="orc-aptos">
                            <thead><tr><th>Apartamento</th><th>Tipologia</th><th class="num">Área priv.</th><th class="num">Custo direto</th><th class="num">R$/m²</th><th class="num">Serviços</th></tr></thead>
                            <tbody>
                                @foreach (var a in _aptosPorTorre[ft])
                                {
                                    var tot = _totais.GetValueOrDefault(a.Id);
                                    <tr @key="a.Id"><td>@a.Codigo</td><td>@_tips.GetValueOrDefault(a.TipologiaId ?? Guid.Empty)</td><td class="num">@(a.AreaPrivativa?.ToString("N2", Br) ?? "—")</td><td class="num">@tot.Custo.ToString("N2", Br)</td>
                                        <td class="num">@(a.AreaPrivativa is > 0 ? (tot.Custo / a.AreaPrivativa.Value).ToString("N2", Br) : "—")</td><td class="num">@_servicosApto.GetValueOrDefault(a.Id)</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                }
                else if (_aba == "cel")
                {
                    <div class="barra-filtro">
                        <label>Local (código começa com) <input @bind="_fCodigo" @bind:event="oninput" placeholder="QA-T01-P02" /></label>
                        <label>Serviço <select @bind="_fComp"><option value="">Todos</option>@foreach (var c in _comps.Values.OrderBy(c => c.Codigo)) { <option @key="c.Id" value="@c.Id">@c.Codigo – @c.Descricao</option> }</select></label>
                    </div>
                    var lista = Celulas().Take(500).ToList();
                    <table class="itens" id="orc-celulas">
                        <thead><tr><th>Local</th><th>Serviço</th><th class="num">Quantidade</th><th class="num">Custo unit.</th><th class="num">Custo</th><th>Origem</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in lista)
                            {
                                var l = _porId.GetValueOrDefault(c.LocalId);
                                <tr @key="(c.Id, _versaoCel)"><td>@l?.Codigo <span class="mudo">@l?.Nome</span></td><td>@_comps.GetValueOrDefault(c.ComposicaoId)?.Descricao</td>
                                    <td class="num"><input type="number" step="0.01" class="larg-100 texto-dir" aria-label="@($"Quantidade de {_comps.GetValueOrDefault(c.ComposicaoId)?.Descricao} em {l?.Codigo}")" value="@c.Quantidade.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="e => Editar(c, e.Value?.ToString())" /></td>
                                    <td class="num">@c.CustoUnitario.ToString("N2", Br)</td><td class="num">@c.Custo.ToString("N2", Br)</td>
                                    <td>@if (c.Travado) { <Selo Texto="manual (travada)" Tom="aviso" /> } else { <span class="mudo">@c.Origem</span> }</td>
                                    <td>@if (c.Travado) { <button class="btn sec pq" disabled="@_ocupado" @onclick="() => Destravar(c)">Destravar</button> }</td></tr>
                            }
                        </tbody>
                    </table>
                    <p class="mudo">Editar a quantidade trava a célula (o gerador não altera). @(lista.Count == 500 ? "Mostrando as primeiras 500 células — filtre pelo código do local." : $"{lista.Count} célula(s).")</p>
                }
                else
                {
                    <div class="barra-filtro"><label>Requisitar <select id="ct-tipo" value="@_tipoCtr" @onchange="e => { _tipoCtr = Enum.Parse<TipoRequisicao>(e.Value!.ToString()!); _demanda = null; }"><option value="@TipoRequisicao.Servico">Serviço (contratar)</option><option value="@TipoRequisicao.Material">Material (comprar — sai das composições)</option></select></label>
                        <span class="mudo">Mesmo caminho da tela de requisição: itens com a quebra por local, SPE dos locais, faturamento padrão.</span></div>
                    <SeletorDemanda Servicos="_servicosCtr" Locais="_locais" ServicosSelecionados="_selComp" LocaisSelecionados="_selLoc" Demanda="_demanda"
                                    AoMudarSelecao="() => _demanda = null" AoCalcular="Previa" Ocupado="_ocupado"
                                    IdCalcular="ct-previa" IdTabela="ct-demanda" TituloServicos="@(_tipoCtr == TipoRequisicao.Material ? "1. Serviços (os materiais saem das composições)" : "1. Serviços a contratar")" TituloLocais="2. Locais (torres, pavimentos, apartamentos)"
                                    TextoCalcular="Ver quantidades" RotuloOrcado="Orçado nos locais" RotuloSaldo="@(_tipoCtr == TipoRequisicao.Material ? "Saldo a comprar" : "Saldo a contratar")" MostrarReferencia>
                        <Acoes>@if (_demanda is { Count: > 0 }) { <button class="btn prim" id="ct-req" disabled="@_ocupado" @onclick="CriarRequisicao"><Icone Nome="prancheta" Tam="14" /> Criar requisição de @(_tipoCtr == TipoRequisicao.Material ? "material" : "serviço")</button> }</Acoes>
                        <Nota><p class="mudo">A requisição sai com o serviço × local × quantidade (a cotação e o contrato levam essa planilha). A SPE vem dos locais.</p></Nota>
                    </SeletorDemanda>
                }
            }
        </div>
    </ChildContent>
    <Faixa><b>Orçamento</b><span>Serviços das tipologias × locais gerados = matriz serviço × local</span><span>Totais calculados no navegador · contratação por local</span></Faixa>
</Pagina>

@code {
    private sealed record LinhaServico(string? Grupo, string Servico, string Un, decimal Qtd, decimal Unit, decimal Custo, int N);
    private static readonly System.Globalization.CultureInfo Br = new("pt-BR");
    [SupplyParameterFromQuery(Name = "obra")] public Guid? ObraQuery { get; set; }

    private Guid? _obraId, _fTorre, _fComp;
    private string? _fCodigo, _erro;
    private string _aba = "serv";
    private bool _ocupado;
    private OrcamentoObraDto? _dados;
    private List<CelulaOrcamento> _cels = [];
    private List<LocalOrcamento> _locais = [];
    private Dictionary<Guid, LocalOrcamento> _porId = [];
    private ILookup<Guid?, LocalOrcamento> _filhos = Array.Empty<LocalOrcamento>().ToLookup(l => l.PaiId);
    private Dictionary<Guid, ComposicaoResumo> _comps = [];
    private Dictionary<Guid, string> _tips = [];
    private decimal _areaPriv, _total;
    private int _travadas, _versaoCel;
    private readonly HashSet<Guid> _selComp = [];
    private HashSet<Guid> _selLoc = [];
    private List<LinhaDemanda>? _demanda;
    private List<LinhaServico> _porServico = [];
    private List<LocalOrcamento> _conds = [], _torres = [];
    private ILookup<Guid, LocalOrcamento> _aptosPorTorre = Array.Empty<LocalOrcamento>().ToLookup(l => l.Id);
    private ILookup<Guid, CelulaOrcamento> _celsPorLocal = Array.Empty<CelulaOrcamento>().ToLookup(c => c.LocalId);
    private Dictionary<Guid, (decimal Custo, int Aptos, decimal Area)> _totais = [];
    private Dictionary<Guid, int> _servicosApto = [];
    private Dictionary<Guid, decimal> _comumCond = [];
    private List<ServicoOrcado> _servicosCtr = [];
    private TipoRequisicao _tipoCtr = TipoRequisicao.Servico;
    private List<CelulaOrcamento> _celsOrdenadas = [];
    private static readonly List<(string, string)> _abas = [("serv", "Por serviço"), ("spe", "Por condomínio e torre"), ("apto", "Por apartamento"), ("cel", "Células"), ("ctr", "Contratar / comprar")];

    private async Task TrocarObra(Guid? obra)
    {
        _obraId = obra;
        _selComp.Clear(); _selLoc = []; _fTorre = null; _fComp = null; _fCodigo = null; _demanda = null; _erro = null; _dados = null;
        await Carregar();
    }

    private Task Carregar() => _obraId is not { } o ? Task.CompletedTask : Buscar(async () =>
    {
        _demanda = null;
        var d = await Api.ObterAsync<OrcamentoObraDto>($"api/telas/obra/{o}/orcamento", Cancelamento);
        Precalcular(d);
        _dados = d;
    });

    /// <summary>Totais por nó da árvore, áreas comuns por condomínio e listas usadas na tela — uma passada só, no navegador.</summary>
    private void Precalcular(OrcamentoObraDto d)
    {
        _cels = d.Celulas.ToList();
        _locais = d.Locais.ToList();
        _porId = _locais.ToDictionary(l => l.Id);
        _filhos = _locais.ToLookup(l => l.PaiId);
        _comps = d.Composicoes.ToDictionary(c => c.Id);
        _tips = d.Tipologias.ToDictionary(t => t.Id, t => t.Texto);
        _areaPriv = _locais.Where(l => l.Tipo == GeradorEmpreendimento.TipoApartamento).Sum(l => l.AreaPrivativa ?? 0);
        _celsPorLocal = _cels.ToLookup(c => c.LocalId);
        _total = _cels.Sum(c => c.Custo);
        _travadas = _cels.Count(c => c.Travado);
        _porServico = _cels.GroupBy(c => c.ComposicaoId).Select(g =>
        {
            var c = _comps.GetValueOrDefault(g.Key);
            var q = g.Sum(x => x.Quantidade);
            var custo = g.Sum(x => x.Custo);
            return new LinhaServico(c?.Grupo, c is null ? "?" : $"{c.Codigo} – {c.Descricao}", c?.Unidade ?? "", q, q == 0 ? 0 : custo / q, custo, g.Count());
        }).OrderBy(x => x.Grupo).ThenBy(x => x.Servico).ToList();
        _servicosCtr = _comps.Values.OrderBy(c => c.Codigo).Select(c => new ServicoOrcado(c.Id, c.Codigo, c.Descricao, c.Unidade, c.Grupo)).ToList();
        _celsOrdenadas = _cels.OrderBy(c => _porId.GetValueOrDefault(c.LocalId)?.Codigo).ToList();
        _conds = _locais.Where(l => l.Tipo == GeradorEmpreendimento.TipoCondominio).OrderBy(l => l.Codigo).ToList();
        _torres = _locais.Where(l => l.Tipo == GeradorEmpreendimento.TipoTorre).OrderBy(l => l.Codigo).ToList();
        _comumCond = _conds.ToDictionary(c => c.Id, c => _filhos[c.Id].Where(l => l.Tipo == GeradorEmpreendimento.TipoAreaComum).Select(l => l.Id).Append(c.Id)
            .Sum(id => _celsPorLocal[id].Sum(x => x.Custo)));

        // Totais acumulados de baixo para cima (pós-ordem, sem recursão) e a torre de cada apartamento.
        _totais = new(_locais.Count);
        var ordem = new List<LocalOrcamento>(_locais.Count);
        var pilha = new Stack<LocalOrcamento>(_locais.Where(l => l.PaiId is null || !_porId.ContainsKey(l.PaiId.Value)));
        while (pilha.Count > 0) { var l = pilha.Pop(); ordem.Add(l); foreach (var f in _filhos[l.Id]) pilha.Push(f); }
        var servicos = new Dictionary<Guid, HashSet<Guid>>();
        for (var i = ordem.Count - 1; i >= 0; i--)
        {
            var l = ordem[i];
            var custo = _celsPorLocal[l.Id].Sum(c => c.Custo);
            var ap = l.Tipo == GeradorEmpreendimento.TipoApartamento ? 1 : 0;
            var area = ap == 1 ? l.AreaPrivativa ?? 0 : 0;
            var sv = _celsPorLocal[l.Id].Select(c => c.ComposicaoId).ToHashSet();
            foreach (var f in _filhos[l.Id])
            {
                if (_totais.TryGetValue(f.Id, out var t)) { custo += t.Custo; ap += t.Aptos; area += t.Area; }
                if (servicos.TryGetValue(f.Id, out var sf)) sv.UnionWith(sf);
            }
            _totais[l.Id] = (custo, ap, area);
            servicos[l.Id] = sv;
        }
        var aptos = _locais.Where(l => l.Tipo == GeradorEmpreendimento.TipoApartamento).ToList();
        _servicosApto = aptos.ToDictionary(a => a.Id, a => servicos.GetValueOrDefault(a.Id)?.Count ?? 0);
        _aptosPorTorre = aptos.Select(a => (Torre: TorreDe(a), Apto: a)).Where(x => x.Torre is not null).OrderBy(x => x.Apto.Codigo).ToLookup(x => x.Torre!.Value, x => x.Apto);
    }

    private Guid? TorreDe(LocalOrcamento l)
    {
        for (Guid? p = l.PaiId; p is { } id && _porId.TryGetValue(id, out var x); p = x.PaiId)
            if (x.Tipo == GeradorEmpreendimento.TipoTorre) return x.Id;
        return null;
    }

    private (decimal Custo, int Aptos, decimal Area) Soma(Guid raiz) => _totais.GetValueOrDefault(raiz);

    private IEnumerable<CelulaOrcamento> Celulas() =>
        _celsOrdenadas.Where(c => (_fComp is null || c.ComposicaoId == _fComp) && (string.IsNullOrWhiteSpace(_fCodigo) || (_porId.GetValueOrDefault(c.LocalId)?.Codigo ?? "").StartsWith(_fCodigo.Trim(), StringComparison.OrdinalIgnoreCase)));

    /// <summary>Ação que grava: bloqueia os botões, mostra a recusa do servidor e recarrega só se deu certo.</summary>
    private async Task<bool> Acao(Func<Task> acao, string? sucesso = null)
    {
        if (_ocupado) return false;
        _ocupado = true; _erro = null;
        try
        {
            await acao();
            if (sucesso is not null) Notif.Sucesso(sucesso);
            return true;
        }
        catch (Sigeo.Web.Client.Servicos.RecusaApi r) { _erro = r.Message; Notif.Erro(r.Message); return false; }
        catch (Exception e) when (e is not OperationCanceledException) { _erro = "Não foi possível concluir. Tente de novo."; Notif.Erro(_erro); return false; }
        finally { _ocupado = false; }
    }

    private async Task Gerar()
    {
        ResultadoOrcamento? r = null;
        if (await Acao(async () => r = await Api.EnviarAsync<object, ResultadoOrcamento>($"api/telas/obra/{_obraId}/orcamento/gerar", new { }, Cancelamento)))
        {
            Notif.Sucesso($"Orçamento atualizado: {r!.Criadas} células novas, {r.Atualizadas} atualizadas, {r.Removidas} removidas, {r.Travadas} travadas mantidas. Total {Moeda(r.Total)}.");
            await Carregar();
        }
    }

    private async Task Editar(CelulaOrcamento c, string? v)
    {
        if (string.IsNullOrWhiteSpace(v) || !decimal.TryParse(v, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var q) || q < 0)
        {
            _erro = $"Quantidade inválida: \"{v}\". Informe um número maior ou igual a zero.";
            Notif.Erro(_erro);
            _versaoCel++; // recria a linha para voltar ao valor salvo
            return;
        }
        if (await Acao(() => Api.EnviarAsync($"api/telas/orcamento/celula/{c.Id}", new EdicaoCelula(q, true), Cancelamento), "Célula alterada e travada.")) await Carregar();
        else _versaoCel++;
    }

    private async Task Destravar(CelulaOrcamento c)
    {
        if (await Acao(() => Api.EnviarAsync($"api/telas/orcamento/celula/{c.Id}", new EdicaoCelula(c.Quantidade, false), Cancelamento),
                "Destravada — o próximo 'Gerar' recalcula pela tipologia.")) await Carregar();
    }

    private PedidoDemanda Escolha() => new(_tipoCtr, _selComp.ToList(), _selLoc.ToList());

    private Task Previa() => Acao(async () =>
        _demanda = await Api.EnviarAsync<PedidoDemanda, List<LinhaDemanda>>($"api/telas/obra/{_obraId}/orcamento/demanda", Escolha(), Cancelamento));

    private sealed record Criada(Guid Id);

    private async Task CriarRequisicao()
    {
        Criada? r = null;
        if (await Acao(async () => r = await Api.EnviarAsync<PedidoDemanda, Criada>($"api/telas/obra/{_obraId}/orcamento/requisicao", Escolha(), Cancelamento),
                $"Requisição de {(_tipoCtr == TipoRequisicao.Material ? "material" : "serviço")} criada — revise e envie para aprovação."))
            Nav.NavigateTo($"requisicoes?id={r!.Id}");
    }
}
