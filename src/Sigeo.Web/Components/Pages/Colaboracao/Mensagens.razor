@page "/mensagens"
@inherits PaginaBase
@inject MensagensServico Caixa
@inject NavigationManager Nav
@inject Sigeo.Application.Comum.CanalAvisos Canal

<PageTitle>Mensagens · SIGEO</PageTitle>
<div class="tela">
    <div class="topo"><h1>Mensagens</h1></div>
    <div class="miolo">
        <div class="acoes-pagina"><button class="btn prim" id="msg-nova" @onclick="() => _nova = true"><Icone Nome="mais" Tam="16" /> Nova mensagem</button></div>
        <div class="caixa-msg @(_aberta is not null ? "lendo" : "")">
            <nav class="pastas-msg" aria-label="Pastas">
                @foreach (var (p, texto, icone) in Pastas)
                {
                    <button class="pasta-msg" aria-pressed="@(_pasta == p)" @onclick="() => TrocarPasta(p)">
                        <Icone Nome="@icone" Tam="16" /> @texto
                        @if (p == MensagensServico.Pasta.Entrada && _naoLidas > 0) { <b class="cont">@_naoLidas</b> }
                    </button>
                }
            </nav>
            <section class="lista-msg" aria-label="Conversas">
                <div class="busca-msg"><input type="search" placeholder="Procurar por assunto, pessoa, registro ou texto" aria-label="Procurar" @bind="_busca" @bind:event="oninput" @bind:after="Buscar" /></div>
                <div class="itens-msg">
                    @if (_lista is null) { <Esqueleto Linhas="6" /> }
                    else if (_lista.Count == 0) { <p class="mudo pad">@(string.IsNullOrWhiteSpace(_busca) ? "Nenhuma conversa nesta pasta." : "Nada encontrado.")</p> }
                    else
                    {
                        @foreach (var c in _lista)
                        {
                            <button class="item-msg @(c.NaoLidas > 0 ? "nlida" : "")" @key="c.Id" aria-current="@(_aberta?.Id == c.Id)" @onclick="() => Abrir(c.Id)">
                                <span class="av" style="--cor:@Cor(c.UltimoAutor)">@Iniciais(c.UltimoAutor)</span>
                                <span class="de">@(_pasta == MensagensServico.Pasta.Enviadas ? $"Para: {c.Participantes}" : c.UltimoAutor)</span>
                                <span class="hora">@Quando(c.UltimaEm)</span>
                                <span class="ass">@if (c.NaoLidas > 0) { <b class="cont">@c.NaoLidas</b> } @c.Assunto</span>
                                <span class="prev">@if (c.RegistroDescricao is not null) { <span class="selo-reg">@c.RegistroDescricao</span> } @c.Previa</span>
                            </button>
                        }
                        @if (_lista.Count >= 200) { <p class="mudo pad">Exibindo as 200 mais recentes — use a busca para achar as antigas.</p> }
                    }
                </div>
            </section>
            <section class="leitura-msg" aria-label="Conversa aberta" aria-live="polite">
                @if (_aberta is null)
                {
                    <div class="vazio-msg"><Icone Nome="mensagem" Tam="40" /><p>Escolha uma conversa ou escreva uma nova mensagem.</p></div>
                }
                else
                {
                    var c = _aberta;
                    <div class="cab-msg">
                        <button class="btn sec pq voltar-msg" @onclick="() => _aberta = null">← Voltar</button>
                        <h2>@c.Assunto <small class="mudo">nº @c.Numero</small></h2>
                        <div class="meta-msg">
                            @foreach (var p in c.Participantes) { <span class="part @(p.Papel.ToString().ToLowerInvariant())">@p.Nome@(p.Papel == PapelParticipante.Copia ? " (cópia)" : "")</span> }
                        </div>
                        @if (c.RegistroLink is not null) { <a class="vinculo-reg" href="@c.RegistroLink"><Icone Nome="corrente" Tam="14" /> @c.RegistroDescricao · abrir</a> }
                    </div>
                    <div class="fio-msg">
                        @foreach (var m in c.Mensagens)
                        {
                            <article class="msg @(m.AutorId == Usuario.UsuarioId ? "minha" : "")" @key="m.Id">
                                <div class="linha"><b>@m.Autor</b><span class="mudo">@DataHora(m.EnviadaEm)</span></div>
                                <div class="corpo">@((MarkupString)m.Html)</div>
                                <div class="lidos mudo">
                                    @string.Join(" · ", new[] { m.Lidos.Count > 0 ? "Lido por: " + string.Join(", ", m.Lidos.Select(l => $"{l.Nome} {l.LidaEm.ToLocalTime():dd/MM HH:mm}")) : null,
                                        m.NaoLeram.Count > 0 ? "Ainda não leram: " + string.Join(", ", m.NaoLeram) : null }.Where(x => x is not null))
                                </div>
                            </article>
                        }
                        <details class="anexos-msg"><summary><Icone Nome="clipe" Tam="14" /> Anexos da conversa</summary>
                            <Anexos Entidade="Conversa" EntidadeId="c.Id" />
                        </details>
                    </div>
                    <div class="resposta-msg">
                        <Erros Lista="ErrosForm" />
                        <EditorMensagem @bind-Valor="_resposta" Placeholder="Responder a todos…" Linhas="3" />
                        @if (_incluindo) { <SeletorDestinatarios Rotulo="Incluir na conversa" Opcoes="_opcoes" Selecionados="_incluir" /> }
                        <div class="acoes-msg">
                            <span class="grupo-btn">
                                <button class="btn sec pq" @onclick="Arquivar"><Icone Nome="arquivar" Tam="14" /> @(c.Arquivada ? "Voltar para a entrada" : "Arquivar")</button>
                                <button class="btn sec pq" @onclick="IncluirPessoas"><Icone Nome="pessoa" Tam="14" /> Incluir pessoas</button>
                                <a class="btn sec pq" href="@LinkTarefa(c)"><Icone Nome="lista" Tam="14" /> Criar tarefa</a>
                            </span>
                            <button class="btn prim" id="msg-responder" disabled="@(Ocupado || string.IsNullOrWhiteSpace(_resposta))" @onclick="Responder"><Icone Nome="responder" Tam="16" /> Responder</button>
                        </div>
                    </div>
                }
            </section>
        </div>
    </div>
    <div class="faixa"><b>Mensagens internas</b><span>Só entre usuários · cada um vê as suas conversas</span><span>Ligada a registro = evidência</span><span>Nada é apagado</span></div>
</div>

<NovaMensagem @bind-Aberto="_nova" AoEnviar="AoEnviar" />
