@page "/sgq/documentos"
@inherits PaginaBase
@inject DocumentosServico Docs
@inject NavigationManager Nav

<Pagina Titulo="Documentos do SGQ" Grade="_grade" AoNovo="Novo" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="kpis">
                <Kpi Rotulo="Vigentes" Valor="@_todos.Count(d => d.Status == StatusDocumentoSgq.Vigente)" Tom="ok" />
                <Kpi Rotulo="Em elaboração / revisão" Valor="@_todos.Count(d => d.Status is StatusDocumentoSgq.EmElaboracao or StatusDocumentoSgq.EmRevisao)" Tom="info" />
                <Kpi Rotulo="Análise crítica vencida" Valor="@_todos.Count(d => d.ProximaAnalise < Hoje)" Tom="erro" />
                <Kpi Rotulo="Cópias a recolher" Valor="@_aRecolher" Sub="revisões obsoletas" Tom="aviso" />
            </div>
            <div class="duas-colunas">
                <aside class="arvore">
                    <div class="@(_pasta is null ? "on" : "")" @onclick="() => Filtrar(null)"><Icone Nome="pasta" Tam="15" /> Todos (@_todos.Count)</div>
                    @foreach (var (p, nivel) in Arvore(null, 0))
                    {
                        <div class="@(_pasta == p.Id ? "on" : "")" style="padding-left:@(10 + nivel * 14)px" @onclick="() => Filtrar(p.Id)">
                            <Icone Nome="pasta" Tam="15" /> @p.Nome <small class="mudo">(@_todos.Count(d => d.PastaId == p.Id))</small>
                        </div>
                    }
                    @if (Gestor) { <div class="mudo marg-topo-8" @onclick="() => { _novaPasta = new Pasta(); _abertoPasta = true; }"><Icone Nome="mais" Tam="14" /> Nova pasta</div> }
                </aside>
                <div class="flex-1">
                    @if (Gestor) {
                        <div class="acoes-pagina"><button class="btn sec" id="sgq-lote" @onclick="AbrirLote"
                                title="Traz vários documentos já elaborados (.docx/.xlsx e o PDF) — cada um entra com a revisão do arquivo, em elaboração"><Icone
                                    Nome="upload" Tam="16" />
                                Importar em lote</button></div>
                    }
                    <Grade T="Linha" @ref="_grade" Itens="_itens" AoClicar="l => Abrir(l.Id)" NomeExportacao="documentos-sgq" CriadoPor="l => l.CriadoPor">
                        <Colunas>
                            <Coluna T="Linha" Titulo="Código" Valor="l => l.Codigo" Largura="110px" />
                            <Coluna T="Linha" Titulo="Título" Valor="l => l.Titulo" />
                            <Coluna T="Linha" Titulo="Tipo" Valor="l => l.Tipo" />
                            <Coluna T="Linha" Titulo="Pasta" Valor="l => l.Pasta" />
                            <Coluna T="Linha" Titulo="Rev." Valor="l => l.Revisao" Largura="60px" />
                            <Coluna T="Linha" Titulo="Vigência" Valor="l => l.Vigencia" />
                            <Coluna T="Linha" Titulo="Próx. análise" Valor="l => l.ProximaAnalise"><Modelo><span class="@(context.ProximaAnalise < Hoje ? "texto-erro" : "")">@Data(context.ProximaAnalise)</span></Modelo></Coluna>
                            <Coluna T="Linha" Titulo="Responsável" Valor="l => l.Responsavel" />
                            <Coluna T="Linha" Titulo="Status" Valor="l => l.Status"><Modelo><Selo Texto="@De(context.Status)" Tom="@Tom(context.Status)" /></Modelo></Coluna>
                        </Colunas>
                    </Grade>
                </div>
            </div>
        </div>
    </ChildContent>
    <Faixa><b>Controle de documentos</b><span>Elaboração → análise crítica → aprovação → publicação (segregação de funções)</span><span>Publicada = imutável · anterior vira obsoleta e cópias entram em recolhimento</span><span>Todos os acessos ficam no log</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_abertoPasta" Titulo="Nova pasta (processo / área)" Tamanho="media">
    <ChildContent>
        @if (_novaPasta is not null)
        {
            <div class="form">
                <Campo Rotulo="Nome" Obrigatorio Classe="s8"><input @bind="_novaPasta.Nome" /></Campo>
                <Campo Rotulo="Ordem" Classe="s4"><input type="number" @bind="_novaPasta.Ordem" /></Campo>
                <Campo Rotulo="Pasta pai" Classe="s12"><select @bind="_novaPasta.PastaPaiId"><option value="">(raiz)</option>@foreach (var p in _pastas) { <option value="@p.Id">@p.Nome</option> }</select></Campo>
            </div>
        }
    </ChildContent>
    <Rodape><button class="btn prim" disabled="@Ocupado" @onclick="SalvarPasta"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

<Modal @bind-Aberto="_abertoNovo" Titulo="Novo documento" Tamanho="media">
    <ChildContent>
        @if (_novo is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Código" Obrigatorio Classe="s4"><input @bind="_novo.Codigo" placeholder="PQ-01" /></Campo>
                <Campo Rotulo="Título" Obrigatorio Classe="s8"><input @bind="_novo.Titulo" /></Campo>
                <Campo Rotulo="Tipo" Obrigatorio Classe="s4"><select @bind="_novo.Tipo"><option value="">Selecione…</option>@foreach (var t in _tipos) { <option>@t</option> }</select></Campo>
                <Campo Rotulo="Pasta (processo/área)" Obrigatorio Classe="s8"><select @bind="_novo.PastaId"><option value="@Guid.Empty">Selecione…</option>@foreach (var p in _pastas) { <option value="@p.Id">@p.Nome</option> }</select></Campo>
                <Campo Rotulo="Requisito SiAC" Classe="s4"><input @bind="_novo.RequisitoSiac" placeholder="ex.: 7.5.3" /></Campo>
                <Campo Rotulo="Abrangência" Classe="s4"><select @bind="_novo.Abrangencia">@foreach (var a in Enum.GetValues<AbrangenciaDocumento>()) { <option value="@a">@De(a)</option> }</select></Campo>
                <Campo Rotulo="Nível de acesso" Classe="s4"><select @bind="_novo.NivelAcesso">@foreach (var a in Enum.GetValues<NivelAcesso>()) { <option value="@a">@De(a)</option> }</select></Campo>
                @if (_novo.Abrangencia == AbrangenciaDocumento.PorObra)
                {
                    <Campo Rotulo="Obra" Classe="s6"><select @bind="_novo.ObraId"><option value="">Selecione…</option>@foreach (var o in _obras) { <option value="@o.Id">@o.Texto</option> }</select></Campo>
                }
                <Campo Rotulo="Responsável (elaboração)" Classe="s6"><select @bind="_novo.ResponsavelUsuarioId"><option value="">—</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                <Campo Rotulo="Aprovador" Classe="s6"><select @bind="_novo.AprovadorUsuarioId"><option value="">—</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                <Campo Rotulo="Periodicidade análise crítica (meses)" Classe="s6"><input type="number" @bind="_novo.PeriodicidadeMeses" /></Campo>
                <Campo Rotulo="Distribuição padrão (funções/perfis)" Classe="s6"><input @bind="_novo.DistribuicaoPadrao" /></Campo>
                <Campo Rotulo="Leitura obrigatória (funções/perfis)" Classe="s6"><input @bind="_novo.LeituraObrigatoria" placeholder="ex.: Engenharia; Campo" /></Campo>
                <Campo Rotulo="" Classe="s12"><label><input type="checkbox" @bind="_novo.GeraRegistro" /> Gera registro (formulário) — definir retenção</label></Campo>
                @if (_novo.GeraRegistro)
                {
                    <Campo Rotulo="Regra de retenção" Classe="s12"><select @bind="_novo.RegraRetencaoId"><option value="">—</option>@foreach (var r in _retencoes) { <option value="@r.Id">@r.Texto</option> }</select></Campo>
                }
            </div>
        }
    </ChildContent>
    <Rodape><button class="btn prim" disabled="@Ocupado" @onclick="Criar"><Icone Nome="check" Tam="16" /> Criar (abre R00 em elaboração)</button></Rodape>
</Modal>

<Modal @bind-Aberto="_abertoLote" Titulo="Importar documentos em lote" Tamanho="grande">
    <ChildContent>
        <Erros Lista="ErrosForm" />
        <p class="mudo">Selecione os editáveis (.docx/.xlsx) e, se tiver, os PDFs. O código, o título e a revisão vêm do conteúdo do arquivo
            (propriedades, cabeçalho "Identificação/Versão" ou aba BANCO DE DADOS) — o nome do arquivo só é usado na falta deles.
            Cada documento entra com a revisão do arquivo <b>em elaboração</b>: a análise crítica, a aprovação e a publicação seguem o fluxo normal.</p>
        <div class="form">
            <Campo Rotulo="Pasta (processo/área)" Obrigatorio Classe="s6"><select id="lote-pasta" @bind="_lotePasta"><option value="@Guid.Empty">Selecione…</option>@foreach (var p in _pastas) { <option value="@p.Id">@p.Nome</option> }</select></Campo>
            <Campo Rotulo="Tipo" Classe="s6"><select id="lote-tipo" @bind="_loteTipo"><option value="">Pelo código (PEIS/ITS → ITS; FVS/FVM → ficha…)</option>@foreach (var t in _tipos) { <option>@t</option> }</select></Campo>
            <Campo Rotulo="Arquivos" Classe="s12"><InputFile id="lote-arquivos" OnChange="LerLote" multiple accept=".docx,.xlsx,.xlsm,.pdf" disabled="@Ocupado" /></Campo>
        </div>
        @if (_lote is { } r)
        {
            <p><b>@r.Criar</b> novos · <b>@r.Revisoes</b> revisões · <b>@r.Ignorados</b> ignorados</p>
            @if (r.SemCodigo.Count > 0) { <div class="alerta aviso"><Icone Nome="alerta" /> <div>Sem código identificado (não entram): @string.Join(", ", r.SemCodigo)</div></div> }
            <table class="itens" id="lote-resumo">
                <thead><tr><th>Código</th><th>Título</th><th>Tipo</th><th>Rev.</th><th>Editável</th><th>PDF</th><th>Ação</th><th>Serviço controlado</th></tr></thead>
                <tbody>
                    @foreach (var i in r.Itens)
                    {
                        <tr>
                            <td>@i.Codigo</td><td>@i.Titulo</td><td>@i.Tipo</td><td>R@(i.Revisao.ToString("00"))</td>
                            <td class="mudo">@i.Editavel</td><td class="mudo">@(i.Pdf ?? "—")</td>
                            <td><Selo Texto="@AcaoLote(i.Acao)" Tom="@(i.Acao == AcaoLoteSgq.Ignorar ? "aviso" : "ok")" /> <small class="mudo">@i.Observacao</small></td>
                            <td class="mudo">@(i.ServicoVinculado ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </ChildContent>
    <Rodape>@if (_lote is { } l && l.Itens.Any(i => i.Acao != AcaoLoteSgq.Ignorar)) { <button class="btn prim" id="lote-importar" disabled="@Ocupado" @onclick="ImportarLote"><Icone Nome="check" Tam="16" /> Importar</button> }</Rodape>
</Modal>

<Modal @bind-Aberto="_aberto" Titulo="@($"{_d?.Codigo} — {_d?.Titulo}")" Tamanho="grande">
    <ChildContent>
        @if (_d is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="cabecalho-doc">
                <Selo Texto="@De(_d.Status)" Tom="@Tom(_d.Status)" />
                <span>Vigente: <b>@(_d.RevisaoVigente?.Rotulo ?? "—")</b> desde @Data(_d.DataVigencia)</span>
                <span>Próxima análise crítica: <b class="@(_d.AnaliseVencida(Hoje) ? "texto-erro" : "")">@Data(_d.ProximaAnalise)</b></span>
                <span>Responsável: @(_d.ResponsavelNome ?? "—")</span>
            </div>
            <Abas Itens="_abasDoc" @bind-Ativa="_aba" />
            @if (_aba == "revisao")
            {
                var rev = _emAndamento ?? _d.RevisaoVigente;
                @if (rev is null) { <p class="mudo">Sem revisão.</p> }
                else
                {
                    <div class="secao"><Icone Nome="arquivo" /> @rev.Rotulo — @De(rev.Status) <span class="mudo">&nbsp;· @De(rev.MotivoRevisao) · @rev.DescricaoAlteracao</span></div>
                    <Etapas Itens="PassosRev(rev)" />
                    <div class="arquivos">
                        <div><b>Editável</b>
                            @if (rev.ArquivoEditavelNome is not null && _perm?.Editar == true) { <a href="arquivos/sgq/@rev.Id/editavel" target="_blank" data-enhance-nav="false">@rev.ArquivoEditavelNome</a> } else { <span class="mudo">@(rev.ArquivoEditavelNome ?? "não anexado")</span> }
                            @if (_emAndamento is not null && _perm?.Editar == true) { <InputFile OnChange="e => Anexar(e, false)" accept=".docx,.xlsx,.doc,.xls,.pptx,.dwg,.pdf" /> }
                        </div>
                        <div><b>Publicado (PDF)</b>
                            @if (rev.ArquivoPublicadoNome is not null) { <a href="arquivos/sgq/@rev.Id/publicado" target="_blank" data-enhance-nav="false">@rev.ArquivoPublicadoNome</a> <small class="mudo">sha256 @rev.HashSha256?[..12]…</small> } else { <span class="mudo">não anexado</span> }
                            @if (_emAndamento is not null && _perm?.Editar == true) { <InputFile OnChange="e => Anexar(e, true)" accept=".pdf" /> }
                        </div>
                        @if (_emAndamento is not null && _perm?.Editar == true)
                        {
                            <div><b>Check-out</b>
                                @if (_checkout is not null) { <span>com <b>@_checkout.UsuarioNome</b> até @Data(_checkout.Prazo)</span>
                                    <button class="btn sec pq" @onclick="() => Checkin(false)">Check-in</button>
                                    @if (Gestor) { <button class="btn sec pq" @onclick="() => Checkin(true)">Liberar (forçado)</button> }
                                }
                                else { <button class="btn sec pq" @onclick="Checkout">Fazer check-out</button> }
                            </div>
                        }
                    </div>
                    @if (_emAndamento?.EtapaAtual is { } etapa)
                    {
                        <div class="secao"><Icone Nome="check" /> Etapa atual: @De(etapa.Etapa)</div>
                        @if (etapa.Etapa == EtapaRevisaoTipo.Publicacao)
                        {
                            <div class="form"><Campo Rotulo="Início de vigência" Classe="s3"><input type="date" @bind="_vigencia" /></Campo></div>
                        }
                        else
                        {
                            <div class="form"><Campo Rotulo="Comentário (obrigatório para devolver/recusar)" Classe="s12"><textarea @bind="_comentario"></textarea></Campo></div>
                        }
                    }
                    <div class="secao"><Icone Nome="relogio" /> Assinaturas das etapas</div>
                    <table class="itens">
                        <thead><tr><th>Etapa</th><th>Decisão</th><th>Responsável</th><th>Data</th><th>Comentário</th><th>Assinatura</th></tr></thead>
                        <tbody>
                            @foreach (var e in rev.Etapas.OrderBy(e => e.DataDecisao ?? DateTimeOffset.MaxValue).ThenBy(e => e.Etapa))
                            {
                                <tr class="@(e.Historico ? "mudo" : "")"><td>@De(e.Etapa) @(e.Historico ? "(histórico)" : "")</td><td><Selo Texto="@De(e.Decisao)" Tom="@Tom(e.Decisao)" /></td>
                                    <td>@e.ResponsavelNome</td><td>@DataHora(e.DataDecisao)</td><td>@e.Comentario</td><td><small>@e.Assinatura</small></td></tr>
                            }
                        </tbody>
                    </table>
                }
            }
            else if (_aba == "historico")
            {
                <table class="itens">
                    <thead><tr><th>Rev.</th><th>Motivo</th><th>Alteração</th><th>Elaborado</th><th>Aprovado</th><th>Vigência</th><th>Status</th><th>Arquivo</th></tr></thead>
                    <tbody>
                        @foreach (var r in _d.Revisoes.OrderByDescending(r => r.Revisao))
                        {
                            <tr><td>@r.Rotulo</td><td>@De(r.MotivoRevisao)</td><td>@r.DescricaoAlteracao</td><td>@r.ElaboradoPor</td><td>@r.AprovadoPor</td><td>@Data(r.DataVigencia)</td>
                                <td><Selo Texto="@De(r.Status)" Tom="@Tom(r.Status)" /></td>
                                <td>@if (r.ArquivoPublicadoNome is not null && (r.Status != StatusRevisao.Obsoleta || _perm?.VerObsoletos == true)) { <a href="arquivos/sgq/@r.Id/publicado" target="_blank" data-enhance-nav="false">PDF</a> }</td></tr>
                        }
                    </tbody>
                </table>
            }
            else if (_aba == "copias")
            {
                <table class="itens">
                    <thead><tr><th>Cópia</th><th>Rev.</th><th>Tipo</th><th>Destinatário</th><th>Entregue</th><th>Status</th><th>Prazo recolh.</th></tr></thead>
                    <tbody>
                        @foreach (var c in _d.Revisoes.SelectMany(r => r.Copias.Select(c => (r, c))).OrderByDescending(x => x.r.Revisao))
                        {
                            <tr><td>@c.c.NumeroCopia</td><td>@c.r.Rotulo</td><td>@De(c.c.TipoCopia)</td><td>@c.c.Destinatario</td><td>@DataHora(c.c.EntregueEm)</td><td><Selo Texto="@De(c.c.Status)" Tom="@Tom(c.c.Status)" /></td><td>@Data(c.c.PrazoRecolhimento)</td></tr>
                        }
                    </tbody>
                </table>
            }
            else if (_aba == "leituras")
            {
                <table class="itens">
                    <thead><tr><th>Usuário</th><th>Função</th><th>Rev.</th><th>Prazo</th><th>Lido em</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var c in _ciencias)
                        {
                            var st = c.Status(Hoje);
                            <tr><td>@c.UsuarioNome</td><td>@c.Funcao</td><td>@_d.Revisoes.FirstOrDefault(r => r.Id == c.DocumentoRevisaoId)?.Rotulo</td><td>@Data(c.Prazo)</td><td>@DataHora(c.LidoEm)</td><td><Selo Texto="@De(st)" Tom="@Tom(st)" /></td></tr>
                        }
                        @if (_ciencias.Count == 0) { <tr><td colspan="6" class="mudo">Sem leitura obrigatória.</td></tr> }
                    </tbody>
                </table>
            }
            else if (_aba == "log")
            {
                @if (_eventos.Count >= LimiteEventos) { <p class="mudo">Exibindo os primeiros @LimiteEventos — refine o filtro.</p> }
                <table class="itens">
                    <thead><tr><th>Data/hora</th><th>Usuário</th><th>Evento</th><th>Detalhe</th></tr></thead>
                    <tbody>
                        @foreach (var e in _eventos) { <tr><td>@DataHora(e.DataHora)</td><td>@e.UsuarioNome</td><td>@De(e.Evento)</td><td>@e.Detalhe</td></tr> }
                    </tbody>
                </table>
            }
        }
    </ChildContent>
    <Rodape>
        @if (_d is not null && _aba == "revisao")
        {
            @if (_emAndamento?.EtapaAtual is { } et)
            {
                if (et.Etapa == EtapaRevisaoTipo.Publicacao)
                {
                    <button class="btn laranja" disabled="@Ocupado" @onclick="Publicar"><Icone Nome="enviar" Tam="16" /> Publicar</button>
                }
                else
                {
                    <button class="btn perigo" disabled="@Ocupado" @onclick="() => Decidir(DecisaoEtapa.Recusado)">Recusar</button>
                    @if (et.Etapa != EtapaRevisaoTipo.Elaboracao) { <button class="btn sec" disabled="@Ocupado" @onclick="() => Decidir(DecisaoEtapa.Devolvido)">Devolver p/ ajuste</button> }
                    <button class="btn ok" disabled="@Ocupado" @onclick="() => Decidir(DecisaoEtapa.Aprovado)"><Icone Nome="check" Tam="16" /> @(et.Etapa == EtapaRevisaoTipo.Elaboracao ? "Concluir elaboração" : "Aprovar")</button>
                }
            }
            @if (_emAndamento is null && _perm?.Editar == true) { <button class="btn prim" @onclick="() => { _motivo = MotivoRevisao.Melhoria; _descricao = null; _origem = null; _abertoRev = true; }"><Icone Nome="mais" Tam="16" /> Nova revisão</button> }
        }
    </Rodape>
</Modal>

<Modal @bind-Aberto="_abertoRev" Titulo="@($"Nova revisão — {_d?.Codigo}")" Tamanho="media">
    <ChildContent>
        <Erros Lista="ErrosForm" />
        <div class="form">
            <Campo Rotulo="Motivo" Obrigatorio Classe="s6"><select @bind="_motivo">@foreach (var m in Enum.GetValues<MotivoRevisao>().Where(m => m != MotivoRevisao.EmissaoInicial)) { <option value="@m">@De(m)</option> }</select></Campo>
            <Campo Rotulo="Origem (RNC, auditoria, sugestão…)" Classe="s6"><input @bind="_origem" /></Campo>
            <Campo Rotulo="Descrição da alteração" Obrigatorio Classe="s12"><textarea @bind="_descricao"></textarea></Campo>
        </div>
        <p class="mudo">A revisão vigente continua valendo até a publicação da nova.</p>
    </ChildContent>
    <Rodape><button class="btn prim" disabled="@Ocupado" @onclick="NovaRevisao"><Icone Nome="check" Tam="16" /> Abrir revisão</button></Rodape>
</Modal>
