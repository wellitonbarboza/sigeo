@page "/fornecedor/cotacao/{CotacaoId:guid}"
@* Sem [Authorize]: o [Authorize] geral das páginas é do login interno. A sessão do fornecedor é conferida no OnInitialized (sem identidade → /fornecedor). *@
@attribute [AllowAnonymous]
@layout LayoutPublico
@implements IDisposable
@inject AcessoFornecedorServico Acesso
@inject NavigationManager Nav
@* Proposta da cotação dentro da Área do Fornecedor: a chave do convite fica no servidor (não vai na URL). *@

<PageTitle>Proposta de cotação · Área do Fornecedor</PageTitle>
<div class="portal">
    <p><a href="@($"fornecedor/area{(Fornecedor is { } f ? $"?f={f}" : "")}")" id="forn-voltar">‹ Voltar às cotações</a></p>
    @if (_erro is not null) { <div class="alerta erro" role="alert">@_erro</div> }
    else if (_convite is { } t) { <Sigeo.Web.Components.Pages.Publico.PortalCotacao Token="@t" NaArea="true" /> }
    else { <p class="mudo">Carregando…</p> }
</div>

@code {
    [Parameter] public Guid CotacaoId { get; set; }
    [SupplyParameterFromQuery(Name = "f")] public Guid? Fornecedor { get; set; }
    [CascadingParameter] private Task<AuthenticationState> Estado { get; set; } = default!;
    private readonly CancellationTokenSource _cts = new();
    private Guid? _convite;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        var id = ClaimsFornecedor.Identidade((await Estado).User);
        if (id is null) { Nav.NavigateTo(Sessao.Entrada(Nav), forceLoad: true); return; }
        try
        {
            // Sem ?f= (link antigo/convite): procura entre os CNPJs da pessoa o que foi convidado para esta cotação.
            var candidatos = Fornecedor is { } f ? [f] : (await Acesso.AcessosAsync(id, _cts.Token)).Select(a => a.FornecedorId).ToList();
            foreach (var fid in candidatos)
            {
                try { _convite = await Acesso.ConviteAsync(id, fid, CotacaoId, _cts.Token); Fornecedor = fid; break; }
                catch (Domain.Aprovacoes.RegraDeNegocioException) { }
            }
            if (_convite is null) _erro = "Esta cotação não está disponível para os CNPJs do seu acesso.";
        }
        catch (Domain.Aprovacoes.RegraDeNegocioException e) { _erro = e.Message; }
    }

    public void Dispose() => _cts.Cancel();
}
