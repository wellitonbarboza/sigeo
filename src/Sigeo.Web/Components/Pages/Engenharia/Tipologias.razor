@page "/engenharia/tipologias"
@inherits PaginaBase
@inject EngenhariaServico Eng
@inject OrcamentoServico Orc
@inject KitTipologiaServico Kit

<Pagina Titulo="Tipologias" Grade="_grade" AoNovo="Novo" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="barra-filtro">
                <SeletorObra Id="tip-obra" Valor="_obraId" ValorChanged="TrocarObra" Inicial="ObraQuery" />
                <div class="filtros-rapidos">@foreach (var t in Enum.GetValues<TipoTipologia>()) { <label><input type="radio" name="ttip" checked="@(_tipo == t)" @onchange="() => _tipo = t" /> @NomeTipo(t)</label> }</div>
                <a class="btn sec" href="@(_obraId is null ? "engenharia/obras" : $"engenharia/obras?obra={_obraId}")"><Icone Nome="predio" Tam="14" /> Estrutura e gerador</a>
                @if (_obraId is not null && Perfil(PerfilUsuario.Engenharia))
                {
                    <label class="btn sec arquivo" id="kit-importar" style="cursor:@(Ocupado ? "wait" : "pointer")" title="Planilha com as abas Tipologias, Ambientes, Mix, Serviços e Aplicação (atualiza por código, não duplica)">
                        <Icone Nome="upload" Tam="14" /> Importar kit (xlsx)<InputFile OnChange="PreverKit" accept=".xlsx" disabled="@Ocupado" class="so-leitor" /></label>
                }
            </div>
            @if (_obraId is null) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra.</div> }
            else
            {
                <Grade T="Tipologia" @ref="_grade" Itens="_lista.Where(t => t.Tipo == _tipo)" AoClicar="Editar" NomeExportacao="tipologias">
                    <Colunas>
                        <Coluna T="Tipologia" Titulo="Código" Valor="t => t.Codigo" Largura="110px" />
                        <Coluna T="Tipologia" Titulo="Nome" Valor="t => t.Nome" />
                        <Coluna T="Tipologia" Titulo="Área privativa (m²)" Valor="t => t.Tipo == TipoTipologia.Apartamento ? t.AreaPrivativa : (decimal?)null" Formato="N2" Alinhar="num" />
                        <Coluna T="Tipologia" Titulo="Pavimentos" Valor="t => t.Tipo == TipoTipologia.Torre ? t.Pavimentos : (int?)null" Alinhar="num" />
                        <Coluna T="Tipologia" Titulo="Ambientes" Valor="t => t.Ambientes.Count" Alinhar="num" />
                        <Coluna T="Tipologia" Titulo="Serviços marcados" Valor="t => _qtdMarcados.GetValueOrDefault(t.Id)" Alinhar="num" />
                        <Coluna T="Tipologia" Titulo="Locais gerados" Valor="t => _usos.GetValueOrDefault(t.Id)" Alinhar="num" />
                    </Colunas>
                </Grade>
                <div class="alerta info"><Icone Nome="info" />
                    <div><b>Apartamento</b>: cômodos com medidas (piso, perímetro, pé-direito, vãos). <b>Torre</b>: pavimentos, mix de apartamentos por faixa de pavimentos e áreas comuns do pavimento/torre. <b>Implantação</b>: áreas comuns do condomínio.
                    Na aba <b>Serviços</b> de cada tipologia, marque em que cômodo/nível cada serviço entra — o orçamento explode isso para todos os locais.</div></div>
            }
        </div>
    </ChildContent>
    <Faixa><b>Tipologias</b><span>Apartamento, torre e implantação do condomínio</span><span>Base do gerador de locais, do orçamento e das FVS</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_aberto" Titulo="@(_t is null ? "" : $"Tipologia de {NomeTipo(_t.Tipo).ToLower()} {_t.Codigo}")" Tamanho="grande">
    <ChildContent>
        @if (_t is not null)
        {
            <Erros Lista="ErrosForm" />
            @if (_t.CriadoEm != default) { <Abas Itens="_abasEd" @bind-Ativa="_abaEd" /> }
            @if (_abaEd == "dados" || _t.CriadoEm == default)
            {
                <div class="form">
                    <Campo Rotulo="Código" Obrigatorio Classe="s2"><input id="tip-cod" @bind="_t.Codigo" placeholder="@(_t.Tipo == TipoTipologia.Torre ? "T-2Q-8" : "2Q-56")" /></Campo>
                    <Campo Rotulo="Nome" Obrigatorio Classe="s6"><input id="tip-nome" @bind="_t.Nome" /></Campo>
                    <Campo Rotulo="Pé-direito padrão (m)" Classe="s2"><input id="tip-pd" type="number" step="0.01" @bind="_t.PeDireitoPadrao" /></Campo>
                    <Campo Rotulo="" Classe="s2"><label><input type="checkbox" @bind="_t.Ativa" /> Ativa</label></Campo>
                    @if (_t.Tipo == TipoTipologia.Apartamento)
                    {
                        <Campo Rotulo="Dormitórios" Classe="s2"><input id="tip-dorm" type="number" @bind="_t.Dormitorios" /></Campo>
                        <Campo Rotulo="Suítes" Classe="s2"><input id="tip-suites" type="number" @bind="_t.Suites" /></Campo>
                        <Campo Rotulo="Área privativa (m²)" Obrigatorio Classe="s3"><input id="tip-area" type="number" step="0.01" @bind="_t.AreaPrivativa" /></Campo>
                        <Campo Rotulo="Área equivalente (m²)" Classe="s2"><input type="number" step="0.01" @bind="_t.AreaEquivalente" /></Campo>
                        <Campo Rotulo="Soma dos cômodos" Classe="s3"><div class="lado-a-lado estreito"><b>@_t.SomaAreaComodos.ToString("N2", Br) m²</b><button class="btn sec pq" @onclick="() => _t.AreaPrivativa = _t.SomaAreaComodos">usar</button></div></Campo>
                    }
                    @if (_t.Tipo == TipoTipologia.Torre)
                    {
                        <Campo Rotulo="Pavimentos" Obrigatorio Classe="s2"><input id="tip-pavs" type="number" min="1" max="60" @bind="_t.Pavimentos" /></Campo>
                        <Campo Rotulo="" Classe="s4"><label><input type="checkbox" @bind="_t.PrimeiroTerreo" /> 1º pavimento se chama "Térreo"</label></Campo>
                        <Campo Rotulo="" Classe="s4"><label title="Térreo: 01, 02…; 1º pavimento: 101…"><input type="checkbox" id="tip-num-andar" @bind="_t.NumeracaoPorAndar" disabled="@(!_t.PrimeiroTerreo)" /> Numerar aptos pelo andar (térreo 01)</label></Campo>
                    }
                    <Campo Rotulo="Observações" Classe="s12"><input @bind="_t.Observacoes" /></Campo>
                </div>

                @if (_t.Tipo == TipoTipologia.Torre)
                {
                    <div class="secao"><Icone Nome="tabela" /> Mix de apartamentos por pavimento <span class="acao"><button class="btn sec pq" id="mix-add" @onclick="AddMix"><Icone Nome="mais" Tam="14" /> Faixa</button></span></div>
                    <table class="itens" id="mix">
                        <thead><tr><th>Pav. de</th><th>até</th><th>Tipologia do apartamento</th><th class="num">Aptos por pavimento</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var m in _t.Mix.OrderBy(m => m.Ordem))
                            {
                                <tr @key="m"><td class="larg-90"><input type="number" min="1" @bind="m.PavimentoDe" /></td><td class="larg-90"><input type="number" min="1" @bind="m.PavimentoAte" /></td>
                                    <td><select @bind="m.ApartamentoTipologiaId"><option
                                                value="@Guid.Empty">—</option>@foreach (var a in _lista.Where(x => x.Tipo == TipoTipologia.Apartamento)) {
                                                <option value="@a.Id">@a.Codigo – @a.Nome (@a.AreaPrivativa.ToString("N2", Br) m²)</option>
                                            }</select></td>
                                    <td class="larg-120"><input type="number" min="1" @bind="m.Quantidade" /></td>
                                    <td><button class="icone-btn" @onclick="() => _t.Mix.Remove(m)"><Icone Nome="lixeira" Tam="16" /></button></td></tr>
                            }
                            @if (_t.Mix.Count == 0) { <tr><td colspan="5" class="mudo">Ex.: pav. 1 a 8 · 2Q-56 · 8 aptos por pavimento.</td></tr> }
                        </tbody>
                    </table>
                    <p class="mudo">Total: @Enumerable.Range(1, Math.Max(0, _t.Pavimentos)).Sum(p => _t.Mix.Where(m => p >= m.PavimentoDe && p <= m.PavimentoAte).Sum(m => m.Quantidade)) apartamentos por torre.</p>
                }

                <div class="secao"><Icone Nome="regua" /> @(_t.Tipo switch { TipoTipologia.Apartamento => $"{_n.Comodo}s", TipoTipologia.Torre => $"Áreas comuns do {_n.Pavimento.ToLower()} e da {_n.Torre.ToLower()}", _ => $"Áreas comuns do {_n.Condominio.ToLower()}" })
                    <span class="acao"><button class="btn sec pq" id="amb-add" @onclick="AddAmbiente"><Icone Nome="mais" Tam="14" /> Ambiente</button></span></div>
                <table class="itens" id="ambientes">
                    <thead><tr><th>Nome</th><th>Sigla</th><th>Categoria</th>@if (_t.Tipo == TipoTipologia.Torre) { <th>Onde</th><th>Pav. de–até</th>
                            }<th class="num">Piso (m²)</th><th class="num">Perímetro (m)</th><th class="num">Pé-dir. (m)</th><th class="num">Vãos (m²)</th><th
                                class="num">Parede (m²)</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in _t.Ambientes.OrderBy(a => a.Ordem))
                        {
                            <tr @key="a"><td><input @bind="a.Nome" class="larg-min-140" /></td><td class="larg-80"><input @bind="a.Sigla" maxlength="8" class="maiusc" placeholder="auto" /></td>
                                <td><input @bind="a.Categoria" list="tipos-comodo" class="larg-min-120" /></td>
                                @if (_t.Tipo == TipoTipologia.Torre)
                                {
                                    <td><select @bind="a.Escopo"><option value="@EscopoAmbiente.AreaComumPavimento">Pavimento</option><option value="@EscopoAmbiente.AreaComumTorre">Torre</option></select></td>
                                    <td class="sem-quebra">@if (a.Escopo == EscopoAmbiente.AreaComumPavimento) { <input type="number" class="larg-52" @bind="a.PavimentoDe" /><span> – </span><input type="number" class="larg-52" @bind="a.PavimentoAte" /> }</td>
                                }
                                <td class="larg-90"><input type="number" step="0.01" @bind="a.AreaPiso" /></td>
                                <td class="larg-90"><input type="number" step="0.01" @bind="a.Perimetro" /></td>
                                <td class="larg-80"><input type="number" step="0.01" @bind="a.PeDireito" placeholder="@_t.PeDireitoPadrao?.ToString("0.00")" /></td>
                                <td class="larg-80"><input type="number" step="0.01" @bind="a.AreaVaos" /></td>
                                <td class="num">@a.AreaParede(_t.PeDireitoPadrao).ToString("N2", Br)</td>
                                <td class="sem-quebra"><button class="icone-btn" title="Subir" @onclick="() => Mover(a, -1)">↑</button><button class="icone-btn" title="Remover" @onclick="() => _t.Ambientes.Remove(a)"><Icone Nome="lixeira" Tam="16" /></button></td></tr>
                        }
                        @if (_t.Ambientes.Count == 0) {
                            <tr><td colspan="11"
                                    class="mudo">@(_t.Tipo == TipoTipologia.Apartamento
                                        ? "Inclua os cômodos (sala, cozinha, dormitórios, BWC…) com as medidas do projeto."
                                        : "Inclua as áreas comuns (hall, escada, fachada, guarita, lazer…).")</td></tr>
                        }
                    </tbody>
                </table>
                <datalist id="tipos-comodo">@foreach (var c in _comodos) { <option>@c</option> }</datalist>
                <p class="mudo">Parede = perímetro × pé-direito − vãos. Sigla em branco é gerada (SAL, DOR1, BWC…). Depois de gerar locais, altere aqui e use "Sincronizar com as tipologias".</p>
            }
            else if (_abaEd == "serv")
            {
                <div class="barra-filtro">
                    <label>Grupo <select @bind="_fGrupo"><option value="">Todos</option>@foreach (var g in _grupos) { <option>@g</option> }</select></label>
                    <label>Buscar <input @bind="_fTexto" @bind:event="onchange" placeholder="serviço… (Enter)" /></label>
                    <label class="check-linha"><input type="checkbox" @bind="_soMarcados" /> só marcados</label>
                    <a class="btn sec pq" href="engenharia/composicoes" target="_blank">Serviços e composições ↗</a>
                </div>
                @if (_t.Ambientes.Any(a => !_ambSalvos.Contains(a.Id))) { <div class="alerta aviso"><Icone Nome="alerta" /> Há ambientes ainda não salvos — salve a tipologia (aba Dados) para que apareçam na matriz.</div> }
                <div class="rolagem-60vh">
                    <table class="itens matriz-serv" id="matriz-serv">
                        @{ var cols = Colunas().ToList(); }
                        <thead><tr><th class="larg-min-240">Serviço</th><th>Un.</th>@foreach (var c in cols) { <th title="@c.Titulo" class="num">@c.Rotulo</th> }</tr></thead>
                        <tbody>
                            @foreach (var s in ServicosFiltrados())
                            {
                                <tr @key="(s.Id, _versaoMatriz)"><td>@s.Codigo – @s.Descricao<br /><span class="mudo">@De(s.Regra)</span></td><td>@s.Unidade</td>
                                    @foreach (var c in cols)
                                    {
                                        var marcado = Marcado(s.Id, c.Alvo, c.AmbienteId);
                                        <td class="num"><input type="checkbox" checked="@marcado" disabled="@Ocupado" @onchange="e => Marcar(s.Id, c.Alvo, c.AmbienteId, (bool)e.Value!)" /></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="mudo">Marcação gravada na hora. Depois, em Engenharia › Orçamento, use "Gerar / atualizar orçamento".</p>
            }
        }
    </ChildContent>
    <Rodape>
        @if (_t is not null && _abaEd == "dados")
        {
            @if (_t.CriadoEm != default) { <div class="esq"><button class="btn sec" disabled="@Ocupado" @onclick="Copiar"><Icone Nome="mais" Tam="14" /> Copiar como nova</button></div> }
            <BotaoExcluir Tipo="typeof(Tipologia)" Id="@(_t?.CriadoEm == default ? Guid.Empty : _t.Id)" IdBotao="exc-t" AoExcluir="async () => { _aberto = false; await Carregar(); }" />
            <button class="btn prim" id="tip-salvar" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="16" /> Salvar</button>
        }
    </Rodape>
</Modal>

<Modal @bind-Aberto="_abertoKit" Titulo="Importar kit de tipologia">
    <ChildContent>
        <Erros Lista="ErrosForm" />
        @if (_resumoKit is { } r)
        {
            <table class="itens" id="kit-resumo">
                <tbody>
                    <tr><td>Tipologias novas / atualizadas</td><td class="num">@r.TipologiasNovas / @r.TipologiasAtualizadas</td></tr>
                    <tr><td>Ambientes (cômodos e áreas comuns)</td><td class="num">@r.Ambientes</td></tr>
                    <tr><td>Serviços novos / atualizados</td><td class="num">@r.ServicosNovos / @r.ServicosAtualizados</td></tr>
                    <tr><td>Marcações de serviço (onde entra)</td><td class="num">@r.Aplicacoes</td></tr>
                    @if (r.Insumos > 0)
                    {
                        <tr><td>Insumos (substituem os dos serviços listados)</td><td class="num">@r.Insumos em @r.ServicosComInsumos serviço(s)</td></tr>
                        <tr><td>Materiais novos no cadastro de produtos</td><td class="num">@r.ProdutosNovos</td></tr>
                    }
                </tbody>
            </table>
            @if (r.ItsNaoEncontradas.Count > 0)
            {
                <div class="alerta aviso"><Icone Nome="alerta" /> <div>ITS não cadastradas em Materiais/Serviços controlados (o serviço entra sem a ITS): @string.Join(", ", r.ItsNaoEncontradas)</div></div>
            }
            @foreach (var a in r.Avisos) { <div class="alerta info"><Icone Nome="info" /> @a</div> }
            <p class="mudo">Serviços já existentes mantêm os insumos (salvo os que vêm na aba Insumos); ambientes com a mesma sigla mantêm os locais já gerados. Depois: Estrutura e gerador › gerar as torres; Orçamento › gerar.</p>
        }
    </ChildContent>
    <Rodape>@if (_resumoKit is not null && _kit is not null) { <button class="btn prim" id="kit-aplicar" disabled="@Ocupado" @onclick="AplicarKit"><Icone Nome="check" Tam="16" /> Importar</button> }</Rodape>
</Modal>
