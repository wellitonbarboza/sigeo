@page "/engenharia/diario/imprimir"
@attribute [ExcludeFromInteractiveRouting]
@layout Sigeo.Web.Components.Layout.LayoutImpressao
@using Sigeo.Domain.Planejamento
@inject DiarioImprimirConsultas Consultas

<PageTitle>RDO @_d?.Numero.ToString("0000") · @_obra</PageTitle>
<style>
    @@page { size: A4 portrait; margin: 10mm; }
    body { margin: 0; font-family: Inter, Arial, sans-serif; color: #111827; background: #fff; font-size: 11.5px; }
    h1 { font-size: 16px; margin: 0; }
    .cab { display: flex; justify-content: space-between; border-bottom: 2px solid #111; padding-bottom: 6px; margin-bottom: 8px; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
    th, td { border: 1px solid #94a3b8; padding: 4px 6px; text-align: left; vertical-align: top; }
    th { background: #f1f5f9; font-size: 10.5px; text-transform: uppercase; }
    h2 { font-size: 12px; text-transform: uppercase; margin: 12px 0 4px; }
    .fotos { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
    .fotos img { width: 120px; height: 90px; object-fit: cover; border: 1px solid #cbd5e1; }
    .ass { margin-top: 30px; display: flex; gap: 40px; } .ass span { flex: 1; border-top: 1px solid #111; padding-top: 4px; text-align: center; }
    @@media screen { body { padding: 16px; background: #f1f5f9; } .folha { background: #fff; max-width: 820px; margin: auto; padding: 14mm; box-shadow: 0 1px 6px rgba(0,0,0,.15); } }
</style>
@if (_d is null) { <p>Diário não encontrado.</p> }
else
{
    var d = _d;
    <div class="folha">
        <div class="cab"><div><h1>Diário de Obra · RDO nº @d.Numero.ToString("0000")</h1>@_obra</div>
            <div style="text-align:right"><b>@d.Data.ToString("dddd, dd/MM/yyyy", Rotulos.Br)</b><br />@(d.Status == StatusDiario.Assinado ? $"Assinado por {d.AssinadoPorNome} em {Rotulos.DataHora(d.AssinadoEm)}" : "RASCUNHO — não assinado")</div></div>
        <table><tr><th>Clima manhã</th><th>Clima tarde</th><th>Condição</th><th>Dia trabalhado</th><th>Expediente</th></tr>
            <tr><td>@Rotulos.De(d.ClimaManha)</td><td>@Rotulos.De(d.ClimaTarde)</td><td>@Rotulos.De(d.Condicao)</td><td>@Rotulos.De(d.Trabalhado)</td><td>@d.HoraInicio?.ToString("HH:mm") – @d.HoraTermino?.ToString("HH:mm")</td></tr>
            @if (d.ObservacaoClima is { Length: > 0 } oc) { <tr><td colspan="5">@oc</td></tr> }</table>
        <h2>Efetivo</h2>
        <table><tr><th>Próprio (função)</th><th style="width:60px">Qtd.</th><th>Terceiros</th><th style="width:60px">Qtd.</th></tr>
            @{ var pr = d.Efetivo.Where(e => !e.Terceiro).ToList(); var te = d.Efetivo.Where(e => e.Terceiro).ToList(); }
            @for (var i = 0; i < Math.Max(1, Math.Max(pr.Count, te.Count)); i++)
            {
                <tr><td>@(i < pr.Count ? pr[i].Nome : "")</td><td>@(i < pr.Count ? pr[i].Quantidade : "")</td><td>@(i < te.Count ? te[i].Nome : "")</td><td>@(i < te.Count ? te[i].Quantidade : "")</td></tr>
            }
            <tr><th>Total próprio</th><th>@d.TotalProprio</th><th>Total terceiros</th><th>@d.TotalTerceiros</th></tr></table>
        <h2>Atividades executadas</h2>
        <table><tr><th style="width:24px">#</th><th>Descrição</th><th style="width:180px">Local</th></tr>
            @foreach (var a in d.Atividades.OrderBy(a => a.Ordem))
            {
                <tr><td>@a.Ordem</td><td>@a.Descricao
                        @if (_fotos.TryGetValue(a.Id, out var fs) && fs.Count > 0) { <div class="fotos">@foreach (var f in fs) { <img src="arquivos/anexo/@f" alt="Foto da atividade @a.Ordem" /> }</div> }</td>
                    <td>@(a.LocalId is { } l ? _locais.GetValueOrDefault(l) : "—")</td></tr>
            }
            @if (d.Atividades.Count == 0) { <tr><td colspan="3">—</td></tr> }</table>
        @if (d.EquipamentosDia.Count > 0)
        {
            <h2>Equipamentos</h2>
            <table><tr><th>Equipamento</th><th style="width:70px">Horas</th><th style="width:70px">Parado</th><th>Observação</th></tr>
                @foreach (var x in d.EquipamentosDia) { <tr><td>@_equip.GetValueOrDefault(x.EquipamentoId)</td><td>@x.Horas.ToString("0.#", Rotulos.Br)</td><td>@(x.Parado ? "Sim" : "")</td><td>@x.Observacao</td></tr> }
            </table>
        }
        <h2>Ocorrências e registros</h2>
        <table><tr><th>Ocorrências</th><td>@d.Ocorrencias</td></tr><tr><th>Visitas</th><td>@d.Visitas</td></tr><tr><th>Equipamentos</th><td>@d.Equipamentos</td></tr></table>
        <div class="ass"><span>Engenheiro(a) da obra@(d.AssinadoPorNome is { } n ? $" — {n}" : "")</span><span>Fiscalização / cliente</span></div>
    </div>
    <script>window.addEventListener('load', () => setTimeout(() => window.print(), 700));</script>
}

@code {
    [SupplyParameterFromQuery(Name = "id")] public Guid Id { get; set; }
    private DiarioObra? _d;
    private string _obra = "";
    private Dictionary<Guid, string> _locais = [];
    private Dictionary<Guid, string> _equip = [];
    private Dictionary<Guid, List<Guid>> _fotos = [];

    protected override async Task OnInitializedAsync()
    {
        if (await Consultas.CarregarAsync(Id) is not { } dados) return;
        _d = dados.Diario;
        _obra = dados.Obra;
        _equip = dados.Equipamentos;
        _locais = dados.Locais;
        _fotos = dados.Fotos;
    }
}
