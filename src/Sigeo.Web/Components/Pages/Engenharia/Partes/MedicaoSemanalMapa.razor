@* Medição semanal pelo mapa: escolhe a rede (torre) e o serviço, marca os locais e grava o % acumulado na data escolhida. *@
@using Sigeo.Domain.Planejamento
@inherits PaginaBase
@inject AcompanhamentoServico Acomp

<div class="barra-filtro">
    <label>Data da medição <input type="date" id="md-data" max="@Hoje.ToString("yyyy-MM-dd")" value="@_data.ToString("yyyy-MM-dd")" @onchange="TrocarData" /></label>
    @if (_m is { Opcoes.Count: > 0 })
    {
        <label>Rede (local macro) <select id="md-rede" value="@_rede" @onchange="TrocarRede">@foreach (var o in _m.Opcoes) { <option value="@o.RedeId">@o.Rede</option> }</select></label>
        <label>Serviço <select id="md-serv" value="@_pacote" @onchange="TrocarServico">@foreach (var s in ServicosDaRede) { <option value="@s.PacoteId">@s.Servico</option> }</select></label>
        <button class="btn sec pq" id="md-todos" @onclick="SelecionarTodos">Selecionar todos</button>
    }
    <span class="mudo">Semana @_m?.Semana.ToString("dd/MM") a @_m?.Semana.AddDays(5).ToString("dd/MM")</span>
</div>
<Erros Lista="ErrosForm" />
@if (_m is null) { <Esqueleto Linhas="8" /> }
else if (_m.Opcoes.Count == 0) { <div class="alerta info"><Icone Nome="info" /> Sem atividades por rede no cronograma de referência. Gere o cronograma pelas redes.</div> }
else
{
    var grupos = _m.Celulas.GroupBy(c => c.Grupo ?? "").ToList();
    var colunas = Math.Max(1, grupos.Max(g => g.Count()));
    var sel = _m.Celulas.Where(c => _sel.Contains(c.LocalId)).ToList();
    var semFvs = sel.Where(c => c.TemControle && !c.FvsAprovada).ToList();
    var jaMedidos = sel.Where(c => c.MedidoEm != null).ToList();
    <div class="md-grade">
        <div>
            <div class="md-mapa" id="md-mapa" style="grid-template-columns:@(grupos.Any(g => g.Key != "") ? "70px " : "")repeat(@colunas, minmax(74px, 1fr))">
                @foreach (var g in grupos.AsEnumerable().Reverse())
                {
                    @if (g.Key != "") { <div class="md-pav">@g.Key</div> }
                    @foreach (var c in g)
                    {
                        var aviso = c.Avanco >= 100 && c.TemControle && !c.FvsAprovada;
                        <button type="button" class="md-cel @(c.Avanco >= 100 ? "c100" : "")" aria-pressed="@_sel.Contains(c.LocalId)" @onclick="() => Alternar(c.LocalId)"
                                title="@Dica(c, aviso)">
                            <div class="f" style="height:@Altura(c.Avanco)"></div>
                            @if (c.TemControle) { <span class="fvs @(c.FvsAprovada ? "" : "pend")">@(c.FvsAprovada ? "FVS" : aviso ? "⚠ FVS" : "")</span> }
                            <b>@c.Local@(c.MedidoEm != null ? " ●" : "")</b><span>@c.Avanco.ToString("0", Br)%</span>
                        </button>
                    }
                    @for (var i = g.Count(); i < colunas; i++) { <span></span> }
                }
            </div>
            <div class="legenda mt-6"><span><i style="background:var(--ok-suave)"></i>100%</span><span><i
                        style="background:var(--primaria);opacity:.3"></i>parcial (altura = %)</span><span><b
                        style="color:var(--ok-texto)">FVS</b> aprovada</span><span><b
                        style="color:var(--aviso-texto)">⚠ FVS</b> 100% com FVS aberta/não concluída</span><span>● medido nesta semana</span></div>
        </div>
        <div class="cartao md-lado">
            <b>@ServicoAtual · avanço do serviço @_m.AvancoServico.ToString("0.#", Br)%</b>
            <div>@if (sel.Count == 0) { <span class="mudo">Clique nos locais do mapa para medir.</span> } else { <span><b>@sel.Count local(is):</b> @string.Join(", ", sel.Select(c => c.Local))</span> }</div>
            @if (jaMedidos.Count > 0) { <div class="alerta info pq">✎ @string.Join(", ", jaMedidos.Select(c => $"{c.Local} ({c.MedidoEm:dd/MM})")): gravar <b>sobrepõe</b> a medição desta semana (a anterior fica no histórico).</div> }
            <label class="campo-pilha">% executado acumulado
                <input type="range" id="md-pct" min="0" max="100" step="5" value="@_pct" @oninput="MudarPct" />
            </label>
            <span class="md-pct">@_pct%</span>
            <div class="grupo-btn">@foreach (var v in new[] { 25, 50, 75, 100 }) { <button type="button" class="btn sec pq" @onclick="() => _pct = v">@v%</button> }</div>
            @if (_pct >= 100 && semFvs.Count > 0) { <div class="alerta aviso pq">⚠ FVS aberta ou não concluída em @string.Join(", ", semFvs.Select(c => c.Local)). A medição de 100% é aceita; o aviso fica registrado.</div> }
            <label class="campo-pilha">Observação <textarea id="md-obs" rows="2" @bind="_obs" placeholder="ex.: falta regularizar box do banheiro"></textarea></label>
            @if (_m.PodeMedir)
            {
                <button class="btn prim" id="md-gravar" disabled="@(Ocupado || sel.Count == 0)" @onclick="Gravar"><Icone Nome="check" Tam="14" /> @(jaMedidos.Count > 0 ? "Gravar (sobrepor)" : "Gravar medição")</button>
            }
            else { <div class="alerta aviso pq">Só a Engenharia de obra registra a medição semanal. Você pode consultar.</div> }
            <p class="mudo">A medição atualiza o avanço das atividades (versão vigente e reprogramação em elaboração) e a curva física do painel.</p>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ObraId { get; set; }
    [Parameter] public EventCallback AoGravar { get; set; }
    private AcompanhamentoServico.MapaMedicao? _m;
    private DateOnly _data;
    private Guid? _rede, _pacote;
    private readonly HashSet<Guid> _sel = [];
    private int _pct = 100;
    private string? _obs;
    private Guid _carregada;

    private IReadOnlyList<(Guid PacoteId, string Servico)> ServicosDaRede => _m?.Opcoes.FirstOrDefault(o => o.RedeId == _rede)?.Servicos ?? [];
    private string ServicoAtual => ServicosDaRede.FirstOrDefault(s => s.PacoteId == _pacote).Servico ?? "";

    protected override void OnInitialized() => _data = Hoje;

    protected override async Task OnParametersSetAsync()
    {
        if (_carregada == ObraId) return;
        _carregada = ObraId; _rede = null; _pacote = null; _sel.Clear();
        await Carregar();
    }

    private async Task Carregar()
    {
        _m = await Acomp.MapaMedicaoAsync(ObraId, _rede, _pacote, _data, Cancelamento);
        _rede = _m.Opcoes.Any(o => o.RedeId == _rede) ? _rede : _m.Opcoes.FirstOrDefault()?.RedeId;
        if (!ServicosDaRede.Any(s => s.PacoteId == _pacote)) _pacote = ServicosDaRede.Count > 0 ? ServicosDaRede[0].PacoteId : null;
        _sel.IntersectWith(_m.Celulas.Select(c => c.LocalId));
    }

    private async Task TrocarData(ChangeEventArgs e) { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) { _data = d > Hoje ? Hoje : d; await Carregar(); } }
    private async Task TrocarRede(ChangeEventArgs e) { _rede = Guid.Parse(e.Value!.ToString()!); _pacote = null; _sel.Clear(); await Carregar(); }
    private async Task TrocarServico(ChangeEventArgs e) { _pacote = Guid.Parse(e.Value!.ToString()!); _sel.Clear(); await Carregar(); }
    private static string Dica(AcompanhamentoServico.CelulaMedicao c, bool aviso) =>
        (c.MedidoEm is { } me ? $"Medido em {me:dd/MM}: {c.MedidoPercentual:0}%" : "") + (aviso ? " · 100% com FVS aberta/não concluída" : "");
    private static string Altura(decimal v) => Math.Clamp(v, 0, 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture) + "%";
    private void MudarPct(ChangeEventArgs e) => _pct = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
    private void Alternar(Guid id) { if (!_sel.Remove(id)) _sel.Add(id); }
    private void SelecionarTodos() { if (_m is null) return; if (_sel.Count == _m.Celulas.Count) _sel.Clear(); else _sel.UnionWith(_m.Celulas.Select(c => c.LocalId)); }

    private async Task Gravar()
    {
        if (_pacote is not { } p) return;
        AcompanhamentoServico.ResultadoMedicao? r = null;
        if (await Executar(async () => r = await Acomp.MedirAsync(ObraId, p, _sel.ToList(), _pct, _data, _obs, Cancelamento)))
        {
            Notif.Sucesso($"Medição de {_data:dd/MM} gravada: {r!.Gravadas} local(is){(r.Sobrepostas > 0 ? $", {r.Sobrepostas} sobreposta(s)" : "")}{(r.ComAvisoFvs > 0 ? $" · {r.ComAvisoFvs} com aviso de FVS" : "")}.");
            _sel.Clear(); _obs = null;
            await Carregar();
            await AoGravar.InvokeAsync();
        }
    }
}
