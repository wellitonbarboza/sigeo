@* Painel do planejamento: avanço físico previsto × real por SPE e por macroetapa (1º nível da EAP), curva física semanal e dias de obra do RDO. *@
@using Sigeo.Domain.Planejamento
@inherits PaginaBase
@inject AcompanhamentoServico Acomp

<div class="barra-filtro">
    <label>SPE <select id="pn-spe" value="@(_spe?.ToString() ?? "")" @onchange="TrocarSpe"><option value="">Todas as SPEs</option>@foreach (var (id, nome) in _p?.Spes ?? []) { <option value="@id">@nome</option> }</select></label>
    <label>Data de status <input type="date" id="pn-data" value="@_data.ToString("yyyy-MM-dd")" @onchange="TrocarData" /></label>
    @if (_p?.Versao is { } cod) { <span class="mudo">Referência: @cod@(_p.Vigente ? " (vigente)" : " — ainda não aprovada")</span> }
</div>
@if (_p is null) { <Esqueleto Indicadores="5" Linhas="6" /> }
else if (_p.Versao is null) { <div class="alerta info"><Icone Nome="info" /> A obra ainda não tem cronograma. Monte as redes e gere a LB0.</div> }
else
{
    var p = _p;
    var desvioFis = p.Real - p.Previsto;
    <div class="kpis">
        <Kpi Rotulo="Avanço previsto" Valor="@($"{p.Previsto:0.0}%")" Sub="@($"até {Data(p.DataStatus)} (linha de base)")" />
        <Kpi Rotulo="Avanço real" Valor="@($"{p.Real:0.0}%")" Sub="@($"{desvioFis:+0.0;-0.0;0} p.p. vs previsto")" Tom="@(desvioFis < -2 ? "erro" : desvioFis >= 0 ? "ok" : "aviso")" />
        <Kpi Rotulo="Término" Valor="@Data(p.Termino)" Sub="@(p.Desvio is { } d ? $"{d:+0;-0;0} d.ú. vs base {Data(p.TerminoBase)}" : "sem linha de base")" Tom="@(p.Desvio > 0 ? "erro" : "")" />
        <Kpi Rotulo="Atividades atrasadas" Valor="@p.Atrasadas" Sub="término passou e não concluíram" Tom="@(p.Atrasadas > 0 ? "aviso" : "")" />
        <Kpi Rotulo="Plano de ação" Valor="@p.AcoesAbertas" Sub="@($"{p.AcoesAtrasadas} atrasada(s) · {p.RestricoesAbertas} restrição(ões) aberta(s)")" Tom="@(p.AcoesAtrasadas > 0 ? "erro" : "")" />
    </div>
    <div class="pn-grade mt-12">
        <div class="cartao">
            <h4>Avanço físico por macroetapa <span class="mudo">(1º nível da EAP)</span></h4>
            <div class="pn-macro" id="pn-macro">
                @foreach (var m in p.Macroetapas)
                {
                    <div class="lin" title="@($"{m.Atividades} atividades")"><span>@m.Nome</span>
                        <div class="trilho"><div class="prev" style="width:@Pct(m.Previsto)"></div><div class="real @(m.Real + 2 < m.Previsto ? "atras" : "")" style="width:@Pct(m.Real)"></div></div>
                        <span class="num">@($"{m.Real:0}% / {m.Previsto:0}%")</span></div>
                }
                @if (p.Macroetapas.Count == 0) { <span class="mudo">Sem atividades para a SPE escolhida.</span> }
            </div>
            <div class="pn-leg"><span><i style="background:var(--primaria)"></i>real</span><span><i
                        style="background:var(--erro)"></i>real abaixo do previsto</span><span><i
                        style="background:repeating-linear-gradient(45deg,var(--borda-forte) 0 3px,transparent 3px 6px)"></i>previsto na data de status</span></div>
        </div>
        <div class="cartao pn-curva">
            <h4>Curva física (semanal)</h4>
            @((MarkupString)Curva(p.Curva, p.DataStatus))
            <div class="pn-leg"><span><i style="background:#94a3b8"></i>previsto (base)</span><span><i style="background:var(--primaria)"></i>real (medições semanais)</span></div>
        </div>
    </div>
    <div class="cartao mt-12">
        <h4>Dias de obra no mês <span class="mudo">(Diário de obra · Engenharia › Diário de obra)</span></h4>
        <div class="kpis">
            <Kpi Rotulo="Dias úteis" Valor="@p.Dias.Uteis" Sub="calendário da obra" />
            <Kpi Rotulo="Trabalhados" Valor="@p.Dias.Trabalhados" Sub="@($"{p.Dias.Assinados} diário(s) assinado(s)")" />
            <Kpi Rotulo="Perdidos por chuva" Valor="@p.Dias.PerdidosChuva" Sub="evidência para a reprogramação" Tom="@(p.Dias.PerdidosChuva > 0 ? "aviso" : "")" />
            <Kpi Rotulo="Efetivo médio" Valor="@p.Dias.EfetivoMedio.ToString("0.#", Br)" Sub="pessoas por dia trabalhado" />
        </div>
    </div>
}

@code {
    [Parameter] public Guid ObraId { get; set; }
    [Parameter] public int Versao { get; set; }
    private AcompanhamentoServico.Painel? _p;
    private Guid? _spe;
    private DateOnly _data;
    private (Guid, int) _carregado;

    protected override void OnInitialized() => _data = Hoje;

    protected override async Task OnParametersSetAsync()
    {
        if (_carregado == (ObraId, Versao)) return;
        _carregado = (ObraId, Versao);
        await Carregar();
    }

    private async Task Carregar() => _p = await Acomp.PainelAsync(ObraId, _spe, _data, Cancelamento);
    private async Task TrocarSpe(ChangeEventArgs e) { _spe = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; await Carregar(); }
    private async Task TrocarData(ChangeEventArgs e) { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) { _data = d; await Carregar(); } }
    private static string Pct(decimal v) => Math.Clamp(v, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static string Curva(IReadOnlyList<AcompanhamentoServico.PontoCurva> pts, DateOnly status)
    {
        if (pts.Count < 2) return "<p class=\"mudo\">Curva disponível com o cronograma gerado.</p>";
        const int W = 560, H = 230, L = 34, R = 10, T = 10, B = 26;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double X(int i) => L + (W - L - R) * i / (double)(pts.Count - 1);
        double Y(decimal v) => T + (H - T - B) * (1 - (double)v / 100);
        var sb = new System.Text.StringBuilder($"<svg viewBox=\"0 0 {W} {H}\" role=\"img\" aria-label=\"Curva física prevista e real\">");
        foreach (var g in new[] { 0, 25, 50, 75, 100 })
            sb.Append(inv, $"<line x1=\"{L}\" x2=\"{W - R}\" y1=\"{Y(g):0.#}\" y2=\"{Y(g):0.#}\" stroke=\"var(--borda)\"/><text x=\"{L - 4}\" y=\"{Y(g) + 3:0.#}\" font-size=\"10\" text-anchor=\"end\" fill=\"var(--texto-3)\">{g}%</text>");
        var passo = Math.Max(1, pts.Count / 8);
        for (var i = 0; i < pts.Count; i += passo)
            sb.Append(inv, $"<text x=\"{X(i):0.#}\" y=\"{H - 8}\" font-size=\"10\" text-anchor=\"middle\" fill=\"var(--texto-3)\">{pts[i].Semana:dd/MM}</text>");
        sb.Append("<polyline fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2\" points=\"");
        for (var i = 0; i < pts.Count; i++) sb.Append(inv, $"{X(i):0.#},{Y(pts[i].Previsto):0.#} ");
        sb.Append("\"/>");
        var reais = pts.Select((p, i) => (p, i)).Where(x => x.p.Real != null).ToList();
        if (reais.Count > 0)
        {
            sb.Append("<polyline fill=\"none\" stroke=\"var(--primaria)\" stroke-width=\"2.5\" points=\"");
            foreach (var (p, i) in reais) sb.Append(inv, $"{X(i):0.#},{Y(p.Real!.Value):0.#} ");
            sb.Append("\"/>");
            var (ult, iu) = reais[^1];
            sb.Append(inv, $"<circle cx=\"{X(iu):0.#}\" cy=\"{Y(ult.Real!.Value):0.#}\" r=\"4\" fill=\"var(--primaria)\"><title>{ult.Real:0.0}% em {ult.Semana:dd/MM}</title></circle>");
        }
        var ist = pts.ToList().FindLastIndex(p => p.Semana <= status);
        if (ist >= 0) sb.Append(inv, $"<line x1=\"{X(ist):0.#}\" x2=\"{X(ist):0.#}\" y1=\"{T}\" y2=\"{H - B}\" stroke=\"var(--erro)\" stroke-dasharray=\"3 3\"/>");
        sb.Append("</svg>");
        return sb.ToString();
    }
}
