@page "/engenharia/custo-realizado"
@inherits PaginaBase
@inject CustoRealizadoServico Custos
@inject NavigationManager Nav

<Pagina Titulo="Custo realizado" Grade="GradeAtiva" AoNovo="Novo" AoAtualizar="Recarregar">
    <ChildContent>
        <div class="pagina">
            <div class="barra-filtro">
                <SeletorObra Id="cr-obra" Valor="_obraId" ValorChanged="TrocarObra" Inicial="ObraQuery" />
                @if (_obraId is not null)
                {
                    <label>Data de corte <input id="cr-corte" type="date" value="@_corte?.ToString("yyyy-MM-dd")" @onchange="TrocarCorte" title="Antes do corte = histórico do ERP; a partir dele tudo é lançado no sistema" /></label>
                }
            </div>
            @if (_obraId is null) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra.</div> }
            else if (_painel is not null)
            {
                <div class="kpis">
                    <Kpi Rotulo="Custo realizado" Valor="@_painel.Total.ToString("C0", Br)" Tom="info" />
                    <Kpi Rotulo="Histórico (antes do corte)" Valor="@_painel.Historico.ToString("C0", Br)" Sub="@(_painel.Corte is { } c ? $"até {c.AddDays(-1):dd/MM/yyyy}" : "sem data de corte")" />
                    <Kpi Rotulo="No sistema (após o corte)" Valor="@_painel.AposCorte.ToString("C0", Br)" />
                    <Kpi Rotulo="A apropriar" Valor="@_painel.AApropriar.ToString("C0", Br)" Tom="@(_painel.AApropriar > 0 ? "aviso" : "")" Sub="sem fase definida" />
                </div>
                <div class="acoes-pagina">
                    <button class="btn sec" id="cr-importar" @onclick="@(() => Nav.NavigateTo($"engenharia/importar-erp?obra={_obraId}"))"><Icone Nome="upload" Tam="16" /> Importar histórico do ERP</button>
                </div>
                <Abas Itens="_abas" @bind-Ativa="_aba" />
                @if (_aba == "lanc")
                {
                    <div class="barra-filtro">
                        <label>Fase <select id="cr-f-fase" class="larg-260" @bind="_fFase"><option value="">Todas</option>@foreach (var f in FasesUsadas) { <option value="@f">@f</option> }</select></label>
                        <label>Tipo <select id="cr-f-tipo" @bind="_fTipo"><option value="">Todos</option>@foreach (var t in TiposCusto.Todos) { <option value="@t">@TiposCusto.Nome(t)</option> }</select></label>
                        <label>Local <select id="cr-f-local" class="larg-200" @bind="_fLocal"><option value="">Todos</option><option value="obra">Obra toda (sem local)</option>@foreach (var l in _locais) { <option value="@l.Id">@l.Texto</option> }</select></label>
                        <label>Origem <select id="cr-f-origem" @bind="_fOrigem"><option value="">Todas</option>@foreach (var o in Enum.GetValues<OrigemCusto>()) { <option value="@o">@NomeOrigem(o)</option> }</select></label>
                        <label>Buscar <input id="cr-f-texto" class="larg-200" placeholder="Descrição, fornecedor, documento" @bind="_fTexto" @bind:event="oninput" /></label>
                    </div>
                    <div class="barra-acoes">
                        <button class="btn sec" id="cr-reclass" disabled="@(Filtrados.Count == 0)" @onclick="AbrirReclassificar" title="Muda a fase e/ou o local de todos os lançamentos filtrados"><Icone Nome="editar" Tam="16" /> Reclassificar filtrados (@Filtrados.Count)</button>
                    </div>
                    <div class="mudo fonte-13 my-6">@Filtrados.Count lançamentos · @Filtrados.Sum(l => l.Valor).ToString("C2", Br)</div>
                    <Grade T="LinhaCustoRealizado" @ref="_grade" Itens="Filtrados" AoClicar="Abrir" NomeExportacao="custo-realizado" Vazio="Sem lançamentos. O custo entra pelo recebimento (material), pela medição aprovada (serviço), pela importação do ERP ou pelo botão Novo.">
                        <Colunas>
                            <Coluna T="LinhaCustoRealizado" Titulo="Data" Valor="l => l.Data" Formato="dd/MM/yyyy" Largura="100px" />
                            <Coluna T="LinhaCustoRealizado" Titulo="Fase" Valor="l => l.Fase" />
                            <Coluna T="LinhaCustoRealizado" Titulo="Local" Valor="@(l => l.Local ?? "Obra toda")" />
                            <Coluna T="LinhaCustoRealizado" Titulo="Descrição" Valor="l => l.Descricao" />
                            <Coluna T="LinhaCustoRealizado" Titulo="Fornecedor" Valor="l => l.Fornecedor" />
                            <Coluna T="LinhaCustoRealizado" Titulo="Tipo" Valor="l => TiposCusto.Nome(l.Tipo)" Largura="110px" />
                            <Coluna T="LinhaCustoRealizado" Titulo="Qtd." Valor="l => l.Quantidade" Formato="N2" Alinhar="num" Largura="90px" />
                            <Coluna T="LinhaCustoRealizado" Titulo="Valor" Valor="l => l.Valor" Formato="N2" Alinhar="num" Largura="120px" />
                            <Coluna T="LinhaCustoRealizado" Titulo="Documento" Valor="l => l.Documento" Largura="120px" />
                            <Coluna T="LinhaCustoRealizado" Titulo="Pedido" Valor="l => l.Pedido" Largura="90px" />
                            <Coluna T="LinhaCustoRealizado" Titulo="Origem" Valor="@(l => NomeOrigem(l.Origem) + (l.Historico ? " · histórico" : ""))" Largura="150px" />
                        </Colunas>
                    </Grade>
                }
                else if (_aba == "orc")
                {
                    <p class="mudo fonte-13">Orçado = matriz serviço × local (custo das composições, pelo grupo de serviço). Realizado = lançamentos desta tela pela fase.</p>
                    <div class="tabela-rolavel"><table class="itens" id="cr-orcado">
                        <thead><tr><th>Fase (grupo de serviço)</th><th class="num">Orçado</th><th class="num">Realizado</th><th class="num">Saldo</th><th class="num">% realizado</th></tr></thead>
                        <tbody>
                            @foreach (var f in _painel.PorFase)
                            {
                                <tr class="@(f.Orcado > 0 && f.Realizado > f.Orcado ? "linha-erro" : "")"><td>@f.Fase</td><td class="num">@f.Orcado.ToString("N2", Br)</td><td class="num">@f.Realizado.ToString("N2", Br)</td>
                                    <td class="num">@f.Saldo.ToString("N2", Br)</td><td class="num">@(f.Perc is { } p ? p.ToString("N1", Br) + "%" : "—")</td></tr>
                            }
                            @if (_painel.PorFase.Count == 0) { <tr><td colspan="5" class="mudo">Sem orçamento nem custo lançado.</td></tr> }
                        </tbody>
                        <tfoot><tr><td><b>Total</b></td><td class="num"><b>@_painel.PorFase.Sum(f => f.Orcado).ToString("N2", Br)</b></td><td class="num"><b>@_painel.Total.ToString("N2", Br)</b></td><td colspan="2"></td></tr></tfoot>
                    </table></div>
                    <div class="grade-2 mt-12">
                        <div>
                            <h3>Por tipo de custo</h3>
                            <table class="itens" id="cr-tipo"><tbody>
                                @foreach (var t in _painel.PorTipo.OrderByDescending(x => x.Value)) { <tr><td>@TiposCusto.Nome(t.Key)</td><td class="num">@t.Value.ToString("N2", Br)</td><td class="num">@(_painel.Total == 0 ? "" : (t.Value / _painel.Total * 100).ToString("N1", Br) + "%")</td></tr> }
                            </tbody></table>
                        </div>
                        <div>
                            <h3>Por mês</h3>
                            <table class="itens" id="cr-mes"><tbody>
                                @foreach (var m in _painel.PorMes) { <tr><td>@m.Mes.ToString("MM/yyyy")</td><td class="num">@m.Valor.ToString("N2", Br)</td></tr> }
                            </tbody></table>
                        </div>
                    </div>
                }
            }
        </div>
    </ChildContent>
</Pagina>

<Modal @bind-Aberto="_aberto" Titulo="@(_c?.ValorTravado == true ? "Lançamento de custo (reclassificar)" : "Lançamento de custo")" Tamanho="media">
    <ChildContent>
        @if (_c is not null)
        {
            <Erros Lista="ErrosForm" />
            @if (_c.ValorTravado) { <div class="alerta info"><Icone Nome="info" /> Veio @(_c.Origem switch { OrigemCusto.Recebimento => "do recebimento", OrigemCusto.Medicao => "da medição", _ => "da importação do ERP" }): valor e quantidade são do documento de origem. Aqui muda só fase, local, tipo e observação.</div> }
            <div class="form">
                <Campo Rotulo="Data" Obrigatorio Classe="s3"><input id="cr-data" type="date" @bind="_c.Data" disabled="@_c.ValorTravado" /></Campo>
                <Campo Rotulo="Tipo de custo" Classe="s3"><select id="cr-tipo" @bind="_c.TipoCusto">@foreach (var t in TiposCusto.Todos) { <option value="@t">@TiposCusto.Nome(t)</option> }</select></Campo>
                <Campo Rotulo="Fase (grupo de serviço)" Obrigatorio Classe="s6"><select id="cr-fase" @bind="_c.Fase">@foreach (var f in _fases.Union(new[] { _c.Fase }).Distinct()) { <option value="@f">@f</option> }</select></Campo>
                <Campo Rotulo="Local" Classe="s6"><select id="cr-local" value="@(_c.LocalId?.ToString() ?? "")" @onchange="e => _c.LocalId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null"><option value="">Obra toda (sem local)</option>@foreach (var l in _locais) { <option value="@l.Id">@l.Texto</option> }</select></Campo>
                <Campo Rotulo="Fornecedor" Classe="s6"><select id="cr-forn" value="@(_c.FornecedorId?.ToString() ?? "")" disabled="@_c.ValorTravado" @onchange="e => _c.FornecedorId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null"><option value="">(sem fornecedor)</option>@foreach (var f in _fornecedores) { <option value="@f.Id">@f.Texto</option> }</select></Campo>
                <Campo Rotulo="Descrição" Obrigatorio Classe="s12"><input id="cr-desc" @bind="_c.Descricao" disabled="@_c.ValorTravado" maxlength="300" /></Campo>
                <Campo Rotulo="Unidade" Classe="s2"><input @bind="_c.Unidade" list="cr-unidades" disabled="@_c.ValorTravado" maxlength="10" /><datalist id="cr-unidades">@foreach (var u in UnidadesPadrao.Lista) { <option>@u</option> }</datalist></Campo>
                <Campo Rotulo="Quantidade" Classe="s3"><input id="cr-qtd" type="number" step="0.0001" @bind="_c.Quantidade" disabled="@_c.ValorTravado" /></Campo>
                <Campo Rotulo="Valor (R$)" Obrigatorio Classe="s3" Ajuda="Negativo = estorno/crédito"><input id="cr-valor" type="number" step="0.01" @bind="_c.Valor" disabled="@_c.ValorTravado" /></Campo>
                <Campo Rotulo="Documento" Classe="s2"><input @bind="_c.DocumentoTipo" placeholder="NF, recibo…" disabled="@_c.ValorTravado" maxlength="40" /></Campo>
                <Campo Rotulo="Nº" Classe="s2"><input @bind="_c.DocumentoNumero" disabled="@_c.ValorTravado" maxlength="60" /></Campo>
                <Campo Rotulo="Observação" Classe="s12"><textarea @bind="_c.Observacao" rows="2"></textarea></Campo>
            </div>
        }
    </ChildContent>
    <Rodape>
        @if (_c is not null && !_c.ValorTravado)
        {
            <BotaoExcluir Tipo="typeof(Sigeo.Domain.Engenharia.CustoRealizado)" Id="@(_novo ? Guid.Empty : _c.Id)" IdBotao="cr-excluir" Descricao="este lançamento de custo" AoExcluir="async () => { _aberto = false; await Recarregar(); }" />
        }
        <button class="btn prim" id="cr-salvar" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="16" /> Salvar</button>
    </Rodape>
</Modal>

<Modal @bind-Aberto="_abertoRec" Titulo="Reclassificar lançamentos filtrados" Tamanho="pequena">
    <ChildContent>
        <Erros Lista="ErrosForm" />
        <p>@Filtrados.Count lançamentos (@Filtrados.Sum(l => l.Valor).ToString("C2", Br)) passam para:</p>
        <div class="form">
            <Campo Rotulo="Fase" Classe="s12"><select id="rec-fase" @bind="_recFase"><option value="">(manter a fase)</option>@foreach (var f in _fases) { <option value="@f">@f</option> }</select></Campo>
            <Campo Rotulo="Local" Classe="s12"><select id="rec-local" @bind="_recLocal"><option value="">(manter o local)</option><option value="obra">Obra toda (sem local)</option>@foreach (var l in _locais) { <option value="@l.Id">@l.Texto</option> }</select></Campo>
        </div>
    </ChildContent>
    <Rodape><button class="btn prim" id="rec-aplicar" disabled="@Ocupado" @onclick="Reclassificar"><Icone Nome="check" Tam="16" /> Aplicar</button></Rodape>
</Modal>

@code {
    [SupplyParameterFromQuery(Name = "obra")] public Guid? ObraQuery { get; set; }
    private Grade<LinhaCustoRealizado>? _grade;
    private Guid? _obraId;
    private DateOnly? _corte;
    private PainelCusto? _painel;
    private List<LinhaCustoRealizado> _linhas = [];
    private List<string> _fases = [];
    private List<Opcao> _locais = [], _fornecedores = [];
    private string _aba = "lanc";
    private readonly List<(string, string)> _abas = [("lanc", "Lançamentos"), ("orc", "Orçado × realizado")];
    private string _fFase = "", _fTipo = "", _fLocal = "", _fOrigem = "", _fTexto = "";
    private Sigeo.Domain.Engenharia.CustoRealizado? _c;
    private bool _aberto, _novo, _abertoRec;
    private string _recFase = "", _recLocal = "";

    private IGrade? GradeAtiva => _aba == "lanc" ? _grade : null;
    private IGrade? _gradeVista;
    // A grade só existe depois da 1ª renderização (e some na outra aba): a barra do topo acompanha.
    protected override void OnAfterRender(bool firstRender) { if (!ReferenceEquals(_gradeVista, GradeAtiva)) { _gradeVista = GradeAtiva; StateHasChanged(); } }

    private IEnumerable<string> FasesUsadas => _linhas.Select(l => l.Fase).Union(_fases).Distinct().OrderBy(f => f);

    private List<LinhaCustoRealizado> Filtrados => _linhas.Where(l =>
        (_fFase == "" || l.Fase == _fFase)
        && (_fTipo == "" || l.Tipo.ToString() == _fTipo)
        && (_fLocal == "" || (_fLocal == "obra" ? l.LocalId == null : l.LocalId?.ToString() == _fLocal))
        && (_fOrigem == "" || l.Origem.ToString() == _fOrigem)
        && (_fTexto.Length < 2 || $"{l.Descricao} {l.Fornecedor} {l.Documento} {l.Pedido}".Contains(_fTexto, StringComparison.OrdinalIgnoreCase))).ToList();

    private static string NomeOrigem(OrigemCusto o) => o switch
    {
        OrigemCusto.Manual => "Manual", OrigemCusto.ImportacaoErp => "Importação ERP", OrigemCusto.Recebimento => "Recebimento", _ => "Medição"
    };

    protected override async Task OnInitializedAsync()
    {
        _fases = await Cat.ListaAsync(TipoLista.GrupoServico);
        if (!_fases.Contains(Sigeo.Domain.Engenharia.CustoRealizado.FaseAApropriar)) _fases.Add(Sigeo.Domain.Engenharia.CustoRealizado.FaseAApropriar);
        _fornecedores = await Cat.FornecedoresAsync();
    }

    private async Task TrocarObra(Guid? id)
    {
        _obraId = id;
        _locais = id is { } o ? (await Cat.LocaisComCaminhoAsync(o)) : [];
        await Recarregar();
    }

    private async Task Recarregar()
    {
        if (_obraId is not { } o) { _painel = null; _linhas = []; return; }
        _painel = await Custos.PainelAsync(o, Cancelamento);
        _corte = _painel.Corte;
        _linhas = await Custos.ListarAsync(o, null, null, Cancelamento);
    }

    private async Task TrocarCorte(ChangeEventArgs e)
    {
        if (_obraId is not { } o) return;
        DateOnly? nova = DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : null;
        if (await Executar(() => Custos.DefinirCorteAsync(o, nova, Cancelamento), nova is null ? "Data de corte removida." : $"Data de corte: {nova:dd/MM/yyyy}.")) await Recarregar();
    }

    private void Novo()
    {
        if (_obraId is not { } o) { Notif.Erro("Escolha a obra."); return; }
        ErrosForm = null; _novo = true;
        _c = new Sigeo.Domain.Engenharia.CustoRealizado { ObraId = o, Data = Hoje, Fase = Sigeo.Domain.Engenharia.CustoRealizado.FaseAApropriar };
        _aberto = true;
    }

    private async Task Abrir(LinhaCustoRealizado l)
    {
        ErrosForm = null; _novo = false;
        _c = await Custos.ObterAsync(l.Id, Cancelamento);
        _aberto = _c is not null;
    }

    private async Task Salvar()
    {
        if (_c is null) return;
        if (await Executar(() => Custos.SalvarAsync(_c, Cancelamento), "Lançamento salvo.")) { _aberto = false; await Recarregar(); }
    }

    private void AbrirReclassificar() { ErrosForm = null; _recFase = ""; _recLocal = ""; _abertoRec = true; }

    private async Task Reclassificar()
    {
        var ids = Filtrados.Select(l => l.Id).ToList();
        Guid? local = Guid.TryParse(_recLocal, out var g) ? g : null;
        var n = 0;
        if (await Executar(async () => n = await Custos.ReclassificarAsync(ids, _recFase, local, _recLocal == "obra", Cancelamento)))
        {
            Notif.Sucesso($"{n} lançamentos reclassificados.");
            _abertoRec = false; await Recarregar();
        }
    }
}
