@page "/engenharia/diario"
@using Sigeo.Domain.Planejamento
@inherits PaginaBase
@inject DiarioObraServico Diario

<Pagina Titulo="Diário de Obra (RDO)" AoAtualizar="Recarregar">
    <ChildContent>
        <div class="pagina toque">
            <div class="barra-filtro">
                <SeletorObra Id="rdo-obra" Valor="_obraId" ValorChanged="TrocarObra" Inicial="ObraQuery" />
                @if (_d is { Numero: > 0 }) { <a class="btn sec" id="rdo-imprimir" target="_blank" href="@($"engenharia/diario/imprimir?id={_d.Id}")"><Icone Nome="impressora" Tam="14" /> Imprimir RDO</a> }
            </div>
            @if (_obraId is null) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra.</div> }
            else
            {
                <div class="rdo-grade">
                    <div class="cartao">
                        <div class="barra-botoes" style="justify-content:space-between">
                            <button class="icone-btn" title="Mês anterior" aria-label="Mês anterior" @onclick="() => TrocarMes(-1)">‹</button>
                            <b>@Meses[_mes.Month - 1]/@_mes.Year</b>
                            <button class="icone-btn" title="Próximo mês" aria-label="Próximo mês" @onclick="() => TrocarMes(1)">›</button>
                        </div>
                        <div class="rdo-cal" id="rdo-cal">
                            @foreach (var c in new[] { "S", "T", "Q", "Q", "S", "S", "D" }) { <span class="cab">@c</span> }
                            @for (var i = 0; i < ((int)_mes.DayOfWeek + 6) % 7; i++) { <button class="vazio" tabindex="-1" aria-hidden="true"></button> }
                            @for (var dia = 1; dia <= DateTime.DaysInMonth(_mes.Year, _mes.Month); dia++)
                            {
                                var data = new DateOnly(_mes.Year, _mes.Month, dia);
                                var r = _dias.FirstOrDefault(x => x.Data == data);
                                var cls = r is null ? (data.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "fds" : "")
                                    : r.Trabalhado != DiaTrabalhado.Sim ? (r.Trabalhado == DiaTrabalhado.NaoChuva ? "chuva" : "parado") + (r.Status == StatusDiario.Assinado ? "" : " rasc")
                                    : r.Status == StatusDiario.Assinado ? "ass" : "rasc";
                                <button class="@cls" aria-pressed="@(_data == data)" disabled="@(data > Hoje)" title="@Dica(r)" @onclick="() => Abrir(data)">@dia</button>
                            }
                        </div>
                        <div class="legenda"><span><i style="background:var(--ok-suave)"></i>assinado</span><span><i
                                    style="background:var(--info-suave)"></i>chuva</span><span><i
                                    style="background:var(--erro-suave)"></i>não trabalhado</span><span><b
                                    style="color:var(--aviso)">•</b> rascunho</span></div>
                        <p class="mudo">O diário alimenta o Planejamento: dias trabalhados × úteis, dias perdidos por chuva (evidência na reprogramação) e o efetivo médio.</p>
                    </div>

                    <div class="cartao" id="rdo-form">
                        @if (_d is null) { <Esqueleto Linhas="10" /> }
                        else
                        {
                            var d = _d; var ro = !d.Editavel || !_podePreencher;
                            <div class="barra-botoes" style="justify-content:space-between;flex-wrap:wrap">
                                <h3>@(d.Numero > 0 ? $"RDO nº {d.Numero:0000} · " : "Novo RDO · ")@d.Data.ToString("dddd, dd/MM/yyyy", Br)</h3>
                                <Selo Texto="@(d.Status == StatusDiario.Assinado ? "Assinado" : d.Numero > 0 ? "Rascunho" : "Não iniciado")" Tom="@(d.Status == StatusDiario.Assinado ? "ok" : "aviso")" />
                            </div>
                            <Erros Lista="ErrosForm" />
                            @if (!ro)
                            {
                                <div class="barra-botoes">
                                    <button class="btn sec pq" id="rdo-copiar" @onclick="CopiarEfetivo"><Icone Nome="atualizar" Tam="14" /> Copiar efetivo do dia anterior</button>
                                    <button class="btn sec pq" id="rdo-plano" @onclick="TrazerPlano"><Icone Nome="baixar" Tam="14" /> Trazer atividades do plano semanal</button>
                                </div>
                            }

                            <div class="rdo-sec"><Icone Nome="sol" Tam="16" /> Condições do dia</div>
                            <div class="form">
                                <Campo Rotulo="Clima manhã" Classe="s3"><select @bind="d.ClimaManha" disabled="@ro">@foreach (var c in Enum.GetValues<ClimaDia>()) { <option value="@c">@Clima(c)</option> }</select></Campo>
                                <Campo Rotulo="Clima tarde" Classe="s3"><select @bind="d.ClimaTarde" disabled="@ro">@foreach (var c in Enum.GetValues<ClimaDia>()) { <option value="@c">@Clima(c)</option> }</select></Campo>
                                <Campo Rotulo="Condição" Classe="s3"><select @bind="d.Condicao" disabled="@ro"><option
                                            value="@CondicaoDia.Praticavel">Praticável</option><option
                                            value="@CondicaoDia.ParcialmentePraticavel">Parcialmente praticável</option><option
                                            value="@CondicaoDia.Impraticavel">Impraticável</option></select></Campo>
                                <Campo Rotulo="Dia trabalhado" Classe="s3"><select id="rdo-trab" @bind="d.Trabalhado" disabled="@ro"><option
                                            value="@DiaTrabalhado.Sim">Sim</option><option value="@DiaTrabalhado.NaoChuva">Não — chuva</option><option
                                            value="@DiaTrabalhado.NaoFeriadoParalisacao">Não — feriado / paralisação</option></select></Campo>
                                <Campo Rotulo="Início" Classe="s2"><input type="time" @bind="d.HoraInicio" disabled="@ro" /></Campo>
                                <Campo Rotulo="Término" Classe="s2"><input type="time" @bind="d.HoraTermino" disabled="@ro" /></Campo>
                                <Campo Rotulo="Observação do clima" Classe="s8"><input @bind="d.ObservacaoClima" disabled="@ro" /></Campo>
                            </div>

                            <div class="rdo-sec"><Icone Nome="pessoa" Tam="16" /> Efetivo</div>
                            <div class="grade-2">
                                <div>
                                    <b>Próprio</b> <span class="mudo">(funções do controle de mão de obra)</span>
                                    @foreach (var e in d.Efetivo.Where(x => !x.Terceiro).ToList())
                                    {
                                        <div class="rdo-lin" @key="e">
                                            <select aria-label="Função" value="@e.FuncaoObraId" disabled="@ro" @onchange="ev => DefinirFuncao(e, ev)"><option value="">Função…</option>@foreach (var f in _funcoes) { <option value="@f.Id">@f.Texto</option> }</select>
                                            <input type="number" min="0" aria-label="Quantidade" @bind="e.Quantidade" disabled="@ro" />
                                            @if (!ro) { <button class="icone-btn" title="Remover" @onclick="() => d.Efetivo.Remove(e)"><Icone Nome="lixeira" Tam="15" /></button> }
                                        </div>
                                    }
                                    @if (!ro) { <button class="btn sec pq" id="rdo-add-func" @onclick="() => d.Efetivo.Add(new DiarioEfetivo())"><Icone Nome="mais" Tam="14" /> Função</button> }
                                    <div class="mudo mt-6">Total próprio: <b>@d.TotalProprio</b></div>
                                </div>
                                <div>
                                    <b>Terceiros</b> <span class="mudo">(nome e quantidade)</span>
                                    @foreach (var e in d.Efetivo.Where(x => x.Terceiro).ToList())
                                    {
                                        <div class="rdo-lin" @key="e">
                                            <input list="rdo-terceiros" aria-label="Terceiro" placeholder="Empreiteiro" @bind="e.Nome" disabled="@ro" />
                                            <input type="number" min="0" aria-label="Quantidade" @bind="e.Quantidade" disabled="@ro" />
                                            @if (!ro) { <button class="icone-btn" title="Remover" @onclick="() => d.Efetivo.Remove(e)"><Icone Nome="lixeira" Tam="15" /></button> }
                                        </div>
                                    }
                                    <datalist id="rdo-terceiros">@foreach (var f in _fornecedores) { <option value="@f.Texto"></option> }</datalist>
                                    @if (!ro) { <button class="btn sec pq" id="rdo-add-terc" @onclick="() => d.Efetivo.Add(new DiarioEfetivo { Terceiro = true })"><Icone Nome="mais" Tam="14" /> Terceiro</button> }
                                    <div class="mudo mt-6">Total terceiros: <b>@d.TotalTerceiros</b></div>
                                </div>
                            </div>

                            <div class="rdo-sec"><Icone Nome="ferramenta" Tam="16" /> Atividades executadas @if (!ro) { <button class="btn sec pq" id="rdo-add-ativ" @onclick="AddAtividade"><Icone Nome="mais" Tam="14" /> Atividade</button> }</div>
                            @foreach (var a in d.Atividades.ToList())
                            {
                                var n = d.Atividades.ToList().IndexOf(a) + 1;
                                <div class="rdo-ativ" @key="a.Id">
                                    <div class="topo-a">
                                        <b>@n</b>
                                        <textarea rows="2" aria-label="Descrição da atividade" placeholder="O que foi feito (serviço, equipe, quantidade)" @bind="a.Descricao" disabled="@ro"></textarea>
                                        <select aria-label="Local (opcional)" value="@a.LocalId" disabled="@ro" @onchange="ev => DefinirLocal(a, ev)"><option value="">Local (opcional)</option>@foreach (var l in _locais) { <option value="@l.Id">@l.Texto</option> }</select>
                                        @if (!ro) { <button class="icone-btn" title="Remover atividade" @onclick="() => d.Atividades.Remove(a)"><Icone Nome="lixeira" Tam="15" /></button> }
                                    </div>
                                    @if (_salvas.Contains(a.Id)) { <FotosRegistro Entidade="@DiarioObraServico.EntidadeAtividade" EntidadeId="a.Id" SomenteLeitura="@(!d.Editavel || !_podePreencher)" /> }
                                    else { <div class="mudo mt-6"><Icone Nome="camera" Tam="14" /> Salve o rascunho para adicionar fotos nesta atividade.</div> }
                                </div>
                            }
                            @if (d.Atividades.Count == 0) { <div class="mudo">Nenhuma atividade. @(ro ? "" : "Use \"+ Atividade\" ou traga do plano semanal.")</div> }

                            <div class="rdo-sec"><Icone Nome="engrenagem" Tam="16" /> Equipamentos no dia
                                @if (!ro)
                                {
                                    <button class="btn sec pq" id="rdo-add-eq" @onclick="() => d.EquipamentosDia.Add(new DiarioEquipamento { DiarioId = d.Id })"><Icone Nome="mais" Tam="14" /> Equipamento</button>
                                    @if (_equipObra.Count > 0) { <button class="btn sec pq" id="rdo-eq-obra" @onclick="TrazerEquipamentos"><Icone Nome="atualizar" Tam="14" /> Os da obra</button> }
                                }
                            </div>
                            @if (d.EquipamentosDia.Count > 0)
                            {
                                <table class="itens" id="rdo-equip">
                                    <thead><tr><th>Equipamento</th><th class="num">Horas</th><th>Parado</th><th>Observação</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (var x in d.EquipamentosDia.ToList())
                                        {
                                            <tr><td><select aria-label="Equipamento" @bind="x.EquipamentoId" disabled="@ro"><option value="@Guid.Empty">—</option>@foreach (var eq in _equipTodos) { <option value="@eq.Id">@eq.Texto</option> }</select></td>
                                                <td class="larg-90"><input type="number" step="0.5" min="0" max="24" aria-label="Horas" @bind="x.Horas" disabled="@ro" /></td>
                                                <td><input type="checkbox" aria-label="Parado" @bind="x.Parado" disabled="@ro" /></td>
                                                <td><input aria-label="Observação" @bind="x.Observacao" disabled="@ro" placeholder="Ex.: aguardando peça, chuva" /></td>
                                                <td>@if (!ro) { <button class="icone-btn" title="Remover" @onclick="() => d.EquipamentosDia.Remove(x)"><Icone Nome="lixeira" Tam="15" /></button> }</td></tr>
                                        }
                                    </tbody>
                                </table>
                                <div class="mudo mt-6">Ao assinar, as horas somam no horímetro. Equipamento parado sem OS: abra a corretiva em Suprimentos › Equipamentos.</div>
                            }
                            else { <div class="mudo">Nenhum equipamento registrado no dia.</div> }

                            <div class="rdo-sec"><Icone Nome="alerta" Tam="16" /> Ocorrências e registros</div>
                            <div class="form">
                                <Campo Rotulo="Ocorrências" Classe="s12"><textarea rows="2" @bind="d.Ocorrencias" disabled="@ro"></textarea></Campo>
                                <Campo Rotulo="Visitas" Classe="s6"><textarea rows="2" @bind="d.Visitas" disabled="@ro"></textarea></Campo>
                                <Campo Rotulo="Equipamentos no canteiro" Classe="s6"><textarea rows="2" @bind="d.Equipamentos" disabled="@ro"></textarea></Campo>
                            </div>

                            <div class="rdo-sec"><Icone Nome="editar" Tam="16" /> Responsável</div>
                            <div class="form">
                                <Campo Rotulo="Engenheiro(a) da obra — preenche e assina" Classe="s8"><input value="@(d.AssinadoPorNome ?? (_podeAssinar ? Usuario.Nome : "—"))" disabled /></Campo>
                                <Campo Rotulo="Assinado em" Classe="s4"><input id="rdo-assinado-em" value="@(d.AssinadoEm is { } ae ? DataHora(ae) : "")" disabled /></Campo>
                            </div>
                            @if (!ro)
                            {
                                <div class="barra-botoes fim">
                                    <button class="btn sec" id="rdo-salvar" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="14" /> Salvar rascunho</button>
                                    @if (_podeAssinar) {
                                        <button class="btn prim" id="rdo-assinar" disabled="@Ocupado"
                                            @onclick='() =>
                                                Confirmar("Assinar e fechar o diário? Depois de assinado ele não muda (correção vira observação no dia seguinte).",
                                                    Assinar)'><Icone
                                                Nome="check-circulo" Tam="14" />
                                            Assinar e fechar o dia</button>
                                    }
                                </div>
                                @if (!_podeAssinar) { <p class="mudo">Quem assina é o engenheiro(a) da obra (Obras › engenheiro da obra ou da SPE).</p> }
                            }
                            else if (!_podePreencher && d.Editavel) { <div class="alerta aviso pq">Só a Engenharia preenche o diário. Você pode consultar.</div> }
                        }
                    </div>
                </div>
            }
        </div>
    </ChildContent>
    <Faixa><b>Engenharia · Diário de Obra</b><span>Um por dia · preenche e assina o engenheiro(a) da obra</span><span>Efetivo próprio por função e terceiros por nome</span><span>Fotos dentro de cada atividade · assinado não muda</span></Faixa>
</Pagina>

<Confirmacao Pergunta="@PerguntaConfirmacao" AoSim="ConfirmacaoSim" AoNao="ConfirmacaoNao" />
