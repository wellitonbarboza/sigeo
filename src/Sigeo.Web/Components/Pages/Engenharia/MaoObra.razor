@page "/engenharia/mao-de-obra"
@inherits PaginaBase
@inject MaoObraServico Mo

<Pagina Titulo="Mão de obra própria e apropriação" AoAtualizar="Atualizar">
    <ChildContent>
        <div class="pagina toque">
            <div class="barra-filtro">
                <SeletorObra Id="mo-obra" Valor="_obraId" ValorChanged="TrocarObra" Inicial="ObraQuery" />
                <label>Competência <input id="mo-mes" @key="_versaoFiltro" type="month" value="@_mes.ToString("yyyy-MM")" @onchange="TrocarMes" /></label>
            </div>
            @if (_obraId is null) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra.</div> }
            else
            {
                <Abas Itens="_abas" @bind-Ativa="_aba" />
                @if (Sujo) { <div class="alerta aviso"><Icone Nome="alerta" /> Há alterações nos custos do mês ainda não salvas.</div> }
                <Erros Lista="ErrosForm" />
                @if (_aba == "eq")
                {
                    <div class="my-6"><button class="btn sec" id="eq-nova" @onclick="NovaEquipe"><Icone Nome="mais" Tam="14" /> Nova equipe</button></div>
                    <div class="tabela-rolavel"><table class="itens" id="equipes">
                        <thead><tr><th>Código</th><th>Equipe</th><th>Encarregado</th><th class="num">Membros</th><th>Ativa</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var eq in _equipes)
                            {
                                <tr><td><b>@eq.Codigo</b></td><td>@eq.Nome</td><td>@eq.Encarregado</td><td class="num">@eq.Membros.Count(m => m.Ate == null)</td><td>@(eq.Ativa ? "Sim" : "Não")</td><td><button class="btn sec pq" @onclick="() => { _e = eq; ErrosForm = null; _abertoEq = true; }">Editar</button></td></tr>
                            }
                            @if (_equipes.Count == 0) { <tr><td colspan="6" class="mudo">Cadastre as equipes próprias (ex.: Alvenaria 1, Acabamento 2). Os membros são os colaboradores próprios (Segurança e Pessoas › Colaboradores).</td></tr> }
                        </tbody>
                    </table></div>
                }
                else if (_aba == "custo" && _veCustos)
                {
                    <div class="barra-botoes">
                        <button class="btn sec" id="custo-add" @onclick="AddCusto"><Icone Nome="mais" Tam="14" /> Linha</button>
                        <button class="btn sec" id="custo-replicar" disabled="@Ocupado" @onclick="Replicar"><Icone Nome="atualizar" Tam="14" /> Replicar de @_mes.AddMonths(-1).ToString("MM/yyyy")</button>
                        <button class="btn prim" id="custo-salvar" disabled="@Ocupado" @onclick="SalvarCustos"><Icone Nome="check" Tam="14" /> Salvar custos do mês</button>
                    </div>
                    <div class="tabela-rolavel"><table class="itens" id="custos">
                        <thead><tr><th>Equipe</th><th>Colaborador / função / descrição</th><th class="num">Pessoas</th><th class="num">Salário (R$/pessoa)</th><th class="num">Encargos %</th><th class="num">Benefícios (R$/pessoa)</th><th class="num">Outros (R$)</th><th class="num">Horas/mês</th><th class="num">Total</th><th class="num">R$/h</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in _custos)
                            {
                                <tr @key="c"><td><select @bind="c.EquipeId"><option value="">—</option>@foreach (var eq in _equipes) { <option value="@eq.Id">@eq.Codigo</option> }</select></td>
                                    <td><select @bind="c.ColaboradorId"><option value="">(colaborador)</option>@foreach (var p in _colabs) { <option value="@p.Id">@p.Texto</option> }</select>
                                        <select class="mt-3" @bind="c.FuncaoObraId"><option value="">(função)</option>@foreach (var f in _funcoes) { <option value="@f.Id">@f.Texto</option> }</select>
                                        <input class="mt-3" @bind="c.Descricao" placeholder="Descrição (opcional)" /></td>
                                    <td class="larg-70"><input type="number" min="1" @bind="c.Pessoas" /></td>
                                    <td class="larg-110"><input type="number" step="0.01" @bind="c.Salario" /></td>
                                    <td class="larg-80"><input type="number" step="0.01" @bind="c.EncargosPerc" /></td>
                                    <td class="larg-100"><input type="number" step="0.01" @bind="c.Beneficios" /></td>
                                    <td class="larg-100"><input type="number" step="0.01" @bind="c.Outros" /></td>
                                    <td class="larg-80"><input type="number" step="1" @bind="c.HorasMes" /></td>
                                    <td class="num">@c.Total.ToString("N2", Br)</td><td class="num">@c.CustoHora.ToString("N2", Br)</td>
                                    <td><button class="icone-btn" title="Remover linha" @onclick="() => RemoverCusto(c)"><Icone Nome="lixeira" Tam="16" /></button></td></tr>
                            }
                            @if (_custos.Count == 0) { <tr><td colspan="11" class="mudo">Sem custos em @_mes.ToString("MM/yyyy"). Lance por equipe/colaborador ou replique o mês anterior e ajuste.</td></tr> }
                        </tbody>
                        <tfoot><tr><td colspan="8" class="texto-dir">Total do mês</td><td class="num"><b>@_custos.Sum(c => c.Total).ToString("N2", Br)</b></td><td colspan="2"></td></tr></tfoot>
                    </table></div>
                }
                else if (_aba == "apr")
                {
                    <div class="grade-2">
                        <div>
                            <div class="form">
                                <Campo Rotulo="Data" Obrigatorio Classe="s4"><input id="apr-data" type="date" @bind="_aData" /></Campo>
                                <Campo Rotulo="Equipe" Classe="s8"><select id="apr-equipe" @bind="_aEquipe"><option value="">—</option>@foreach (var eq in _equipes.Where(x => x.Ativa)) { <option value="@eq.Id">@eq.Codigo – @eq.Nome</option> }</select></Campo>
                                <Campo Rotulo="ou colaborador" Classe="s12"><select @bind="_aColab"><option value="">—</option>@foreach (var p in _colabs) { <option value="@p.Id">@p.Texto</option> }</select></Campo>
                                <Campo Rotulo="Serviço" Obrigatorio Classe="s12"><select id="apr-serv" @bind="_aComp"><option value="">Selecione…</option>@foreach (var c in _comps) { <option value="@c.Id">@c.Texto</option> }</select></Campo>
                                <Campo Rotulo="Horas trabalhadas (total)" Obrigatorio Classe="s4"><input id="apr-horas" type="number" step="0.5" @bind="_aHoras" /></Campo>
                                <Campo Rotulo="Quantidade executada" Classe="s4"><input type="number" step="0.01" @bind="_aQtd" /></Campo>
                                <Campo Rotulo="Observação" Classe="s12"><input @bind="_aObs" /></Campo>
                            </div>
                            <button class="btn prim cheio-cel" id="apr-lancar" disabled="@(Ocupado || _aLocais.Count == 0)" @onclick="Apropriar"><Icone Nome="check" Tam="14" /> Lançar em @_aLocais.Count local(is)</button>
                            <p class="mudo">As horas são rateadas entre os locais pelas quantidades orçadas do serviço.</p>
                        </div>
                        <div>
                            <div class="secao"><Icone Nome="predio" /> Locais (pavimentos, apartamentos…)</div>
                            <SeletorLocais Locais="_locaisSel" Selecionados="_aLocais" SelecionadosChanged="StateHasChanged" />
                        </div>
                    </div>
                    <div class="secao"><Icone Nome="lista" /> Lançamentos de @_mes.ToString("MM/yyyy")</div>
                    <div class="tabela-rolavel"><table class="itens" id="apropriacoes">
                        <thead><tr><th>Data</th><th>Equipe / colaborador</th><th>Serviço</th><th>Locais</th><th class="num">Horas</th><th class="num">Qtd. exec.</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var g in _aps.GroupBy(a => a.Lancamento).OrderByDescending(g => g.First().Data))
                            {
                                var a = g.First();
                                <tr @key="g.Key"><td>@a.Data.ToString("dd/MM")</td><td>@(_equipes.FirstOrDefault(x => x.Id == a.EquipeId)?.Codigo ?? _colabs.FirstOrDefault(c => c.Id == a.ColaboradorId)?.Texto ?? "(sem equipe)")</td>
                                    <td>@_comps.FirstOrDefault(c => c.Id == a.ComposicaoId)?.Texto</td><td>@string.Join(", ", g.Select(x => _porId.GetValueOrDefault(x.LocalId)?.Codigo).Take(4))@(g.Count() > 4 ? $" +{g.Count() - 4}" : "")</td>
                                    <td class="num">@g.Sum(x => x.Horas).ToString("N1", Br)</td><td class="num">@g.Sum(x => x.QuantidadeExecutada ?? 0).ToString("N2", Br)</td>
                                    <td><button class="icone-btn" title="Excluir lançamento" disabled="@Ocupado" @onclick="() => Excluir(g.Key, g.Count())"><Icone Nome="lixeira" Tam="16" /></button></td></tr>
                            }
                            @if (_aps.Count == 0) { <tr><td colspan="7" class="mudo">Nenhum lançamento no mês.</td></tr> }
                        </tbody>
                    </table></div>
                }
                else if (_aba == "fech" && _veCustos && _fech is not null)
                {
                    <div class="kpis">
                        <Kpi Rotulo="Custo da mão de obra no mês" Valor="@_fech.CustoTotal.ToString("C2", Br)" />
                        <Kpi Rotulo="Horas apropriadas" Valor="@_fech.HorasApropriadas.ToString("N1", Br)" Tom="info" />
                        <Kpi Rotulo="Custo-hora médio real" Valor="@(_fech.HorasApropriadas == 0 ? "—" : (_fech.CustoTotal / _fech.HorasApropriadas).ToString("N2", Br))" Tom="info" />
                        <Kpi Rotulo="Custo sem apropriação" Valor="@_fech.CustoSemApropriacao.ToString("C2", Br)" Sub="lance as horas dessas equipes" Tom="@(_fech.CustoSemApropriacao > 0 ? "aviso" : "ok")" />
                    </div>
                    <div class="tabela-rolavel"><table class="itens" id="fech-equipes">
                        <thead><tr><th>Equipe</th><th class="num">Custo do mês</th><th class="num">Horas apropriadas</th><th class="num">Custo-hora real</th></tr></thead>
                        <tbody>@foreach (var eq in _fech.Equipes) { <tr><td>@(eq.EquipeId is null ? "(sem equipe)" : _equipes.FirstOrDefault(x => x.Id == eq.EquipeId)?.Nome)</td><td class="num">@eq.CustoMes.ToString("N2", Br)</td><td class="num">@eq.HorasApropriadas.ToString("N1", Br)</td><td class="num">@eq.CustoHoraReal.ToString("N2", Br)</td></tr> }</tbody>
                    </table></div>
                    <div class="secao"><Icone Nome="tabela" /> Realizado × orçado (mão de obra própria) por serviço</div>
                    <div class="tabela-rolavel"><table class="itens" id="fech-servicos">
                        <thead><tr><th>Serviço</th><th class="num">Horas</th><th class="num">Custo real</th><th class="num">Qtd. executada</th><th class="num">R$/un real</th><th class="num">R$/un orçado (M.O. própria)</th></tr></thead>
                        <tbody>
                            @foreach (var g in _fech.Celulas.GroupBy(c => c.ComposicaoId))
                            {
                                var comp = _compsObj.GetValueOrDefault(g.Key);
                                var qtd = _aps.Where(a => a.ComposicaoId == g.Key).Sum(a => a.QuantidadeExecutada ?? 0);
                                <tr><td>@(comp is null ? "?" : $"{comp.Codigo} – {comp.Descricao}")</td><td class="num">@g.Sum(x => x.Horas).ToString("N1", Br)</td><td class="num">@g.Sum(x => x.Custo).ToString("N2", Br)</td>
                                    <td class="num">@qtd.ToString("N2", Br)</td><td class="num">@(qtd == 0 ? "—" : (g.Sum(x => x.Custo) / qtd).ToString("N2", Br))</td><td class="num">@comp?.Custo(TipoInsumo.MaoObraPropria).ToString("N2", Br)</td></tr>
                            }
                        </tbody>
                    </table></div>
                }
            }
        </div>
    </ChildContent>
    <Faixa><b>Mão de obra própria</b><span>Equipes · custo mensal (replicável) · horas por serviço × local</span><span>Fechamento: custo-hora real e realizado × orçado</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_abertoEq" Titulo="Equipe" Tamanho="media toque">
    <ChildContent>
        @if (_e is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Código" Obrigatorio Classe="s3"><input id="eq-cod" @bind="_e.Codigo" placeholder="ALV1" /></Campo>
                <Campo Rotulo="Nome" Obrigatorio Classe="s6"><input id="eq-nome" @bind="_e.Nome" placeholder="Alvenaria 1" /></Campo>
                <Campo Rotulo="" Classe="s3"><label><input type="checkbox" @bind="_e.Ativa" /> Ativa</label></Campo>
                <Campo Rotulo="Encarregado" Classe="s12"><input @bind="_e.Encarregado" /></Campo>
            </div>
            <div class="secao"><Icone Nome="pessoa" /> Membros <span class="acao"><button class="btn sec pq" @onclick="() => _e.Membros.Add(new EquipeMembro { EquipeId = _e.Id, Desde = Hoje })"><Icone Nome="mais" Tam="14" /> Membro</button></span></div>
            <div class="tabela-rolavel"><table class="itens"><thead><tr><th>Colaborador</th><th>Desde</th><th>Até</th><th></th></tr></thead>
                <tbody>@foreach (var m in _e.Membros)
                {
                    <tr @key="m"><td><select @bind="m.ColaboradorId"><option value="@Guid.Empty">—</option>@foreach (var p in _colabs) { <option value="@p.Id">@p.Texto</option> }</select></td><td><input type="date" @bind="m.Desde" /></td><td><input type="date" @bind="m.Ate" /></td>
                        <td><button class="icone-btn" title="Remover membro" @onclick="() => _e.Membros.Remove(m)"><Icone Nome="lixeira" Tam="16" /></button></td></tr>
                }</tbody></table></div>
            @if (_colabs.Count == 0) { <div class="alerta aviso"><Icone Nome="alerta" /> Nenhum colaborador próprio nesta obra. Cadastre em Segurança e Pessoas › Colaboradores (vínculo próprio).</div> }
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="eq-salvar" disabled="@Ocupado" @onclick="SalvarEquipe"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

<Confirmacao Pergunta="@PerguntaConfirmacao" AoSim="ConfirmacaoSim" AoNao="ConfirmacaoNao" />
