@page "/engenharia/planejamento"
@using Sigeo.Domain.Planejamento
@using Sigeo.Web.Components.Pages.Engenharia.Partes
@inherits PaginaBase
@inject NavigationManager Nav
@inject PlanejamentoTelaConsultas Consultas
@* Indicadores do planejamento: só leitura. A edição do cronograma e a reprogramação ficam em "Cronograma e Reprogramação";
   o acompanhamento semanal (plano de ação, programação, médio e curto prazo, medição) fica em "Last Planner". *@

<Pagina Titulo="Indicadores do planejamento" AoAtualizar="Recarregar">
    <ChildContent>
        <div class="pagina toque plan">
            <div class="barra-filtro">
                <SeletorObra Id="plan-obra" Valor="_obraId" ValorChanged="TrocarObra" Inicial="ObraQuery" />
                @if (_versoes.Count > 0)
                {
                    <label>Versão
                        <select id="plan-versao" value="@_versaoId" @onchange="e => AbrirVersao(Guid.Parse(e.Value!.ToString()!))">
                            @foreach (var v in _versoes) { <option value="@v.Id">@v.Codigo · @De(v.Status)@(v.Motivo is { Length: > 0 } m ? $" · {m}" : "")</option> }
                        </select>
                    </label>
                }
                <span class="esp"></span>
                @if (_obraId is { } ol)
                {
                    <a class="btn sec pq" id="ir-cronograma" href="@($"engenharia/cronograma?obra={ol}")"><Icone Nome="calendario" Tam="14" /> Cronograma e reprogramação</a>
                    <a class="btn sec pq" id="ir-lps" href="@($"engenharia/last-planner?obra={ol}")"><Icone Nome="alvo" Tam="14" /> Last Planner</a>
                }
            </div>

            @if (_obraId is null) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra.</div> }
            else if (_versao is null)
            {
                <div class="alerta info"><Icone Nome="info" /> A obra ainda não tem cronograma. Crie a linha de base em <a href="@($"engenharia/cronograma?obra={_obraId}")">Cronograma e reprogramação</a>.</div>
            }
            else
            {
                var v = _versao;
                <div class="kpis">
                    <Kpi Rotulo="Término previsto" Valor="@Data(v.TerminoPrevisto)" Sub="@(v.TerminoBase is { } tb ? $"Base: {Data(tb)}" : "sem linha de base")" />
                    <Kpi Rotulo="Desvio vs base" Valor="@(_desvio is { } d ? (d > 0 ? $"+{d}" : d.ToString()) + " d.ú." : "—")" Sub="dias úteis no término" Tom="@(_desvio > 0 ? "erro" : _desvio < 0 ? "ok" : "")" />
                    <Kpi Rotulo="Custo orçado ligado" Valor="@v.CustoTotal.ToString("C0", Br)" Sub="@($"{_folhas} atividades")" />
                    <Kpi Rotulo="Avanço físico" Valor="@($"{_avanco:0.0}%")" Sub="ponderado pelo custo" />
                    <Kpi Rotulo="Atividades críticas" Valor="@_criticas" Sub="folga ≤ 0, não concluídas" Tom="@(_criticas > 0 ? "aviso" : "")" />
                </div>
                <div class="barra-botoes plan-acoes">
                    <Selo Texto="@($"{v.Codigo} · {De(v.Status)}")" Tom="@Tom(v.Status)" />
                    @if (v.MotivoDevolucao is { Length: > 0 } md) { <span class="alerta aviso pq"><Icone Nome="alerta" Tam="14" /> Devolvida: @md</span> }
                </div>
                <Abas Itens="_abas" Ativa="@_aba" AtivaChanged="a => _aba = a" />

                @if (_aba == "painel")
                {
                    <PainelPlanejamento ObraId="_obraId!.Value" Versao="_chave" />
                }
                else if (_aba == "gantt")
                {
                    <GanttPorLocal ObraId="_obraId!.Value" VersaoId="v.Id" Modo="ver" PodeEditar="false" Versao="_chave" />
                }
                else if (_aba == "desemb")
                {
                    var atual = Desembolso.PorMes(v.Atividades, _cal);
                    var baseM = Desembolso.PorMes(v.Atividades, _cal, usarBase: true);
                    <p class="mudo">Custo orçado (serviço × local) distribuído pelos dias úteis de cada atividade. Azul = linha de base; laranja = @v.Codigo. Linhas = curva S acumulada.</p>
                    <div class="cartao plan-svg" id="desembolso">@((MarkupString)CronogramaVisao.DesembolsoSvg(atual, baseM, v.DataStatus, 1100))</div>
                    <div class="tabela-rolavel"><table class="itens" id="tabela-desembolso">
                        <thead><tr><th>Mês</th><th class="num">Base</th><th class="num">@v.Codigo</th><th class="num">Diferença</th><th class="num">Acum. base</th><th class="num">Acum. @v.Codigo</th></tr></thead>
                        <tbody>
                            @{ decimal ab = 0, aa = 0; }
                            @foreach (var m in atual.Keys.Union(baseM.Keys).Distinct().Order())
                            {
                                var vb = baseM.GetValueOrDefault(m); var va = atual.GetValueOrDefault(m); ab += vb; aa += va;
                                <tr><td>@m.ToString("MM/yyyy")</td><td class="num">@vb.ToString("N0", Br)</td><td class="num">@va.ToString("N0", Br)</td>
                                    <td class="num @(va - vb < 0 ? "neg" : "")">@((va - vb).ToString("N0", Br))</td><td class="num">@ab.ToString("N0", Br)</td><td class="num">@aa.ToString("N0", Br)</td></tr>
                            }
                        </tbody>
                    </table></div>
                }
            }
        </div>
    </ChildContent>
</Pagina>

@code {
    [SupplyParameterFromQuery(Name = "obra")] public Guid? ObraQuery { get; set; }
    [SupplyParameterFromQuery(Name = "aba")] public string? AbaQuery { get; set; }

    // Abas que mudaram de tela: links antigos (?aba=…) continuam funcionando.
    private static readonly HashSet<string> AbasCronograma = ["crono", "redes", "versoes", "cal"];
    private static readonly HashSet<string> AbasLastPlanner = ["acao", "prog", "medio", "curto"];

    private readonly List<(string, string)> _abas = [("painel", "Painel"), ("gantt", "Gantt por local"), ("desemb", "Desembolso e curva S")];
    private string _aba = "painel";
    private Guid? _obraId, _versaoId;
    private List<VersaoCronograma> _versoes = [];
    private VersaoCronograma? _versao;
    private Calendario _cal = new();
    private int? _desvio;
    private int _criticas, _folhas, _chave;
    private decimal _avanco;

    protected override void OnInitialized()
    {
        if (AbaQuery is { } a)
        {
            var destino = AbasCronograma.Contains(a) ? "engenharia/cronograma" : AbasLastPlanner.Contains(a) ? "engenharia/last-planner" : null;
            if (destino is not null) { Nav.NavigateTo(destino + new Uri(Nav.Uri).Query, replace: true); return; }
            if (_abas.Any(x => x.Item1 == a)) _aba = a;
        }
    }

    private async Task TrocarObra(Guid? nova)
    {
        _obraId = nova; _versaoId = null; _versao = null;
        await Recarregar();
    }

    private async Task Recarregar()
    {
        if (_obraId is not { } o) return;
        var dados = await Consultas.ObraAsync(o, Cancelamento);
        _versoes = dados.Versoes;
        // Indicadores olham a versão vigente; sem ela, a mais recente em aprovação ou elaboração.
        _versaoId = _versaoId is { } atual && _versoes.Any(v => v.Id == atual) ? atual
            : (_versoes.FirstOrDefault(v => v.Status == StatusVersao.Vigente) ?? _versoes.FirstOrDefault(v => v.Status == StatusVersao.EmAprovacao)
               ?? _versoes.FirstOrDefault())?.Id;
        _cal = dados.Calendario;
        await CarregarVersao();
    }

    private async Task AbrirVersao(Guid id)
    {
        _versaoId = id;
        await CarregarVersao();
    }

    private async Task CarregarVersao()
    {
        _versao = null;
        if (_versaoId is not { } id) return;
        _versao = await Consultas.VersaoAsync(id, Cancelamento);
        var v = _versao;
        var folhas = v.Atividades.Where(a => !a.Resumo).ToList();
        _folhas = folhas.Count;
        _criticas = folhas.Count(a => a.Critica);
        _avanco = folhas.Sum(a => a.Custo) is > 0 and var c ? folhas.Sum(a => a.Avanco * a.Custo) / c : folhas.Count == 0 ? 0 : folhas.Average(a => a.Avanco);
        _desvio = v.TerminoBase is { } tb && v.TerminoPrevisto is { } tp ? _cal.DiasUteisEntre(tb, tp) : null;
        _chave++;
    }
}
