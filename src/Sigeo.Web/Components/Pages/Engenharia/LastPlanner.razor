@page "/engenharia/last-planner"
@using Sigeo.Domain.Planejamento
@using Sigeo.Web.Components.Pages.Engenharia.Partes
@inherits PaginaBase
@inject LastPlannerConsultas Consultas
@* Acompanhamento semanal do planejamento (Last Planner): plano de ação, programação semanal, médio prazo com restrições,
   curto prazo com PPC e medição semanal. O cronograma em si é editado em "Cronograma e Reprogramação". *@

<Pagina Titulo="Last Planner · curto e médio prazo">
    <ChildContent>
        <div class="pagina toque plan">
            <div class="barra-filtro">
                <SeletorObra Id="lps-obra" Valor="_obraId" ValorChanged="TrocarObra" Inicial="ObraQuery" />
                <span class="esp"></span>
                @if (_obraId is { } ol)
                {
                    <button class="btn sec pq" id="plan-medicao" @onclick="() => _abertoMedicao = true"><Icone Nome="check" Tam="14" /> Medição semanal</button>
                    <a class="btn sec pq" id="ir-indicadores" href="@($"engenharia/planejamento?obra={ol}")"><Icone Nome="grafico" Tam="14" /> Indicadores</a>
                    <a class="btn sec pq" id="ir-cronograma" href="@($"engenharia/cronograma?obra={ol}")"><Icone Nome="calendario" Tam="14" /> Cronograma</a>
                }
            </div>

            @if (_obraId is not { } o) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra.</div> }
            else
            {
                <Abas Itens="_abas" Ativa="@_aba" AtivaChanged="a => _aba = a" />
                @if (_aba == "acao")
                {
                    <PlanoAcaoPlanejamento @key="_chave" ObraId="o" Versoes="_versoes" PodeEditar="_podeEditar" />
                }
                else if (_aba == "prog")
                {
                    <ProgramacaoSemanal @key="_chave" ObraId="o" />
                }
                else if (_aba == "medio")
                {
                    <MedioPrazo @key="_chave" ObraId="o" PodeEditar="_podeApontar" Destacar="RestricaoQuery" />
                }
                else if (_aba == "curto")
                {
                    <CurtoPrazo @key="_chave" ObraId="o" PodeEditar="_podeApontar" />
                }
            }
        </div>
    </ChildContent>
</Pagina>

<Modal Titulo="Medição semanal" @bind-Aberto="_abertoMedicao" Tamanho="grande">
    <ChildContent>
        @if (_obraId is { } om && _abertoMedicao) { <MedicaoSemanalMapa ObraId="om" AoGravar="AoGravarMedicao" /> }
    </ChildContent>
</Modal>

@code {
    [SupplyParameterFromQuery(Name = "obra")] public Guid? ObraQuery { get; set; }
    [SupplyParameterFromQuery(Name = "aba")] public string? AbaQuery { get; set; }
    [SupplyParameterFromQuery(Name = "restricao")] public Guid? RestricaoQuery { get; set; }

    private readonly List<(string, string)> _abas = [("medio", "Médio prazo · restrições"), ("curto", "Curto prazo · PPC"), ("prog", "Programação semanal"), ("acao", "Plano de ação")];
    private string _aba = "curto";
    private Guid? _obraId;
    private List<VersaoCronograma> _versoes = [];
    private bool _podeEditar, _podeApontar, _abertoMedicao;
    private int _chave;

    protected override void OnInitialized()
    {
        _podeEditar = Perfil(PerfilUsuario.Engenharia, PerfilUsuario.Diretoria);
        _podeApontar = Perfil(PerfilUsuario.Engenharia, PerfilUsuario.Diretoria, PerfilUsuario.Campo);
        if (AbaQuery is { } a && _abas.Any(x => x.Item1 == a)) _aba = a;
    }

    private async Task TrocarObra(Guid? nova)
    {
        _obraId = nova;
        _versoes = [];
        if (nova is { } o)
            _versoes = await Consultas.VersoesAsync(o, Cancelamento);
        _chave++;
    }

    // Medição grava avanço no cronograma: as abas abertas recarregam.
    private Task AoGravarMedicao() { _chave++; return Task.CompletedTask; }
}
