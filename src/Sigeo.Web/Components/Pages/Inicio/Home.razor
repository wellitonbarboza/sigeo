@page "/"
@inherits PaginaBase
@inject AprovacaoServico Aprov
@inject SistemaServico Sistema
@inject MensagensServico Mensagens
@inject NavigationManager Nav

<PageTitle>Minhas pendências · SIGEO</PageTitle>
<div class="tela">
    <div class="topo"><h1>Minhas pendências</h1></div>
    <div class="miolo">
        <div class="pagina toque">
            <p class="mb-10"><b>@Saudacao(), @Usuario.Nome.Split(' ')[0]</b> <span class="mudo">· @(Rotulos.De(Enum.TryParse<PerfilUsuario>(Usuario.Perfil, out var pf) ? pf : PerfilUsuario.Campo)) · @Usuario.EmpresaNome · @Data(Hoje)</span></p>
            <div class="kpis">
                <Kpi Rotulo="Aprovações pendentes" Valor="@_aprovar.Count" Sub="@($"{_aprovar.Count(a => a.Atrasada)} fora do prazo")" Tom="@(_aprovar.Count > 0 ? "aviso" : "ok")" />
                <Kpi Rotulo="Pagamentos a liberar" Valor="@_pagamentos.Count" Sub="@Moeda(_pagamentos.Sum(p => p.Valor))" Tom="info" />
                <Kpi Rotulo="Alertas" Valor="@_alertas.Sum(a => a.Qtd)" Sub="documentos, prazos e vencimentos" Tom="@(_alertas.Any(a => a.Tom == "erro") ? "erro" : "aviso")" />
                <Kpi Rotulo="Minhas tarefas" Valor="@_tarefas.Count" Sub="@($"{_tarefas.Count(t => t.Atrasada(Hoje))} atrasada(s)")" Tom="@(_tarefas.Any(t => t.Atrasada(Hoje)) ? "erro" : "info")" />
                <Kpi Rotulo="Mensagens não lidas" Valor="@_msgs.Count(m => m.NaoLidas > 0)" Sub="conversas com novidade" Tom="@(_msgs.Any(m => m.NaoLidas > 0) ? "aviso" : "ok")" />
                <Kpi Rotulo="Minhas leituras" Valor="@_leituras.Count" Sub="@(_leituras.Count == 0 ? "em dia" : $"prazo {_leituras.Min(l => l.Prazo):dd/MM}")" />
            </div>
            <div class="acoes-pagina"><button class="btn sec pq" @onclick="AbrirDelegacao"><Icone Nome="pessoa" Tam="14" /> Delegar aprovações (férias/ausência)</button></div>
            <Abas Itens="Abas" @bind-Ativa="_aba" />
            @if (_aba == "aprovar" || _aba == "pagar")
            {
                var lista = _aba == "aprovar" ? _aprovar.Where(a => a.Entidade != EntidadeAprovavel.Pagamento).ToList() : _aprovar.Where(a => a.Entidade == EntidadeAprovavel.Pagamento).ToList();
                <div class="tabela-rolavel"><table class="itens">
                    <thead><tr><th>Tipo</th><th>Título</th><th>Solicitante</th><th class="num">Valor</th><th>Aguardando há</th><th>Prazo</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in lista)
                        {
                            <tr class="cursor-mao" @onclick="() => Ir(a.Entidade, a.EntidadeId)">
                                <td><Selo Texto="@De(a.Entidade)" Tom="info" /></td><td>@a.Titulo</td><td>@a.Solicitante</td><td class="num">@Moeda(a.Valor)</td>
                                <td>@Espera(a.Enviado)</td>
                                <td>@if (a.Prazo is { } pz) { <Selo Texto="@(a.Atrasada ? "atrasado" : pz.ToLocalTime().ToString("dd/MM HH:mm"))" Tom="@(a.Atrasada ? "erro" : "aviso")" /> }</td>
                                <td><button class="btn pq @(a.Entidade == EntidadeAprovavel.Pagamento ? "ok" : "prim")">@(a.Entidade == EntidadeAprovavel.Pagamento ? "Liberar" : "Abrir")</button></td>
                            </tr>
                        }
                        @if (lista.Count == 0) { <tr><td colspan="7" class="mudo">Nada pendente com você.</td></tr> }
                    </tbody>
                </table></div>
            }
            else if (_aba == "alertas")
            {
                <div class="alertas-home">
                    @foreach (var a in _alertas) { <a class="alerta @a.Tom" href="@a.Link"><Icone Nome="alerta" /> <b>&nbsp;@a.Qtd&nbsp;</b> @a.Texto</a> }
                    @if (_alertas.Count == 0) { <div class="alerta ok"><Icone Nome="check" /> Nenhum alerta. Tudo em dia.</div> }
                </div>
            }
            else if (_aba == "tarefas")
            {
                <div class="tabela-rolavel"><table class="itens"><thead><tr><th>Nº</th><th>Título</th><th>Solicitante</th><th>Prioridade</th><th>Prazo</th><th>Status</th></tr></thead>
                    <tbody>@foreach (var t in _tarefas) { <tr class="cursor-mao" @onclick='() => Nav.NavigateTo($"tarefas?id={t.Id}")'><td>@t.Numero</td><td>@t.Titulo @if (t.Leituras.Count == 0) { <Selo Texto="nova" Tom="info" /> }</td><td>@t.CriadoPor</td><td><Selo Texto="@De(t.Prioridade)" Tom="@Tom(t.Prioridade)" /></td><td class="@(t.Atrasada(Hoje) ? "texto-erro" : "")">@Data(t.Prazo)</td><td><Selo Texto="@De(t.Status)" Tom="@Tom(t.Status)" /></td></tr> }
                    @if (_tarefas.Count == 0) { <tr><td colspan="6" class="mudo">Nenhuma tarefa aberta para você.</td></tr> }</tbody></table></div>
            }
            else if (_aba == "mensagens")
            {
                <div class="tabela-rolavel"><table class="itens"><thead><tr><th>Assunto</th><th>Última</th><th>Registro</th><th>Quando</th><th></th></tr></thead>
                    <tbody>@foreach (var m in _msgs.Where(m => m.NaoLidas > 0)) { <tr class="cursor-mao" @onclick='() => Nav.NavigateTo($"mensagens?id={m.Id}")'><td><b>@m.Assunto</b> <Selo Texto="@($"{m.NaoLidas} nova(s)")" Tom="erro" /></td><td>@m.UltimoAutor: <span class="mudo">@m.Previa</span></td><td>@m.RegistroDescricao</td><td>@DataHora(m.UltimaEm)</td><td><button class="btn pq prim">Abrir</button></td></tr> }
                    @if (!_msgs.Any(m => m.NaoLidas > 0)) { <tr><td colspan="5" class="mudo">Nenhuma mensagem nova. <a href="mensagens">Abrir a caixa de mensagens</a></td></tr> }</tbody></table></div>
            }
            else if (_aba == "leituras")
            {
                <div class="tabela-rolavel"><table class="itens"><thead><tr><th>Documento</th><th>Prazo</th><th></th></tr></thead>
                    <tbody>@foreach (var l in _leituras) { <tr><td>@l.Documento</td><td>@Data(l.Prazo)</td><td><a class="btn pq prim" href="sgq/leituras">Ler</a></td></tr> }
                    @if (_leituras.Count == 0) { <tr><td colspan="3" class="mudo">Nenhuma leitura pendente.</td></tr> }</tbody></table></div>
            }
            else
            {
                <div class="tabela-rolavel"><table class="itens"><thead><tr><th>Tipo</th><th>Título</th><th>Enviado</th><th>Etapa</th><th>Status</th></tr></thead>
                    <tbody>@foreach (var s in _meus) { <tr class="cursor-mao" @onclick="() => Ir(s.Entidade, s.EntidadeId)"><td>@De(s.Entidade)</td><td>@s.Titulo</td><td>@DataHora(s.EnviadoEm)</td><td>@s.EtapaAtual de @s.Etapas.Count</td><td><Selo Texto="@De(s.Status)" Tom="@(s.Status == StatusAprovacao.Aprovado ? "ok" : s.Status == StatusAprovacao.Reprovado ? "erro" : "aviso")" /></td></tr> }
                    @if (_meus.Count == 0) { <tr><td colspan="5" class="mudo">Você não enviou nada para aprovação nos últimos 60 dias.</td></tr> }</tbody></table></div>
                @if (_meus.Count >= LimiteMeus) { <div class="alerta info"><Icone Nome="info" /> Exibindo os primeiros @LimiteMeus (os mais recentes) — veja os demais na tela de cada documento.</div> }
            }

            <div class="duas-caixas">
                <div class="caixa-sec"><div class="secao"><Icone Nome="pessoa" /> Delegação ativa</div>
                    @if (_delegacao is null) { <p class="fonte-13">Nenhuma delegação ativa. Ao delegar, as aprovações do período vão para o substituto e o log registra "aprovado por X em nome de @Usuario.Nome".</p> }
                    else { <p class="fonte-13">Suas aprovações estão com <b>@_delegacao.Value.Substituto</b> até <b>@_delegacao.Value.Fim.ToLocalTime().ToString("dd/MM/yyyy")</b>.</p> }
                </div>
                @if (_vazio)
                {
                    <div class="caixa-sec"><div class="secao"><Icone Nome="casa" /> Primeiros passos (banco zerado)</div>
                        <ol class="passos-iniciais">
                            <li><a href="cadastros/estabelecimentos">Estabelecimentos (matriz, filiais)</a> e <a href="cadastros/centros-custo">centros de custo</a></li>
                            <li><a href="engenharia/tipologias">Tipologias</a> (apartamento, torre, implantação) e <a href="engenharia/obras">obras, condomínios (SPE) e gerador</a></li>
                            <li><a href="engenharia/composicoes">Serviços e composições</a> e <a href="engenharia/orcamento">orçamento por local</a></li>
                            <li><a href="sistema/usuarios">Usuários, limites e alçadas</a></li>
                            <li><a href="sistema/parametros">Parâmetros, listas e notificações</a></li>
                            <li><a href="fornecedores">Fornecedores</a> e <a href="fornecedores/qualificacao">qualificação</a></li>
                            <li><a href="obra/modelos/fvs">Modelos de FVS</a> e <a href="obra/modelos/fvm">FVM</a></li>
                            <li><a href="sst/exigencias">Matriz de exigências (validar com SST)</a> e <a href="sst/colaboradores">colaboradores</a></li>
                        </ol>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="faixa"><b>Tela 25 · Minhas pendências</b><span>Caixa de entrada por usuário: aprovar, liberar, alertas e leituras</span><span>Prazo por etapa (alçada)</span></div>
</div>

<Modal @bind-Aberto="_abertoDel" Titulo="Delegar minhas aprovações" Tamanho="media toque">
    <ChildContent>
        <Erros Lista="ErrosForm" />
        <div class="form">
            <Campo Rotulo="Quem delega" Classe="s6"><input readonly value="@Usuario.Nome" /></Campo>
            <Campo Rotulo="Substituto" Obrigatorio Classe="s6"><select @bind="_d.SubstitutoUsuarioId"><option value="@Guid.Empty">Selecione…</option>@foreach (var u in _usuarios.Where(u => u.Id != Usuario.UsuarioId)) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
            <Campo Rotulo="Início" Classe="s6"><input type="date" value="@_d.Inicio.ToString("yyyy-MM-dd")" @onchange="e => _d.Inicio = DateOnly.Parse(e.Value!.ToString()!).ToDateTime(TimeOnly.MinValue)" /></Campo>
            <Campo Rotulo="Fim" Classe="s6"><input type="date" value="@_d.Fim.ToString("yyyy-MM-dd")" @onchange="e => _d.Fim = DateOnly.Parse(e.Value!.ToString()!).ToDateTime(new TimeOnly(23, 59))" /></Campo>
            <Campo Rotulo="Etapas" Classe="s6"><select @bind="_d.Entidade"><option value="">Todas</option>@foreach (var e in Enum.GetValues<EntidadeAprovavel>()) { <option value="@e">@De(e)</option> }</select></Campo>
            <Campo Rotulo="Motivo" Obrigatorio Classe="s6"><input @bind="_d.Motivo" placeholder="Férias, viagem…" /></Campo>
        </div>
        <p class="mudo">Quem solicita ou elabora não aprova o próprio item, mesmo por delegação. A aprovação grava "em nome de".</p>
    </ChildContent>
    <Rodape><button class="btn prim" disabled="@Ocupado" @onclick="SalvarDelegacao"><Icone Nome="check" Tam="16" /> Salvar delegação</button></Rodape>
</Modal>
