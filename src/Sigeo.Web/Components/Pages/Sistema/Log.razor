@page "/sistema/log"
@inherits PaginaBase
@inject LogConsultas Consultas

<Pagina Titulo="Log de auditoria" Grade="GradeAtual" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="barra-filtro">
                <label>De <input type="date" @bind="_de" /></label>
                <label>Até <input type="date" @bind="_ate" /></label>
                <label>Texto <input @bind="_texto" placeholder="usuário, entidade, detalhe…" /></label>
                <button class="btn sec" @onclick="Carregar"><Icone Nome="filtro" Tam="16" /> Aplicar</button>
            </div>
            <Abas Itens="_abas" @bind-Ativa="_aba" />
            @if (_aba == "dados")
            {
                <Grade T="RegistroAuditoria" @ref="_gA" Itens="_auditoria" AoClicar="r => { _r = r; _aberto = true; }" NomeExportacao="log-auditoria">
                    <Colunas>
                        <Coluna T="RegistroAuditoria" Titulo="Quando" Valor="r => r.Quando" />
                        <Coluna T="RegistroAuditoria" Titulo="Usuário" Valor="r => r.Usuario" />
                        <Coluna T="RegistroAuditoria" Titulo="Operação" Valor="r => r.Operacao" />
                        <Coluna T="RegistroAuditoria" Titulo="Entidade" Valor="r => r.Entidade" />
                        <Coluna T="RegistroAuditoria" Titulo="Campos alterados" Valor="r => r.CamposAlterados" />
                        <Coluna T="RegistroAuditoria" Titulo="Origem" Valor="r => r.Origem" />
                    </Colunas>
                </Grade>
                <Paginacao Total="_totalA" Pagina="_pagA" Tamanho="TamanhoPagina" AoMudar="IrAuditoria" />
            }
            else
            {
                <Grade T="EventoDocumento" @ref="_gE" Itens="_eventos" NomeExportacao="log-documentos">
                    <Colunas>
                        <Coluna T="EventoDocumento" Titulo="Quando" Valor="e => e.DataHora" />
                        <Coluna T="EventoDocumento" Titulo="Usuário" Valor="e => e.UsuarioNome" />
                        <Coluna T="EventoDocumento" Titulo="Evento" Valor="e => e.Evento" />
                        <Coluna T="EventoDocumento" Titulo="Documento" Valor="e => e.DocumentoId == null ? null : _docs.GetValueOrDefault(e.DocumentoId.Value)" />
                        <Coluna T="EventoDocumento" Titulo="Detalhe" Valor="e => e.Detalhe" />
                        <Coluna T="EventoDocumento" Titulo="Origem" Valor="e => e.Origem" />
                    </Colunas>
                </Grade>
                <Paginacao Total="_totalE" Pagina="_pagE" Tamanho="TamanhoPagina" AoMudar="IrEventos" />
            }
        </div>
    </ChildContent>
    <Faixa><b>Auditoria</b><span>Toda gravação passa pelo interceptor (quem, quando, antes/depois)</span><span>Documentos do SGQ: visualização, download, impressão, cópias, leituras</span><span>Somente leitura · exclusão sempre lógica</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_aberto" Titulo="@($"{_r?.Operacao} · {_r?.Entidade}")">
    <ChildContent>
        @if (_r is not null)
        {
            <p class="mudo">@DataHora(_r.Quando) · @_r.Usuario · id @_r.EntidadeId</p>
            <div class="duas-colunas">
                <div class="flex-1"><b>Antes</b><pre class="json">@Formatar(_r.ValoresAnterioresJson)</pre></div>
                <div class="flex-1"><b>Depois</b><pre class="json">@Formatar(_r.ValoresNovosJson)</pre></div>
            </div>
        }
    </ChildContent>
</Modal>

@code {
    private IGrade? GradeAtual => _aba == "dados" ? _gA : _gE;
    private Grade<RegistroAuditoria>? _gA;
    private Grade<EventoDocumento>? _gE;
    private List<RegistroAuditoria>? _auditoria;
    private List<EventoDocumento>? _eventos;
    private Dictionary<Guid, string> _docs = [];
    private RegistroAuditoria? _r;
    private bool _aberto;
    private string _aba = "dados";
    private DateOnly _de, _ate;
    private string? _texto;
    private static readonly List<(string, string)> _abas = [("dados", "Alterações de dados"), ("docs", "Eventos de documentos")];

    // Paginação no banco: o log cresce sem limite e o período padrão (30 dias) já pode ter dezenas de milhares de linhas.
    private const int TamanhoPagina = 200;
    private int _pagA, _pagE, _totalA, _totalE;

    protected override async Task OnInitializedAsync() { _ate = Hoje; _de = Hoje.AddDays(-30); await Carregar(); }

    private async Task Carregar()
    {
        _pagA = 0; _pagE = 0;
        await CarregarAuditoria();
        await CarregarEventos();
    }

    private async Task IrAuditoria(int pagina) { _pagA = pagina; await CarregarAuditoria(); }
    private async Task IrEventos(int pagina) { _pagE = pagina; await CarregarEventos(); }

    private (DateTimeOffset Ini, DateTimeOffset Fim) Periodo() =>
        (new DateTimeOffset(_de.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero), new DateTimeOffset(_ate.ToDateTime(TimeOnly.MaxValue), TimeSpan.Zero));

    private async Task CarregarAuditoria()
    {
        var (ini, fim) = Periodo();
        var r = await Consultas.AuditoriaAsync(ini, fim, _texto, _pagA, TamanhoPagina, Cancelamento);
        _totalA = r.Total;
        _auditoria = r.Itens;
    }

    private async Task CarregarEventos()
    {
        var (ini, fim) = Periodo();
        var r = await Consultas.EventosAsync(ini, fim, _texto, _pagE, TamanhoPagina, Cancelamento);
        _totalE = r.Total;
        _eventos = r.Eventos;
        _docs = r.CodigosDocumentos;
    }

    private static string Formatar(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "—";
        try { return System.Text.Json.JsonSerializer.Serialize(System.Text.Json.JsonDocument.Parse(json), new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }); }
        catch { return json; }
    }
}
