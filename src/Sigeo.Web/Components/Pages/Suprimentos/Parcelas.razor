@page "/contratos/parcelas"
@inherits PaginaBase
@inject ContratosRecorrentesServico RecSrv
@inject NavigationManager Nav

<Pagina Titulo="Parcelas de contratos recorrentes" Grade="_grade" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="kpis">
                <Kpi Rotulo="Aguardando nota" Valor="@_linhas?.Count(l => l.P.Status == StatusParcela.Prevista && l.P.Inicio <= Hoje)" Tom="aviso" />
                <Kpi Rotulo="A aprovar" Valor="@_linhas?.Count(l => l.P.Status == StatusParcela.Conferida)" Tom="info" />
                <Kpi Rotulo="Fora da tolerância" Valor="@_linhas?.Count(l => l.Fora)" Tom="erro" />
                <Kpi Rotulo="Vencidas sem pagamento" Valor="@_linhas?.Count(l => l.P.Vencida(Hoje))" Tom="erro" />
                <Kpi Rotulo="Previsto no mês" Valor="@(_linhas?.Where(l => l.P.Vencimento.Year == Hoje.Year && l.P.Vencimento.Month == Hoje.Month && l.P.Status != StatusParcela.Cancelada).Sum(l => l.P.NotaValor ?? l.P.ValorPrevisto).ToString("C0", Br))" />
            </div>
            <div class="acoes-pagina">
        <select id="pc-contrato" class="larg-260" value="@_contratoId" @onchange="async e => { _contratoId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; await Carregar(); }" aria-label="Contrato">
            <option value="">Todos os contratos recorrentes</option>
            @foreach (var c in _contratos) { <option value="@c.Id">@c.Numero – @c.Fornecedor</option> }
        </select>
        <button class="btn sec" id="pc-gerar" disabled="@(Ocupado || _contratoId is null)" @onclick="Gerar" title="Cria as parcelas da vigência e recalcula o previsto das que ainda não têm nota"><Icone Nome="calendario" Tam="16" /> Gerar / atualizar parcelas</button>
        <button class="btn sec" id="pc-vincular" disabled="@Ocupado" @onclick="Vincular" title="Liga notas importadas (SIEG/XML) do fornecedor à parcela do período"><Icone Nome="corrente" Tam="16" /> Vincular notas SIEG</button>
        @if (ContratoAtual?.FormaCobranca == FormaCobranca.Uso) { <button class="btn prim" id="pc-uso" disabled="@Ocupado" @onclick="AbrirUso"><Icone Nome="mais" Tam="16" /> Lançar uso</button> }
            </div>
            <Grade T="Linha" @ref="_grade" Itens="_linhas" AoClicar="l => Abrir(l.P.Id)" NomeExportacao="parcelas-contratos" Vazio="Nenhuma parcela. Marque o contrato como recorrente e use “Gerar / atualizar parcelas”.">
                <Colunas>
                    <Coluna T="Linha" Titulo="Contrato" Valor="l => l.Contrato" />
                    <Coluna T="Linha" Titulo="Fornecedor" Valor="l => l.Fornecedor" />
                    <Coluna T="Linha" Titulo="Nº" Valor="l => l.P.Numero" Largura="50px" />
                    <Coluna T="Linha" Titulo="Período" Valor="l => Periodo(l.P)" />
                    <Coluna T="Linha" Titulo="Vencimento" Valor="l => l.P.Vencimento" />
                    <Coluna T="Linha" Titulo="Previsto" Valor="l => l.P.ValorPrevisto" Formato="N2" Alinhar="num" />
                    <Coluna T="Linha" Titulo="Nota" Valor="l => l.P.NotaNumero" />
                    <Coluna T="Linha" Titulo="Valor da nota" Valor="l => l.P.NotaValor" Formato="N2" Alinhar="num" />
                    <Coluna T="Linha" Titulo="Diferença" Valor="l => l.P.Diferenca"><Modelo>@if (context.P.Diferenca is { } d) { <Selo Texto="@d.ToString("N2", Br)" Tom="@(context.Fora ? "erro" : "ok")" /> }</Modelo></Coluna>
                    <Coluna T="Linha" Titulo="Status" Valor="l => l.P.Status"><Modelo><Selo Texto="@De(context.P.Status)" Tom="@(context.P.Vencida(Hoje) ? "erro" : Tom(context.P.Status))" /></Modelo></Coluna>
                </Colunas>
            </Grade>
            <div class="alerta info"><Icone Nome="info" /> Fluxo: prevista → nota lançada (almoxarife ou SIEG) → aprovada pela engenharia (fora da tolerância exige justificativa) → liberada pelo financeiro → paga.</div>
        </div>
    </ChildContent>
    <Faixa><b>Parcelas</b><span>Locação · serviço contínuo · manutenção</span><span>Previsto × nota por período</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_aberto" Titulo="@(_p is null ? "" : $"Parcela {_p.Numero} · {_ct?.Numero}")" Tamanho="grande">
    <ChildContent>
        @if (_p is not null && _ct is not null)
        {
            <Erros Lista="ErrosForm" />
            <p class="mudo">@_ct.Fornecedor.RazaoSocial · @De(_ct.FormaCobranca) · período @Periodo(_p) · vence @Data(_p.Vencimento) · tolerância @_ct.ToleranciaPerc.ToString("N1", Br)%</p>
            @if (!string.IsNullOrWhiteSpace(_p.Composicao))
            {
                <div class="secao"><Icone Nome="calculadora" /> Composição do previsto</div>
                <pre class="composicao" id="pc-comp">@_p.Composicao</pre>
            }
            <p><b>Previsto: @Moeda(_p.ValorPrevisto)</b>@if (_p.NotaValor is { } nv) { <span> · Nota @_p.NotaNumero: <b>@Moeda(nv)</b> (@_p.NotaOrigem) · diferença @Moeda(_p.Diferenca)</span> }</p>
            <div class="form">
                @if (_p.Status == StatusParcela.Prevista)
                {
                    <Campo Rotulo="Nº da nota" Classe="s4" Obrigatorio="true"><input id="pc-nota" @bind="_notaNumero" /></Campo>
                    <Campo Rotulo="Valor da nota" Classe="s4" Obrigatorio="true"><input id="pc-valor" type="number" step="0.01" @bind="_notaValor" /></Campo>
                }
                @if (_p.Status == StatusParcela.Conferida)
                {
                    <Campo Rotulo="Justificativa (obrigatória fora da tolerância)" Classe="s12" Obrigatorio="@_p.ForaDaTolerancia(_ct.ToleranciaPerc)"><input id="pc-just" @bind="_justificativa" /></Campo>
                    @if (_ct.ExigeOsPorVisita)
                    {
                        <div class="s12 @(_p.OrdemServicoId is null ? "alerta aviso" : "alerta ok")"><Icone Nome="ferramenta" /> @(_p.OrdemServicoId is null ? "Contrato exige a OS da visita: verifique a OS em Equipamentos para liberar a aprovação." : "OS da visita vinculada.")</div>
                    }
                }
                @if (_p.Status == StatusParcela.Liberada) { <Campo Rotulo="Pago em" Classe="s4"><input id="pc-pago" type="date" @bind="_pagoEm" /></Campo> }
                @if (_p.Status is StatusParcela.Conferida or StatusParcela.Aprovada or StatusParcela.Prevista) { <Campo Rotulo="@(_p.Status == StatusParcela.Prevista ? "Motivo (para cancelar a parcela)" : "Motivo (para devolver)")" Classe="s12"><input id="pc-motivo" @bind="_motivo" /></Campo> }
            </div>
            @if (!string.IsNullOrWhiteSpace(_p.Justificativa)) { <p class="mudo">Justificativa: @_p.Justificativa</p> }
            <p class="mudo">
                @if (_p.ConferidoEm is { } c) { <span>Nota lançada por @_p.ConferidoPor em @DataHora(c). </span> }
                @if (_p.AprovadoEm is { } a) { <span>Aprovada por @_p.AprovadoPor em @DataHora(a). </span> }
                @if (_p.LiberadoEm is { } l) { <span>Liberada por @_p.LiberadoPor em @DataHora(l). </span> }
                @if (_p.PagoEm is { } pg) { <span>Paga em @Data(pg).</span> }
            </p>
            @if (_usos.Count > 0)
            {
                <div class="secao"><Icone Nome="lista" /> Usos lançados no período</div>
                <table class="itens"><thead><tr><th>Data</th><th>Item</th><th class="num">Qtde</th><th>Documento</th><th></th></tr></thead>
                    <tbody>@foreach (var u in _usos) { <tr><td>@Data(u.Data)</td><td>@(_ct.Itens.FirstOrDefault(i => i.Id == u.ContratoItemId)?.Descricao)</td><td class="num">@u.Quantidade.ToString("N2", Br)</td><td>@u.Documento</td>
                        <td>@if (_p.Status == StatusParcela.Prevista) { <button class="icone-btn" title="Excluir este uso" aria-label="Excluir uso" @onclick="() => ExcluirUso(u)"><Icone Nome="lixeira" Tam="15" /></button> }</td></tr> }</tbody>
                </table>
            }
        }
    </ChildContent>
    <Rodape>
        @if (_p is not null)
        {
            @if (_p.Status == StatusParcela.Prevista) { <button class="btn perigo" id="pc-cancelar" disabled="@Ocupado" @onclick="CancelarParcela">Cancelar parcela</button> }
            @if (_p.Status == StatusParcela.Prevista) { <button class="btn prim" id="pc-lancar" disabled="@Ocupado" @onclick="LancarNota"><Icone Nome="arquivo" Tam="16" /> Lançar nota</button> }
            @if (_p.Status is StatusParcela.Conferida or StatusParcela.Aprovada) { <button class="btn perigo" disabled="@Ocupado" @onclick="Devolver">Devolver</button> }
            @if (_p.Status == StatusParcela.Conferida && Perfil(PerfilUsuario.Engenharia, PerfilUsuario.Diretoria)) { <button class="btn ok" id="pc-aprovar" disabled="@Ocupado" @onclick="Aprovar"><Icone Nome="check" Tam="16" /> Aprovar</button> }
            @if (_p.Status == StatusParcela.Aprovada && Perfil(PerfilUsuario.Financeiro, PerfilUsuario.Diretoria)) { <button class="btn ok" id="pc-liberar" disabled="@Ocupado" @onclick="Liberar"><Icone Nome="dinheiro" Tam="16" /> Liberar pagamento</button> }
            @if (_p.Status == StatusParcela.Liberada && Perfil(PerfilUsuario.Financeiro, PerfilUsuario.Diretoria)) { <button class="btn ok" id="pc-paga" disabled="@Ocupado" @onclick="Pagar"><Icone Nome="check" Tam="16" /> Marcar paga</button> }
        }
    </Rodape>
</Modal>

<Modal @bind-Aberto="_abertoUso" Titulo="Lançar uso (ex.: troca de caçamba, visita)">
    <ChildContent>
        <Erros Lista="ErrosForm" />
        @if (_uso is not null && ContratoAtual is not null)
        {
            <div class="form">
                <Campo Rotulo="Item" Classe="s6" Obrigatorio="true">
                    <select id="uso-item" @bind="_uso.ContratoItemId"><option value="@Guid.Empty">—</option>@foreach (var i in _itensContrato) { <option value="@i.Id">@i.Texto</option> }</select>
                </Campo>
                <Campo Rotulo="Data" Classe="s3"><input type="date" @bind="_uso.Data" /></Campo>
                <Campo Rotulo="Quantidade" Classe="s3"><input id="uso-qtd" type="number" step="0.01" @bind="_uso.Quantidade" /></Campo>
                <Campo Rotulo="Documento (ticket, MTR, romaneio)" Classe="s6"><input @bind="_uso.Documento" /></Campo>
                <Campo Rotulo="Observação" Classe="s6"><input @bind="_uso.Observacao" /></Campo>
            </div>
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="uso-ok" disabled="@Ocupado" @onclick="LancarUso"><Icone Nome="check" Tam="16" /> Lançar</button></Rodape>
</Modal>

<Confirmacao Pergunta="@PerguntaConfirmacao" AoSim="ConfirmacaoSim" AoNao="ConfirmacaoNao" />
