@page "/medicoes"
@inherits PaginaBase
@inject MedicoesServico MedicoesSrv
@inject NavigationManager Nav

<Pagina Titulo="Medições e avaliação do prestador" Grade="_grade" AoNovo="AbrirNova" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="kpis">
                <Kpi Rotulo="Em elaboração" Valor="@_itens?.Count(m => m.Status == StatusMedicao.EmElaboracao)" />
                <Kpi Rotulo="Aguard. aprovação" Valor="@_itens?.Count(m => m.Status == StatusMedicao.AguardandoAprovacao)" Tom="aviso" />
                <Kpi Rotulo="Nota média" Valor="@Num(_itens?.Where(m => m.Nota != null).Select(m => m.Nota).DefaultIfEmpty(null).Average())" Tom="info" />
                <Kpi Rotulo="@($"Abaixo de {Num(_p?[Parametros.NotaPlanoPontual])}")" Valor="@_itens?.Count(m => m.Faixa != FaixaNota.Nenhuma)" Sub="geraram plano de ação" Tom="erro" />
            </div>
            <Grade T="MedicaoLinha" @ref="_grade" Itens="_itens" Limite="LimiteGrade" AoCarregarTudo="async () => { ListaCompleta = true; await Carregar(); }" AoClicar="l => Abrir(l.Id)" NomeExportacao="medicoes" CriadoPor="l => l.CriadoPor">
                <Colunas>
                    <Coluna T="MedicaoLinha" Titulo="Contrato" Valor="l => l.Contrato" />
                    <Coluna T="MedicaoLinha" Titulo="Nº" Valor="l => l.Numero" Largura="60px" />
                    <Coluna T="MedicaoLinha" Titulo="Fornecedor" Valor="l => l.Fornecedor" />
                    <Coluna T="MedicaoLinha" Titulo="Período" Valor='l => $"{DataCurta(l.Inicio)} a {DataCurta(l.Fim)}"' />
                    <Coluna T="MedicaoLinha" Titulo="Valor período" Valor="l => l.Valor" Formato="C2" Alinhar="num" />
                    <Coluna T="MedicaoLinha" Titulo="Nota" Valor="l => l.Nota" Alinhar="num" />
                    <Coluna T="MedicaoLinha" Titulo="Faixa" Valor="l => l.Faixa"><Modelo>@if (context.Faixa != FaixaNota.Nenhuma) { <Selo Texto="@De(context.Faixa)" Tom="erro" /> }</Modelo></Coluna>
                    <Coluna T="MedicaoLinha" Titulo="Status" Valor="l => l.Status"><Modelo><Selo Texto="@De(context.Status)" Tom="@Tom(context.Status)" /></Modelo></Coluna>
                </Colunas>
            </Grade>
        </div>
    </ChildContent>
    <Faixa><b>Medição</b><span>Quantidades × planilha do contrato + FVS aprovada dos serviços controlados</span><span>Notas: escopo @Pct(Parametros.PesoEscopo)
            · material @Pct(Parametros.PesoMaterial) · serviço @Pct(Parametros.PesoServico) · limpeza @Pct(Parametros.PesoLimpeza) · doc/seg
            @Pct(Parametros.PesoDocSeg)</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_nova" Titulo="Nova medição" Tamanho="media">
    <ChildContent>
        <Erros Lista="ErrosForm" />
        <div class="form">
            <Campo Rotulo="Contrato ativo" Obrigatorio Classe="s12"><select @bind="_novoContrato"><option value="">Selecione…</option>@foreach (var c in _contratos) { <option value="@c.Id">@c.Texto</option> }</select></Campo>
            <Campo Rotulo="Início do período" Classe="s6"><input type="date" @bind="_ini" /></Campo>
            <Campo Rotulo="Fim do período" Classe="s6"><input type="date" @bind="_fim" /></Campo>
        </div>
    </ChildContent>
    <Rodape><button class="btn prim" disabled="@(_novoContrato is null || Ocupado)" @onclick="CriarMedicao"><Icone Nome="mais" Tam="16" /> Criar</button></Rodape>
</Modal>

<Modal @bind-Aberto="_aberto" Titulo="@($"Medição {_m?.NumeroMedicao:00} — {_m?.Contrato.Numero} — {_m?.Contrato.Fornecedor.NomeExibicao}")" Tamanho="grande">
    <ChildContent>
        @if (_m is not null)
        {
            <Erros Lista="ErrosForm" />
            @if (!string.IsNullOrEmpty(_m.Bloqueios)) { <div class="alerta erro"><Icone Nome="x-circulo" /> @_m.Bloqueios</div> }
            <div class="kpis">
                <Kpi Rotulo="Valor do período" Valor="@Moeda(_m.ValorPeriodo)" />
                <Kpi Rotulo="Acumulado" Valor="@Moeda(_m.ValorAcumulado)" Sub="@($"de {Moeda(_m.Contrato.ValorTotal)}")" />
                <Kpi Rotulo="Saldo" Valor="@Moeda(_m.Saldo)" />
                <Kpi Rotulo="Retenção" Valor="@Moeda(_m.ValorRetencao)" Sub="@($"{_m.Contrato.RetencaoPerc:0.##}%")" />
            </div>
            <div class="secao"><Icone Nome="regua" /> Quantidades do período</div>
            <div class="tabela-rolavel">
                <table class="itens">
                    <thead><tr><th>Item</th><th>Descrição</th><th>UN</th><th class="num">Contratado</th><th class="num">Anterior</th><th>No período</th><th class="num">Acumulado</th><th class="num">% exec.</th><th>FVS liberada (serv. controlado)</th></tr></thead>
                    <tbody>
                        @foreach (var i in _m.Itens.OrderBy(i => i.ContratoItem.Item).ThenBy(i => _locNomes.GetValueOrDefault(i.LocalId ?? Guid.Empty)))
                        {
                            var q = _qtd[i.Id];
                            var cl = i.LocalId is { } lid ? i.ContratoItem.Locais.FirstOrDefault(x => x.LocalId == lid) : null;
                            <tr @key="(i.Id, _versaoQtd)">
                                <td>@i.ContratoItem.Item</td><td>@i.ContratoItem.Descricao @if (i.LocalId is { } lc) { <div class="mudo">@_locNomes.GetValueOrDefault(lc)</div> }</td><td>@i.ContratoItem.Unidade</td>
                                <td class="num">@Num(cl?.Quantidade ?? i.ContratoItem.Quantidade, 3)</td><td class="num">@Num(i.QtdAnterior, 3)</td>
                                <td class="larg-110"><input type="number" step="0.001" value="@q.Qtd.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="e => DefinirQtd(i.Id, e.Value)" disabled="@(!Editavel)" /></td>
                                <td class="num">@Num(i.QtdAcumulada, 3)</td>
                                <td class="num"><div class="barra"><span style="width:@(Math.Min(100, i.PercExecutado).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span></div>@Num(i.PercExecutado, 1)%</td>
                                <td>@if (i.ContratoItem.ServicoControladoId is not null) {
                                        <select value="@q.FvsId"
                                            @onchange="e => _qtd[i.Id] = (_qtd[i.Id].Qtd, i.LocalId, Guid.TryParse(e.Value?.ToString(), out var g) ? g : null)"
                                            disabled="@(!Editavel)"><option
                                                value="">@(i.LocalId is null ? "FVS liberada…" : "automático pelo local")</option>@foreach (var f in
                                                _fvsLib.Where(f =>
                                                    f.ServicoControladoId == i.ContratoItem.ServicoControladoId)) {
                                                <option value="@f.Id">@f.Numero · @_locNomes.GetValueOrDefault(f.LocalId)</option>
                                            }</select>
                                    } else { <span class="mudo">—</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_comp is { } cp)
            {
                <div class="alerta @(cp.LiberaMedicao ? "ok" : "aviso")" id="med-competencia"><Icone Nome="prancheta" />
                    Documentação mensal @cp.Mes.ToString("MM/yyyy"): <b>@De(cp.Situacao)</b>
                    (@cp.Entregues de @cp.Itens.Count itens)@(cp.LiberaMedicao ? " — libera a aprovação." : " — a aprovação fica bloqueada até a conferência.")
                    <a href="suprimentos/documentacao-mensal">Abrir conferência</a></div>
            }
            @if (_colabBloq > 0) { <div class="alerta aviso"><Icone Nome="alerta" /> @_colabBloq colaborador(es) desta empresa bloqueado(s) na obra no período (ASO/integração) — verificar antes de aprovar.</div> }
            <div class="secao"><Icone Nome="grafico" /> Avaliação do prestador (0 a 10)</div>
            @if (_sugestao is not null) { <div class="alerta info"><Icone Nome="info" /> @_sugestao</div> }
            <div class="criterios">
                @foreach (var (nome, peso, get, set, opcional) in Notas())
                {
                    var v = get();
                    <div class="criterio" @key="(nome, _versaoQtd)">
                        <b>@nome @if (opcional) { <small class="mudo">(opcional)</small> }</b><span>peso @Pct(peso)</span>
                        <input type="number" min="0" max="10" step="0.5" value="@v?.ToString(System.Globalization.CultureInfo.InvariantCulture)" disabled="@(!Editavel)"
                               @onchange="e => DefinirNota(nome, set, e.Value)" />
                        <div class="barra"><span class="@(v < _p![Parametros.NotaPlanoCompleto] ? "erro" : v < _p[Parametros.NotaPlanoPontual] ? "aviso" : "ok")" style="width:@(((v ?? 0) * 10).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                    </div>
                }
                <div class="criterio resultado @(_m.Faixa == FaixaNota.ReuniaoPlanoCompleto ? "erro" : _m.Faixa == FaixaNota.PlanoPontual ? "aviso" : _m.NotaFinal is null ? "" : "ok")">
                    <b>Nota final</b><span>@(_m.NotaFinal is null ? "preencha as notas" : Medicao.DescricaoFaixa(_m.Faixa, _p!))</span>
                    <div class="nota">@Num(_m.NotaFinal)</div>
                </div>
            </div>
            <div class="form mt-12">
                <Campo Rotulo="Data da reunião com o prestador" Classe="s3"><input type="date" @bind="_m.DataReuniao" disabled="@(!Editavel)" /></Campo>
                <Campo Rotulo="Avaliador" Classe="s5"><input readonly value="@(_m.AvaliadorNome ?? Usuario.Nome)" /></Campo>
                @if (_m.PlanoAcaoId is not null) { <div class="campo s4"><button class="btn sec" @onclick='() => Nav.NavigateTo("fornecedores/planos")'><Icone Nome="alvo" Tam="16" /> Ver plano de ação</button></div> }
                @if (!string.IsNullOrEmpty(_m.MotivoReprovacao)) { <div class="campo s12"><div class="alerta erro">Reprovação: @_m.MotivoReprovacao</div></div> }
            </div>
            @if (_m.CriadoEm != default) { <Notas Entidade="Medicao" EntidadeId="_m.Id" /> }
            <Autorizacoes Entidade="EntidadeAprovavel.Medicao" EntidadeId="_m.Id" Versao="_versao" AoDecidir="Recarregar" />
        }
    </ChildContent>
    <Rodape>
        @if (_m is not null)
        {
            @if (_m.Status == StatusMedicao.Aprovada) { <button class="btn laranja" @onclick='() => Nav.NavigateTo($"pagamentos?medicao={_m.Id}")'><Icone Nome="dinheiro" Tam="16" /> Encaminhar pagamento</button> }
            @if (Editavel)
            {
                <button class="btn ok" disabled="@Ocupado" @onclick="Enviar"><Icone Nome="enviar" Tam="16" /> Enviar p/ aprovação</button>
                <BotaoExcluir Tipo="typeof(Medicao)" Id="@(_m?.CriadoEm == default ? Guid.Empty : _m.Id)" IdBotao="exc-m" AoExcluir="async () => { _aberto = false; await Carregar(); }" />
            <button class="btn prim" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="16" /> Salvar e calcular</button>
            }
        }
    </Rodape>
</Modal>
