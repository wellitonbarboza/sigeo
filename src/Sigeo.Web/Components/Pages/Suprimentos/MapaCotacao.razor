@page "/cotacoes/mapa"
@inherits PaginaBase
@inject CotacoesServico CotacoesSrv
@inject IJSRuntime JS
@using Sigeo.Application.Comum
@* Mapa comparativo em tela própria (aberto da cotação, em nova janela): fornecedores por coluna com o que cada um
   preencheu no portal (prazo, pagamento, validade, frete, entrega por item, atende especificação), preços de
   referência / último / ofertado / negociado, economia gerada e análise por IA. Preços editáveis enquanto a cotação
   está em análise; condições do fornecedor são editadas na tela da cotação. *@

<Pagina Titulo="@(_c is null ? "Mapa comparativo" : $"Mapa comparativo · cotação {_c.Numero}")" AoAtualizar="Carregar">
    <Direita>
        @if (_c is not null)
        {
            <a class="btn sec pq" href="@($"cotacoes?id={_c.Id}")"><Icone Nome="calculadora" Tam="14" /> Cotação</a>
            <button class="btn sec pq" id="mapa-excel" @onclick="Excel"><Icone Nome="excel" Tam="14" /> Excel</button>
            <button class="btn sec pq" @onclick="Imprimir2"><Icone Nome="impressora" Tam="14" /> Imprimir / PDF</button>
            @if (Editavel)
            {
                <button class="btn sec pq" id="mapa-menor" title="Marca, em cada item, o fornecedor de menor preço como vencedor" @onclick="MenorPrecoEmTodos"><Icone Nome="medalha" Tam="14" /> Menor preço em cada item</button>
                @if (_c?.VencedorPorItem == true) { <button class="btn sec pq" id="mapa-limpar" @onclick="LimparVencedores">Limpar vencedores</button> }
                <button class="btn prim pq" id="mapa-salvar" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="14" /> Salvar preços e vencedores</button>
            }
        }
    </Direita>
    <ChildContent>
        <div class="pagina mapa-cotacao">
            <Erros Lista="ErrosForm" />
            @if (_c is null) { @if (_naoEncontrada) { <p class="mudo">Cotação não encontrada.</p> } else { <Esqueleto Indicadores="3" Linhas="8" /> } }
            else
            {
                var forns = _c.Fornecedores.ToList();
                var econ = Econ;
                <p class="fonte-13"><b>@_c.Nome</b> · @_obra · @De(_c.Tipo) · frete @De(_c.Frete) · <Selo Texto="@De(_c.Status)" Tom="@Tom(_c.Status)" />
                    @if (!Editavel) { <span class="mudo">· somente leitura (cotação @De(_c.Status).ToLowerInvariant())</span> }</p>
                <div class="kpis">
                    <Kpi Rotulo="@(_c.FornecedorVencedorId is null ? "Menor total (1 fornecedor)" : "Total do vencedor")"
                        Valor="@Moeda(_c.FornecedorVencedorId is { } v ? Total(v) : MenorTotal?.Total)"
                        Sub="@(_c.FornecedorVencedorId is { } v2 ? Nome(v2) : MenorTotal is { } m ? Nome(m.Id) : "sem preços")" Tom="info" />
                    <Kpi Rotulo="Melhor preço por item" Valor="@Moeda(MelhorPorItem)" Sub="@(MenorTotal is { } mt && mt.Total > MelhorPorItem ? $"dividir economiza {Moeda(mt.Total - MelhorPorItem)}" : "sem ganho em dividir")" />
                    <Kpi Rotulo="Economia negociada" Valor="@Moeda(econ.Negociada)" Sub="@($"{econ.NegociadaPerc:0.0}% vs. ofertado")" Tom="ok" />
                    <Kpi Rotulo="Economia vs. último preço" Valor="@(econ.VsUltimo is { } u ? Moeda(u) : "—")" Sub="@(econ.VsUltimoPerc is { } up ? $"{up:0.0}%" : "sem compra anterior")" Tom="@(econ.VsUltimo is < 0 ? "erro" : "ok")" />
                    <Kpi Rotulo="Economia vs. referência" Valor="@(econ.VsReferencia is { } r ? Moeda(r) : "—")" Sub="@(econ.VsReferenciaPerc is { } rp ? $"{rp:0.0}%" : "sem preço de referência")" Tom="@(econ.VsReferencia is < 0 ? "erro" : "ok")" />
                </div>
                @if (_c.FornecedorVencedorId is null) { <p class="mudo">Economias sobre o menor preço de cada item até a escolha do vencedor (na tela da cotação).</p> }

                <div class="secao"><Icone Nome="predio" /> Propostas dos fornecedores</div>
                <div class="tabela-rolavel">
                    <table class="itens mapa" id="mapa-fornecedores">
                        <thead><tr><th>Condição</th>@foreach (var f in forns) {
                                    <th
                                        class="texto-centro @(f.FornecedorId == _c.FornecedorVencedorId ? "destaque"
                                            : "")">@Nome(f.FornecedorId)@if (f.FornecedorId == _c.FornecedorVencedorId) {
                                            <br /><Selo Texto="vencedor" Tom="ok" />
                                        }</th>
                                }</tr></thead>
                        <tbody>
                            <tr><td>Qualificação</td>@foreach (var f in forns) { <td class="texto-centro"><Selo Texto="@De(f.QualificacaoNaData)" Tom="@Tom(f.QualificacaoNaData)" /></td> }</tr>
                            @if (forns.Any(f => !string.IsNullOrWhiteSpace(f.PendenciaNaData)))
                            {
                                <tr><td>Pendência no convite</td>@foreach (var f in forns) { <td class="texto-centro"><small class="@(string.IsNullOrWhiteSpace(f.PendenciaNaData) ? "mudo" : "texto-erro")">@(f.PendenciaNaData ?? "—")</small></td> }</tr>
                            }
                            @if (_c.VencedorPorItem)
                            {
                                <tr class="peso-600"><td>Itens vencidos · total</td>@foreach (var f in forns) {
                                        var vi = _c.Itens.Where(i => i.FornecedorId == f.FornecedorId && i.Vencedor).ToList();
                                        <td class="num">@(vi.Count == 0 ? "—" : $"{vi.Count} · {Moeda(vi.Sum(i => i.ValorTotalVencido))}")</td>
                                    }</tr>
                            }
                            <tr><td>Situação / resposta</td>@foreach (var f in forns) { <td class="texto-centro">@De(f.Status) @(f.DataResposta is { } d ? $"· {d:dd/MM}" : "")</td> }</tr>
                            <tr><td>Prazo de entrega ofertado</td>@foreach (var f in forns) { <td class="texto-centro @(f.PrazoEntregaOfertado is { } p && p == MelhorPrazo ? "melhor" : "")">@Data(f.PrazoEntregaOfertado)</td> }</tr>
                            <tr><td>Condição de pagamento</td>@foreach (var f in forns) { <td class="texto-centro">@(f.CondicaoPagamento ?? "—")</td> }</tr>
                            <tr><td>Validade da proposta</td>@foreach (var f in forns) { <td class="texto-centro @(f.ValidadeProposta < Hoje ? "texto-erro" : "")">@Data(f.ValidadeProposta)</td> }</tr>
                            <tr><td>Frete</td>@foreach (var f in forns) { <td class="num">@(_c.Frete == TipoFrete.NaoSeAplica ? "N/A" : Moeda(f.ValorFrete ?? 0))</td> }</tr>
                            <tr><td>Proposta anexada</td>@foreach (var f in forns) { <td class="texto-centro">@(f.TemAnexoProposta ? "sim" : "—")</td> }</tr>
                            <tr><td>Itens com preço</td>@foreach (var f in forns) { <td class="texto-centro">@ComPreco(f.FornecedorId) de @_grupos.Count</td> }</tr>
                            <tr class="peso-600"><td>Total (itens + frete)</td>@foreach (var f in forns) { var t = Total(f.FornecedorId); <td class="num @(MenorTotal is { } mn && mn.Id == f.FornecedorId ? "melhor" : "")">@Moeda(t)<br /><small class="mudo">@Diferenca(t)</small></td> }</tr>
                        </tbody>
                    </table>
                </div>

                <div class="secao"><Icone Nome="tabela" /> Itens × fornecedores (valor unitário)</div>
                <div class="tabela-rolavel">
                    <table class="itens mapa" id="mapa-itens">
                        <thead>
                            <tr><th rowspan="2">Item</th><th rowspan="2">UN</th><th rowspan="2" class="num">Quant.</th><th rowspan="2" class="num"
                                    title="Último preço unitário pago pelo mesmo produto">Último</th><th rowspan="2" class="num"
                                    title="Preço de referência do cadastro do produto">Ref.</th>
                                @foreach (var f in forns) { <th colspan="3" class="texto-centro">@Nome(f.FornecedorId)</th> }<th rowspan="2" class="num">Melhor</th></tr>
                            <tr>@foreach (var _ in forns) { <th>Ofertado</th><th>Negociado</th><th class="num">Total</th> }</tr>
                        </thead>
                        <tbody>
                            @foreach (var g in _grupos)
                            {
                                var primeiro = g.First();
                                var precos = g.Where(i => i.ValorUnitarioFinal > 0).ToList();
                                var menor = precos.Count == 0 ? 0 : precos.Min(i => i.ValorUnitarioFinal);
                                var locaisItem = primeiro.RequisicaoItemId is { } rid && _locaisItem.TryGetValue(rid, out var ls) ? ls : null;
                                var aberto = locaisItem is not null && _abertos.Contains(primeiro.RequisicaoItemId!.Value);
                                <tr @key="primeiro.Id">
                                    <td><b>@primeiro.Descricao</b> @if (primeiro.MaterialControlado) { <Selo Texto="controlado" Tom="info" /> }
                                        @if (primeiro.RequisicaoItemId is { } rqm && _pedidas.TryGetValue(rqm, out var mp) && !string.IsNullOrWhiteSpace(mp.Marca)) { <br /><small class="mudo">Pedida: @mp.Marca@(mp.Mesma ? " (somente esta)" : " ou similar")</small> }
                                        @if (locaisItem is not null) {
                                            <br /><button type="button" class="pl-toggle" aria-expanded="@(aberto ? "true" : "false")"
                                                @onclick="() => AlternarLocais(primeiro.RequisicaoItemId!.Value)">@(aberto ? "▾" : "▸") <span
                                                    class="pl-ico">▦</span> Locais: @QuadroLocais.Resumo(locaisItem, primeiro.Unidade)</button>
                                        }</td>
                                    <td>@primeiro.Unidade</td><td class="num">@Num(primeiro.Quantidade, 3)</td>
                                    <td class="num mudo">@(primeiro.PrecoUltimo is { } pu ? Moeda(pu) : "—")</td>
                                    <td class="num mudo">@(primeiro.PrecoReferencia is { } pr ? Moeda(pr) : "—")</td>
                                    @foreach (var f in forns)
                                    {
                                        var it = g.FirstOrDefault(i => i.FornecedorId == f.FornecedorId);
                                        if (it is null) { <td></td><td></td><td></td> continue; }
                                        var melhor = it.ValorUnitarioFinal > 0 && it.ValorUnitarioFinal == menor;
                                        <td class="larg-110 @(melhor ? "melhor" : "")"><input type="number" step="0.01" aria-label="@($"Ofertado {Nome(f.FornecedorId)} – {primeiro.Descricao}")" @bind="it.ValorOfertado" @bind:after="Recalcular" disabled="@(!Editavel)" />
                                            @if (_c.Tipo == TipoRequisicao.Material) {
                                                <input class="mt-4 @(it.ValorOfertado > 0 && string.IsNullOrWhiteSpace(it.Marca) ? "invalido" : "")"
                                                    list="mapa-marcas" placeholder="marca"
                                                    aria-label="@($"Marca {Nome(f.FornecedorId)} – {primeiro.Descricao}")" @bind="it.Marca"
                                                    disabled="@(!Editavel)" />
                                            }
                                            @if (it.Entrega is { } en) { <small class="mudo">entrega @en.ToString("dd/MM")</small> }
                                            @if (it.MaterialControlado) { <small class="@(it.AtendeEspecificacao == true ? "" : "texto-erro")">@(it.AtendeEspecificacao switch { true => "atende espec.", false => "não atende espec.", _ => "espec. não avaliada" })</small> }</td>
                                        <td class="larg-110"><input type="number" step="0.01" aria-label="@($"Negociado {Nome(f.FornecedorId)} – {primeiro.Descricao}")" @bind="it.ValorNegociado" @bind:after="Recalcular" disabled="@(!Editavel)" />
                                            @if (it.Economia > 0) { <small class="econ pos">−@Moeda(it.Economia)</small> }</td>
                                        <td class="num @(melhor ? "melhor" : "") @(it.Vencedor ? "destaque" : "")">@(it.ValorUnitarioFinal > 0 ? Moeda(it.ValorTotal) : "—")
                                            @if (it.PrecoUltimo is { } ult && ult > 0 && it.ValorUnitarioFinal > ult) { <br /><small class="texto-erro" title="Acima do último preço pago">+@(((it.ValorUnitarioFinal - ult) / ult).ToString("P1", Br)) vs. último</small> }
                                            @if (it.ValorUnitarioFinal > 0)
                                            {
                                                <br /><label class="check fonte-12"><input type="radio" name="@($"venc-{primeiro.Id}")" checked="@it.Vencedor" disabled="@(!Editavel)" @onchange="() => Vencer(it)" /> vencer</label>
                                                @if (it.Vencedor && Editavel) {
                                                    <input type="number" class="mt-4" step="0.001" min="0" max="@it.Quantidade"
                                                        title="Quantidade que este fornecedor atende (vazio = toda)" placeholder="qtd. toda"
                                                        value="@it.QuantidadeVencida" @onchange="e => DefinirQtd(it, e.Value)"
                                                        aria-label="@($"Quantidade vencida – {primeiro.Descricao}")" />
                                                }
                                                else if (it.Vencedor && it.QuantidadeVencida is { } qv) { <small>só @Num(qv, 3)</small> }
                                            }</td>
                                    }
                                    <td class="num">@(menor > 0 ? Moeda(menor) : "—")</td>
                                </tr>
                                @if (aberto) { <tr class="linha-locais" @key="(primeiro.Id, 1)"><td colspan="@(6 + 3 * forns.Count)"><PainelLocais Linhas="locaisItem!" Unidade="@primeiro.Unidade" /></td></tr> }
                            }
                        </tbody>
                        <tfoot>
                            <tr class="peso-600"><td colspan="5">Total dos itens</td>
                                @foreach (var f in forns) { <td colspan="2"></td><td class="num">@Moeda(_c.Itens.Where(i => i.FornecedorId == f.FornecedorId).Sum(i => i.ValorTotal))</td> }<td class="num">@Moeda(MelhorPorItem)</td></tr>
                        </tfoot>
                    </table>
                </div>
                <datalist id="mapa-marcas">@foreach (var nomeMarca in _marcas) { <option>@nomeMarca</option> }</datalist>
                @if (_c.VencedorPorItem && _grupos.Any(g => !g.Any(i => i.Vencedor))) { <div class="alerta aviso"><Icone Nome="alerta" /> @_grupos.Count(g => !g.Any(i => i.Vencedor)) item(ns) sem vencedor: ficam como "a pedir" na requisição.</div> }
                <p class="mudo">Vencedor item a item: cada fornecedor vencedor recebe um pedido com os itens dele; quantidade menor que a do item (fornecedor só atende parte) devolve o resto para "a pedir". Sem marcação item a item, vale o vencedor geral da cotação.
                    Marca obrigatória em cada item de material com preço (vai para o pedido). Verde = menor valor do item (negociado, se houver). Valores preenchidos pelo fornecedor na Área do Fornecedor entram aqui sozinhos; os demais são lançados nesta tela.</p>

                <AnaliseIaCotacao Cotacao="_c" AntesDeAnalisar="SalvarAntesDaIa" AoConcluir="Carregar" />
            }
        </div>
    </ChildContent>
    <Faixa><b>Mapa comparativo</b><span>Referência · último · ofertado · negociado</span><span>Economia e análise por IA</span><span>Excel e impressão/PDF pelo navegador</span></Faixa>
</Pagina>
