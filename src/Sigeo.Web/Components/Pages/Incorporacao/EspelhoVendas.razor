@page "/incorporacao/espelho"
@inherits PaginaBase
@using Sigeo.Domain.Incorporacao
@inject IncorporacaoServico Inc
@inject NavigationManager Nav

<Pagina Titulo="Espelho de vendas" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="barra-filtro"><SeletorObra Id="esp-obra" Valor="_obraId" ValorChanged="async v => { _obraId = v; await Carregar(); }" Inicial="ObraQuery" /></div>
            @if (_obraId is null) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra.</div> }
            else
            {
                <div class="kpis">
                    <Kpi Rotulo="VGV total" Valor="@Moeda(_painel?.Vgv)" Tom="info" Sub="vendido + estoque a preço de tabela" />
                    <Kpi Rotulo="VGV vendido" Valor="@Moeda(_painel?.VgvVendido)" Tom="ok" Sub="@($"{_painel?.Vendidas} de {_painel?.Unidades} unidades")" />
                    <Kpi Rotulo="Estoque (tabela)" Valor="@Moeda(_painel?.VgvEstoque)" Sub="@($"{_painel?.Disponiveis} disponíveis")" />
                    <Kpi Rotulo="% vendido" Valor="@(_painel is { Unidades: > 0 } p ? (p.Vendidas * 100m / p.Unidades).ToString("N1", Br) + "%" : "—")" />
                </div>
                <div class="acoes-pagina">
                    <button class="btn sec" id="esp-gerar" disabled="@Ocupado" @onclick="Gerar" title="Cria a unidade comercial para cada apartamento/casa da estrutura da obra"><Icone Nome="raio" Tam="16" /> Gerar unidades da estrutura</button>
                    <button class="btn sec" id="esp-reajustar" @onclick="() => { ErrosForm = null; _reaj = true; }"><Icone Nome="calculadora" Tam="16" /> Reajustar tabela</button>
                    <button class="btn sec" @onclick="@(() => Nav.NavigateTo($"incorporacao/vendas?obra={_obraId}"))"><Icone Nome="contrato" Tam="16" /> Vendas e contratos</button>
                </div>
                <div class="legenda-esp">
                    @foreach (var s in Enum.GetValues<SituacaoUnidade>()) { <span class="chip-esp @Cor(s)">@NomesVenda.Situacao(s) (@_unidades.Count(u => u.Situacao == s))</span> }
                </div>
                @if (_unidades.Count == 0) { <div class="alerta info"><Icone Nome="info" /> Sem unidades. Gere a estrutura da obra (torres, pavimentos e apartamentos) e clique em "Gerar unidades da estrutura".</div> }
                @foreach (var torre in _unidades.GroupBy(u => u.Torre ?? "Unidades"))
                {
                    <h3 class="mt-12">@torre.Key</h3>
                    <div class="espelho">
                        @foreach (var pav in torre.GroupBy(u => (u.OrdemPavimento, u.Pavimento ?? "")).OrderByDescending(g => g.Key.OrdemPavimento))
                        {
                            <div class="esp-linha"><div class="esp-pav">@pav.Key.Item2</div>
                                @foreach (var u in pav.OrderBy(u => u.Ordem).ThenBy(u => u.Unidade))
                                {
                                    var un = u;
                                    <button class="esp-unid @Cor(un.Situacao)" title="@($"{un.Unidade} · {NomesVenda.Situacao(un.Situacao)}{(un.Comprador is null ? "" : " · " + un.Comprador)}")" @onclick="() => Abrir(un)">
                                        <b>@un.Unidade</b><small>@(un.ValorVenda is { } v ? v.ToString("N0", Br) : un.PrecoTabela > 0 ? un.PrecoTabela.ToString("N0", Br) : "sem preço")</small>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </ChildContent>
</Pagina>

<Modal @bind-Aberto="_aberto" Titulo="@($"Unidade {_u?.Unidade}")" Tamanho="pequena">
    <ChildContent>
        @if (_u is not null)
        {
            <Erros Lista="ErrosForm" />
            <p class="mudo">@_u.Torre · @_u.Pavimento @(_u.Tipologia is null ? "" : $"· {_u.Tipologia}") @(_u.Area is { } a ? $"· {a:N2} m²" : "")</p>
            @if (_u.ContratoId is not null) { <div class="alerta info"><Icone Nome="info" /> Vendida para @_u.Comprador por @Moeda(_u.ValorVenda). <a href="@($"incorporacao/vendas?obra={_obraId}&contrato={_u.ContratoId}")">Abrir contrato</a></div> }
            <div class="form">
                <Campo Rotulo="Preço de tabela" Classe="s6"><input id="esp-preco" type="number" step="0.01" @bind="_preco" /></Campo>
                <Campo Rotulo="Situação" Classe="s6"><select id="esp-sit" @bind="_sit"
                        disabled="@(_u.ContratoId is not null)">@foreach (var s in Enum.GetValues<SituacaoUnidade>().Where(s => _u.ContratoId is not null
                                || s is not (SituacaoUnidade.Vendida or SituacaoUnidade.Permuta))) {
                            <option value="@s">@NomesVenda.Situacao(s)</option>
                        }</select></Campo>
                <Campo Rotulo="Vagas / box" Classe="s6"><input @bind="_vagas" maxlength="60" /></Campo>
                <Campo Rotulo="Observação" Classe="s12"><input @bind="_obs" /></Campo>
            </div>
        }
    </ChildContent>
    <Rodape>
        @if (_u?.ContratoId is null) { <button class="btn sec" @onclick="@(() => Nav.NavigateTo($"incorporacao/vendas?obra={_obraId}&unidade={_u?.Id}"))"><Icone Nome="contrato" Tam="16" /> Vender</button> }
        <button class="btn prim" id="esp-salvar" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="16" /> Salvar</button>
    </Rodape>
</Modal>

<Modal @bind-Aberto="_reaj" Titulo="Reajustar tabela" Tamanho="pequena">
    <ChildContent>
        <Erros Lista="ErrosForm" />
        <p>Aplica o percentual no preço das unidades disponíveis e reservadas (vendidas não mudam).</p>
        <Campo Rotulo="Percentual (%)"><input id="reaj-perc" type="number" step="0.01" @bind="_perc" /></Campo>
    </ChildContent>
    <Rodape><button class="btn prim" id="reaj-ok" disabled="@Ocupado" @onclick="Reajustar">Aplicar</button></Rodape>
</Modal>


@code {
    [SupplyParameterFromQuery(Name = "obra")] public Guid? ObraQuery { get; set; }
    private Guid? _obraId;
    private List<LinhaUnidade> _unidades = [];
    private PainelVendas? _painel;
    private LinhaUnidade? _u;
    private bool _aberto, _reaj;
    private decimal _preco, _perc;
    private SituacaoUnidade _sit;
    private string? _vagas, _obs;

    private static string Cor(SituacaoUnidade s) => s switch
    {
        SituacaoUnidade.Disponivel => "s-disp", SituacaoUnidade.Reservada => "s-res", SituacaoUnidade.Proposta => "s-prop",
        SituacaoUnidade.Vendida => "s-vend", SituacaoUnidade.Permuta => "s-perm", _ => "s-bloq"
    };

    private async Task Carregar()
    {
        if (_obraId is not { } o) { _unidades = []; _painel = null; return; }
        _unidades = await Inc.EspelhoAsync(o, Cancelamento);
        _painel = await Inc.PainelAsync(o, Cancelamento);
    }

    private async Task Gerar()
    {
        if (_obraId is not { } o) return;
        var n = 0;
        if (await Executar(async () => n = await Inc.GerarUnidadesAsync(o, Cancelamento))) { Notif.Sucesso(n == 0 ? "Todas as unidades já existem." : $"{n} unidades criadas."); await Carregar(); }
    }

    private void Abrir(LinhaUnidade u) { ErrosForm = null; _u = u; _preco = u.PrecoTabela; _sit = u.Situacao; _vagas = null; _obs = null; _aberto = true; }

    private async Task Salvar()
    {
        if (_u is null) return;
        if (await Executar(() => Inc.SalvarUnidadeAsync(_u.Id, _preco, _sit, _vagas, _obs, Cancelamento), "Unidade salva.")) { _aberto = false; await Carregar(); }
    }

    private async Task Reajustar()
    {
        if (_obraId is not { } o) return;
        var n = 0;
        if (await Executar(async () => n = await Inc.ReajustarTabelaAsync(o, _perc, Cancelamento))) { Notif.Sucesso($"{n} unidades reajustadas."); _reaj = false; await Carregar(); }
    }
}
