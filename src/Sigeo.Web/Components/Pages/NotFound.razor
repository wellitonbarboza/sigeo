@page "/not-found"
@layout MainLayout
@inject NavigationManager Nav

@if (!_recarregando)
{
    <PageTitle>Página não encontrada · SIGEO</PageTitle>
    <h1>Página não encontrada</h1>
    <p>O endereço não existe ou foi alterado. Use o menu ao lado.</p>
}

@code {
    private bool _recarregando;

    // Tela que roda no navegador aberta por código a partir de uma tela do servidor: recarrega para o servidor entregá-la.
    protected override void OnInitialized()
    {
        var caminho = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0];
        if (Sigeo.Web.Client.RotasNavegador.Atende(caminho)) { _recarregando = true; Nav.NavigateTo(Nav.Uri, forceLoad: true, replace: true); }
    }
}
