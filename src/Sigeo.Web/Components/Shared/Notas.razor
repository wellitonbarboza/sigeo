@* Notas do registro: histórico de comentários (data/hora + usuário), imutável — padrão "NOTAS" do ExpertData. *@
@inject ColaboracaoServico Colab
@inject MensagensServico Mensagens
@inject Notificacoes Notif
@implements IDisposable

<div class="secao"><Icone Nome="info" /> @Titulo <small class="mudo">(@_itens.Count)</small></div>
@if (!SomenteLeitura)
{
    <div class="nota-nova">
        <textarea @bind="_texto" @bind:event="oninput" placeholder="Escreva uma nota (fica registrada com seu nome e a data/hora — não pode ser editada)" rows="2" maxlength="4000"></textarea>
        <button class="btn sec pq" disabled="@(_ocupado || string.IsNullOrWhiteSpace(_texto))" @onclick="Adicionar"><Icone Nome="check" Tam="14" /> Nova nota</button>
    </div>
}
@if (_itens.Count == 0) { <div class="mudo vazio-curto">Nenhuma nota.</div> }
else
{
    <ul class="notas">
        @foreach (var n in _itens)
        {
            <li><div class="nota-cab"><b>@n.CriadoPor</b> <span class="mudo">@Rotulos.DataHora(n.CriadoEm)</span></div><div class="nota-txt">@n.Texto</div></li>
        }
    </ul>
}
@if (_comMensagens)
{
    <div class="secao"><Icone Nome="mensagem" /> Mensagens deste registro <small class="mudo">(@_conversas.Count)</small>
        <span class="acao"><button type="button" class="btn sec pq" @onclick="() => _nova = true"><Icone Nome="mais" Tam="14" /> Mensagem sobre este registro</button></span></div>
    @if (_conversas.Count == 0) { <div class="mudo vazio-curto">Nenhuma conversa sua ligada a este registro.</div> }
    else
    {
        <ul class="conversas-reg">
            @foreach (var c in _conversas)
            {
                <li @key="c.Id"><a href="mensagens?id=@c.Id"><b>@c.Assunto</b> @if (c.NaoLidas > 0) { <Selo Texto="@($"{c.NaoLidas} nova(s)")" Tom="erro" /> }</a>
                    <div class="mudo fonte-13">@c.UltimoAutor · @Rotulos.DataHora(c.UltimaEm) — @c.Previa</div></li>
            }
        </ul>
    }
    <NovaMensagem @bind-Aberto="_nova" RegistroEntidade="@Entidade" RegistroId="EntidadeId" AssuntoInicial="@($"Sobre {Sigeo.Application.Comum.RotasRegistro.Rotulo(Entidade)}")" AoEnviar="AoEnviarMensagem" />
}
@code {
    [Parameter] public string Entidade { get; set; } = "";
    [Parameter] public Guid EntidadeId { get; set; }
    [Parameter] public string Titulo { get; set; } = "Notas";
    [Parameter] public bool SomenteLeitura { get; set; }
    private List<Nota> _itens = [];
    private string? _texto;
    private bool _ocupado;
    private Guid _carregado;
    // Cancela a consulta/gravação em andamento se o usuário sair da tela antes de terminar.
    private readonly CancellationTokenSource _cts = new();

    public void Dispose() => _cts.Cancel(); // não descarta a fonte: código que ainda está num await lê o token depois e precisa ver "cancelado", não ObjectDisposedException

    protected override async Task OnParametersSetAsync()
    {
        if (_carregado == EntidadeId) return;
        _carregado = EntidadeId;
        _itens = EntidadeId == Guid.Empty ? [] : await Colab.NotasAsync(Entidade, EntidadeId, _cts.Token);
        _comMensagens = !SemMensagens && EntidadeId != Guid.Empty && Sigeo.Application.Comum.RotasRegistro.Link(Entidade, EntidadeId) is not null;
        _conversas = _comMensagens ? await Mensagens.DoRegistroAsync(Entidade, EntidadeId, _cts.Token) : [];
    }

    // Mensagens internas ligadas ao registro (só as conversas de que o usuário participa).
    [Parameter] public bool SemMensagens { get; set; }
    private bool _comMensagens, _nova;
    private List<MensagensServico.ResumoConversa> _conversas = [];

    private async Task AoEnviarMensagem(Guid _) => _conversas = await Mensagens.DoRegistroAsync(Entidade, EntidadeId, _cts.Token);

    private async Task Adicionar()
    {
        _ocupado = true;
        try
        {
            await Colab.AdicionarNotaAsync(Entidade, EntidadeId, _texto ?? "", _cts.Token);
            _texto = null;
            _itens = await Colab.NotasAsync(Entidade, EntidadeId, _cts.Token);
            Notif.Sucesso("Nota registrada.");
        }
        catch (RegraDeNegocioException e) { Notif.Erro(e.Message); }
        finally { _ocupado = false; }
    }
}
