@* Escolha de pessoas e grupos (perfil, obra) como "chips". Grupo vira as pessoas dele no envio. *@
<div class="chips" role="group" aria-label="@Rotulo">
    @foreach (var c in Selecionados)
    {
        <span class="chip" @key="c">@Texto(c) <button type="button" aria-label="@($"Remover {Texto(c)}")" @onclick="() => Remover(c)">×</button></span>
    }
    <select aria-label="@($"Adicionar em {Rotulo}")" value="" @onchange="Adicionar">
        <option value="">+ pessoa ou grupo…</option>
        @foreach (var g in Opcoes.Where(o => !Selecionados.Contains(o.Chave)).GroupBy(o => o.Grupo).OrderBy(g => g.Key == "Pessoas" ? 0 : 1))
        {
            <optgroup label="@g.Key">@foreach (var o in g) { <option value="@o.Chave">@o.Texto</option> }</optgroup>
        }
    </select>
</div>

@code {
    [Parameter] public string Rotulo { get; set; } = "Para";
    [Parameter] public IReadOnlyList<Sigeo.Application.Colaboracao.MensagensServico.Destinatario> Opcoes { get; set; } = [];
    [Parameter] public List<string> Selecionados { get; set; } = [];
    [Parameter] public EventCallback SelecionadosChanged { get; set; }

    private string Texto(string chave) => Opcoes.FirstOrDefault(o => o.Chave == chave)?.Texto.Split(" · ")[0] ?? chave;

    private async Task Adicionar(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } v && !Selecionados.Contains(v)) { Selecionados.Add(v); await SelecionadosChanged.InvokeAsync(); }
    }

    private async Task Remover(string c) { Selecionados.Remove(c); await SelecionadosChanged.InvokeAsync(); }
}
