<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>try { document.documentElement.dataset.tema = localStorage.getItem('qh.tema') || 'claro'; } catch { }</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/telas-cadastros-engenharia.css"]" />
    <link rel="stylesheet" href="@Assets["css/telas-suprimentos.css"]" />
    <link rel="stylesheet" href="@Assets["css/telas-qualidade.css"]" />
    <link rel="stylesheet" href="@Assets["QualyHub.Web.styles.css"]" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <ImportMap />
    <HeadOutlet @rendermode="ModoPagina" />
</head>
<body>
    @if (NoNavegador)
    {
        <QualyHub.Web.Client.RotasNavegador @rendermode="ModoPagina" />
    }
    else
    {
        <Routes @rendermode="ModoPagina" />
    }
    <ReconnectModal />
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    // Login e configuração inicial são páginas estáticas (postam formulário e gravam o cookie); o resto é interativo.
    // Sem pré-renderização: app interno autenticado não precisa de SEO, e com ela cada tela consultava o banco duas vezes
    // (uma para o HTML inicial e outra ao conectar o circuito) e o conteúdo piscava na troca.
    private static readonly IComponentRenderMode Interativo = new InteractiveServerRenderMode(prerender: false);
    // Telas que rodam no navegador (projeto QualyHub.Web.Client). Ir de uma tela do servidor para uma do navegador
    // (e vice-versa) recarrega a página: o roteador de cada lado só conhece as suas rotas e entrega a outra ao servidor.
    private static readonly IComponentRenderMode Navegador = new InteractiveWebAssemblyRenderMode(prerender: false);
    private bool NoNavegador => QualyHub.Web.Client.RotasNavegador.Atende(HttpContext.Request.Path);
    private IComponentRenderMode? ModoPagina => !HttpContext.AcceptsInteractiveRouting() ? null : NoNavegador ? Navegador : Interativo;
}
