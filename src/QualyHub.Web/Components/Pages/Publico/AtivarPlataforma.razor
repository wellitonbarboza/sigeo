@page "/plataforma/ativar"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout LayoutPublico
@inject UsuarioAtualWeb Atual

<PageTitle>Administrador da plataforma · QualyHub</PageTitle>
<div class="login">
    <div class="caixa">
        <div class="login-marca"><Logo /></div>
        <h1>Administrador da plataforma</h1>
        <p class="mudo">@Atual.Nome, informe o código da plataforma para administrar construtoras, usuários entre construtoras e o acesso de suporte. A ativação fica registrada na auditoria.</p>
        @if (Erro is not null) { <div class="alerta erro">@(Erro switch { "codigo" => "Código inválido.", "sem-codigo" => "O código da plataforma não está configurado (segredo CodigoPlataforma no Key Vault).", _ => "A página ficou aberta por muito tempo. Tente de novo." })</div> }
        <form method="post" action="plataforma/ativar/salvar" class="form mt-14">
            <AntiforgeryToken />
            <div class="campo s12"><label for="codigo">Código da plataforma</label><input id="codigo" name="codigo" type="password" autocomplete="off" /><span class="ajuda">Segredo "CodigoPlataforma" do Key Vault (o mesmo usado para criar construtoras).</span></div>
            <div class="campo s12 botoes-dir"><a class="btn sec" href="">Voltar</a><button class="btn prim" type="submit" id="ativar">Ativar</button></div>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Erro { get; set; }
}
