@page "/fornecedores"
@inherits PaginaBase
@inject NavigationManager Nav
@inject QualyHub.Infrastructure.Importacao.ImportadorFornecedoresExpertData ImpExpert
@inject FornecedoresServico Forn

<Pagina Titulo="Fornecedores" Grade="_grade" AoNovo="Novo" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="kpis">
                <Kpi Rotulo="Ativos" Valor="@_itens?.Count(f => f.Ativo)" Sub="fornecedores" />
                <Kpi Rotulo="Qualificados" Valor="@_itens?.Count(f => f.StatusQualificacao == StatusQualificacao.Qualificado)" Tom="ok" />
                <Kpi Rotulo="Qualificação vencida" Valor="@_itens?.Count(f => f.StatusQualificacao == StatusQualificacao.Vencida)" Sub="reconsultar" Tom="erro" />
                <Kpi Rotulo="Sem e-mail" Valor="@_itens?.Count(f => string.IsNullOrWhiteSpace(f.Emails))" Sub="bloqueia envio de pedido" Tom="aviso" />
            </div>
            <div class="barra-acoes">
                <button class="btn prim pq" id="pre-cadastro" @onclick="NovoPre"><Icone Nome="enviar" Tam="14" /> Pré-cadastro + link para o fornecedor</button>
                <a class="btn sec pq" href="fornecedores/exigencias"><Icone Nome="tabela" Tam="14" /> Matriz de documentos</a>
                <label class="btn sec pq arquivo cursor-mao" title="Planilha de fornecedores (.xlsx, 1ª linha com CPF / CNPJ, NOME, FANTASIA, CIDADE, UF, BAIRRO, TELEFONES, E-MAILS…). Sem CPF/CNPJ entra bloqueado para compra."><Icone Nome="upload" Tam="14" /> Importar planilha<InputFile OnChange="Prever" accept=".xlsx" class="so-leitor" /></label>
            </div>
            <Grade T="Fornecedor" @ref="_grade" Itens="_itens" AoClicar="Editar" NomeExportacao="fornecedores" CriadoPor="f => f.CriadoPor">
                <Acoes><button title="Editar" @onclick="() => Editar(context)"><Icone Nome="editar" Tam="16" /></button><button title="Qualificação" @onclick='() => Nav.NavigateTo($"fornecedores/qualificacao?f={context.Id}")'><Icone Nome="selo" Tam="16" /></button></Acoes>
                <Colunas>
                    <Coluna T="Fornecedor" Titulo="CPF / CNPJ" Valor="f => f.CpfCnpj" Largura="150px" />
                    <Coluna T="Fornecedor" Titulo="Razão social" Valor="f => f.RazaoSocial" />
                    <Coluna T="Fornecedor" Titulo="Fantasia" Valor="f => f.NomeFantasia" />
                    <Coluna T="Fornecedor" Titulo="Cidade / UF" Valor='f => f.Cidade == null ? null : $"{f.Cidade}/{f.Uf}"' />
                    <Coluna T="Fornecedor" Titulo="Tipo de fornecimento" Valor="f => f.TipoFornecimento" />
                    <Coluna T="Fornecedor" Titulo="Status de qualificação" Valor="f => f.StatusQualificacao"><Modelo><Selo Texto="@De(context.StatusQualificacao)" Tom="@Tom(context.StatusQualificacao)" /></Modelo></Coluna>
                    <Coluna T="Fornecedor" Titulo="Nota média" Valor="f => f.NotaMedia" Alinhar="num" />
                    <Coluna T="Fornecedor" Titulo="Ativo" Valor="f => f.Ativo" />
                    <Coluna T="Fornecedor" Titulo="Pré-cadastro" Valor="f => f.PreCadastro" />
                    <Coluna T="Fornecedor" Titulo="Telefones" Valor="f => f.Telefones" Visivel="false" />
                    <Coluna T="Fornecedor" Titulo="E-mails" Valor="f => f.Emails" Visivel="false" />
                    <Coluna T="Fornecedor" Titulo="Porte" Valor="f => f.Porte" Visivel="false" />
                    <Coluna T="Fornecedor" Titulo="Situação cadastral" Valor="f => f.SituacaoCadastral" Visivel="false" />
                    <Coluna T="Fornecedor" Titulo="CNAE" Valor="f => f.Cnae" Visivel="false" />
                    <Coluna T="Fornecedor" Titulo="Capital social" Valor="f => f.CapitalSocial" Formato="C2" Alinhar="num" Visivel="false" />
                    <Coluna T="Fornecedor" Titulo="Fundação" Valor="f => f.DataFundacao" Visivel="false" />
                    <Coluna T="Fornecedor" Titulo="MEI" Valor="f => f.Mei" Visivel="false" />
                    <Coluna T="Fornecedor" Titulo="Origem" Valor="f => f.OrigemSistema" Visivel="false" />
                    <Coluna T="Fornecedor" Titulo="Criado por" Valor="f => f.CriadoPor" Visivel="false" />
                    <Coluna T="Fornecedor" Titulo="Criado em" Valor="f => f.CriadoEm" Visivel="false" />
                </Colunas>
            </Grade>
        </div>
    </ChildContent>
    <Faixa><b>Fornecedores</b><span>Cadastro (dados da Receita) + tipo de fornecimento + status de qualificação</span><span>Desqualificado = inativo · e-mail obrigatório para envio de pedido</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_aberto" Titulo="@(_novo ? "Novo fornecedor" : "Fornecedor")">
    <ChildContent>
        @if (_f is not null)
        {
            <Erros Lista="ErrosForm" />
            @if (_f.PreCadastro) { <div class="alerta aviso"><Icone Nome="info" /> Pré-cadastro: o fornecedor completa os dados e envia os documentos pelo link. Desmarque "pré-cadastro" depois de conferir.</div> }
            <Abas Itens="_abasF" @bind-Ativa="_abaF" />
            @if (_abaF == "grupos")
            {
                <div class="secao"><Icone Nome="caixa" /> Grupos do catálogo que atende <span class="acao"><button class="btn sec pq" @onclick="() => _f.Grupos.Add(new FornecedorGrupo { FornecedorId = _f.Id })"><Icone Nome="mais" Tam="14" /> Grupo</button></span></div>
                <table class="itens" id="forn-grupos"><thead><tr><th>Grupo</th><th>Subgrupos (vazio = todos)</th><th></th></tr></thead>
                    <tbody>@foreach (var g in _f.Grupos)
                    {
                        <tr @key="g"><td><select value="@g.CategoriaProdutoId" @onchange="e => TrocarGrupo(g, e.Value?.ToString())"><option value="@Guid.Empty">—</option>@foreach (var x in _cats.Where(c => c.PaiId == null)) { <option value="@x.Id">@x.Nome</option> }</select></td>
                            <td>@foreach (var sg in _cats.Where(c => c.PaiId == g.CategoriaProdutoId)) { <label class="check-linha mr-10"><input type="checkbox" checked="@((g.Subgrupos ?? "").Contains(sg.Id.ToString()))" @onchange="e => MarcarSub(g, sg.Id, (bool)e.Value!)" /> @sg.Nome</label> }
                                @if (g.Todos) { <span class="mudo">todos os subgrupos</span> }</td>
                            <td><button class="icone-btn" @onclick="() => _f.Grupos.Remove(g)"><Icone Nome="lixeira" Tam="16" /></button></td></tr>
                    }
                    @if (_f.Grupos.Count == 0) { <tr><td colspan="3" class="mudo">Ligue o fornecedor aos grupos do catálogo — ele aparece como sugerido nas cotações desses materiais.</td></tr> }</tbody></table>
                <div class="secao"><Icone Nome="escudo-check" /> Serviços que executa (ITS)</div>
                <div class="checks quebra">@foreach (var sv in _servicosIts) { <label class="larg-min-260"><input type="checkbox" checked="@_f.Servicos.Any(x => x.ServicoControladoId == sv.Id)" @onchange="e => MarcarIts(sv.Id, (bool)e.Value!)" /> @sv.Texto</label> }</div>
            }
            else if (_abaF == "docs")
            {
                <div class="form">
                    <Campo Rotulo="" Classe="s6"><label><input type="checkbox" @bind="_f.IncluirDocsFuncionarios" /> Exigir documentos dos funcionários (presta serviço na obra)</label></Campo>
                    <Campo Rotulo="" Classe="s6"><button class="btn sec pq" @onclick="AplicarMatriz"><Icone Nome="atualizar" Tam="14" /> Aplicar a matriz pelo tipo de fornecimento</button></Campo>
                </div>
                <ListaExigencias Tipos="_tiposDoc" Fornecedor="_f" />
                <p class="mudo">Sem nenhum marcado, vale a matriz pelo tipo de fornecimento. Mensais: competência anterior até o dia limite (padrão 20) — sem eles a medição trava.</p>
            }
            else if (_abaF == "painel")
            {
                @if (_painel is null) { <div class="mudo">Salve o fornecedor para ver o painel.</div> }
                else
                {
                    <div class="kpis">
                        <Kpi Rotulo="Documentos válidos" Valor="@_painel.DocsValidos" Tom="ok" Sub="@($"{_painel.DocsEmValidacao} em validação")" />
                        <Kpi Rotulo="Pendentes / vencidos" Valor="@($"{_painel.DocsPendentes} / {_painel.DocsVencidos}")" Tom="@(_painel.DocsPendentes + _painel.DocsVencidos > 0 ? "erro" : "ok")" />
                        <Kpi Rotulo="FVM aprovadas (6 meses)" Valor="@(_painel.FvmAprovadasPerc is { } p ? $"{p:0}%" : "—")" Sub="@($"{_painel.Fvm} recebimentos")" Tom="info" />
                        <Kpi Rotulo="Nota média medições" Valor="@(_painel.NotaMedia?.ToString("0.0") ?? "—")" Tom="info" />
                    </div>
                    <div class="kpis">
                        <Kpi Rotulo="Qualificação vigente até" Valor="@(_painel.QualificacaoValidaAte?.ToString("dd/MM/yyyy") ?? (_painel.Qualificacoes > 0 ? "sem validade" : "—"))" />
                        <Kpi Rotulo="Pedidos" Valor="@_painel.Pedidos" Sub="@_painel.ValorPedidos.ToString("C0", Br)" />
                        <Kpi Rotulo="Contratos" Valor="@_painel.Contratos" Sub="@_painel.ValorContratos.ToString("C0", Br)" />
                        <Kpi Rotulo="Planos de ação abertos" Valor="@_painel.PlanosAbertos" Tom="@(_painel.PlanosAbertos > 0 ? "aviso" : "ok")" />
                    </div>
                    @if (_painel.MensaisPendentes.Count + _painel.Bloqueios.Count > 0)
                    {
                        <div class="alerta erro"><Icone Nome="x-circulo" /><div><b>Pendências que travam compra/medição</b><ul>@foreach (var b in _painel.Bloqueios.Concat(_painel.MensaisPendentes)) { <li>@b</li> }</ul></div></div>
                    }
                    else { <div class="alerta ok"><Icone Nome="check" /> Sem pendências que travem compra ou medição.</div> }
                    <div class="lado-a-lado"><a class="btn sec" href="fornecedores/documentos?f=@_f.Id">Documentos</a><a class="btn sec" href="fornecedores/qualificacao?f=@_f.Id">Qualificação</a><a class="btn sec" href="fornecedores/avaliacao">Avaliação</a></div>
                }
            }
            else
            {
            <div class="form">
                <Campo Rotulo="CPF / CNPJ" Obrigatorio Classe="s3"><input @bind="_f.CpfCnpj" placeholder="00.000.000/0000-00" /></Campo>
                <Campo Rotulo="Razão social / nome" Obrigatorio Classe="s6"><input @bind="_f.RazaoSocial" /></Campo>
                <Campo Rotulo="Nome fantasia" Classe="s3"><input @bind="_f.NomeFantasia" /></Campo>
                <Campo Rotulo="Inscrição estadual" Classe="s3"><input @bind="_f.InscricaoEstadual" /></Campo>
                <Campo Rotulo="Inscrição municipal" Classe="s3"><input @bind="_f.InscricaoMunicipal" /></Campo>
                <Campo Rotulo="Porte" Classe="s3"><input @bind="_f.Porte" list="portes" /><datalist id="portes"><option>Micro Empresa</option><option>Pequeno Porte</option><option>Demais</option></datalist></Campo>
                <Campo Rotulo="Natureza jurídica" Classe="s4"><input @bind="_f.NaturezaJuridica" /></Campo>
                <Campo Rotulo="Situação cadastral (Receita)" Classe="s3"><input @bind="_f.SituacaoCadastral" list="situacoes" /><datalist id="situacoes"><option>Ativa</option><option>Suspensa</option><option>Inapta</option><option>Baixada</option><option>Nula</option></datalist></Campo>
                <Campo Rotulo="Capital social (R$)" Classe="s2"><input type="number" step="0.01" @bind="_f.CapitalSocial" /></Campo>
                <Campo Rotulo="Fundação" Classe="s3"><input type="date" @bind="_f.DataFundacao" /></Campo>
                <Campo Rotulo="CNAE principal" Classe="s9"><input @bind="_f.Cnae" /></Campo>
                <Campo Rotulo="Regime" Classe="s3"><div class="checks"><label><input type="checkbox" @bind="_f.OptanteSimples" /> Simples</label><label><input type="checkbox" @bind="_f.Mei" /> MEI</label></div></Campo>
                <Campo Rotulo="CEP" Classe="s2"><input @bind="_f.Cep" /></Campo>
                <Campo Rotulo="Endereço" Classe="s5"><input @bind="_f.Endereco" /></Campo>
                <Campo Rotulo="Número" Classe="s2"><input @bind="_f.Numero" /></Campo>
                <Campo Rotulo="Complemento" Classe="s3"><input @bind="_f.Complemento" /></Campo>
                <Campo Rotulo="Bairro" Classe="s4"><input @bind="_f.Bairro" /></Campo>
                <Campo Rotulo="Cidade" Classe="s6"><input @bind="_f.Cidade" /></Campo>
                <Campo Rotulo="UF" Classe="s2"><input @bind="_f.Uf" maxlength="2" /></Campo>
                <Campo Rotulo="Telefones" Classe="s4"><input @bind="_f.Telefones" /></Campo>
                <Campo Rotulo="Telefone 0800" Classe="s2"><input @bind="_f.Telefone0800" /></Campo>
                <Campo Rotulo="Site" Classe="s6"><input @bind="_f.Site" placeholder="https://" /></Campo>
                <Campo Rotulo="E-mails" Obrigatorio Classe="s6" Ajuda="Obrigatório para envio de pedido e contrato. Separe por ;"><input @bind="_f.Emails" /></Campo>
                <Campo Rotulo="Tipo de fornecimento" Obrigatorio Classe="s12">
                    <div class="checks">
                        @foreach (var t in Enum.GetValues<TipoFornecimento>().Where(t => t != TipoFornecimento.Nenhum))
                        {
                            <label><input type="checkbox" checked="@_f.TipoFornecimento.HasFlag(t)" @onchange="e => Marcar(t, (bool)e.Value!)" /> @De(t)</label>
                        }
                    </div>
                </Campo>
                <Campo Rotulo="Status de qualificação" Classe="s4" Ajuda="Calculado pela última qualificação"><input readonly value="@De(_f.StatusQualificacao)" /></Campo>
                <Campo Rotulo="Nota média (6 meses)" Classe="s4"><input readonly value="@Num(_f.NotaMedia)" /></Campo>
                <Campo Rotulo="Ativo" Classe="s4"><div class="checks"><label><input type="checkbox" @bind="_f.Ativo" /> Ativo</label><label><input type="checkbox" @bind="_f.PreCadastro" /> Pré-cadastro</label></div></Campo>
            </div>
            <div class="secao"><Icone Nome="pessoa" /> Contatos <span class="acao"><button class="btn sec pq" @onclick="() => _f.Contatos.Add(new FornecedorContato { FornecedorId = _f.Id, Principal = _f.Contatos.Count == 0 })"><Icone Nome="mais" Tam="14" /> Contato</button></span></div>
            @if (_f.Contatos.Count == 0) { <div class="mudo vazio-curto">Nenhum contato. Cadastre ao menos o comercial (recebe pedidos e cotações).</div> }
            else
            {
                <table class="itens"><thead><tr><th>Nome</th><th>Função / setor</th><th>Telefone</th><th>Celular</th><th>E-mail</th><th>Principal</th><th></th></tr></thead>
                    <tbody>@foreach (var c in _f.Contatos)
                    {
                        <tr @key="c"><td><input @bind="c.Nome" /></td><td><input @bind="c.Funcao" list="funcoesContato" /></td><td><input @bind="c.Telefone" /></td><td><input @bind="c.Celular" /></td><td><input @bind="c.Email" type="email" /></td>
                            <td class="texto-centro"><input type="checkbox" @bind="c.Principal" /></td><td><button class="btn sec pq" title="Remover" @onclick="() => _f.Contatos.Remove(c)"><Icone Nome="lixeira" Tam="14" /></button></td></tr>
                    }</tbody></table>
                <datalist id="funcoesContato"><option>Comercial</option><option>Financeiro</option><option>Técnico</option><option>Qualidade</option><option>Segurança do trabalho</option><option>Logística</option></datalist>
            }
            @if (_f.OrigemSistema is not null)
            {
                <p class="mudo mt-8">Origem: <b>@_f.OrigemSistema</b>@(_f.OrigemCriadoPor is null ? "" : $" · criado por {_f.OrigemCriadoPor}")@(_f.OrigemCriadoEm is { } oc ? $" em {oc:dd/MM/yyyy HH:mm}" : "")@(_f.OrigemAlteradoPor is null ? "" : $" · alterado por {_f.OrigemAlteradoPor}")@(_f.OrigemAlteradoEm is { } oa ? $" em {oa:dd/MM/yyyy HH:mm}" : "")</p>
            }
            }
        }
    </ChildContent>
    <Rodape>
        @if (!_novo) { <div class="esq"><button class="btn sec" id="forn-convite" title="Convida o fornecedor para a Área do Fornecedor (entra com CNPJ + código)" @onclick="() => AbrirConvite(AssuntoCadastro)"><Icone Nome="enviar" Tam="16" /> Enviar convite</button></div> }
        <BotaoExcluir Tipo="typeof(Fornecedor)" Id="@(_f?.CriadoEm == default ? Guid.Empty : _f.Id)" IdBotao="exc-f" AoExcluir="async () => { _aberto = false; await Carregar(); }" />
            <button class="btn prim" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="16" /> Salvar</button>
    </Rodape>
</Modal>

<Modal @bind-Aberto="_abertoPre" Titulo="Pré-cadastro de fornecedor" Tamanho="grande">
    <ChildContent>
        @if (_f is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="CNPJ" Obrigatorio Classe="s3"><input id="pre-cnpj" @bind="_f.CpfCnpj" placeholder="00.000.000/0000-00" /></Campo>
                <Campo Rotulo="Razão social" Obrigatorio Classe="s6"><input id="pre-razao" @bind="_f.RazaoSocial" /></Campo>
                <Campo Rotulo="E-mail do contato" Obrigatorio Classe="s3"><input id="pre-email" type="email" @bind="_f.Emails" /></Campo>
                <Campo Rotulo="Nome do contato (recebe o código de acesso)" Obrigatorio Classe="s6"><input id="pre-contato" @bind="_contatoPre.Nome" /></Campo>
                <Campo Rotulo="Celular (WhatsApp)" Classe="s3"><input id="pre-celular" type="tel" @bind="_contatoPre.Celular" placeholder="(00) 90000-0000" /></Campo>
                <Campo Rotulo="Fornece" Obrigatorio Classe="s12">
                    <div class="checks">
                        <label><input type="checkbox" id="pre-mat" checked="@_f.TipoFornecimento.HasFlag(TipoFornecimento.Material)" @onchange="async e => await MarcarPre(TipoFornecimento.Material, (bool)e.Value!)" /> Material</label>
                        <label><input type="checkbox" id="pre-serv" checked="@_f.TipoFornecimento.HasFlag(TipoFornecimento.ServicoObra)" @onchange="async e => await MarcarPre(TipoFornecimento.ServicoObra, (bool)e.Value!)" /> Serviço de obra</label>
                        @foreach (var t in new[] { TipoFornecimento.ServicoEspecializadoEngenharia, TipoFornecimento.Laboratorio, TipoFornecimento.Consultoria, TipoFornecimento.Locacao })
                        {
                            <label><input type="checkbox" checked="@_f.TipoFornecimento.HasFlag(t)" @onchange="async e => await MarcarPre(t, (bool)e.Value!)" /> @De(t)</label>
                        }
                        <label class="ml-18"><input type="checkbox" id="pre-func" checked="@_f.IncluirDocsFuncionarios" @onchange="async e => { _f.IncluirDocsFuncionarios = (bool)e.Value!; await AplicarMatriz(); }" /> Incluir documentos dos funcionários</label>
                    </div>
                </Campo>
            </div>
            <div class="secao"><Icone Nome="arquivo" /> Documentos que serão pedidos (da matriz — ajuste à vontade)</div>
            <ListaExigencias Tipos="_tiposDoc" Fornecedor="_f" />
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="pre-salvar" disabled="@Ocupado" @onclick="SalvarPre"><Icone Nome="enviar" Tam="16" /> Salvar e enviar convite</button></Rodape>
</Modal>

@if (_f is not null)
{
    <EnviarConvite @bind-Aberto="_abertoConvite" FornecedorId="_f.Id" Assunto="@_assuntoConvite" Endereco="@EnderecoArea" />
}

<Modal @bind-Aberto="_abertoImp" Titulo="Importar fornecedores — planilha ExpertData" Tamanho="grande">
    <ChildContent>
        @if (_previa is not null)
        {
            <div class="kpis">
                <Kpi Rotulo="Novos" Valor="@_previa.Novos" Tom="ok" />
                <Kpi Rotulo="Atualizar" Valor="@_previa.Atualizar" Tom="info" Sub="campo vazio não apaga dado" />
                <Kpi Rotulo="Sem alteração" Valor="@_previa.SemAlteracao" />
                <Kpi Rotulo="Com erro (ignorados)" Valor="@_previa.ComErro" Tom="@(_previa.ComErro > 0 ? "erro" : "ok")" />
            </div>
            <div class="alerta info"><Icone Nome="info" /> Tipo de fornecimento e qualificação não vêm da planilha: os novos entram "Em qualificação" e sem tipo — classifique depois. Fornecedor sem e-mail fica bloqueado para envio de pedido.</div>
            <div class="filtros-rapidos">@foreach (var f in new[] { "Todos", "Inserir", "Atualizar", "Erro" }) { <label><input type="radio" name="fimp" checked="@(_filtroImp == f)" @onchange="() => _filtroImp = f" /> @f</label> }</div>
            <div class="rolagem-360">
                <table class="itens"><thead><tr><th>Linha</th><th>CPF / CNPJ</th><th>Nome</th><th>Ação</th><th>Detalhe</th></tr></thead>
                    <tbody>@foreach (var l in _previa.Linhas.Where(l => _filtroImp == "Todos" || l.Acao == _filtroImp).Take(500))
                    {
                        <tr><td>@l.Linha</td><td>@l.Documento</td><td>@l.Nome</td><td><Selo Texto="@l.Acao" Tom="@(l.Acao switch { "Inserir" => "ok", "Atualizar" => "info", "Erro" => "erro", _ => "neutro" })" /></td><td class="mudo">@string.Join("; ", l.Erros.Concat(l.Alteracoes))</td></tr>
                    }</tbody></table>
            </div>
        }
    </ChildContent>
    <Rodape>
        @if (_previa is not null && _previa.Novos + _previa.Atualizar > 0) { <button class="btn prim" disabled="@Ocupado" @onclick="ConfirmarImportacao"><Icone Nome="check" Tam="16" /> Importar @(_previa.Novos + _previa.Atualizar) fornecedor(es)</button> }
    </Rodape>
</Modal>

@code {
    private bool _abertoImp;
    private byte[]? _arquivoImp;
    private QualyHub.Infrastructure.Importacao.PreviaImportacaoFornecedores? _previa;
    private string _filtroImp = "Todos";

    private async Task Prever(InputFileChangeEventArgs e)
    {
        await Executar(async () =>
        {
            if (e.File.Size > 20 * 1024 * 1024) throw new RegraDeNegocioException("Planilha acima de 20 MB.");
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(20 * 1024 * 1024).CopyToAsync(ms, Cancelamento);
            _arquivoImp = ms.ToArray();
            _previa = await ImpExpert.PreverAsync(new MemoryStream(_arquivoImp), ct: Cancelamento);
            _filtroImp = "Todos"; _abertoImp = true;
        });
    }

    private async Task ConfirmarImportacao()
    {
        (int Inseridos, int Atualizados) r = default;
        if (await Executar(async () => r = await ImpExpert.ImportarAsync(new MemoryStream(_arquivoImp!), ct: Cancelamento)))
        {
            Notif.Sucesso($"{r.Inseridos} fornecedor(es) incluído(s) e {r.Atualizados} atualizado(s).");
            _abertoImp = false; _previa = null; _arquivoImp = null;
            await Carregar();
        }
    }

    private Grade<Fornecedor>? _grade;
    private List<Fornecedor>? _itens;
    private Fornecedor? _f;
    private bool _aberto, _novo;
    private bool _abertoConvite;
    private string _assuntoConvite = "";
    private FornecedorContato _contatoPre = new();
    private const string AssuntoCadastro = "complete o cadastro e envie os documentos na Área do Fornecedor";
    private string EnderecoArea => $"{Nav.BaseUri}fornecedor?doc={new string((_f?.CpfCnpj ?? "").Where(char.IsDigit).ToArray())}";
    private void AbrirConvite(string assunto) { _assuntoConvite = assunto; _abertoConvite = true; }

    protected override Task OnInitializedAsync() => Carregar();

    private async Task Carregar()
    {
        await using var db = Fabrica.CriarLeitura();
        _itens = await db.Fornecedores.AsNoTracking().OrderBy(f => f.RazaoSocial).ToListAsync(Cancelamento);
    }

    private bool _abertoPre;
    private string _abaF = "dados";
    private static readonly List<(string, string)> _abasF = [("dados", "Dados e contatos"), ("grupos", "Grupos e serviços (ITS)"), ("docs", "Documentos exigidos"), ("painel", "Painel")];
    private List<CategoriaProduto> _cats = [];
    private List<Opcao> _servicosIts = [];
    private List<TipoDocumentoExigido> _tiposDoc = [];
    private PainelFornecedor? _painel;

    private async Task CarregarApoio()
    {
        await using var db = Fabrica.CriarLeitura();
        _cats = await db.CategoriasProduto.AsNoTracking().Where(c => c.Ativo).OrderBy(c => c.Nome).ToListAsync(Cancelamento);
        _servicosIts = await Cat.ServicosAsync();
        _tiposDoc = await db.TiposDocumento.AsNoTracking().Where(t => t.Ativo && t.AplicaA == AplicaA.Fornecedor).OrderBy(t => t.Categoria).ThenBy(t => t.Ordem).ThenBy(t => t.Nome).ToListAsync(Cancelamento);
    }

    private async Task Novo() { await CarregarApoio(); _f = new Fornecedor(); _novo = true; _painel = null; _abaF = "dados"; ErrosForm = null; _aberto = true; }
    private async Task NovoPre()
    {
        await CarregarApoio();
        _f = new Fornecedor { PreCadastro = true, TipoFornecimento = TipoFornecimento.Material };
        _contatoPre = new FornecedorContato { FornecedorId = _f.Id, Principal = true };
        _daMatriz.Clear();
        await AplicarMatriz();
        ErrosForm = null; _abertoPre = true;
    }
    private async Task Editar(Fornecedor f)
    {
        await CarregarApoio();
        await using var db = Fabrica.CriarLeitura();
        _f = await db.Fornecedores.AsNoTracking().Include(x => x.Contatos).Include(x => x.Grupos).Include(x => x.Servicos).Include(x => x.Exigencias).AsSplitQuery().FirstAsync(x => x.Id == f.Id, Cancelamento);
        _painel = await Forn.PainelAsync(f.Id, ct: Cancelamento);
        _novo = false; ErrosForm = null; _aberto = true;
    }

    private async Task MarcarPre(TipoFornecimento t, bool on)
    {
        _f!.TipoFornecimento = on ? _f.TipoFornecimento | t : _f.TipoFornecimento & ~t;
        await AplicarMatriz();
    }

    /// <summary>Documentos que entraram sozinhos pela matriz (os incluídos/ajustados à mão nunca são tirados).</summary>
    private readonly HashSet<Guid> _daMatriz = [];

    /// <summary>Mescla a matriz: mantém o que já está (com os ajustes manuais), acrescenta o que falta
    /// e só retira o que a própria matriz tinha incluído e deixou de valer para o tipo de fornecimento.</summary>
    private async Task AplicarMatriz()
    {
        var f = _f!;
        var m = await Forn.MatrizAsync(f.TipoFornecimento, f.IncluirDocsFuncionarios, ct: Cancelamento);
        var novos = m.Select(t => t.Id).ToHashSet();
        foreach (var x in f.Exigencias.Where(x => _daMatriz.Contains(x.TipoDocumentoExigidoId) && !novos.Contains(x.TipoDocumentoExigidoId)).ToList())
        { f.Exigencias.Remove(x); _daMatriz.Remove(x.TipoDocumentoExigidoId); }
        var existentes = f.Exigencias.Select(x => x.TipoDocumentoExigidoId).ToHashSet();
        foreach (var t in m.Where(t => !existentes.Contains(t.Id)))
        {
            f.Exigencias.Add(new FornecedorExigencia { FornecedorId = f.Id, TipoDocumentoExigidoId = t.Id, Obrigatorio = t.Obrigatorio });
            _daMatriz.Add(t.Id);
        }
    }

    private void TrocarGrupo(FornecedorGrupo g, string? v)
    {
        var novo = Guid.TryParse(v, out var id) ? id : Guid.Empty;
        if (novo == g.CategoriaProdutoId) return;
        g.CategoriaProdutoId = novo;
        g.Subgrupos = null; // subgrupos eram do grupo anterior
    }

    private void MarcarSub(FornecedorGrupo g, Guid sub, bool on)
    {
        var l = (g.Subgrupos ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (on) l.Add(sub.ToString()); else l.Remove(sub.ToString());
        g.Subgrupos = l.Count == 0 ? null : string.Join(',', l.Distinct());
    }

    private void MarcarIts(Guid id, bool on)
    {
        if (on && _f!.Servicos.All(x => x.ServicoControladoId != id)) _f.Servicos.Add(new FornecedorServico { FornecedorId = _f.Id, ServicoControladoId = id });
        else if (!on) foreach (var x in _f!.Servicos.Where(x => x.ServicoControladoId == id).ToList()) _f.Servicos.Remove(x);
    }

    private async Task SalvarPre()
    {
        var ok = await Executar(async () =>
        {
            // O contato do pré-cadastro é quem recebe o código de acesso à Área do Fornecedor.
            if (string.IsNullOrWhiteSpace(_contatoPre.Nome)) throw new RegraDeNegocioException("Informe o nome do contato.");
            _contatoPre.Email = _f!.Emails?.Split([';', ',', ' '], StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
            if (!_f.Contatos.Contains(_contatoPre)) _f.Contatos.Add(_contatoPre);
            await Forn.SalvarAsync(_f, ct: Cancelamento);
        }, "Pré-cadastro salvo.");
        if (!ok) return;
        await Carregar();
        _abertoPre = false;
        AbrirConvite("faça o pré-cadastro: complete os dados e envie os documentos na Área do Fornecedor");
    }
    private void Marcar(TipoFornecimento t, bool on) => _f!.TipoFornecimento = on ? _f.TipoFornecimento | t : _f.TipoFornecimento & ~t;

    private async Task Salvar()
    {
        _f!.Grupos = _f.Grupos.Where(g => g.CategoriaProdutoId != Guid.Empty).ToList();
        var ok = await Executar(() => Forn.SalvarAsync(_f, ct: Cancelamento), "Fornecedor salvo.");
        if (ok) { _aberto = false; await Carregar(); }
    }

}
