@page "/cadastros/obras"
@inherits PaginaBase
@inject QualidadeObraServico Qob

<Pagina Titulo="Obras e centros de custo" Grade="GradeAtual" AoNovo="Novo" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <Abas Itens="_abas" @bind-Ativa="_aba" />
            @if (_aba == "obras")
            {
                <Grade T="Obra" @ref="_gObras" Itens="_obras" AoClicar="AbrirObra" NomeExportacao="obras" CriadoPor="o => o.CriadoPor">
                    <Colunas>
                        <Coluna T="Obra" Titulo="Código" Valor="o => o.Codigo" Largura="100px" />
                        <Coluna T="Obra" Titulo="Obra" Valor="o => o.Nome" />
                        <Coluna T="Obra" Titulo="Empresa / SPE" Valor="o => o.EmpresaSpe" />
                        <Coluna T="Obra" Titulo="Endereço de entrega" Valor="o => o.EnderecoEntrega" />
                        <Coluna T="Obra" Titulo="Eng. responsável" Valor="o => NomeU(o.EngenheiroId)" />
                        <Coluna T="Obra" Titulo="Almoxarife" Valor="o => NomeU(o.AlmoxarifeId)" />
                        <Coluna T="Obra" Titulo="Centros de custo" Valor="o => _ccs?.Count(c => c.ObraId == o.Id)" Alinhar="num" />
                        <Coluna T="Obra" Titulo="Status" Valor="o => o.Status"><Modelo><Selo Texto="@De(context.Status)" Tom="@Tom(context.Status)" /></Modelo></Coluna>
                    </Colunas>
                </Grade>
            }
            else if (_aba == "cc")
            {
                <Grade T="CentroCusto" @ref="_gCc" Itens="_ccs" AoClicar="c => { _c = c; ErrosForm = null; _abertoCc = true; }" NomeExportacao="centros-custo" CriadoPor="c => c.CriadoPor">
                    <Colunas>
                        <Coluna T="CentroCusto" Titulo="Código / etapa" Valor="c => c.Codigo" Largura="110px" />
                        <Coluna T="CentroCusto" Titulo="Centro de custo" Valor="c => c.Nome" />
                        <Coluna T="CentroCusto" Titulo="Obra" Valor='c => c.ObraId == null ? "(corporativo)" : _obras?.FirstOrDefault(o => o.Id == c.ObraId)?.Nome' />
                        <Coluna T="CentroCusto" Titulo="Orçamento" Valor="c => c.Orcamento" Formato="C2" Alinhar="num" />
                        <Coluna T="CentroCusto" Titulo="Comprometido" Valor="c => _comprometido.GetValueOrDefault(c.Id)" Formato="C2" Alinhar="num" />
                        <Coluna T="CentroCusto" Titulo="Saldo" Valor="c => c.Orcamento == null ? (decimal?)null : c.Orcamento - _comprometido.GetValueOrDefault(c.Id)" Formato="C2" Alinhar="num" />
                        <Coluna T="CentroCusto" Titulo="Ativo" Valor="c => c.Ativo" />
                    </Colunas>
                </Grade>
            }
            else
            {
                <div class="barra-filtro">
                    <label>Obra <select value="@_obraLocais" @onchange="async e => { _obraLocais = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; await CarregarLocais(); }"><option value="">Selecione…</option>@foreach (var o in _obras ?? []) { <option value="@o.Id">@o.Nome</option> }</select></label>
                    @if (_obraLocais is not null)
                    {
                        <label>Gerar torre <input @bind="_gTorre" placeholder="Torre 1" style="width:120px" /></label>
                        <label>Pavimentos <input type="number" @bind="_gPav" style="width:80px" /></label>
                        <label style="flex-direction:row;align-items:center;gap:6px;text-transform:none"><input type="checkbox" @bind="_gTerreo" /> térreo</label>
                        <button class="btn sec" disabled="@Ocupado" @onclick="GerarLocais"><Icone Nome="mais" Tam="14" /> Gerar</button>
                        <button class="btn sec" @onclick="NovoLocal"><Icone Nome="mais" Tam="14" /> Local</button>
                    }
                </div>
                <Grade T="Local" @ref="_gLoc" Itens="_locais" AoClicar="l => { _l = l; ErrosForm = null; _abertoLoc = true; }" NomeExportacao="locais">
                    <Acoes><a title="QR do local (abre a FVS no celular)" href="campo/local/@context.QrToken" target="_blank" data-enhance-nav="false"><Icone Nome="qr" Tam="16" /></a></Acoes>
                    <Colunas>
                        <Coluna T="Local" Titulo="Código" Valor="l => l.Codigo" Largura="110px" />
                        <Coluna T="Local" Titulo="Descrição" Valor="l => l.Nome" />
                        <Coluna T="Local" Titulo="Nível" Valor="l => l.Tipo" />
                        <Coluna T="Local" Titulo="Pai" Valor="l => l.LocalPaiId == null ? null : _locais!.FirstOrDefault(x => x.Id == l.LocalPaiId)?.Codigo" />
                        <Coluna T="Local" Titulo="Qtd. ref." Valor='l => l.Quantidade == null ? null : $"{l.Quantidade:0.##} {l.Unidade}"' />
                    </Colunas>
                </Grade>
            }
        </div>
    </ChildContent>
    <Faixa><b>Tela 27 · Obras e centros de custo</b><span>Obra define endereço, aprovador de 1º nível (engenheiro) e almoxarife</span><span>Locais (Q03): árvore torre › pavimento › unidade — base do mapa de inspeções e da medição</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_abertoObra" Titulo="@($"Obra — {_o?.Nome}")">
    <ChildContent>
        @if (_o is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Código" Obrigatorio Classe="s2"><input @bind="_o.Codigo" /></Campo>
                <Campo Rotulo="Nome da obra" Obrigatorio Classe="s5"><input @bind="_o.Nome" /></Campo>
                <Campo Rotulo="Empresa / SPE" Classe="s3"><input @bind="_o.EmpresaSpe" /></Campo>
                <Campo Rotulo="Status" Classe="s2"><select @bind="_o.Status">@foreach (var s in Enum.GetValues<StatusObra>()) { <option value="@s">@De(s)</option> }</select></Campo>
                <Campo Rotulo="Endereço de entrega padrão" Obrigatorio Classe="s8"><input @bind="_o.EnderecoEntrega" /></Campo>
                <Campo Rotulo="Início" Classe="s2"><input type="date" @bind="_o.DataInicio" /></Campo>
                <Campo Rotulo="Término previsto" Classe="s2"><input type="date" @bind="_o.DataPrevistaTermino" /></Campo>
                <Campo Rotulo="Cidade" Classe="s4"><input @bind="_o.Cidade" /></Campo>
                <Campo Rotulo="UF" Classe="s1"><input @bind="_o.Uf" maxlength="2" /></Campo>
                <Campo Rotulo="Código no ERP" Classe="s3"><input @bind="_o.CodigoObraPrima" /></Campo>
                <Campo Rotulo="" Classe="s4"><label><input type="checkbox" @bind="_o.Ativa" /> Ativa</label></Campo>
                <Campo Rotulo="Engenheiro responsável (1º nível)" Obrigatorio Classe="s3"><select @bind="_o.EngenheiroId"><option value="">—</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                <Campo Rotulo="Administrativo de obra" Classe="s3"><select @bind="_o.AdministrativoId"><option value="">—</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                <Campo Rotulo="Almoxarife" Classe="s3"><select @bind="_o.AlmoxarifeId"><option value="">—</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                <Campo Rotulo="PQO (Plano da Qualidade)" Classe="s3"><select @bind="_o.PqoDocumentoId"><option value="">—</option>@foreach (var d in _docs) { <option value="@d.Id">@d.Texto</option> }</select></Campo>
            </div>
            @if (_o.CriadoEm != default)
            {
                <div class="secao"><Icone Nome="tabela" /> Centros de custo / etapas</div>
                <table class="itens"><thead><tr><th>Código</th><th>Centro de custo</th><th class="num">Orçamento</th><th class="num">Comprometido</th><th class="num">Saldo</th></tr></thead>
                    <tbody>@foreach (var c in _ccs!.Where(c => c.ObraId == _o.Id)) { var cp = _comprometido.GetValueOrDefault(c.Id); <tr><td>@c.Codigo</td><td>@c.Nome</td><td class="num">@Moeda(c.Orcamento)</td><td class="num">@Moeda(cp)</td><td class="num">@Moeda(c.Orcamento - cp)</td></tr> }</tbody></table>
                <div class="alerta aviso"><Icone Nome="info" /> Com a obra cadastrada, requisição, pedido e contrato ficam amarrados à obra e à etapa. Orçado × comprometido é opcional.</div>
            }
        }
    </ChildContent>
    <Rodape><button class="btn prim" disabled="@Ocupado" @onclick="SalvarObra"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

<Modal @bind-Aberto="_abertoCc" Titulo="Centro de custo / etapa" Tamanho="media">
    <ChildContent>
        @if (_c is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Código / etapa" Obrigatorio Classe="s4"><input @bind="_c.Codigo" /></Campo>
                <Campo Rotulo="Descrição" Obrigatorio Classe="s8"><input @bind="_c.Nome" /></Campo>
                <Campo Rotulo="Obra" Classe="s6"><select @bind="_c.ObraId"><option value="">(corporativo)</option>@foreach (var o in _obras ?? []) { <option value="@o.Id">@o.Nome</option> }</select></Campo>
                <Campo Rotulo="Orçamento (opcional)" Classe="s3"><input type="number" step="0.01" @bind="_c.Orcamento" /></Campo>
                <Campo Rotulo="" Classe="s3"><label><input type="checkbox" @bind="_c.Ativo" /> Ativo</label></Campo>
            </div>
        }
    </ChildContent>
    <Rodape><button class="btn prim" disabled="@Ocupado" @onclick="SalvarCc"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

<Modal @bind-Aberto="_abertoLoc" Titulo="Local da obra" Tamanho="media">
    <ChildContent>
        @if (_l is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Código" Obrigatorio Classe="s4"><input @bind="_l.Codigo" placeholder="T2-P03-L05" /></Campo>
                <Campo Rotulo="Descrição" Obrigatorio Classe="s8"><input @bind="_l.Nome" placeholder="Torre 2 › Pav. 3 › Laje L5" /></Campo>
                <Campo Rotulo="Nível" Classe="s4"><select @bind="_l.Tipo">@foreach (var n in new[] { "Torre", "Pavimento", "Unidade", "Ambiente", "Elemento", "Área comum" }) { <option>@n</option> }</select></Campo>
                <Campo Rotulo="Local pai" Classe="s8"><select @bind="_l.LocalPaiId"><option value="">(raiz)</option>@foreach (var x in (_locais ?? []).Where(x => x.Id != _l.Id)) { <option value="@x.Id">@x.Codigo – @x.Nome</option> }</select></Campo>
                <Campo Rotulo="Ordem" Classe="s3"><input type="number" @bind="_l.Ordem" /></Campo>
                <Campo Rotulo="Quantidade de referência" Classe="s5"><input type="number" step="0.01" @bind="_l.Quantidade" /></Campo>
                <Campo Rotulo="Unidade" Classe="s4"><select @bind="_l.Unidade"><option value="">—</option><option>m²</option><option>m</option><option>m³</option><option>un</option></select></Campo>
            </div>
        }
    </ChildContent>
    <Rodape><button class="btn prim" disabled="@Ocupado" @onclick="SalvarLocal"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

@code {
    private IGrade? GradeAtual => _aba switch { "obras" => _gObras, "cc" => _gCc, _ => _gLoc };
    private Grade<Obra>? _gObras;
    private Grade<CentroCusto>? _gCc;
    private Grade<Local>? _gLoc;
    private List<Obra>? _obras;
    private List<CentroCusto>? _ccs;
    private List<Local>? _locais = [];
    private Dictionary<Guid, decimal> _comprometido = [];
    private Obra? _o;
    private CentroCusto? _c;
    private Local? _l;
    private Guid? _obraLocais;
    private string _gTorre = "Torre 1";
    private int _gPav = 4;
    private bool _gTerreo = true, _abertoObra, _abertoCc, _abertoLoc;
    private string _aba = "obras";
    private List<Opcao> _usuarios = [], _docs = [];
    private static readonly List<(string, string)> _abas = [("obras", "Obras"), ("cc", "Centros de custo / etapas"), ("locais", "Locais da obra")];
    private string? NomeU(Guid? id) => id is null ? null : _usuarios.FirstOrDefault(u => u.Id == id)?.Texto;

    protected override async Task OnInitializedAsync() { _usuarios = await Cat.UsuariosAsync(); _docs = await Cat.DocumentosSgqAsync(); await Carregar(); }

    private async Task Carregar()
    {
        await using var db = Fabrica.Criar();
        _obras = await db.Obras.AsNoTracking().OrderBy(o => o.Codigo).ToListAsync();
        _ccs = await db.CentrosCusto.AsNoTracking().OrderBy(o => o.Codigo).ToListAsync();
        var peds = await db.Pedidos.AsNoTracking().Where(p => p.Status >= StatusPedido.Aprovado && p.Status != StatusPedido.Cancelado).Include(p => p.Itens).ToListAsync();
        var reqs = await db.Requisicoes.AsNoTracking().Where(r => r.CentroCustoId != null).ToDictionaryAsync(r => r.Id, r => r.CentroCustoId!.Value);
        var ctrs = await db.Contratos.AsNoTracking().Include(k => k.Itens).Where(k => k.CentroCustoId != null && k.Status == StatusContrato.Ativo).ToListAsync();
        _comprometido = peds.Where(p => p.RequisicaoId is { } r && reqs.ContainsKey(r)).GroupBy(p => reqs[p.RequisicaoId!.Value]).ToDictionary(g => g.Key, g => g.Sum(p => p.Valor));
        foreach (var k in ctrs) _comprometido[k.CentroCustoId!.Value] = _comprometido.GetValueOrDefault(k.CentroCustoId!.Value) + k.ValorTotal;
        if (_obraLocais is null && _obras.Count == 1) _obraLocais = _obras[0].Id;
        await CarregarLocais();
    }

    private async Task CarregarLocais()
    {
        if (_obraLocais is not { } o) { _locais = []; return; }
        await using var db = Fabrica.Criar();
        _locais = await db.Locais.AsNoTracking().Where(l => l.ObraId == o).OrderBy(l => l.Codigo).ToListAsync();
    }

    private void Novo()
    {
        ErrosForm = null;
        switch (_aba)
        {
            case "obras": _o = new Obra(); _abertoObra = true; break;
            case "cc": _c = new CentroCusto(); _abertoCc = true; break;
            default: NovoLocal(); break;
        }
    }

    private void NovoLocal()
    {
        if (_obraLocais is null) { Notif.Aviso("Escolha a obra."); return; }
        _l = new Local { ObraId = _obraLocais.Value, Tipo = "Pavimento" }; ErrosForm = null; _abertoLoc = true;
    }

    private void AbrirObra(Obra o) { _o = o; ErrosForm = null; _abertoObra = true; }

    private async Task SalvarObra()
    {
        var ok = await Executar(async () =>
        {
            var e = new List<string>();
            if (string.IsNullOrWhiteSpace(_o!.Codigo)) e.Add("Informe o código.");
            if (string.IsNullOrWhiteSpace(_o.Nome)) e.Add("Informe o nome.");
            if (string.IsNullOrWhiteSpace(_o.EnderecoEntrega)) e.Add("Informe o endereço de entrega padrão.");
            ValidacaoException.Se(e);
            await using var db = Fabrica.Criar();
            _o.Locais = [];
            await Grafo.SalvarAsync(db, _o);
            await db.SaveChangesAsync();
        }, "Obra salva.");
        if (ok) { _abertoObra = false; await Carregar(); }
    }

    private async Task SalvarCc()
    {
        var ok = await Executar(async () =>
        {
            var e = new List<string>();
            if (string.IsNullOrWhiteSpace(_c!.Codigo)) e.Add("Informe o código.");
            if (string.IsNullOrWhiteSpace(_c.Nome)) e.Add("Informe o nome.");
            ValidacaoException.Se(e);
            await using var db = Fabrica.Criar();
            await Grafo.SalvarAsync(db, _c);
            await db.SaveChangesAsync();
        }, "Centro de custo salvo.");
        if (ok) { _abertoCc = false; await Carregar(); }
    }

    private async Task SalvarLocal() { if (await Executar(() => Qob.SalvarLocalAsync(_l!), "Local salvo.")) { _abertoLoc = false; Cat.Invalidar(); await CarregarLocais(); } }

    private async Task GerarLocais()
    {
        var n = 0;
        if (await Executar(async () => n = await Qob.GerarLocaisAsync(_obraLocais!.Value, _gTorre, _gPav, _gTerreo))) { Notif.Sucesso($"{n} locais criados."); Cat.Invalidar(); await CarregarLocais(); }
    }
}
