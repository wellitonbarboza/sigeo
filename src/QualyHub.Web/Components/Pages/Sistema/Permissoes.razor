@page "/sistema/permissoes"
@inherits PaginaBase

<Pagina Titulo="Permissões de documentos do SGQ" Grade="_grade" AoNovo="Novo" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            @if (!Gestor) { <div class="alerta aviso"><Icone Nome="escudo" /> Somente Qualidade/Administrador altera permissões.</div> }
            <div class="alerta info"><Icone Nome="alerta" /> Sem regra específica: Diretoria/Qualidade/Administrador têm acesso total; demais perfis veem apenas as revisões vigentes. Regra por documento prevalece sobre regra por pasta; regra por usuário prevalece sobre regra por perfil.</div>
            <Grade T="Linha" @ref="_grade" Itens="_itens" AoClicar="l => Abrir(l.Id)" NomeExportacao="permissoes-sgq">
                <Colunas>
                    <Coluna T="Linha" Titulo="Escopo" Valor="l => l.Escopo" />
                    <Coluna T="Linha" Titulo="Alvo" Valor="l => l.Alvo" />
                    <Coluna T="Linha" Titulo="Para" Valor="l => l.Para" />
                    <Coluna T="Linha" Titulo="Ver" Valor="l => l.P.PodeVer" />
                    <Coluna T="Linha" Titulo="Baixar" Valor="l => l.P.PodeBaixar" />
                    <Coluna T="Linha" Titulo="Imprimir" Valor="l => l.P.PodeImprimir" />
                    <Coluna T="Linha" Titulo="Editar" Valor="l => l.P.PodeEditar" />
                    <Coluna T="Linha" Titulo="Aprovar" Valor="l => l.P.PodeAprovar" />
                    <Coluna T="Linha" Titulo="Obsoletos" Valor="l => l.P.PodeVerObsoletos" />
                    <Coluna T="Linha" Titulo="Válido até" Valor="l => l.P.ValidoAte" />
                </Colunas>
            </Grade>
        </div>
    </ChildContent>
    <Faixa><b>Permissões</b><span>Por pasta ou documento · por perfil ou usuário · com validade</span><span>Toda alteração fica registrada no log</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_aberto" Titulo="Regra de permissão" Tamanho="media">
    <ChildContent>
        @if (_p is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Escopo" Classe="s4"><select value="@_p.Escopo" @onchange="e => { _p.Escopo = Enum.Parse<EscopoPermissao>(e.Value!.ToString()!); _p.AlvoId = Guid.Empty; }" disabled="@(!Gestor)">@foreach (var s in Enum.GetValues<EscopoPermissao>()) { <option value="@s">@De(s)</option> }</select></Campo>
                <Campo Rotulo="@(_p.Escopo == EscopoPermissao.Pasta ? "Pasta" : "Documento")" Obrigatorio Classe="s8">
                    <select @bind="_p.AlvoId" disabled="@(!Gestor)"><option value="@Guid.Empty">Selecione…</option>
                        @foreach (var a in _p.Escopo == EscopoPermissao.Pasta ? _pastas : _docs) { <option value="@a.Id">@a.Texto</option> }
                    </select>
                </Campo>
                <Campo Rotulo="Perfil" Classe="s6"><select @bind="_p.Perfil" disabled="@(!Gestor)"><option value="">—</option>@foreach (var pf in Enum.GetValues<PerfilUsuario>()) { <option value="@pf">@De(pf)</option> }</select></Campo>
                <Campo Rotulo="ou Usuário" Classe="s6"><select @bind="_p.UsuarioId" disabled="@(!Gestor)"><option value="">—</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                <Campo Rotulo="Permissões" Classe="s12">
                    <div class="checks">
                        <label><input type="checkbox" @bind="_p.PodeVer" disabled="@(!Gestor)" /> Ver</label>
                        <label><input type="checkbox" @bind="_p.PodeBaixar" disabled="@(!Gestor)" /> Baixar</label>
                        <label><input type="checkbox" @bind="_p.PodeImprimir" disabled="@(!Gestor)" /> Imprimir</label>
                        <label><input type="checkbox" @bind="_p.PodeEditar" disabled="@(!Gestor)" /> Editar</label>
                        <label><input type="checkbox" @bind="_p.PodeAprovar" disabled="@(!Gestor)" /> Aprovar</label>
                        <label><input type="checkbox" @bind="_p.PodeVerObsoletos" disabled="@(!Gestor)" /> Ver obsoletos</label>
                    </div>
                </Campo>
                <Campo Rotulo="Válido até" Classe="s4"><input type="date" @bind="_p.ValidoAte" disabled="@(!Gestor)" /></Campo>
            </div>
        }
    </ChildContent>
    <Rodape>
        @if (_p is not null && Gestor)
        {
            @if (_itens?.Any(x => x.Id == _p.Id) == true) { <button class="btn perigo" disabled="@Ocupado" @onclick="Excluir">Excluir</button> }
            <button class="btn prim" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="16" /> Salvar</button>
        }
    </Rodape>
</Modal>

@code {
    private sealed record Linha(Guid Id, EscopoPermissao Escopo, string Alvo, string Para, PermissaoDocumento P);
    private Grade<Linha>? _grade;
    private List<Linha>? _itens;
    private PermissaoDocumento? _p;
    private bool _aberto;
    private List<Opcao> _pastas = [], _docs = [], _usuarios = [];
    private bool Gestor => Perfil(PerfilUsuario.Qualidade);

    protected override async Task OnInitializedAsync() { _usuarios = await Cat.UsuariosAsync(); await Carregar(); }

    private async Task Carregar()
    {
        await using var db = Fabrica.Criar();
        _pastas = await db.Pastas.AsNoTracking().OrderBy(p => p.Ordem).Select(p => new Opcao(p.Id, p.Nome)).ToListAsync();
        _docs = await db.Documentos.AsNoTracking().OrderBy(d => d.Codigo).Select(d => new Opcao(d.Id, d.Codigo + " – " + d.Titulo)).ToListAsync();
        var regras = await db.Permissoes.AsNoTracking().ToListAsync();
        string Alvo(PermissaoDocumento p) => (p.Escopo == EscopoPermissao.Pasta ? _pastas : _docs).FirstOrDefault(o => o.Id == p.AlvoId)?.Texto ?? "?";
        string Para(PermissaoDocumento p) => p.UsuarioId is { } u ? _usuarios.FirstOrDefault(x => x.Id == u)?.Texto ?? "?" : p.Perfil is { } pf ? $"Perfil {De(pf)}" : "—";
        _itens = regras.Select(r => new Linha(r.Id, r.Escopo, Alvo(r), Para(r), r)).OrderBy(l => l.Alvo).ToList();
    }

    private void Novo() { if (!Gestor) return; _p = new PermissaoDocumento { Escopo = EscopoPermissao.Pasta, PodeVer = true }; ErrosForm = null; _aberto = true; }

    private void Abrir(Guid id) { _p = _itens!.First(x => x.Id == id).P; ErrosForm = null; _aberto = true; }

    private async Task Salvar()
    {
        var ok = await Executar(async () =>
        {
            var e = new List<string>();
            if (_p!.AlvoId == Guid.Empty) e.Add("Informe a pasta ou documento.");
            if (_p.Perfil is null && _p.UsuarioId is null) e.Add("Informe o perfil ou o usuário.");
            if (_p.Perfil is not null && _p.UsuarioId is not null) e.Add("Escolha perfil OU usuário.");
            ValidacaoException.Se(e);
            await using var db = Fabrica.Criar();
            await Grafo.SalvarAsync(db, _p);
            db.EventosDocumento.Add(new EventoDocumento { EmpresaId = Usuario.EmpresaId, DataHora = DateTimeOffset.UtcNow, UsuarioId = Usuario.UsuarioId, UsuarioNome = Usuario.Nome,
                Evento = EventoDocumentoTipo.PermissaoAlterada, DocumentoId = _p.Escopo == EscopoPermissao.Documento ? _p.AlvoId : null, Detalhe = $"Regra {_p.Escopo} salva", Origem = "Web" });
            await db.SaveChangesAsync();
        }, "Permissão salva.");
        if (ok) { _aberto = false; await Carregar(); }
    }

    private async Task Excluir()
    {
        var ok = await Executar(async () =>
        {
            await using var db = Fabrica.Criar();
            var r = await db.Permissoes.FirstAsync(x => x.Id == _p!.Id);
            db.Permissoes.Remove(r); // exclusão lógica pelo interceptor de auditoria
            db.EventosDocumento.Add(new EventoDocumento { EmpresaId = Usuario.EmpresaId, DataHora = DateTimeOffset.UtcNow, UsuarioId = Usuario.UsuarioId, UsuarioNome = Usuario.Nome,
                Evento = EventoDocumentoTipo.PermissaoAlterada, Detalhe = "Regra excluída", Origem = "Web" });
            await db.SaveChangesAsync();
        }, "Regra excluída.");
        if (ok) { _aberto = false; await Carregar(); }
    }
}
