@using QualyHub.Domain.Planejamento
@inherits PaginaBase
@inject PlanejamentoServico Plan

@* Redes de planejamento: locais incluídos + pacotes de serviço (do orçamento) em sequência + vínculos entre redes. *@
<div class="plan-redes">
    <div class="plan-redes-lista">
        @foreach (var r in _redes)
        {
            <button type="button" class="rede-cartao @(_form?.Id == r.Id ? "sel" : "")" @onclick="() => Editar(r)">
                <span class="faixa" style="background:@r.Cor"></span>
                <span class="nome">@r.Nome</span>
                <span class="sub">@De(r.Tipo) · @r.Locais.Count local(is) · @r.Pacotes.Count pacote(s)</span>
                <span class="sub">@CustoRede(r).ToString("C0", Br) orçado</span>
            </button>
        }
        @if (Editavel)
        {
            <button type="button" class="rede-cartao nova" id="rede-nova" @onclick="Nova"><span class="nome"><Icone Nome="mais" Tam="14" /> Nova rede</span><span class="sub">Torre por apartamento, estrutura por pavimento, área comum por local</span></button>
            @if (_redes.Count == 0)
            {
                <button type="button" class="btn sec" id="rede-sugerir" disabled="@Ocupado" @onclick="Sugerir"><Icone Nome="raio" Tam="14" /> Sugerir redes pelo orçamento</button>
            }
        }
    </div>

    <div class="plan-redes-editor cartao">
        <Erros Lista="ErrosForm" />
        @if (_form is null)
        {
            <p class="mudo">Escolha uma rede à esquerda ou crie uma nova. Cada rede reúne os locais e os pacotes de serviço em sequência; o cronograma é gerado a partir delas.</p>
        }
        else
        {
            <div class="form">
                <Campo Rotulo="Nome da rede" Classe="s5"><input id="rede-nome" @bind="_form.Nome" disabled="@(!Editavel)" /></Campo>
                <Campo Rotulo="Como enxerga os locais" Classe="s3">
                    <select id="rede-tipo" value="@_form.Tipo" disabled="@(!Editavel)" @onchange="e => { _form.Tipo = Enum.Parse<TipoRede>(e.Value!.ToString()!); _form.Locais.Clear(); }">
                        @foreach (var t in Enum.GetValues<TipoRede>()) { <option value="@t">@De(t)</option> }
                    </select>
                </Campo>
                <Campo Rotulo="Pulmão entre pacotes (d.ú.)" Classe="s2"><input id="rede-pulmao" type="number" min="0" max="60" @bind="_form.Pulmao" disabled="@(!Editavel)" /></Campo>
                <Campo Rotulo="Cor" Classe="s2"><input id="rede-cor" type="color" @bind="_form.Cor" disabled="@(!Editavel)" /></Campo>
            </div>

            <h4 class="mt-12">Locais incluídos <span class="mudo">— @_form.Locais.Count marcado(s), na ordem de ataque (de baixo para cima)</span></h4>
            @if (_form.Tipo == TipoRede.PorApartamento)
            {
                var visiveis = Torres.Where(t => _todasTorres || _form.Id is null || TemSelecao(t)).ToList();
                @foreach (var torre in visiveis)
                {
                    var pavs = Filhos(torre.Id, GeradorEmpreendimento.TipoPavimento).OrderByDescending(p => p.Ordem).ToList();
                    var maxAp = pavs.Select(p => Filhos(p.Id, GeradorEmpreendimento.TipoApartamento).Count()).DefaultIfEmpty(0).Max();
                    <div class="tabela-rolavel"><table class="itens matriz-locais" id="@($"rede-aptos-{torre.Codigo}")">
                        <thead><tr><th>@torre.Nome</th>@for (var i = 1; i <= maxAp; i++) { <th class="centro">@i</th> }<th></th></tr></thead>
                        <tbody>
                            @foreach (var pav in pavs)
                            {
                                var aptos = Filhos(pav.Id, GeradorEmpreendimento.TipoApartamento).OrderBy(a => a.Ordem).ToList();
                                <tr><th>@pav.Nome</th>
                                    @foreach (var ap in aptos)
                                    {
                                        <td class="centro"><label class="chk" title="@ap.Nome"><input type="checkbox" checked="@_form.Locais.Contains(ap.Id)" disabled="@(!Editavel)" @onchange="e => Marcar(ap.Id, (bool)e.Value!)" /><span>@ap.Nome.Replace("Apto ", "")</span></label></td>
                                    }
                                    @for (var i = aptos.Count; i < maxAp; i++) { <td></td> }
                                    <td>@if (Editavel) { <button type="button" class="link" @onclick="() => Alternar(aptos.Select(a => a.Id))">alternar</button> }</td></tr>
                            }
                        </tbody>
                    </table></div>
                }
                @if (visiveis.Count < Torres.Count()) { <button type="button" class="link" id="rede-todas-torres" @onclick="() => _todasTorres = true">Mostrar as outras @(Torres.Count() - visiveis.Count) torre(s)</button> }
                @if (!Torres.Any()) { <p class="mudo">Nenhuma torre gerada. Gere a estrutura em Engenharia › Obras e Empreendimentos.</p> }
            }
            else
            {
                var candidatos = Candidatos(_form.Tipo).ToList();
                <div class="lista-chk" id="rede-locais">
                    @foreach (var g in candidatos.GroupBy(l => NomePai(l)))
                    {
                        <div class="grupo-chk"><b>@g.Key</b>
                            @foreach (var l in g)
                            {
                                <label class="chk"><input type="checkbox" checked="@_form.Locais.Contains(l.Id)" disabled="@(!Editavel)" @onchange="e => Marcar(l.Id, (bool)e.Value!)" /> @l.Nome</label>
                            }
                        </div>
                    }
                    @if (candidatos.Count == 0) { <p class="mudo">Nenhum local desse tipo na obra.</p> }
                </div>
            }

            <h4 class="mt-12">Pacotes de serviço em sequência</h4>
            <div class="tabela-rolavel"><table class="itens" id="rede-pacotes">
                <thead><tr><th>#</th><th>Pacote</th><th>Serviço do orçamento (custo)</th><th class="num">Dur. por local (d.ú.)</th><th class="num">Equipes</th><th></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < _form.Pacotes.Count; i++)
                    {
                        var p = _form.Pacotes[i]; var idx = i;
                        <tr @key="p">
                            <td>@(i + 1)</td>
                            <td><input @bind="p.Nome" disabled="@(!Editavel)" aria-label="Nome do pacote" /></td>
                            <td><select value="@p.ComposicaoId" disabled="@(!Editavel)" aria-label="Serviço do orçamento" @onchange="e => EscolherServico(p, e.Value?.ToString())">
                                <option value="">(sem custo)</option>
                                @foreach (var c in _comps) { <option value="@c.Id">@c.Texto</option> }
                            </select></td>
                            <td class="larg-100"><input type="number" min="0" max="400" @bind="p.Duracao" disabled="@(!Editavel)" aria-label="Duração por local" /></td>
                            <td class="larg-80"><input type="number" min="1" max="50" @bind="p.Equipes" disabled="@(!Editavel)" aria-label="Equipes" /></td>
                            <td class="nowrap">@if (Editavel)
                                {
                                    <button type="button" class="icone-btn" title="Subir" disabled="@(idx == 0)" @onclick="() => Trocar(idx, idx - 1)">↑</button>
                                    <button type="button" class="icone-btn" title="Descer" disabled="@(idx == _form.Pacotes.Count - 1)" @onclick="() => Trocar(idx, idx + 1)">↓</button>
                                    <button type="button" class="icone-btn" title="Remover pacote" @onclick="() => _form.Pacotes.Remove(p)"><Icone Nome="lixeira" Tam="15" /></button>
                                }</td>
                        </tr>
                    }
                    @if (_form.Pacotes.Count == 0) { <tr><td colspan="6" class="mudo">Inclua os pacotes na ordem de execução (ex.: alvenaria → instalações → reboco → contrapiso → revestimento → pintura).</td></tr> }
                </tbody>
            </table></div>
            @if (Editavel) { <button type="button" class="btn sec mt-6" id="rede-pacote-add" @onclick="AddPacote"><Icone Nome="mais" Tam="14" /> Pacote</button> }

            @if (_form.Pacotes.Count > 0 && _form.Locais.Count > 0 && (_form.Tipo == TipoRede.PorLocal || _verMatriz))
            {
                var locaisSel = OrdemLocais(_form).Select(id => _porId[id]).ToList();
                <h4 class="mt-12">O que está incluso <span class="mudo">— marcado = o pacote entra no local (padrão: onde o orçamento tem o serviço)</span></h4>
                <div class="tabela-rolavel"><table class="itens matriz-locais" id="rede-matriz">
                    <thead><tr><th>Pacote</th>@foreach (var l in locaisSel) { <th class="centro">@l.Nome</th> }</tr></thead>
                    <tbody>
                        @foreach (var p in _form.Pacotes)
                        {
                            <tr><th>@p.Nome</th>
                                @foreach (var l in locaisSel)
                                {
                                    var incl = Incluido(p, l.Id, _form.Tipo);
                                    <td class="centro"><input type="checkbox" checked="@incl" disabled="@(!Editavel)" aria-label="@($"{p.Nome} em {l.Nome}")" @onchange="e => p.Ajustes[l.Id] = (bool)e.Value!" />@if (p.Ajustes.ContainsKey(l.Id)) { <span class="selo-mini" title="ajustado à mão">✎</span> }</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
            else if (_form.Tipo != TipoRede.PorLocal && _form.Pacotes.Count > 0)
            {
                <button type="button" class="link mt-6" @onclick="() => _verMatriz = true">Ajustar o que está incluso por local</button>
            }

            <div class="barra-botoes mt-12">
                @if (Editavel)
                {
                    <button type="button" class="btn prim" id="rede-salvar" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="14" /> Salvar rede</button>
                    @if (_form.Id is { } rid) { <button type="button" class="btn sec perigo" id="rede-excluir" disabled="@Ocupado" @onclick="@(() => Confirmar($"Excluir a rede {_form.Nome}? O cronograma já gerado não muda até gerar de novo.", () => Excluir(rid)))">Excluir rede</button> }
                }
            </div>
        }

        <h4 class="mt-18">Vínculos entre redes</h4>
        <div class="tabela-rolavel"><table class="itens" id="vinculos-rede">
            <thead><tr><th>Origem</th><th>Destino</th><th>Regra</th><th class="num">Desloc. (pav.)</th><th class="num">Folga (d.ú.)</th><th></th></tr></thead>
            <tbody>
                @foreach (var v in _vinculos)
                {
                    <tr><td>@NomePacote(v.PacoteOrigemId)</td><td>@NomePacote(v.PacoteDestinoId)</td><td>@De(v.Modo)</td><td class="num">@(v.Modo == ModoVinculoRede.PorPavimento ? $"+{v.Deslocamento}" : "—")</td><td class="num">@v.Lag</td>
                        <td>@if (Editavel) { <button type="button" class="icone-btn" title="Excluir vínculo" @onclick="() => ExcluirVinculo(v.Id)"><Icone Nome="lixeira" Tam="15" /></button> }</td></tr>
                }
                @if (_vinculos.Count == 0) { <tr><td colspan="6" class="mudo">Ex.: alvenaria do pav. N começa depois da estrutura do pav. N+2; fachada depois do último pavimento de alvenaria.</td></tr> }
            </tbody>
            @if (Editavel && _pacotes.Count > 1)
            {
                <tfoot><tr>
                    <td><select id="vr-origem" @bind="_vOrigem" aria-label="Pacote de origem"><option value="">Origem…</option>@foreach (var p in _pacotes) { <option value="@p.Id">@p.Texto</option> }</select></td>
                    <td><select id="vr-destino" @bind="_vDestino" aria-label="Pacote de destino"><option value="">Destino…</option>@foreach (var p in _pacotes) { <option value="@p.Id">@p.Texto</option> }</select></td>
                    <td><select id="vr-modo" @bind="_vModo" aria-label="Regra">@foreach (var m in Enum.GetValues<ModoVinculoRede>()) { <option value="@m">@De(m)</option> }</select></td>
                    <td class="larg-80"><input type="number" min="-20" max="20" @bind="_vDesl" aria-label="Deslocamento em pavimentos" /></td>
                    <td class="larg-80"><input type="number" min="-60" max="120" @bind="_vLag" aria-label="Folga em dias úteis" /></td>
                    <td><button type="button" class="btn sec pq" id="vr-add" disabled="@Ocupado" @onclick="AddVinculo">Incluir</button></td>
                </tr></tfoot>
            }
        </table></div>
    </div>
</div>

<Confirmacao Pergunta="@PerguntaConfirmacao" AoSim="ConfirmacaoSim" AoNao="ConfirmacaoNao" />

@code {
    [Parameter, EditorRequired] public Guid ObraId { get; set; }
    [Parameter] public bool Editavel { get; set; }
    [Parameter] public EventCallback AoMudar { get; set; }

    private sealed class PacoteForm
    {
        public Guid? Id; public string Nome = ""; public Guid? ComposicaoId; public int Duracao = 2; public int Equipes = 1;
        public Dictionary<Guid, bool> Ajustes = [];
    }
    private sealed class RedeForm
    {
        public Guid? Id; public string Nome = ""; public TipoRede Tipo = TipoRede.PorApartamento; public string Cor = "#4f52d6"; public int Pulmao;
        public HashSet<Guid> Locais = []; public List<PacoteForm> Pacotes = [];
    }

    private List<RedePlanejamento> _redes = [];
    private List<VinculoRede> _vinculos = [];
    private List<Local> _locais = [];
    private Dictionary<Guid, Local> _porId = [];
    private ILookup<Guid?, Local> _filhos = Array.Empty<Local>().ToLookup(l => l.LocalPaiId);
    private List<Opcao> _comps = [];
    private Dictionary<Guid, string> _nomeComp = [];
    private List<Opcao> _pacotes = [];
    private Func<Guid, Guid, decimal> _custo = (_, _) => 0;
    private RedeForm? _form;
    private bool _verMatriz, _todasTorres;
    private Guid? _vOrigem, _vDestino;
    private ModoVinculoRede _vModo = ModoVinculoRede.PorPavimento;
    private int _vDesl = 2, _vLag;
    private Guid _obraCarregada;

    protected override async Task OnParametersSetAsync()
    {
        if (_obraCarregada == ObraId) return;
        _obraCarregada = ObraId; _form = null;
        await Carregar();
    }

    private async Task Carregar()
    {
        await using var db = Fabrica.CriarLeitura();
        _redes = await db.RedesPlanejamento.AsNoTracking().Include(r => r.Locais).Include(r => r.Pacotes).ThenInclude(p => p.Ajustes).AsSplitQuery()
            .Where(r => r.ObraId == ObraId).OrderBy(r => r.Ordem).ToListAsync(Cancelamento);
        _vinculos = await db.VinculosRede.AsNoTracking().Where(v => v.ObraId == ObraId).ToListAsync(Cancelamento);
        var defs = await PlanejamentoServico.DefinicoesAsync(db, ObraId, Cancelamento);
        _custo = defs.Custo; _locais = defs.Locais;
        _porId = _locais.ToDictionary(l => l.Id);
        _filhos = _locais.ToLookup(l => l.LocalPaiId);
        var usados = await db.ServicosLocais.AsNoTracking().Where(s => s.ObraId == ObraId).Select(s => s.ComposicaoId).Distinct().ToListAsync(Cancelamento);
        var comps = await db.Composicoes.AsNoTracking().Where(c => c.Ativa).OrderBy(c => c.Codigo).Select(c => new { c.Id, c.Codigo, c.Descricao }).ToListAsync(Cancelamento);
        _nomeComp = comps.ToDictionary(c => c.Id, c => c.Descricao);
        _comps = comps.OrderBy(c => usados.Contains(c.Id) ? 0 : 1).ThenBy(c => c.Codigo).Select(c => new Opcao(c.Id, $"{c.Codigo} – {c.Descricao}{(usados.Contains(c.Id) ? "" : " (fora do orçamento)")}")).ToList();
        _pacotes = _redes.SelectMany(r => r.Pacotes.OrderBy(p => p.Ordem).Select(p => new Opcao(p.Id, $"{r.Nome} › {p.Nome}"))).ToList();
    }

    private IEnumerable<Local> Torres => _locais.Where(l => l.Tipo == GeradorEmpreendimento.TipoTorre).OrderBy(l => l.Codigo);
    private bool TemSelecao(Local torre) => _form is not null && MotorOrcamento.Subarvore(torre.Id, _filhos).Any(_form.Locais.Contains);
    private IEnumerable<Local> Filhos(Guid pai, string tipo) => _filhos[pai].Where(l => l.Tipo == tipo);
    private string NomePai(Local l) => l.LocalPaiId is { } p && _porId.TryGetValue(p, out var pai) ? (pai.LocalPaiId is { } pp && _porId.TryGetValue(pp, out var avo) ? $"{avo.Nome} › {pai.Nome}" : pai.Nome) : "Obra";

    private IEnumerable<Local> Candidatos(TipoRede tipo) => tipo switch
    {
        TipoRede.PorPavimento => OrdemArvore().Where(l => l.Tipo == GeradorEmpreendimento.TipoPavimento),
        _ => OrdemArvore().Where(l => l.Tipo == GeradorEmpreendimento.TipoAreaComum || l.Tipo == GeradorEmpreendimento.TipoTorre
                                      || l.Tipo == GeradorEmpreendimento.TipoCondominio || !GeradorEmpreendimento.Gerados.Contains(l.Tipo))
    };

    /// <summary>Locais em ordem da árvore (torre, pavimento de baixo para cima, apartamento).</summary>
    private List<Local> OrdemArvore()
    {
        var r = new List<Local>();
        void V(Guid? pai) { foreach (var l in _filhos[pai].OrderBy(l => l.Tipo == GeradorEmpreendimento.TipoPavimento ? l.Ordem : 0).ThenBy(l => l.Ordem).ThenBy(l => l.Codigo)) { r.Add(l); V(l.Id); } }
        V(null);
        return r;
    }

    private List<Guid> OrdemLocais(RedeForm f) => OrdemArvore().Where(l => f.Locais.Contains(l.Id)).Select(l => l.Id).ToList();

    private void Marcar(Guid id, bool v) { if (_form is null) return; if (v) _form.Locais.Add(id); else _form.Locais.Remove(id); }
    private void Alternar(IEnumerable<Guid> ids)
    {
        if (_form is null) return;
        var l = ids.ToList(); var todos = l.All(_form.Locais.Contains);
        foreach (var id in l) Marcar(id, !todos);
    }

    private bool Incluido(PacoteForm p, Guid local, TipoRede tipo) =>
        p.Ajustes.TryGetValue(local, out var m) ? m : p.ComposicaoId is not { } c || tipo != TipoRede.PorLocal || _custo(c, local) > 0;

    private decimal CustoRede(RedePlanejamento r) =>
        r.Pacotes.Where(p => p.ComposicaoId != null).Sum(p => r.Locais.Sum(l => _custo(p.ComposicaoId!.Value, l.LocalId)));

    private string NomePacote(Guid id) => _pacotes.FirstOrDefault(p => p.Id == id)?.Texto ?? "(pacote excluído)";

    private void Nova() { ErrosForm = null; _verMatriz = false; _form = new RedeForm { Nome = "Nova rede", Cor = new[] { "#4f52d6", "#64748b", "#0f8a6b", "#d4691e", "#a23ea8" }[_redes.Count % 5] }; }

    private void Editar(RedePlanejamento r)
    {
        ErrosForm = null; _todasTorres = false; _verMatriz = r.Pacotes.Any(p => p.Ajustes.Count > 0);
        _form = new RedeForm
        {
            Id = r.Id, Nome = r.Nome, Tipo = r.Tipo, Cor = r.Cor, Pulmao = r.Pulmao, Locais = r.Locais.Select(l => l.LocalId).ToHashSet(),
            Pacotes = r.Pacotes.OrderBy(p => p.Ordem).Select(p => new PacoteForm { Id = p.Id, Nome = p.Nome, ComposicaoId = p.ComposicaoId, Duracao = p.DuracaoPorLocal, Equipes = p.Equipes, Ajustes = p.Ajustes.ToDictionary(a => a.LocalId, a => a.Incluido) }).ToList()
        };
    }

    private void AddPacote() => _form?.Pacotes.Add(new PacoteForm());
    private void Trocar(int a, int b) { if (_form is null || b < 0 || b >= _form.Pacotes.Count) return; (_form.Pacotes[a], _form.Pacotes[b]) = (_form.Pacotes[b], _form.Pacotes[a]); }
    private void EscolherServico(PacoteForm p, string? v)
    {
        p.ComposicaoId = Guid.TryParse(v, out var g) ? g : null;
        if (p.ComposicaoId is { } c && string.IsNullOrWhiteSpace(p.Nome) && _nomeComp.TryGetValue(c, out var n)) p.Nome = n;
    }

    private async Task Salvar()
    {
        if (_form is not { } f) return;
        var e = new PlanejamentoServico.RedeEdicao(f.Id, ObraId, f.Nome, f.Tipo, f.Cor, f.Pulmao, OrdemLocais(f),
            f.Pacotes.Select(p => new PlanejamentoServico.PacoteEdicao(p.Id, p.Nome, p.ComposicaoId, p.Duracao, p.Equipes, p.Ajustes)).ToList());
        Guid id = default;
        if (await Executar(async () => id = await Plan.SalvarRedeAsync(e, Cancelamento), "Rede salva. Gere o cronograma pelas redes para aplicar."))
        {
            await Carregar();
            if (_redes.FirstOrDefault(r => r.Id == id) is { } r) Editar(r);
            await AoMudar.InvokeAsync();
        }
    }

    private async Task Excluir(Guid id)
    {
        if (await Executar(() => Plan.ExcluirRedeAsync(id, Cancelamento), "Rede excluída.")) { _form = null; await Carregar(); await AoMudar.InvokeAsync(); }
    }

    private async Task Sugerir()
    {
        var n = 0;
        if (await Executar(async () => n = await Plan.SugerirRedesAsync(ObraId, Cancelamento)))
        {
            Notif.Sucesso($"{n} rede(s) sugerida(s) pelo orçamento. Revise durações, equipes e a ordem dos pacotes.");
            await Carregar(); if (_redes.Count > 0) Editar(_redes[0]);
            await AoMudar.InvokeAsync();
        }
    }

    private async Task AddVinculo()
    {
        if (_vOrigem is not { } o || _vDestino is not { } d) { ErrosForm = ["Escolha os pacotes de origem e destino."]; return; }
        var v = new VinculoRede { ObraId = ObraId, PacoteOrigemId = o, PacoteDestinoId = d, Modo = _vModo, Deslocamento = _vModo == ModoVinculoRede.PorPavimento ? _vDesl : 0, Lag = _vLag };
        if (await Executar(() => Plan.SalvarVinculoRedeAsync(v, Cancelamento), "Vínculo incluído.")) { _vOrigem = _vDestino = null; await Carregar(); }
    }

    private async Task ExcluirVinculo(Guid id)
    {
        if (await Executar(() => Plan.ExcluirVinculoRedeAsync(id, Cancelamento), "Vínculo excluído.")) await Carregar();
    }
}
