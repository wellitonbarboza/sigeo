@* Formulário do modal "Condomínio e SPE" (Obras e empreendimentos): separado da tela para encurtá-la.
   Edita os objetos recebidos por referência — quem salva é a tela. Os ids são usados pelos testes de interface. *@
<div class="secao"><Icone Nome="predio" /> Condomínio</div>
<div class="form">
    <Campo Rotulo="Sigla" Obrigatorio Classe="s2" Ajuda="Usada nos códigos (ex.: QA)"><input id="qua-sigla" @bind="Quadra.Codigo" maxlength="6" class="maiusc" disabled="@(Quadra.LocalId != null)" /></Campo>
    <Campo Rotulo="Nome" Obrigatorio Classe="s5"><input id="qua-nome" @bind="Quadra.Nome" placeholder="Condomínio Dona Irene" /></Campo>
    <Campo Rotulo="Tipo" Obrigatorio Classe="s2"><select id="qua-tipo" @bind="Quadra.Tipo">@foreach (var t in TiposAgrupamento) { <option>@t</option> }</select></Campo>
    <Campo Rotulo="Implantação (áreas comuns)" Classe="s3"><select id="qua-impl" @bind="Quadra.ImplantacaoId"><option value="">—</option>@foreach (var t in Tipologias.Where(t => t.Tipo == TipoTipologia.Implantacao)) { <option value="@t.Id">@t.Codigo – @t.Nome</option> }</select></Campo>
    <Campo Rotulo="Nome do condomínio (registro)" Classe="s6"><input id="qua-cond" @bind="Quadra.NomeCondominio" /></Campo>
    <Campo Rotulo="CNPJ do condomínio (após instalação)" Classe="s6"><input @bind="Quadra.CnpjCondominio" /></Campo>
    <Campo Rotulo="Endereço" Classe="s8"><input @bind="Quadra.Endereco" /></Campo>
    <Campo Rotulo="Matrícula do terreno" Classe="s2"><input @bind="Quadra.Matricula" /></Campo>
    <Campo Rotulo="Área do terreno (m²)" Classe="s2"><input id="qua-area" type="number" step="0.01" @bind="Quadra.AreaTerreno" /></Campo>
    <Campo Rotulo="Ordem" Classe="s2"><input type="number" @bind="Quadra.Ordem" /></Campo>
    <Campo Rotulo="" Classe="s2"><label><input type="checkbox" @bind="Quadra.Ativa" /> Ativo</label></Campo>
    <Campo Rotulo="Observações" Classe="s12"><textarea rows="2" @bind="Quadra.Observacoes"></textarea></Campo>
</div>
<div class="secao"><Icone Nome="contrato" /> SPE (CNPJ dono do custo do condomínio)</div>
@if (!Empreendimento.SpePreenchida(Spe)) { <p class="mudo mb-6">Opcional agora: deixe CNPJ e razão social em branco para cadastrar a SPE depois.</p> }
<div class="form">
    <Campo Rotulo="Sigla da SPE" Obrigatorio="@Empreendimento.SpePreenchida(Spe)" Classe="s2"><input id="spe-sigla" @bind="Spe.Codigo" maxlength="10" class="maiusc" /></Campo>
    <Campo Rotulo="CNPJ" Obrigatorio="@Empreendimento.SpePreenchida(Spe)" Classe="s3"><input id="spe-cnpj" @bind="Spe.Cnpj" /></Campo>
    <Campo Rotulo="Razão social" Obrigatorio="@Empreendimento.SpePreenchida(Spe)" Classe="s7"><input id="spe-razao" @bind="Spe.RazaoSocial" /></Campo>
    <Campo Rotulo="Nome curto" Classe="s4"><input id="spe-nome" @bind="Spe.NomeFantasia" placeholder="Dona Irene" /></Campo>
    <Campo Rotulo="Inscrição estadual" Classe="s4"><input @bind="Spe.InscricaoEstadual" /></Campo>
    <Campo Rotulo="E-mail para NF" Classe="s4"><input type="email" @bind="Spe.EmailFiscal" /></Campo>
    <Campo Rotulo="Endereço de faturamento" Classe="s8"><input @bind="Spe.EnderecoFaturamento" /></Campo>
    <Campo Rotulo="Patrimônio de afetação / RET" Classe="s2"><select @bind="Spe.PatrimonioAfetacao"><option>Indefinido</option><option>Sim</option><option>Não</option></select></Campo>
    <Campo Rotulo="" Classe="s2"><label><input type="checkbox" @bind="Spe.Ativa" /> SPE ativa</label></Campo>
</div>
<div class="alerta info"><Icone Nome="info" /> A SPE vira também um estabelecimento (Cadastro › Estabelecimentos). As compras de material saem faturadas pela fábrica e identificadas com a SPE de destino.</div>
@code {
    [Parameter, EditorRequired] public Quadra Quadra { get; set; } = default!;
    [Parameter, EditorRequired] public Spe Spe { get; set; } = default!;
    [Parameter] public IReadOnlyList<string> TiposAgrupamento { get; set; } = [];
    [Parameter] public IReadOnlyList<Tipologia> Tipologias { get; set; } = [];
}
