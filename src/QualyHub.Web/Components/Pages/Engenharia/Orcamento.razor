@page "/engenharia/orcamento"
@inherits PaginaBase
@inject OrcamentoServico Orc
@inject RequisicoesServico RequisicoesSrv
@inject NavigationManager Nav

<Pagina Titulo="Orçamento por local" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="barra-filtro">
                <SeletorObra Id="orc-obra" Valor="_obraId" ValorChanged="TrocarObra" Inicial="ObraQuery" />
                @if (_obraId is not null)
                {
                    <button class="btn prim" id="orc-gerar" disabled="@Ocupado" @onclick="Gerar"><Icone Nome="atualizar" Tam="14" /> Gerar / atualizar orçamento</button>
                    <a class="btn sec" href="@($"engenharia/tipologias?obra={_obraId}")"><Icone Nome="lista" Tam="14" /> Serviços por tipologia</a>
                    <a class="btn sec" href="engenharia/composicoes"><Icone Nome="calculadora" Tam="14" /> Composições</a>
                }
            </div>
            @if (_obraId is null) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra.</div> }
            else
            {
                <div class="kpis">
                    <Kpi Rotulo="Custo orçado" Valor="@_total.ToString("C0", Br)" />
                    <Kpi Rotulo="Células serviço × local" Valor="@_cels.Count.ToString("N0", Br)" Sub="@($"{_travadas} travadas (editadas)")" />
                    <Kpi Rotulo="Área privativa" Valor="@($"{Rotulos.Num(_areaPriv, 0)} m²")" Tom="info" />
                    <Kpi Rotulo="R$/m² privativo" Valor="@(_areaPriv == 0 ? "—" : (_total / _areaPriv).ToString("N2", Br))" Tom="info" />
                </div>
                <Abas Itens="_abas" @bind-Ativa="_aba" />
                <Erros Lista="ErrosForm" />
                @if (_aba == "serv")
                {
                    <table class="itens" id="orc-servicos">
                        <thead><tr><th>Grupo</th><th>Serviço</th><th>Un.</th><th class="num">Quantidade</th><th class="num">Custo unit.</th><th class="num">Custo</th><th class="num">% </th><th class="num">Locais</th></tr></thead>
                        <tbody>
                            @foreach (var g in _porServico)
                            {
                                <tr @key="g.Servico"><td>@g.Grupo</td><td>@g.Servico</td><td>@g.Un</td><td class="num">@g.Qtd.ToString("N2", Br)</td><td class="num">@g.Unit.ToString("N2", Br)</td><td class="num">@g.Custo.ToString("N2", Br)</td>
                                    <td class="num">@(_total == 0 ? "" : (100 * g.Custo / _total).ToString("N1", Br))</td><td class="num">@g.N</td></tr>
                            }
                            @if (_cels.Count == 0) { <tr><td colspan="8" class="mudo">Sem orçamento. Marque os serviços nas tipologias e clique em "Gerar / atualizar orçamento".</td></tr> }
                        </tbody>
                    </table>
                }
                else if (_aba == "spe")
                {
                    <table class="itens" id="orc-spe">
                        <thead><tr><th>Condomínio / torre</th><th class="num">Custo</th><th class="num">Apartamentos</th><th class="num">Área priv. (m²)</th><th class="num">R$/m²</th></tr></thead>
                        <tbody>
                            @foreach (var c in _conds)
                            {
                                var (custo, ap, area) = Soma(c.Id);
                                <tr class="peso-600"><td>@c.Codigo – @c.Nome</td><td class="num">@custo.ToString("N2", Br)</td><td class="num">@ap</td><td class="num">@area.ToString("N2", Br)</td><td class="num">@(area == 0 ? "" : (custo / area).ToString("N2", Br))</td></tr>
                                @foreach (var t in _filhos[c.Id].Where(l => l.Tipo == GeradorEmpreendimento.TipoTorre).OrderBy(l => l.Codigo))
                                {
                                    var (ct, at, ar) = Soma(t.Id);
                                    <tr><td class="pl-24">@t.Codigo – @t.Nome</td><td class="num">@ct.ToString("N2", Br)</td><td class="num">@at</td><td class="num">@ar.ToString("N2", Br)</td><td class="num">@(ar == 0 ? "" : (ct / ar).ToString("N2", Br))</td></tr>
                                }
                                var comum = _comumCond.GetValueOrDefault(c.Id);
                                <tr><td class="mudo pl-24">Áreas comuns do condomínio (rateio pela fração ideal)</td><td class="num">@comum.ToString("N2", Br)</td><td></td><td></td><td></td></tr>
                            }
                        </tbody>
                    </table>
                }
                else if (_aba == "apto")
                {
                    <div class="barra-filtro"><label>Torre <select @bind="_fTorre"><option value="">Selecione…</option>@foreach (var t in _torres) { <option value="@t.Id">@t.Codigo – @t.Nome</option> }</select></label></div>
                    @if (_fTorre is { } ft)
                    {
                        <table class="itens" id="orc-aptos">
                            <thead><tr><th>Apartamento</th><th>Tipologia</th><th class="num">Área priv.</th><th class="num">Custo direto</th><th class="num">R$/m²</th><th class="num">Serviços</th></tr></thead>
                            <tbody>
                                @foreach (var a in _aptosPorTorre[ft])
                                {
                                    var tot = _totais.GetValueOrDefault(a.Id);
                                    <tr @key="a.Id"><td>@a.Codigo</td><td>@_tips.GetValueOrDefault(a.TipologiaId ?? Guid.Empty)</td><td class="num">@a.AreaPrivativa?.ToString("N2", Br)</td><td class="num">@tot.Custo.ToString("N2", Br)</td>
                                        <td class="num">@(a.AreaPrivativa is > 0 ? (tot.Custo / a.AreaPrivativa.Value).ToString("N2", Br) : "")</td><td class="num">@_servicosApto.GetValueOrDefault(a.Id)</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                }
                else if (_aba == "cel")
                {
                    <div class="barra-filtro">
                        <label>Local (código começa com) <input @bind="_fCodigo" placeholder="QA-T01-P02" /></label>
                        <label>Serviço <select @bind="_fComp"><option value="">Todos</option>@foreach (var c in _comps.Values.OrderBy(c => c.Codigo)) { <option value="@c.Id">@c.Codigo – @c.Descricao</option> }</select></label>
                    </div>
                    <table class="itens" id="orc-celulas">
                        <thead><tr><th>Local</th><th>Serviço</th><th class="num">Quantidade</th><th class="num">Custo unit.</th><th class="num">Custo</th><th>Origem</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in Celulas().Take(500))
                            {
                                var l = _porId.GetValueOrDefault(c.LocalId);
                                <tr @key="(c.Id, _versaoCel)"><td>@l?.Codigo <span class="mudo">@l?.Nome</span></td><td>@_comps.GetValueOrDefault(c.ComposicaoId)?.Descricao</td>
                                    <td class="num"><input type="number" step="0.01" class="larg-100 texto-dir" value="@c.Quantidade.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="e => Editar(c, e.Value?.ToString())" /></td>
                                    <td class="num">@c.CustoUnitario.ToString("N2", Br)</td><td class="num">@c.Custo.ToString("N2", Br)</td>
                                    <td>@if (c.Travado) { <Selo Texto="manual (travada)" Tom="aviso" /> } else { <span class="mudo">@c.Origem</span> }</td>
                                    <td>@if (c.Travado) { <button class="btn sec pq" @onclick="() => Destravar(c)">Destravar</button> }</td></tr>
                            }
                        </tbody>
                    </table>
                    <p class="mudo">Editar a quantidade trava a célula (o gerador não altera). Mostrando até 500 células — filtre pelo código do local.</p>
                }
                else
                {
                    <div class="barra-filtro"><label>Requisitar <select id="ct-tipo" value="@_tipoCtr" @onchange="e => { _tipoCtr = Enum.Parse<TipoRequisicao>(e.Value!.ToString()!); _demanda = null; }"><option value="@TipoRequisicao.Servico">Serviço (contratar)</option><option value="@TipoRequisicao.Material">Material (comprar — sai das composições)</option></select></label>
                        <span class="mudo">Mesmo caminho da tela de requisição: itens com a quebra por local, SPE dos locais, faturamento padrão.</span></div>
                    <SeletorDemanda Servicos="_servicosCtr" Locais="_locais" ServicosSelecionados="_selComp" LocaisSelecionados="_selLoc" Demanda="_demanda"
                                    AoMudarSelecao="() => _demanda = null" AoCalcular="Previa" Ocupado="Ocupado"
                                    IdCalcular="ct-previa" IdTabela="ct-demanda" TituloServicos="@(_tipoCtr == TipoRequisicao.Material ? "1. Serviços (os materiais saem das composições)" : "1. Serviços a contratar")" TituloLocais="2. Locais (torres, pavimentos, apartamentos)"
                                    TextoCalcular="Ver quantidades" RotuloOrcado="Orçado nos locais" RotuloSaldo="@(_tipoCtr == TipoRequisicao.Material ? "Saldo a comprar" : "Saldo a contratar")" MostrarReferencia>
                        <Acoes>@if (_demanda is { Count: > 0 }) { <button class="btn prim" id="ct-req" disabled="@Ocupado" @onclick="CriarRequisicao"><Icone Nome="prancheta" Tam="14" /> Criar requisição de @(_tipoCtr == TipoRequisicao.Material ? "material" : "serviço")</button> }</Acoes>
                        <Nota><p class="mudo">A requisição sai com o serviço × local × quantidade (a cotação e o contrato levam essa planilha). A SPE vem dos locais.</p></Nota>
                    </SeletorDemanda>
                }
            }
        </div>
    </ChildContent>
    <Faixa><b>Orçamento</b><span>Serviços das tipologias × locais gerados = matriz serviço × local</span><span>Custo por SPE, torre, apartamento e m² · contratação por local</span></Faixa>
</Pagina>

@code {
    private sealed record LinhaServico(string? Grupo, string Servico, string Un, decimal Qtd, decimal Unit, decimal Custo, int N);
    private Guid? _obraId, _fTorre, _fComp;
    private string? _fCodigo;
    private string _aba = "serv";
    private List<ServicoLocal> _cels = [];
    private List<Local> _locais = [];
    private Dictionary<Guid, Local> _porId = [];
    private ILookup<Guid?, Local> _filhos = Array.Empty<Local>().ToLookup(l => l.LocalPaiId);
    private Dictionary<Guid, Composicao> _comps = [];
    private Dictionary<Guid, string> _tips = [];
    private decimal _areaPriv;
    private readonly HashSet<Guid> _selComp = [];
    private HashSet<Guid> _selLoc = [];
    private List<LinhaDemanda>? _demanda;
    private readonly Dictionary<Guid, HashSet<Guid>> _subCache = [];
    [SupplyParameterFromQuery(Name = "obra")] public Guid? ObraQuery { get; set; }
    // Pré-calculados no Carregar (nada de varrer células × locais a cada renderização)
    private decimal _total;
    private int _travadas, _versaoCel;
    private List<LinhaServico> _porServico = [];
    private List<Local> _conds = [], _torres = [];
    private ILookup<Guid, Local> _aptosPorTorre = Array.Empty<Local>().ToLookup(l => l.Id);
    private ILookup<Guid, ServicoLocal> _celsPorLocal = Array.Empty<ServicoLocal>().ToLookup(c => c.LocalId);
    private Dictionary<Guid, (decimal Custo, int Aptos, decimal Area)> _totais = [];
    private Dictionary<Guid, int> _servicosApto = [];
    private Dictionary<Guid, decimal> _comumCond = [];
    private Dictionary<Guid, HashSet<Guid>> _areasComunsCond = [];
    private List<SeletorDemanda.ItemServico> _servicosCtr = [];
    private TipoRequisicao _tipoCtr = TipoRequisicao.Servico;
    private List<ServicoLocal> _celsOrdenadas = [];
    private static readonly List<(string, string)> _abas = [("serv", "Por serviço"), ("spe", "Por condomínio e torre"), ("apto", "Por apartamento"), ("cel", "Células"), ("ctr", "Contratar / comprar")];

    // A obra inicial (?obra= ou a única permitida) vem do SeletorObra, que chama TrocarObra.
    private async Task TrocarObra(Guid? obra)
    {
        _obraId = obra;
        _selComp.Clear(); _selLoc = []; _fTorre = null; _fComp = null; _fCodigo = null; _demanda = null; ErrosForm = null;
        _cels = []; _locais = []; _porId = []; _filhos = Array.Empty<Local>().ToLookup(l => l.LocalPaiId);
        Precalcular();
        await Carregar();
    }

    private async Task Carregar()
    {
        _subCache.Clear(); _demanda = null;
        if (_obraId is not { } o) return;
        await using var db = Fabrica.CriarLeitura();
        _cels = await db.ServicosLocais.AsNoTracking().Where(s => s.ObraId == o).ToListAsync(Cancelamento);
        _locais = await db.Locais.AsNoTracking().Where(l => l.ObraId == o).ToListAsync(Cancelamento);
        _porId = _locais.ToDictionary(l => l.Id);
        _filhos = _locais.ToLookup(l => l.LocalPaiId);
        _comps = await db.Composicoes.AsNoTracking().Include(c => c.Itens).ToDictionaryAsync(c => c.Id, Cancelamento);
        _tips = await db.Tipologias.AsNoTracking().Where(t => t.ObraId == o).ToDictionaryAsync(t => t.Id, t => t.Codigo, Cancelamento);
        _areaPriv = _locais.Where(l => l.Tipo == GeradorEmpreendimento.TipoApartamento).Sum(l => l.AreaPrivativa ?? 0);
        Precalcular();
    }

    /// <summary>Totais por nó da árvore, áreas comuns por condomínio e listas usadas na tela — uma passada só.</summary>
    private void Precalcular()
    {
        _celsPorLocal = _cels.ToLookup(c => c.LocalId);
        _total = _cels.Sum(c => c.Custo);
        _travadas = _cels.Count(c => c.Travado);
        _porServico = _cels.GroupBy(c => c.ComposicaoId).Select(g =>
        {
            var c = _comps.GetValueOrDefault(g.Key);
            var q = g.Sum(x => x.Quantidade);
            var custo = g.Sum(x => x.Custo);
            return new LinhaServico(c?.Grupo, c is null ? "?" : $"{c.Codigo} – {c.Descricao}", c?.Unidade ?? "", q, q == 0 ? 0 : custo / q, custo, g.Count());
        }).OrderBy(x => x.Grupo).ThenBy(x => x.Servico).ToList();
        var comCelula = _cels.Select(c => c.ComposicaoId).ToHashSet();
        _servicosCtr = _comps.Values.Where(c => comCelula.Contains(c.Id)).OrderBy(c => c.Codigo)
                                .Select(c => new SeletorDemanda.ItemServico(c.Id, c.Codigo, c.Descricao, c.Unidade, c.Grupo)).ToList();
        _celsOrdenadas = _cels.OrderBy(c => _porId.GetValueOrDefault(c.LocalId)?.Codigo).ToList();
        _conds = _locais.Where(l => l.Tipo == GeradorEmpreendimento.TipoCondominio).OrderBy(l => l.Codigo).ToList();
        _torres = _locais.Where(l => l.Tipo == GeradorEmpreendimento.TipoTorre).OrderBy(l => l.Codigo).ToList();
        _areasComunsCond = _conds.ToDictionary(c => c.Id, c => _filhos[c.Id].Where(l => l.Tipo == GeradorEmpreendimento.TipoAreaComum).Select(l => l.Id).Append(c.Id).ToHashSet());
        _comumCond = _areasComunsCond.ToDictionary(kv => kv.Key, kv => kv.Value.Sum(id => _celsPorLocal[id].Sum(c => c.Custo)));

        // totais acumulados de baixo para cima (pós-ordem, sem recursão)
        _totais = new Dictionary<Guid, (decimal, int, decimal)>(_locais.Count);
        var ordem = new List<Local>(_locais.Count);
        var pilha = new Stack<Local>(_filhos[null]);
        while (pilha.Count > 0) { var l = pilha.Pop(); ordem.Add(l); foreach (var f in _filhos[l.Id]) pilha.Push(f); }
        for (var i = ordem.Count - 1; i >= 0; i--)
        {
            var l = ordem[i];
            var custo = _celsPorLocal[l.Id].Sum(c => c.Custo);
            var ap = l.Tipo == GeradorEmpreendimento.TipoApartamento ? 1 : 0;
            var area = ap == 1 ? l.AreaPrivativa ?? 0 : 0;
            foreach (var f in _filhos[l.Id]) if (_totais.TryGetValue(f.Id, out var t)) { custo += t.Custo; ap += t.Aptos; area += t.Area; }
            _totais[l.Id] = (custo, ap, area);
        }

        var aptos = _locais.Where(l => l.Tipo == GeradorEmpreendimento.TipoApartamento).ToList();
        _servicosApto = aptos.ToDictionary(a => a.Id, a => Sub(a.Id).SelectMany(id => _celsPorLocal[id]).Select(c => c.ComposicaoId).Distinct().Count());
        _aptosPorTorre = _torres.SelectMany(t => aptos.Where(a => Sub(t.Id).Contains(a.Id)).OrderBy(a => a.Codigo).Select(a => (Torre: t.Id, Apto: a)))
                                .ToLookup(x => x.Torre, x => x.Apto);
    }

    private HashSet<Guid> Sub(Guid id) => _subCache.TryGetValue(id, out var s) ? s : _subCache[id] = MotorOrcamento.Subarvore(id, _filhos);

    private (decimal Custo, int Aptos, decimal Area) Soma(Guid raiz) => _totais.GetValueOrDefault(raiz);

    private IEnumerable<ServicoLocal> Celulas() =>
        _celsOrdenadas.Where(c => (_fComp is null || c.ComposicaoId == _fComp) && (string.IsNullOrWhiteSpace(_fCodigo) || (_porId.GetValueOrDefault(c.LocalId)?.Codigo ?? "").StartsWith(_fCodigo.Trim(), StringComparison.OrdinalIgnoreCase)));

    private async Task Gerar()
    {
        ResultadoOrcamento? r = null;
        if (await Executar(async () => r = await Orc.GerarAsync(_obraId!.Value, ct: Cancelamento)))
        {
            Notif.Sucesso($"Orçamento atualizado: {r!.Criadas} células novas, {r.Atualizadas} atualizadas, {r.Removidas} removidas, {r.Travadas} travadas mantidas. Total {Rotulos.Moeda(r.Total)}.");
            await Carregar();
        }
    }

    private async Task Editar(ServicoLocal c, string? v)
    {
        if (string.IsNullOrWhiteSpace(v) || !LerDecimal(v, out var q) || q < 0)
        {
            ErrosForm = [$"Quantidade inválida: \"{v}\". Informe um número maior ou igual a zero."];
            Notif.Erro(ErrosForm[0]);
            _versaoCel++; // recria a linha para voltar ao valor salvo
            return;
        }
        if (await Executar(() => Orc.EditarCelulaAsync(c.Id, q, true, ct: Cancelamento), "Célula alterada e travada.")) await Carregar();
    }

    private async Task Destravar(ServicoLocal c)
    {
        if (await Executar(() => Orc.EditarCelulaAsync(c.Id, c.Quantidade, false, ct: Cancelamento), "Destravada — o próximo 'Gerar' recalcula pela tipologia.")) await Carregar();
    }

    private async Task Previa()
    {
        await Executar(async () => _demanda = await Orc.DemandaAsync(_obraId!.Value, _selComp, _selLoc, _tipoCtr, ct: Cancelamento));
    }

    private async Task CriarRequisicao()
    {
        Guid id = default;
        var ok = await Executar(async () =>
        {
            var grupo = _comps.GetValueOrDefault(_selComp.First())?.Grupo;
            id = await RequisicoesSrv.CriarDoOrcamentoAsync(_obraId!.Value, _tipoCtr, _demanda!, grupo, await Cat.ListaAsync(TipoLista.Atividade), Hoje, Cancelamento);
        }, $"Requisição de {(_tipoCtr == TipoRequisicao.Material ? "material" : "serviço")} criada — revise e envie para aprovação.");
        if (ok) Nav.NavigateTo($"requisicoes?id={id}");
    }
}
