@page "/engenharia/mao-de-obra"
@inherits PaginaBase
@inject MaoObraServico Mo

<Pagina Titulo="Mão de obra própria e apropriação" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="barra-filtro">
                <label>Obra <select id="mo-obra" value="@_obraId" @onchange="async e => { _obraId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; await Carregar(); }"><option value="">Selecione…</option>@foreach (var o in _obras) { <option value="@o.Id">@o.Texto</option> }</select></label>
                <label>Competência <input id="mo-mes" type="month" value="@_mes.ToString("yyyy-MM")" @onchange="TrocarMes" /></label>
            </div>
            @if (_obraId is null) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra.</div> }
            else
            {
                <Abas Itens="_abas" @bind-Ativa="_aba" />
                <Erros Lista="ErrosForm" />
                @if (_aba == "eq")
                {
                    <div style="margin:6px 0"><button class="btn sec" id="eq-nova" @onclick="NovaEquipe"><Icone Nome="mais" Tam="14" /> Nova equipe</button></div>
                    <table class="itens" id="equipes">
                        <thead><tr><th>Código</th><th>Equipe</th><th>Encarregado</th><th class="num">Membros</th><th>Ativa</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var eq in _equipes)
                            {
                                <tr><td><b>@eq.Codigo</b></td><td>@eq.Nome</td><td>@eq.Encarregado</td><td class="num">@eq.Membros.Count(m => m.Ate == null)</td><td>@(eq.Ativa ? "Sim" : "Não")</td><td><button class="btn sec pq" @onclick="() => { _e = eq; ErrosForm = null; _abertoEq = true; }">Editar</button></td></tr>
                            }
                            @if (_equipes.Count == 0) { <tr><td colspan="6" class="mudo">Cadastre as equipes próprias (ex.: Alvenaria 1, Acabamento 2). Os membros são os colaboradores próprios (Segurança e Pessoas › Colaboradores).</td></tr> }
                        </tbody>
                    </table>
                }
                else if (_aba == "custo")
                {
                    <div style="display:flex;gap:8px;margin:6px 0;flex-wrap:wrap">
                        <button class="btn sec" id="custo-add" @onclick="AddCusto"><Icone Nome="mais" Tam="14" /> Linha</button>
                        <button class="btn sec" id="custo-replicar" disabled="@Ocupado" @onclick="Replicar"><Icone Nome="atualizar" Tam="14" /> Replicar de @_mes.AddMonths(-1).ToString("MM/yyyy")</button>
                        <button class="btn prim" id="custo-salvar" disabled="@Ocupado" @onclick="SalvarCustos"><Icone Nome="check" Tam="14" /> Salvar custos do mês</button>
                    </div>
                    <table class="itens" id="custos">
                        <thead><tr><th>Equipe</th><th>Colaborador / função / descrição</th><th class="num">Pessoas</th><th class="num">Salário (R$/pessoa)</th><th class="num">Encargos %</th><th class="num">Benefícios (R$/pessoa)</th><th class="num">Outros (R$)</th><th class="num">Horas/mês</th><th class="num">Total</th><th class="num">R$/h</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in _custos)
                            {
                                <tr><td><select @bind="c.EquipeId"><option value="">—</option>@foreach (var eq in _equipes) { <option value="@eq.Id">@eq.Codigo</option> }</select></td>
                                    <td><select @bind="c.ColaboradorId"><option value="">(colaborador)</option>@foreach (var p in _colabs) { <option value="@p.Id">@p.Texto</option> }</select>
                                        <select style="margin-top:3px" @bind="c.FuncaoObraId"><option value="">(função)</option>@foreach (var f in _funcoes) { <option value="@f.Id">@f.Texto</option> }</select>
                                        <input style="margin-top:3px" @bind="c.Descricao" placeholder="Descrição (opcional)" /></td>
                                    <td style="width:70px"><input type="number" min="1" @bind="c.Pessoas" /></td>
                                    <td style="width:110px"><input type="number" step="0.01" @bind="c.Salario" /></td>
                                    <td style="width:80px"><input type="number" step="0.01" @bind="c.EncargosPerc" /></td>
                                    <td style="width:100px"><input type="number" step="0.01" @bind="c.Beneficios" /></td>
                                    <td style="width:100px"><input type="number" step="0.01" @bind="c.Outros" /></td>
                                    <td style="width:80px"><input type="number" step="1" @bind="c.HorasMes" /></td>
                                    <td class="num">@c.Total.ToString("N2", Br)</td><td class="num">@c.CustoHora.ToString("N2", Br)</td>
                                    <td><button class="icone-btn" @onclick="() => RemoverCusto(c)"><Icone Nome="lixeira" Tam="16" /></button></td></tr>
                            }
                            @if (_custos.Count == 0) { <tr><td colspan="11" class="mudo">Sem custos em @_mes.ToString("MM/yyyy"). Lance por equipe/colaborador ou replique o mês anterior e ajuste.</td></tr> }
                        </tbody>
                        <tfoot><tr><td colspan="8" style="text-align:right">Total do mês</td><td class="num"><b>@_custos.Sum(c => c.Total).ToString("N2", Br)</b></td><td colspan="2"></td></tr></tfoot>
                    </table>
                }
                else if (_aba == "apr")
                {
                    <div class="grade-2">
                        <div>
                            <div class="form">
                                <Campo Rotulo="Data" Obrigatorio Classe="s4"><input id="apr-data" type="date" @bind="_aData" /></Campo>
                                <Campo Rotulo="Equipe" Classe="s8"><select id="apr-equipe" @bind="_aEquipe"><option value="">—</option>@foreach (var eq in _equipes.Where(x => x.Ativa)) { <option value="@eq.Id">@eq.Codigo – @eq.Nome</option> }</select></Campo>
                                <Campo Rotulo="ou colaborador" Classe="s12"><select @bind="_aColab"><option value="">—</option>@foreach (var p in _colabs) { <option value="@p.Id">@p.Texto</option> }</select></Campo>
                                <Campo Rotulo="Serviço" Obrigatorio Classe="s12"><select id="apr-serv" @bind="_aComp"><option value="">Selecione…</option>@foreach (var c in _comps) { <option value="@c.Id">@c.Texto</option> }</select></Campo>
                                <Campo Rotulo="Horas trabalhadas (total)" Obrigatorio Classe="s4"><input id="apr-horas" type="number" step="0.5" @bind="_aHoras" /></Campo>
                                <Campo Rotulo="Quantidade executada" Classe="s4"><input type="number" step="0.01" @bind="_aQtd" /></Campo>
                                <Campo Rotulo="Observação" Classe="s12"><input @bind="_aObs" /></Campo>
                            </div>
                            <button class="btn prim" id="apr-lancar" disabled="@(Ocupado || _aLocais.Count == 0)" @onclick="Apropriar"><Icone Nome="check" Tam="14" /> Lançar em @_aLocais.Count local(is)</button>
                            <p class="mudo">As horas são rateadas entre os locais pelas quantidades orçadas do serviço.</p>
                        </div>
                        <div>
                            <div class="secao"><Icone Nome="predio" /> Locais (pavimentos, apartamentos…)</div>
                            <SeletorLocais Locais="_locais" Selecionados="_aLocais" SelecionadosChanged="StateHasChanged" />
                        </div>
                    </div>
                    <div class="secao"><Icone Nome="lista" /> Lançamentos de @_mes.ToString("MM/yyyy")</div>
                    <table class="itens" id="apropriacoes">
                        <thead><tr><th>Data</th><th>Equipe / colaborador</th><th>Serviço</th><th>Locais</th><th class="num">Horas</th><th class="num">Qtd. exec.</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var g in _aps.GroupBy(a => a.Lancamento).OrderByDescending(g => g.First().Data))
                            {
                                var a = g.First();
                                <tr><td>@a.Data.ToString("dd/MM")</td><td>@(_equipes.FirstOrDefault(x => x.Id == a.EquipeId)?.Codigo ?? _colabs.FirstOrDefault(c => c.Id == a.ColaboradorId)?.Texto ?? "(sem equipe)")</td>
                                    <td>@_comps.FirstOrDefault(c => c.Id == a.ComposicaoId)?.Texto</td><td>@string.Join(", ", g.Select(x => _porId.GetValueOrDefault(x.LocalId)?.Codigo).Take(4))@(g.Count() > 4 ? $" +{g.Count() - 4}" : "")</td>
                                    <td class="num">@g.Sum(x => x.Horas).ToString("N1", Br)</td><td class="num">@g.Sum(x => x.QuantidadeExecutada ?? 0).ToString("N2", Br)</td>
                                    <td><button class="icone-btn" title="Excluir lançamento" @onclick="() => Excluir(g.Key)"><Icone Nome="lixeira" Tam="16" /></button></td></tr>
                            }
                            @if (_aps.Count == 0) { <tr><td colspan="7" class="mudo">Nenhum lançamento no mês.</td></tr> }
                        </tbody>
                    </table>
                }
                else if (_fech is not null)
                {
                    <div class="kpis">
                        <Kpi Rotulo="Custo da mão de obra no mês" Valor="@_fech.CustoTotal.ToString("C2", Br)" />
                        <Kpi Rotulo="Horas apropriadas" Valor="@_fech.HorasApropriadas.ToString("N1", Br)" Tom="info" />
                        <Kpi Rotulo="Custo-hora médio real" Valor="@(_fech.HorasApropriadas == 0 ? "—" : (_fech.CustoTotal / _fech.HorasApropriadas).ToString("N2", Br))" Tom="info" />
                        <Kpi Rotulo="Custo sem apropriação" Valor="@_fech.CustoSemApropriacao.ToString("C2", Br)" Sub="lance as horas dessas equipes" Tom="@(_fech.CustoSemApropriacao > 0 ? "aviso" : "ok")" />
                    </div>
                    <table class="itens" id="fech-equipes">
                        <thead><tr><th>Equipe</th><th class="num">Custo do mês</th><th class="num">Horas apropriadas</th><th class="num">Custo-hora real</th></tr></thead>
                        <tbody>@foreach (var eq in _fech.Equipes) { <tr><td>@(eq.EquipeId is null ? "(sem equipe)" : _equipes.FirstOrDefault(x => x.Id == eq.EquipeId)?.Nome)</td><td class="num">@eq.CustoMes.ToString("N2", Br)</td><td class="num">@eq.HorasApropriadas.ToString("N1", Br)</td><td class="num">@eq.CustoHoraReal.ToString("N2", Br)</td></tr> }</tbody>
                    </table>
                    <div class="secao"><Icone Nome="tabela" /> Realizado × orçado (mão de obra própria) por serviço</div>
                    <table class="itens" id="fech-servicos">
                        <thead><tr><th>Serviço</th><th class="num">Horas</th><th class="num">Custo real</th><th class="num">Qtd. executada</th><th class="num">R$/un real</th><th class="num">R$/un orçado (M.O. própria)</th></tr></thead>
                        <tbody>
                            @foreach (var g in _fech.Celulas.GroupBy(c => c.ComposicaoId))
                            {
                                var comp = _compsObj.GetValueOrDefault(g.Key);
                                var qtd = _aps.Where(a => a.ComposicaoId == g.Key).Sum(a => a.QuantidadeExecutada ?? 0);
                                <tr><td>@(comp is null ? "?" : $"{comp.Codigo} – {comp.Descricao}")</td><td class="num">@g.Sum(x => x.Horas).ToString("N1", Br)</td><td class="num">@g.Sum(x => x.Custo).ToString("N2", Br)</td>
                                    <td class="num">@qtd.ToString("N2", Br)</td><td class="num">@(qtd == 0 ? "—" : (g.Sum(x => x.Custo) / qtd).ToString("N2", Br))</td><td class="num">@comp?.Custo(TipoInsumo.MaoObraPropria).ToString("N2", Br)</td></tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>
    </ChildContent>
    <Faixa><b>Mão de obra própria</b><span>Equipes · custo mensal (replicável) · horas por serviço × local</span><span>Fechamento: custo-hora real e realizado × orçado</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_abertoEq" Titulo="Equipe" Tamanho="media">
    <ChildContent>
        @if (_e is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Código" Obrigatorio Classe="s3"><input id="eq-cod" @bind="_e.Codigo" placeholder="ALV1" /></Campo>
                <Campo Rotulo="Nome" Obrigatorio Classe="s6"><input id="eq-nome" @bind="_e.Nome" placeholder="Alvenaria 1" /></Campo>
                <Campo Rotulo="" Classe="s3"><label><input type="checkbox" @bind="_e.Ativa" /> Ativa</label></Campo>
                <Campo Rotulo="Encarregado" Classe="s12"><input @bind="_e.Encarregado" /></Campo>
            </div>
            <div class="secao"><Icone Nome="pessoa" /> Membros <span class="acao"><button class="btn sec pq" @onclick="() => _e.Membros.Add(new EquipeMembro { EquipeId = _e.Id, Desde = Hoje })"><Icone Nome="mais" Tam="14" /> Membro</button></span></div>
            <table class="itens"><thead><tr><th>Colaborador</th><th>Desde</th><th>Até</th><th></th></tr></thead>
                <tbody>@foreach (var m in _e.Membros)
                {
                    <tr><td><select @bind="m.ColaboradorId"><option value="@Guid.Empty">—</option>@foreach (var p in _colabs) { <option value="@p.Id">@p.Texto</option> }</select></td><td><input type="date" @bind="m.Desde" /></td><td><input type="date" @bind="m.Ate" /></td>
                        <td><button class="icone-btn" @onclick="() => _e.Membros.Remove(m)"><Icone Nome="lixeira" Tam="16" /></button></td></tr>
                }</tbody></table>
            @if (_colabs.Count == 0) { <div class="alerta aviso"><Icone Nome="alerta" /> Nenhum colaborador próprio nesta obra. Cadastre em Segurança e Pessoas › Colaboradores (vínculo próprio).</div> }
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="eq-salvar" disabled="@Ocupado" @onclick="SalvarEquipe"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

@code {
    private List<Opcao> _obras = [], _funcoes = [], _colabs = [], _comps = [];
    private Guid? _obraId, _aEquipe, _aColab, _aComp;
    private DateOnly _mes;
    private string _aba = "eq";
    private List<Equipe> _equipes = [];
    private List<CustoMaoObraMes> _custos = [];
    private readonly List<Guid> _removidos = [];
    private List<Apropriacao> _aps = [];
    private List<Local> _locais = [];
    private Dictionary<Guid, Local> _porId = [];
    private Dictionary<Guid, Composicao> _compsObj = [];
    private FechamentoMes? _fech;
    private Equipe? _e;
    private bool _abertoEq;
    private DateOnly _aData;
    private decimal _aHoras;
    private decimal? _aQtd;
    private string? _aObs;
    private HashSet<Guid> _aLocais = [];
    private static readonly List<(string, string)> _abas = [("eq", "Equipes"), ("custo", "Custos do mês"), ("apr", "Apropriação de horas"), ("fech", "Fechamento do mês")];

    protected override async Task OnInitializedAsync()
    {
        _mes = new DateOnly(Hoje.Year, Hoje.Month, 1); _aData = Hoje;
        _obras = await Cat.ObrasAsync(); _funcoes = await Cat.FuncoesAsync();
        if (_obras.Count == 1) _obraId = _obras[0].Id;
        await Carregar();
    }

    private async Task Carregar()
    {
        if (_obraId is not { } o) return;
        _removidos.Clear();
        await using var db = Fabrica.Criar();
        _equipes = await db.Equipes.AsNoTracking().Include(e => e.Membros).Where(e => e.ObraId == o).OrderBy(e => e.Codigo).ToListAsync();
        _colabs = await db.Colaboradores.AsNoTracking().Where(c => c.ObraId == o && c.Vinculo == VinculoColaborador.Proprio && c.DataSaida == null).OrderBy(c => c.Nome).Select(c => new Opcao(c.Id, c.Nome)).ToListAsync();
        _custos = await db.CustosMaoObra.AsNoTracking().Where(c => c.ObraId == o && c.Competencia == _mes).ToListAsync();
        var fim = _mes.AddMonths(1);
        _aps = await db.Apropriacoes.AsNoTracking().Where(a => a.ObraId == o && a.Data >= _mes && a.Data < fim).ToListAsync();
        _locais = await db.Locais.AsNoTracking().Where(l => l.ObraId == o).ToListAsync();
        _porId = _locais.ToDictionary(l => l.Id);
        var usados = await db.ServicosLocais.AsNoTracking().Where(s => s.ObraId == o).Select(s => s.ComposicaoId).Distinct().ToListAsync();
        _compsObj = await db.Composicoes.AsNoTracking().Include(c => c.Itens).ToDictionaryAsync(c => c.Id);
        _comps = _compsObj.Values.Where(c => c.Ativa && (usados.Contains(c.Id) || usados.Count == 0)).OrderBy(c => c.Codigo).Select(c => new Opcao(c.Id, $"{c.Codigo} – {c.Descricao}", c.Unidade)).ToList();
        _fech = await Mo.FechamentoAsync(o, _mes);
    }

    private async Task TrocarMes(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact(e.Value + "-01", "yyyy-MM-dd", out var d)) { _mes = d; await Carregar(); }
    }

    private void NovaEquipe() { _e = new Equipe { ObraId = _obraId!.Value }; ErrosForm = null; _abertoEq = true; }
    private async Task SalvarEquipe()
    {
        _e!.Membros = _e.Membros.Where(m => m.ColaboradorId != Guid.Empty).ToList();
        if (await Executar(() => Mo.SalvarEquipeAsync(_e), "Equipe salva.")) { _abertoEq = false; await Carregar(); }
    }

    private void AddCusto() => _custos.Add(new CustoMaoObraMes { ObraId = _obraId!.Value, Competencia = _mes, EncargosPerc = 80, HorasMes = 220 });
    private void RemoverCusto(CustoMaoObraMes c) { _custos.Remove(c); if (c.CriadoEm != default) _removidos.Add(c.Id); }

    private async Task SalvarCustos()
    {
        if (await Executar(async () =>
        {
            foreach (var id in _removidos) await Mo.ExcluirCustoAsync(id);
            foreach (var c in _custos) await Mo.SalvarCustoAsync(c);
        }, "Custos do mês salvos.")) await Carregar();
    }

    private async Task Replicar()
    {
        int n = 0;
        if (await Executar(async () => n = await Mo.ReplicarAsync(_obraId!.Value, _mes.AddMonths(-1), _mes)))
        { Notif.Sucesso($"{n} linha(s) replicada(s) de {_mes.AddMonths(-1):MM/yyyy}. Ajuste e salve."); await Carregar(); }
    }

    private async Task Apropriar()
    {
        int n = 0;
        if (await Executar(async () => n = await Mo.ApropriarAsync(_obraId!.Value, _aData, _aEquipe, _aColab, _aComp ?? Guid.Empty, _aLocais, _aHoras, _aQtd, _aObs)))
        { Notif.Sucesso($"Horas lançadas em {n} local(is)."); _aLocais = []; _aHoras = 0; _aQtd = null; _aObs = null; await Carregar(); }
    }

    private async Task Excluir(Guid lanc)
    {
        if (await Executar(() => Mo.ExcluirLancamentoAsync(lanc), "Lançamento excluído.")) await Carregar();
    }
}
