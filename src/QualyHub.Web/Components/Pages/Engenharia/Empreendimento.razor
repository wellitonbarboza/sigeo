@page "/engenharia/obras"
@page "/engenharia/empreendimento"
@inherits PaginaBase
@inject EngenhariaServico Eng
@inject QualidadeObraServico Qob
@inject NavigationManager Nav

<Pagina Titulo="Obras e empreendimentos" AoNovo="Novo" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="barra-filtro">
                <label>Obra / empreendimento <select id="sel-obra" value="@_obraId" @onchange="e => TrocarObra(e.Value?.ToString())"><option value="">Selecione…</option>@foreach (var o in _todasObras) { <option value="@o.Id">@($"{o.Codigo} – {o.Nome}{(o.Ativa ? "" : " (inativa)")}")</option> }</select></label>
                <button class="btn sec" id="nova-obra" @onclick="NovaObra"><Icone Nome="mais" Tam="14" /> Nova obra</button>
                @if (_obraId is not null) { <a class="btn sec" href="engenharia/tipologias"><Icone Nome="lista" Tam="14" /> Tipologias</a><a class="btn sec" href="engenharia/orcamento"><Icone Nome="calculadora" Tam="14" /> Orçamento</a> }
            </div>
            @if (_obraId is null && _o is null) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra ou cadastre uma nova. Estrutura: Obra › Condomínio (= SPE, 1 CNPJ) › Torre › Pavimento › Apartamento › Cômodo, com áreas comuns no condomínio, na torre e no pavimento.</div> }
            else
            {
                @if (_obraId is not null) { <Abas Itens="_abas" @bind-Ativa="_aba" /> }
                <Erros Lista="ErrosForm" />
                @if (_aba == "obra" || _obraId is null)
                {
                    @if (_o is not null)
                    {
                        <div class="form" id="form-obra" style="margin-top:10px">
                            <Campo Rotulo="Código" Obrigatorio Classe="s2"><input id="obra-cod" @bind="_o.Codigo" /></Campo>
                            <Campo Rotulo="Nome da obra / empreendimento" Obrigatorio Classe="s6"><input id="obra-nome" @bind="_o.Nome" /></Campo>
                            <Campo Rotulo="Status" Classe="s2"><select @bind="_o.Status">@foreach (var st in Enum.GetValues<StatusObra>()) { <option value="@st">@De(st)</option> }</select></Campo>
                            <Campo Rotulo="Situação" Classe="s2"><label class="check-linha"><input type="checkbox" @bind="_o.Ativa" /> Ativa</label></Campo>
                            <Campo Rotulo="Endereço de entrega padrão" Obrigatorio Classe="s8"><input id="obra-end" @bind="_o.EnderecoEntrega" /></Campo>
                            <Campo Rotulo="Início" Classe="s2"><input type="date" @bind="_o.DataInicio" /></Campo>
                            <Campo Rotulo="Término previsto" Classe="s2"><input type="date" @bind="_o.DataPrevistaTermino" /></Campo>
                            <Campo Rotulo="Cidade" Classe="s4"><input @bind="_o.Cidade" /></Campo>
                            <Campo Rotulo="UF" Classe="s2"><input @bind="_o.Uf" maxlength="2" style="text-transform:uppercase" /></Campo>
                            <Campo Rotulo="Código no ERP" Classe="s3"><input @bind="_o.CodigoErp" /></Campo>
                            <Campo Rotulo="PQO (Plano da Qualidade)" Classe="s3"><select @bind="_o.PqoDocumentoId"><option value="">—</option>@foreach (var d in _docs) { <option value="@d.Id">@d.Texto</option> }</select></Campo>
                            <Campo Rotulo="Engenheiro responsável (1º nível)" Obrigatorio Classe="s4"><select id="obra-eng" @bind="_o.EngenheiroId"><option value="">—</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                            <Campo Rotulo="Administrativo de obra" Classe="s4"><select @bind="_o.AdministrativoId"><option value="">—</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                            <Campo Rotulo="Almoxarife" Classe="s4"><select @bind="_o.AlmoxarifeId"><option value="">—</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                            <Campo Rotulo="Observações" Classe="s12"><textarea rows="2" @bind="_o.Observacoes"></textarea></Campo>
                        </div>
                        <div style="display:flex;gap:8px;justify-content:flex-end;margin:12px 0">
                            @if (_obraId is null) { <button class="btn sec" @onclick="() => { _o = null; ErrosForm = null; }">Cancelar</button> }
                            <button class="btn prim" id="obra-salvar" disabled="@Ocupado" @onclick="SalvarObra"><Icone Nome="check" Tam="16" /> Salvar obra</button>
                        </div>
                        @if (_obraId is not null)
                        {
                            <div class="secao"><Icone Nome="predio" /> Condomínios (SPEs) desta obra</div>
                            <ResumoCondominios Linhas="_resumo" />
                        }
                    }
                }
                else if (_aba == "cond")
                {
                    <div style="margin:6px 0"><button class="btn sec" id="novo-cond" @onclick="Novo"><Icone Nome="mais" Tam="14" /> Novo condomínio (SPE)</button></div>
                    <table class="itens" id="condominios">
                        <thead><tr><th>Sigla</th><th>Condomínio</th><th>Tipo</th><th>SPE (CNPJ que é dono do custo)</th><th>Implantação</th><th class="num">Torres</th><th class="num">Aptos</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var q in _quadras)
                            {
                                var sp = _spes.FirstOrDefault(x => x.QuadraId == q.Id);
                                var r = _resumo.FirstOrDefault(x => x.QuadraId == q.Id);
                                <tr><td><b>@q.Codigo</b></td><td>@q.Nome</td><td>@q.Tipo</td>
                                    <td>@if (sp is null) { <Selo Texto="sem SPE" Tom="aviso" /> } else { <span>@sp.NomeExibicao · @sp.Cnpj</span> }</td>
                                    <td>@_tips.FirstOrDefault(t => t.Id == q.ImplantacaoId)?.Codigo</td>
                                    <td class="num">@r?.Torres</td><td class="num">@r?.Apartamentos</td>
                                    <td><button class="btn sec pq" @onclick="() => EditarCond(q)">Editar</button> @if (!q.Ativa) { <Selo Texto="Inativo" Tom="aviso" /> }</td></tr>
                            }
                            @if (_quadras.Count == 0) { <tr><td colspan="8" class="mudo">Nenhum condomínio. Cadastre um por SPE (ex.: Condomínio Dona Irene · Quadra A).</td></tr> }
                        </tbody>
                    </table>
                    <div class="alerta info"><Icone Nome="info" /> 1 condomínio = 1 SPE (CNPJ próprio). As torres, apartamentos e áreas comuns do condomínio são da SPE. A implantação (tipologia) define as áreas comuns do condomínio.</div>
                }
                else if (_aba == "ger")
                {
                    <div class="secao"><Icone Nome="tabela" /> Resumo por condomínio</div>
                    <ResumoCondominios Linhas="_resumo" />

                    <div class="secao"><Icone Nome="mais" /> Gerar torres no condomínio</div>
                    @if (_quadras.Count == 0 || !_tips.Any(t => t.Tipo == TipoTipologia.Torre)) { <div class="alerta aviso"><Icone Nome="info" /> Cadastre o condomínio (com a SPE) e as tipologias de apartamento e de torre antes de gerar.</div> }
                    else
                    {
                        <div class="form">
                            <Campo Rotulo="Condomínio" Obrigatorio Classe="s6"><select id="g-cond" @bind="_gQuadraId"><option value="">Selecione…</option>@foreach (var q in _quadras.Where(q => q.Ativa)) { <option value="@q.Id">@q.Codigo – @q.Nome</option> }</select></Campo>
                        </div>
                        <table class="itens" id="g-torres">
                            <thead><tr><th>Torre</th><th>Tipologia da torre</th><th class="num">Pavimentos</th><th class="num">Aptos</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var t in _gTorres)
                                {
                                    var tt = _tips.FirstOrDefault(x => x.Id == t.TipologiaId);
                                    <tr><td><input @bind="t.Nome" style="width:160px" /></td>
                                        <td><select @bind="t.TipologiaId"><option value="@Guid.Empty">—</option>@foreach (var x in _tips.Where(x => x.Tipo == TipoTipologia.Torre)) { <option value="@x.Id">@x.Codigo – @x.Nome</option> }</select></td>
                                        <td class="num">@tt?.Pavimentos</td><td class="num">@(tt is null ? "" : AptosTorre(tt).ToString())</td>
                                        <td><button class="btn sec pq" @onclick="() => _gTorres.Remove(t)">Remover</button></td></tr>
                                }
                            </tbody>
                        </table>
                        <div style="display:flex;gap:8px;margin:8px 0;flex-wrap:wrap">
                            <button class="btn sec" id="g-add" @onclick="AddTorre"><Icone Nome="mais" Tam="14" /> Torre</button>
                            <button class="btn prim" id="g-gerar" disabled="@Ocupado" @onclick="Gerar"><Icone Nome="check" Tam="16" /> Gerar @_gTorres.Sum(t => _tips.FirstOrDefault(x => x.Id == t.TipologiaId) is { } tt ? AptosTorre(tt) : 0) apartamentos</button>
                            <button class="btn sec" id="g-sinc" disabled="@Ocupado" @onclick="Sincronizar" title="Atualiza as medidas dos cômodos/áreas comuns e cria os ambientes incluídos nas tipologias depois da geração"><Icone Nome="atualizar" Tam="14" /> Sincronizar com as tipologias</button>
                        </div>
                        <div class="alerta info"><Icone Nome="info" /> Pode gerar em etapas: torres novas entram no condomínio já existente. Código: CONDOMÍNIO-T01-P02-201-SAL (pavimento × 100 + sequência; cômodo pela sigla). Fração ideal = área privativa ÷ área do condomínio; substitua pela do memorial na aba Apartamentos.</div>
                    }
                }
                else if (_aba == "loc")
                {
                    <div class="barra-filtro">
                        <label>Ver <select @bind="_fLocal"><option value="">Condomínios e torres (sem pavimentos)</option>@foreach (var t in _locais.Where(l => l.Tipo == GeradorEmpreendimento.TipoTorre).OrderBy(l => l.Codigo)) { <option value="@t.Id">@t.Codigo – @t.Nome (completo)</option> }</select></label>
                        <button class="btn sec" id="novo-local" @onclick="NovoLocal"><Icone Nome="mais" Tam="14" /> Área comum / elemento</button>
                        <span class="mudo">@_locais.Count locais · condomínio, torre, pavimento, apartamento e cômodo vêm do gerador.</span>
                    </div>
                    <table class="itens" id="locais">
                        <thead><tr><th>Código</th><th>Local</th><th>Nível</th><th>Categoria</th><th class="num">Piso (m²)</th><th class="num">Perím. (m)</th><th class="num">Parede (m²)</th><th>QR</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var (l, nivel) in Arvore().Take(3000))
                            {
                                <tr><td style="padding-left:@(8 + nivel * 16)px">@l.Codigo</td><td>@l.Nome</td><td>@l.Tipo</td><td>@l.Categoria</td>
                                    <td class="num">@l.AreaPiso?.ToString("N2", Br)</td><td class="num">@l.Perimetro?.ToString("N2", Br)</td><td class="num">@l.AreaParede?.ToString("N2", Br)</td>
                                    <td><a title="QR do local (abre a FVS no celular)" href="campo/local/@l.QrToken" target="_blank" data-enhance-nav="false"><Icone Nome="qr" Tam="16" /></a></td>
                                    <td><button class="btn sec pq" @onclick="() => EditarLocal(l)">Editar</button></td></tr>
                            }
                            @if (_locais.Count == 0) { <tr><td colspan="9" class="mudo">Sem locais. Gere a estrutura na aba Gerador.</td></tr> }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="barra-filtro">
                        <label>Condomínio <select @bind="_fCond"><option value="">Todos</option>@foreach (var q in _quadras) { <option value="@q.Id">@q.Codigo – @q.Nome</option> }</select></label>
                        <button class="btn sec" disabled="@(Ocupado || _editadas.Count == 0)" @onclick="SalvarFracoes"><Icone Nome="check" Tam="14" /> Salvar frações (@_editadas.Count)</button>
                        @if (_fCond is { } fq) { <button class="btn sec" disabled="@Ocupado" @onclick="() => Recalcular(fq)">Recalcular pela área</button> }
                    </div>
                    <table class="itens" id="unidades">
                        <thead><tr><th>Código</th><th>Apartamento</th><th>Tipologia</th><th class="num">Área priv. (m²)</th><th class="num">Fração ideal no condomínio (%)</th></tr></thead>
                        <tbody>
                            @foreach (var u in UnidadesFiltradas)
                            {
                                <tr><td>@u.Codigo</td><td>@u.Nome</td><td>@_tips.FirstOrDefault(t => t.Id == u.TipologiaId)?.Codigo</td>
                                    <td class="num">@u.AreaPrivativa?.ToString("N2", Br)</td>
                                    <td class="num"><input type="number" step="0.000001" style="width:110px;text-align:right" value="@(((u.FracaoIdeal ?? 0) * 100).ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture))"
                                        @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v)) { u.FracaoIdeal = Math.Round(v / 100, 8); _editadas[u.Id] = u.FracaoIdeal.Value; } }" /></td></tr>
                            }
                            @if (!UnidadesFiltradas.Any()) { <tr><td colspan="5" class="mudo">Nenhum apartamento. Use a aba Gerador.</td></tr> }
                        </tbody>
                    </table>
                }
            }
        </div>
    </ChildContent>
    <Faixa><b>Engenharia · Estrutura</b><span>1 condomínio = 1 SPE = 1 CNPJ · torres, pavimentos, apartamentos e cômodos gerados pelas tipologias</span><span>Fração ideal confere 100% por condomínio</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_abertoCond" Titulo="Condomínio e SPE" Tamanho="grande">
    <ChildContent>
        @if (_q is not null && _s is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="secao"><Icone Nome="predio" /> Condomínio</div>
            <div class="form">
                <Campo Rotulo="Sigla" Obrigatorio Classe="s2" Ajuda="Usada nos códigos (ex.: QA)"><input id="qua-sigla" @bind="_q.Codigo" maxlength="6" style="text-transform:uppercase" disabled="@(_q.LocalId != null)" /></Campo>
                <Campo Rotulo="Nome" Obrigatorio Classe="s5"><input id="qua-nome" @bind="_q.Nome" placeholder="Condomínio Dona Irene" /></Campo>
                <Campo Rotulo="Tipo" Obrigatorio Classe="s2"><select id="qua-tipo" @bind="_q.Tipo">@foreach (var t in _tiposAgrup) { <option>@t</option> }</select></Campo>
                <Campo Rotulo="Implantação (áreas comuns)" Classe="s3"><select id="qua-impl" @bind="_q.ImplantacaoId"><option value="">—</option>@foreach (var t in _tips.Where(t => t.Tipo == TipoTipologia.Implantacao)) { <option value="@t.Id">@t.Codigo – @t.Nome</option> }</select></Campo>
                <Campo Rotulo="Nome do condomínio (registro)" Classe="s6"><input id="qua-cond" @bind="_q.NomeCondominio" /></Campo>
                <Campo Rotulo="CNPJ do condomínio (após instalação)" Classe="s6"><input @bind="_q.CnpjCondominio" /></Campo>
                <Campo Rotulo="Endereço" Classe="s8"><input @bind="_q.Endereco" /></Campo>
                <Campo Rotulo="Matrícula do terreno" Classe="s2"><input @bind="_q.Matricula" /></Campo>
                <Campo Rotulo="Área do terreno (m²)" Classe="s2"><input id="qua-area" type="number" step="0.01" @bind="_q.AreaTerreno" /></Campo>
                <Campo Rotulo="Ordem" Classe="s2"><input type="number" @bind="_q.Ordem" /></Campo>
                <Campo Rotulo="" Classe="s2"><label><input type="checkbox" @bind="_q.Ativa" /> Ativo</label></Campo>
            </div>
            <div class="secao"><Icone Nome="contrato" /> SPE (CNPJ dono do custo do condomínio)</div>
            <div class="form">
                <Campo Rotulo="Sigla da SPE" Obrigatorio Classe="s2"><input id="spe-sigla" @bind="_s.Codigo" maxlength="10" style="text-transform:uppercase" /></Campo>
                <Campo Rotulo="CNPJ" Obrigatorio Classe="s3"><input id="spe-cnpj" @bind="_s.Cnpj" /></Campo>
                <Campo Rotulo="Razão social" Obrigatorio Classe="s7"><input id="spe-razao" @bind="_s.RazaoSocial" /></Campo>
                <Campo Rotulo="Nome curto" Classe="s4"><input id="spe-nome" @bind="_s.NomeFantasia" placeholder="Dona Irene" /></Campo>
                <Campo Rotulo="Inscrição estadual" Classe="s4"><input @bind="_s.InscricaoEstadual" /></Campo>
                <Campo Rotulo="E-mail para NF" Classe="s4"><input type="email" @bind="_s.EmailFiscal" /></Campo>
                <Campo Rotulo="Endereço de faturamento" Classe="s8"><input @bind="_s.EnderecoFaturamento" /></Campo>
                <Campo Rotulo="Patrimônio de afetação / RET" Classe="s4"><select @bind="_s.PatrimonioAfetacao"><option>Indefinido</option><option>Sim</option><option>Não</option></select></Campo>
            </div>
            <div class="alerta info"><Icone Nome="info" /> A SPE vira também um estabelecimento (Cadastro › Estabelecimentos). As compras de material saem faturadas pela fábrica e identificadas com a SPE de destino.</div>
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="cond-salvar" disabled="@Ocupado" @onclick="SalvarCond"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

<Modal @bind-Aberto="_abertoLoc" Titulo="Local da obra" Tamanho="media">
    <ChildContent>
        @if (_l is not null)
        {
            var gerado = (GeradorEmpreendimento.Gerados.Contains(_l.Tipo) || _l.AmbienteModeloId != null) && _l.CriadoEm != default;
            <Erros Lista="ErrosForm" />
            @if (gerado) { <div class="alerta info"><Icone Nome="info" /> Local gerado pelas tipologias: só a descrição pode ser alterada (medidas: altere a tipologia e sincronize).</div> }
            <div class="form">
                <Campo Rotulo="Código" Obrigatorio Classe="s4"><input id="loc-cod" @bind="_l.Codigo" disabled="@gerado" placeholder="QA-AC-PISC" /></Campo>
                <Campo Rotulo="Descrição" Obrigatorio Classe="s8"><input id="loc-nome" @bind="_l.Nome" placeholder="Piscina" /></Campo>
                <Campo Rotulo="Nível" Classe="s4"><select id="loc-tipo" @bind="_l.Tipo" disabled="@gerado">@if (gerado) { <option>@_l.Tipo</option> } else { @foreach (var n in TiposManuais) { <option>@n</option> } }</select></Campo>
                <Campo Rotulo="Local pai" Classe="s8"><select @bind="_l.LocalPaiId" disabled="@gerado"><option value="">(raiz da obra)</option>@foreach (var x in _locais.Where(x => x.Id != _l.Id && x.Tipo is "Condomínio" or "Torre" or "Pavimento")) { <option value="@x.Id">@x.Codigo – @x.Nome</option> }</select></Campo>
                <Campo Rotulo="Área de piso (m²)" Classe="s4"><input type="number" step="0.01" @bind="_l.AreaPiso" disabled="@gerado" /></Campo>
                <Campo Rotulo="Perímetro (m)" Classe="s4"><input type="number" step="0.01" @bind="_l.Perimetro" disabled="@gerado" /></Campo>
                <Campo Rotulo="Área de parede (m²)" Classe="s4"><input type="number" step="0.01" @bind="_l.AreaParede" disabled="@gerado" /></Campo>
                <Campo Rotulo="Ordem" Classe="s4"><input type="number" @bind="_l.Ordem" /></Campo>
            </div>
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="loc-salvar" disabled="@Ocupado" @onclick="SalvarLocal"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

@code {
    private sealed class TorreForm { public string Nome { get; set; } = ""; public Guid TipologiaId { get; set; } }

    private List<Spe> _spes = [];
    private List<Tipologia> _tips = [];
    private List<Local> _unid = [];
    private List<LinhaResumoCondominio> _resumo = [];
    private readonly Dictionary<Guid, decimal> _editadas = [];
    private Spe? _s;
    private Quadra? _q;
    private List<Quadra> _quadras = [];
    private List<string> _tiposAgrup = [];
    private Guid? _obraId, _gQuadraId, _fLocal, _fCond;
    private bool _abertoCond, _abertoLoc;
    private string _aba = "obra";
    private List<TorreForm> _gTorres = [];
    private static readonly List<(string, string)> _abas = [("obra", "Dados da obra"), ("cond", "Condomínios (SPE)"), ("ger", "Gerador e resumo"), ("uni", "Apartamentos e fração ideal"), ("loc", "Locais")];
    private static readonly string[] TiposManuais = [GeradorEmpreendimento.TipoAreaComum, "Elemento", "Infraestrutura", "Canteiro"];
    private List<Obra> _todasObras = [];
    private Obra? _o;
    private Local? _l;
    private List<Local> _locais = [];
    private List<Opcao> _usuarios = [], _docs = [];

    private int AptosTorre(Tipologia t) => Enumerable.Range(1, Math.Max(0, t.Pavimentos)).Sum(p => t.Mix.Where(m => p >= m.PavimentoDe && p <= m.PavimentoAte).Sum(m => m.Quantidade));

    private IEnumerable<(Local, int)> Arvore()
    {
        var filhos = _locais.ToLookup(l => l.LocalPaiId);
        IEnumerable<(Local, int)> Desce(Guid? pai, int n, bool completo)
        {
            foreach (var l in filhos[pai].OrderBy(l => l.Tipo == GeradorEmpreendimento.TipoAreaComum ? 0 : 1).ThenBy(l => l.Ordem).ThenBy(l => l.Codigo))
            {
                yield return (l, n);
                var abrir = completo || l.Tipo == GeradorEmpreendimento.TipoCondominio || (l.Tipo == GeradorEmpreendimento.TipoTorre && l.Id == _fLocal);
                if (!abrir && l.Tipo == GeradorEmpreendimento.TipoTorre) { foreach (var f in filhos[l.Id].Where(f => f.Tipo == GeradorEmpreendimento.TipoAreaComum)) yield return (f, n + 1); continue; }
                foreach (var f in Desce(l.Id, n + 1, completo || l.Id == _fLocal)) yield return f;
            }
        }
        var ids = _locais.Select(l => l.Id).ToHashSet();
        var raizes = _locais.Where(l => l.LocalPaiId is null || !ids.Contains(l.LocalPaiId.Value)).Select(l => l.LocalPaiId).Distinct();
        return raizes.SelectMany(r => Desce(r, 0, false));
    }

    private async Task TrocarObra(string? v)
    {
        _obraId = Guid.TryParse(v, out var g) ? g : null;
        _gTorres = []; _gQuadraId = null; _aba = "obra"; _o = null; ErrosForm = null;
        await Carregar();
    }

    private void NovaObra() { _obraId = null; _aba = "obra"; ErrosForm = null; _o = new Obra { Status = StatusObra.EmExecucao }; }

    private async Task SalvarObra()
    {
        var ok = await Executar(async () =>
        {
            var e = new List<string>();
            if (string.IsNullOrWhiteSpace(_o!.Codigo)) e.Add("Informe o código.");
            if (string.IsNullOrWhiteSpace(_o.Nome)) e.Add("Informe o nome.");
            if (string.IsNullOrWhiteSpace(_o.EnderecoEntrega)) e.Add("Informe o endereço de entrega padrão.");
            if (_o.EngenheiroId is null) e.Add("Informe o engenheiro responsável (aprovador de 1º nível).");
            ValidacaoException.Se(e);
            _o.Uf = _o.Uf?.Trim().ToUpperInvariant();
            await using var db = Fabrica.Criar();
            _o.Locais = [];
            await Grafo.SalvarAsync(db, _o);
            await db.SaveChangesAsync();
        }, "Obra salva.");
        if (ok) { Cat.Invalidar(); _obraId = _o!.Id; await Carregar(); }
    }

    private void NovoLocal() { _l = new Local { ObraId = _obraId!.Value, Tipo = TiposManuais[0] }; ErrosForm = null; _abertoLoc = true; }
    private void EditarLocal(Local l) { _l = l; ErrosForm = null; _abertoLoc = true; }
    private async Task SalvarLocal()
    {
        if (await Executar(() => Qob.SalvarLocalAsync(_l!), "Local salvo.")) { _abertoLoc = false; Cat.Invalidar(); await Carregar(); }
    }

    private IEnumerable<Local> UnidadesFiltradas
    {
        get
        {
            if (_fCond is not { } q || _quadras.FirstOrDefault(x => x.Id == q)?.LocalId is not { } raiz) return _unid;
            var sub = MotorOrcamento.Subarvore(raiz, _locais.ToLookup(l => l.LocalPaiId));
            return _unid.Where(u => sub.Contains(u.Id));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _usuarios = await Cat.UsuariosAsync(); _docs = await Cat.DocumentosSgqAsync();
        _tiposAgrup = await Cat.ListaAsync(TipoLista.TipoAgrupamento);
        if (_tiposAgrup.Count == 0) _tiposAgrup = [.. QualyHub.Infrastructure.Dados.CargaPadrao.TiposAgrupamento];
        var obras = await Cat.ObrasAsync();
        if (obras.Count == 1) _obraId = obras[0].Id;
        await Carregar();
    }

    private async Task Carregar()
    {
        _editadas.Clear();
        await using var db = Fabrica.Criar();
        _todasObras = await db.Obras.AsNoTracking().OrderBy(x => x.Codigo).ToListAsync();
        if (_obraId is not { } o) return;
        _o = _todasObras.FirstOrDefault(x => x.Id == o);
        _locais = await db.Locais.AsNoTracking().Where(l => l.ObraId == o).ToListAsync();
        _quadras = await db.Quadras.AsNoTracking().Where(q => q.ObraId == o).OrderBy(q => q.Ordem).ThenBy(q => q.Codigo).ToListAsync();
        if (_gQuadraId is null && _quadras.Count(q => q.Ativa) == 1) _gQuadraId = _quadras.First(q => q.Ativa).Id;
        _spes = await db.Spes.AsNoTracking().Where(s => s.ObraId == o).OrderBy(s => s.Codigo).ToListAsync();
        _tips = await db.Tipologias.AsNoTracking().Include(t => t.Mix).Where(t => t.ObraId == o).OrderBy(t => t.Tipo).ThenBy(t => t.Codigo).ToListAsync();
        _unid = _locais.Where(l => l.Tipo == GeradorEmpreendimento.TipoApartamento).OrderBy(l => l.Codigo).ToList();
        _resumo = await Eng.ResumoAsync(o);
        if (_gTorres.Count == 0) AddTorre();
    }

    private void AddTorre()
    {
        var n = _gQuadraId is { } q && _quadras.FirstOrDefault(x => x.Id == q)?.LocalId is { } raiz ? _locais.Count(l => l.LocalPaiId == raiz && l.Tipo == GeradorEmpreendimento.TipoTorre) : 0;
        _gTorres.Add(new TorreForm { Nome = $"Torre {n + _gTorres.Count + 1:00}", TipologiaId = _tips.FirstOrDefault(t => t.Tipo == TipoTipologia.Torre)?.Id ?? Guid.Empty });
    }

    private void Novo()
    {
        if (_obraId is not { } o) { NovaObra(); return; }
        ErrosForm = null;
        if (_aba == "obra") { NovaObra(); return; }
        if (_aba == "loc") { NovoLocal(); return; }
        _q = new Quadra { ObraId = o, Tipo = _tiposAgrup.FirstOrDefault() ?? "Condomínio", Ordem = _quadras.Count + 1 };
        _s = new Spe { ObraId = o };
        _aba = "cond"; _abertoCond = true;
    }

    private void EditarCond(Quadra q)
    {
        _q = q;
        var sp = _spes.FirstOrDefault(x => x.QuadraId == q.Id);
        _s = sp ?? new Spe { ObraId = q.ObraId, QuadraId = q.Id };
        ErrosForm = null; _abertoCond = true;
    }

    private async Task SalvarCond()
    {
        var ok = await Executar(async () =>
        {
            await Eng.SalvarQuadraAsync(_q!);
            if (!string.IsNullOrWhiteSpace(_s!.Cnpj) || !string.IsNullOrWhiteSpace(_s.RazaoSocial))
            {
                _s.QuadraId = _q!.Id;
                await Eng.SalvarSpeAsync(_s);
            }
        }, "Condomínio salvo.");
        if (ok) { _abertoCond = false; await Carregar(); }
    }

    private async Task Gerar()
    {
        int n = 0;
        if (_gQuadraId is not { } qid) { ErrosForm = ["Selecione o condomínio."]; return; }
        var torres = _gTorres.Select(t => (t.Nome, t.TipologiaId)).ToList();
        if (await Executar(async () => n = await Eng.GerarAsync(_obraId!.Value, qid, torres), null))
        {
            Notif.Sucesso($"{n} locais gerados (torres, pavimentos, apartamentos, cômodos e áreas comuns).");
            _gTorres = []; await Carregar(); _aba = "ger";
        }
    }

    private async Task Sincronizar()
    {
        ResultadoSincronizacao? r = null;
        if (await Executar(async () => r = await Eng.SincronizarAsync(_obraId!.Value)))
        { Notif.Sucesso($"Sincronizado: {r!.Atualizados} locais atualizados, {r.Criados} criados."); await Carregar(); }
    }

    private async Task SalvarFracoes()
    {
        if (await Executar(() => Eng.SalvarFracoesAsync(_obraId!.Value, _editadas), "Frações salvas — soma confere 100% por condomínio.")) await Carregar();
    }

    private async Task Recalcular(Guid quadraId)
    {
        if (await Executar(() => Eng.RecalcularFracaoAsync(quadraId), "Fração recalculada pela área privativa.")) await Carregar();
    }
}
