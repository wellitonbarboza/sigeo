@page "/engenharia/obras"
@page "/engenharia/empreendimento"
@inherits PaginaBase
@inject EngenhariaServico Eng
@inject QualidadeObraServico Qob
@using QualyHub.Web.Components.Pages.Engenharia.Partes

<Pagina Titulo="Obras e empreendimentos" AoNovo="Novo" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="barra-filtro">
                <SeletorObra Id="sel-obra" Rotulo="Obra / empreendimento" Valor="_obraId" ValorChanged="TrocarObra" Inicial="ObraQuery" Opcoes="_opcoesObras" />
                <button class="btn sec" id="nova-obra" @onclick="NovaObra"><Icone Nome="mais" Tam="14" /> Nova obra</button>
                @if (_obraId is not null) { <a class="btn sec" href="@($"engenharia/tipologias?obra={_obraId}")"><Icone Nome="lista" Tam="14" /> Tipologias</a><a class="btn sec" href="@($"engenharia/orcamento?obra={_obraId}")"><Icone Nome="calculadora" Tam="14" /> Orçamento</a> }
            </div>
            @if (_obraId is null && _o is null) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra ou cadastre uma nova. @($"Estrutura: Obra › {_n.Condominio} (= SPE, 1 CNPJ) › {_n.Torre} › {_n.Pavimento} › {_n.Unidade} › {_n.Comodo}, com áreas comuns nos três primeiros níveis.")</div> }
            else
            {
                @if (_obraId is not null) { <Abas Itens="_abas" @bind-Ativa="_aba" /> }
                <Erros Lista="ErrosForm" />
                @if (_aba == "obra" || _obraId is null)
                {
                    @if (_o is not null)
                    {
                        <div class="form mt-10" id="form-obra">
                            <Campo Rotulo="Código" Obrigatorio Classe="s2"><input id="obra-cod" @bind="_o.Codigo" /></Campo>
                            <Campo Rotulo="Nome da obra / empreendimento" Obrigatorio Classe="s6"><input id="obra-nome" @bind="_o.Nome" /></Campo>
                            <Campo Rotulo="Status" Classe="s2"><select @bind="_o.Status">@foreach (var st in Enum.GetValues<StatusObra>()) { <option value="@st">@De(st)</option> }</select></Campo>
                            <Campo Rotulo="Situação" Classe="s2"><label class="check-linha"><input type="checkbox" @bind="_o.Ativa" /> Ativa</label></Campo>
                            <Campo Rotulo="Endereço de entrega padrão" Obrigatorio Classe="s8"><input id="obra-end" @bind="_o.EnderecoEntrega" /></Campo>
                            <Campo Rotulo="Início" Classe="s2"><input type="date" @bind="_o.DataInicio" /></Campo>
                            <Campo Rotulo="Término previsto" Classe="s2"><input type="date" @bind="_o.DataPrevistaTermino" /></Campo>
                            <Campo Rotulo="Cidade" Classe="s4"><input @bind="_o.Cidade" /></Campo>
                            <Campo Rotulo="UF" Classe="s2"><input @bind="_o.Uf" maxlength="2" class="maiusc" /></Campo>
                            <Campo Rotulo="Código no ERP" Classe="s3"><input @bind="_o.CodigoErp" /></Campo>
                            <Campo Rotulo="PQO (Plano da Qualidade)" Classe="s3"><select @bind="_o.PqoDocumentoId"><option value="">—</option>@foreach (var d in _docs) { <option value="@d.Id">@d.Texto</option> }</select></Campo>
                            <Campo Rotulo="Engenheiro (só obras sem SPE)" Classe="s4" Ajuda="O 1º nível de aprovação usa o engenheiro da SPE"><select id="obra-eng" @bind="_o.EngenheiroId"><option value="">—</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                            <Campo Rotulo="Administrativo de obra" Classe="s4"><select @bind="_o.AdministrativoId"><option value="">—</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                            <Campo Rotulo="Almoxarife" Classe="s4"><select @bind="_o.AlmoxarifeId"><option value="">—</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                            <Campo Rotulo="Observações" Classe="s12"><textarea rows="2" @bind="_o.Observacoes"></textarea></Campo>
                        </div>
                        <div class="barra-botoes fim">
                            @if (_obraId is null) { <button class="btn sec" @onclick="() => { _o = null; ErrosForm = null; }">Cancelar</button> }
                            <button class="btn prim" id="obra-salvar" disabled="@Ocupado" @onclick="SalvarObra"><Icone Nome="check" Tam="16" /> Salvar obra</button>
                        </div>
                        @if (_obraId is not null)
                        {
                            <div class="secao"><Icone Nome="predio" /> @Pl(_n.Condominio) (SPE) desta obra</div>
                            <ResumoCondominios Linhas="_resumo" />
                        }
                    }
                }
                else if (_aba == "cond")
                {
                    <div class="my-6"><button class="btn sec" id="novo-cond" @onclick="Novo"><Icone Nome="mais" Tam="14" /> @_n.Condominio (SPE)</button></div>
                    <table class="itens" id="condominios">
                        <thead><tr><th>Sigla</th><th>@_n.Condominio</th><th>Tipo</th><th>Registro do condomínio</th><th class="num">Terreno (m²)</th><th>SPE (CNPJ que é dono do custo)</th><th>Implantação</th><th class="num">@Pl(_n.Torre)</th><th class="num">@Pl(_n.Unidade)</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var q in _quadras)
                            {
                                var sp = _spes.FirstOrDefault(x => x.QuadraId == q.Id);
                                var r = _resumo.FirstOrDefault(x => x.QuadraId == q.Id);
                                <tr @key="q.Id"><td><b>@q.Codigo</b></td><td>@q.Nome</td><td>@q.Tipo</td>
                                    <td>@q.NomeCondominio@(string.IsNullOrWhiteSpace(q.CnpjCondominio) ? "" : $" · {q.CnpjCondominio}")</td>
                                    <td class="num">@q.AreaTerreno?.ToString("N2", Br)</td>
                                    <td>@if (sp is null) { <Selo Texto="sem SPE" Tom="aviso" /> } else { <span>@sp.NomeExibicao · @sp.Cnpj</span> }</td>
                                    <td>@(q.ImplantacaoId is { } imp ? _nomeTip.GetValueOrDefault(imp) : null)</td>
                                    <td class="num">@r?.Torres</td><td class="num">@r?.Apartamentos</td>
                                    <td><button class="btn sec pq" @onclick="() => EditarCond(q)">Editar</button> @if (!q.Ativa) { <Selo Texto="Inativo" Tom="aviso" /> }</td></tr>
                            }
                            @if (_quadras.Count == 0) { <tr><td colspan="10" class="mudo">Nenhum condomínio. Cadastre um por SPE (ex.: Condomínio Dona Irene · Quadra A).</td></tr> }
                        </tbody>
                    </table>
                    <div class="alerta info"><Icone Nome="info" /> 1 condomínio = 1 SPE (CNPJ próprio). As torres, apartamentos e áreas comuns do condomínio são da SPE. A implantação (tipologia) define as áreas comuns do condomínio.</div>

                    <div class="secao"><Icone Nome="contrato" /> Todas as SPEs da obra</div>
                    <table class="itens" id="spes">
                        <thead><tr><th>Sigla</th><th>@_n.Condominio</th><th>Razão social</th><th>Nome curto</th><th>CNPJ</th><th>Engenheiro responsável</th><th>Afetação / RET</th><th>Ativa</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var sp in _spes)
                            {
                                <tr @key="sp.Id"><td><b>@sp.Codigo</b></td>
                                    <td>@if (sp.QuadraId is { } qid && _quadras.FirstOrDefault(x => x.Id == qid) is { } qq) { @($"{qq.Codigo} – {qq.Nome}") } else { <Selo Texto="sem condomínio (legado)" Tom="aviso" /> }</td>
                                    <td>@sp.RazaoSocial</td><td>@sp.NomeFantasia</td><td>@sp.Cnpj</td><td>@if (sp.EngenheiroId is { } eid) { @(_usuarios.FirstOrDefault(u => u.Id == eid)?.Texto) } else { <Selo Texto="sem engenheiro" Tom="aviso" /> }</td><td>@sp.PatrimonioAfetacao</td>
                                    <td>@if (sp.Ativa) { <Selo Texto="Ativa" Tom="ok" /> } else { <Selo Texto="Inativa" Tom="aviso" /> }</td>
                                    <td><button class="btn sec pq" @onclick="() => EditarSpe(sp)">Editar</button></td></tr>
                            }
                            @if (_spes.Count == 0) { <tr><td colspan="9" class="mudo">Nenhuma SPE. Ela é criada junto com o condomínio.</td></tr> }
                        </tbody>
                    </table>
                }
                else if (_aba == "ger")
                {
                    <div class="secao"><Icone Nome="tabela" /> Resumo por @_n.Condominio.ToLower()</div>
                    <ResumoCondominios Linhas="_resumo" />

                    <div class="secao"><Icone Nome="predio" /> @Pl(_n.Torre) da obra</div>
                    <table class="itens" id="torres">
                        <thead><tr><th>Código</th><th>@_n.Torre</th><th>@_n.Condominio</th><th>Tipologia</th><th class="num">@Pl(_n.Pavimento)</th><th class="num">@Pl(_n.Unidade)</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var t in Torres)
                            {
                                var pai = t.LocalPaiId is { } pid ? _locais.FirstOrDefault(x => x.Id == pid) : null;
                                var pavs = _locais.Where(x => x.LocalPaiId == t.Id && x.Tipo == GeradorEmpreendimento.TipoPavimento).Select(x => x.Id).ToHashSet();
                                <tr @key="t.Id"><td>@t.Codigo</td><td><b>@t.Nome</b></td><td>@(pai is null ? "—" : $"{pai.Codigo} – {pai.Nome}")</td>
                                    <td>@(t.TipologiaId is { } tid ? _nomeTip.GetValueOrDefault(tid) : null)</td>
                                    <td class="num">@pavs.Count</td><td class="num">@_locais.Count(x => x.Tipo == GeradorEmpreendimento.TipoApartamento && x.LocalPaiId is { } lp && pavs.Contains(lp))</td>
                                    <td><span class="grupo-btn"><button class="btn sec pq" @onclick="() => RenomearTorre(t)">Editar</button>
                                        <button class="btn sec pq perigo" disabled="@Ocupado" @onclick="() => ExcluirTorre(t)"><Icone Nome="lixeira" Tam="14" /> Excluir</button></span></td></tr>
                            }
                            @if (!Torres.Any()) { <tr><td colspan="7" class="mudo">Nada cadastrado nesta obra.</td></tr> }
                        </tbody>
                    </table>
                    <div class="alerta info"><Icone Nome="info" /> Editar muda o nome (o código fica, é a chave das FVS, requisições e QR). Excluir leva pavimentos, apartamentos, cômodos, áreas comuns, a distribuição do orçamento e os locais das redes de planejamento; é bloqueado se já houver FVS, RNC, requisição, contrato, medição, apropriação, SST ou cronograma nesses locais.</div>

                    <div class="secao"><Icone Nome="mais" /> Gerar @Pl(_n.Torre).ToLower() · @_n.Condominio</div>
                    @if (_quadras.Count == 0 || !_tips.Any(t => t.Tipo == TipoTipologia.Torre)) { <div class="alerta aviso"><Icone Nome="info" /> Cadastre o condomínio (com a SPE) e as tipologias de apartamento e de torre antes de gerar.</div> }
                    else
                    {
                        <div class="form">
                            <Campo Rotulo="@_n.Condominio" Obrigatorio Classe="s6"><select id="g-cond" @bind="_gQuadraId"><option value="">Selecione…</option>@foreach (var q in _quadras.Where(q => q.Ativa)) { <option value="@q.Id">@q.Codigo – @q.Nome</option> }</select></Campo>
                        </div>
                        <table class="itens" id="g-torres">
                            <thead><tr><th>@_n.Torre</th><th>Tipologia (@_n.Torre.ToLower())</th><th class="num">@Pl(_n.Pavimento)</th><th class="num">@Pl(_n.Unidade)</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var t in _gTorres)
                                {
                                    var tt = _tips.FirstOrDefault(x => x.Id == t.TipologiaId);
                                    <tr @key="t"><td><input @bind="t.Nome" class="larg-160" /></td>
                                        <td><select @bind="t.TipologiaId"><option value="@Guid.Empty">—</option>@foreach (var x in _tips.Where(x => x.Tipo == TipoTipologia.Torre)) { <option value="@x.Id">@x.Codigo – @x.Nome</option> }</select></td>
                                        <td class="num">@tt?.Pavimentos</td><td class="num">@(tt is null ? "" : AptosTorre(tt).ToString())</td>
                                        <td><button class="btn sec pq" @onclick="() => _gTorres.Remove(t)">Remover</button></td></tr>
                                }
                            </tbody>
                        </table>
                        <div class="barra-botoes mais-ar">
                            <button class="btn sec" id="g-add" @onclick="AddTorre"><Icone Nome="mais" Tam="14" /> @_n.Torre</button>
                            <button class="btn prim" id="g-gerar" disabled="@Ocupado" @onclick="Gerar"><Icone Nome="check" Tam="16" /> Gerar @_gTorres.Sum(t => _tips.FirstOrDefault(x => x.Id == t.TipologiaId) is { } tt ? AptosTorre(tt) : 0) apartamentos</button>
                            <button class="btn sec" id="g-sinc" disabled="@Ocupado" @onclick="Sincronizar" title="Atualiza as medidas dos cômodos/áreas comuns e cria os ambientes incluídos nas tipologias depois da geração"><Icone Nome="atualizar" Tam="14" /> Sincronizar com as tipologias</button>
                        </div>
                        <div class="alerta info"><Icone Nome="info" /> Pode gerar em etapas: torres novas entram no condomínio já existente. Código: CONDOMÍNIO-T01-P02-201-SAL (pavimento × 100 + sequência; cômodo pela sigla). Fração ideal = área privativa ÷ área do condomínio; substitua pela do memorial na aba Apartamentos.</div>
                    }
                }
                else if (_aba == "loc")
                {
                    <div class="barra-filtro">
                        <label>Ver <select @bind="_fLocal" @bind:after="() => { _arvore = null; _pagLoc = 0; }"><option value="">Condomínios e torres (sem pavimentos)</option>@foreach (var t in _locais.Where(l => l.Tipo == GeradorEmpreendimento.TipoTorre).OrderBy(l => l.Codigo)) { <option value="@t.Id">@t.Codigo – @t.Nome (completo)</option> }</select></label>
                        <button class="btn sec" id="novo-local" @onclick="NovoLocal"><Icone Nome="mais" Tam="14" /> Área comum / elemento</button>
                        <span class="mudo">@_locais.Count locais (@ArvoreLista.Count nesta visão) · condomínio, torre, pavimento, apartamento e cômodo vêm do gerador.</span>
                    </div>
                    <Paginacao Total="ArvoreLista.Count" Pagina="_pagLoc" Tamanho="TamPag" AoMudar="p => _pagLoc = p" />
                    <table class="itens" id="locais">
                        <thead><tr><th>Código</th><th>Local</th><th>Nível</th><th>Categoria</th><th class="num">Piso (m²)</th><th class="num">Perím. (m)</th><th class="num">Parede (m²)</th><th class="num">Qtd. ref.</th><th>QR</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var (l, nivel) in ArvoreLista.Skip(_pagLoc * TamPag).Take(TamPag))
                            {
                                <tr @key="l.Id"><td style="padding-left:@(8 + nivel * 16)px">@l.Codigo</td><td>@l.Nome</td><td>@_n.Rotulo(l.Tipo)</td><td>@l.Categoria</td>
                                    <td class="num">@l.AreaPiso?.ToString("N2", Br)</td><td class="num">@l.Perimetro?.ToString("N2", Br)</td><td class="num">@l.AreaParede?.ToString("N2", Br)</td>
                                    <td class="num">@(l.Quantidade is null ? "" : $"{l.Quantidade.Value.ToString("0.##", Br)} {l.Unidade}")</td>
                                    <td><a title="QR do local (abre a FVS no celular)" href="campo/local/@l.QrToken" target="_blank" data-enhance-nav="false"><Icone Nome="qr" Tam="16" /></a></td>
                                    <td><button class="btn sec pq" @onclick="() => EditarLocal(l)">Editar</button></td></tr>
                            }
                            @if (_locais.Count == 0) { <tr><td colspan="10" class="mudo">Sem locais. Gere a estrutura na aba Gerador.</td></tr> }
                        </tbody>
                    </table>
                    <Paginacao Total="ArvoreLista.Count" Pagina="_pagLoc" Tamanho="TamPag" AoMudar="p => _pagLoc = p" />
                }
                else
                {
                    <div class="barra-filtro">
                        <label>@_n.Condominio <select @bind="_fCond" @bind:after="() => { _unidFiltradas = null; _pagUni = 0; }"><option value="">Todos</option>@foreach (var q in _quadras) { <option value="@q.Id">@q.Codigo – @q.Nome</option> }</select></label>
                        <button class="btn sec" disabled="@(Ocupado || _editadas.Count == 0)" @onclick="SalvarFracoes"><Icone Nome="check" Tam="14" /> Salvar frações (@_editadas.Count)</button>
                        @if (_fCond is { } fq) { <button class="btn sec" disabled="@Ocupado" @onclick="() => Recalcular(fq)">Recalcular pela área</button> }
                    </div>
                    <Paginacao Total="UnidadesFiltradas.Count" Pagina="_pagUni" Tamanho="TamPag" AoMudar="p => _pagUni = p" />
                    <table class="itens" id="unidades">
                        <thead><tr><th>Código</th><th>@_n.Unidade</th><th>Tipologia</th><th class="num">Área priv. (m²)</th><th class="num">Fração ideal no condomínio (%)</th></tr></thead>
                        <tbody>
                            @foreach (var u in UnidadesFiltradas.Skip(_pagUni * TamPag).Take(TamPag))
                            {
                                <tr @key="u.Id"><td>@u.Codigo</td><td>@u.Nome</td><td>@(u.TipologiaId is { } tid ? _nomeTip.GetValueOrDefault(tid) : null)</td>
                                    <td class="num">@u.AreaPrivativa?.ToString("N2", Br)</td>
                                    <td class="num"><input type="number" step="0.000001" class="larg-110 texto-dir" value="@(((u.FracaoIdeal ?? 0) * 100).ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture))"
                                        @onchange="e => DefinirFracao(u, e.Value)" /></td></tr>
                            }
                            @if (UnidadesFiltradas.Count == 0) { <tr><td colspan="5" class="mudo">Nenhum apartamento. Use a aba Gerador.</td></tr> }
                        </tbody>
                    </table>
                }
            }
        </div>
    </ChildContent>
    <Faixa><b>Engenharia · Estrutura</b><span>@($"1 {_n.Condominio.ToLower()} = 1 SPE = 1 CNPJ · {string.Join(", ", new[] { _n.Torre, _n.Pavimento, _n.Unidade, _n.Comodo }.Select(x => Pl(x).ToLower()))} gerados pelas tipologias")</span><span>Fração ideal confere 100% por @_n.Condominio.ToLower()</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_abertoCond" Titulo="@($"{_n.Condominio} e SPE")" Tamanho="grande">
    <ChildContent>
        @if (_q is not null && _s is not null)
        {
            <Erros Lista="ErrosForm" />
            <FormCondominio Quadra="_q" Spe="_s" TiposAgrupamento="_tiposAgrup" Tipologias="_tips" Usuarios="_usuarios" />
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="cond-salvar" disabled="@Ocupado" @onclick="SalvarCond"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

<Modal @bind-Aberto="_abertoLoc" Titulo="Local da obra" Tamanho="media">
    <ChildContent>
        @if (_l is not null)
        {
            var gerado = (GeradorEmpreendimento.Gerados.Contains(_l.Tipo) || _l.AmbienteModeloId != null) && _l.CriadoEm != default;
            <Erros Lista="ErrosForm" />
            @if (gerado) { <div class="alerta info"><Icone Nome="info" /> Local gerado pelas tipologias: só a descrição pode ser alterada (medidas: altere a tipologia e sincronize).</div> }
            <div class="form">
                <Campo Rotulo="Código" Obrigatorio Classe="s4"><input id="loc-cod" @bind="_l.Codigo" disabled="@gerado" placeholder="QA-AC-PISC" /></Campo>
                <Campo Rotulo="Descrição" Obrigatorio Classe="s8"><input id="loc-nome" @bind="_l.Nome" placeholder="Piscina" /></Campo>
                <Campo Rotulo="Nível" Classe="s4"><select id="loc-tipo" @bind="_l.Tipo" disabled="@gerado">@if (gerado) { <option>@_l.Tipo</option> } else { @foreach (var n in TiposManuais) { <option>@n</option> } }</select></Campo>
                <Campo Rotulo="Local pai" Classe="s8"><select @bind="_l.LocalPaiId" disabled="@gerado"><option value="">(raiz da obra)</option>@foreach (var x in _locais.Where(x => x.Id != _l.Id && x.Tipo is GeradorEmpreendimento.TipoCondominio or GeradorEmpreendimento.TipoTorre or GeradorEmpreendimento.TipoPavimento)) { <option value="@x.Id">@x.Codigo – @x.Nome</option> }</select></Campo>
                <Campo Rotulo="Área de piso (m²)" Classe="s4"><input type="number" step="0.01" @bind="_l.AreaPiso" disabled="@gerado" /></Campo>
                <Campo Rotulo="Perímetro (m)" Classe="s4"><input type="number" step="0.01" @bind="_l.Perimetro" disabled="@gerado" /></Campo>
                <Campo Rotulo="Área de parede (m²)" Classe="s4"><input type="number" step="0.01" @bind="_l.AreaParede" disabled="@gerado" /></Campo>
                <Campo Rotulo="Ordem" Classe="s4"><input type="number" @bind="_l.Ordem" /></Campo>
                <Campo Rotulo="Quantidade de referência" Classe="s5"><input type="number" step="0.01" @bind="_l.Quantidade" disabled="@gerado" /></Campo>
                <Campo Rotulo="Unidade" Classe="s3"><select @bind="_l.Unidade" disabled="@gerado"><option value="">—</option>@foreach (var un in UnidadesRef) { <option>@un</option> }@if (!string.IsNullOrEmpty(_l.Unidade) && !UnidadesRef.Contains(_l.Unidade)) { <option>@_l.Unidade</option> }</select></Campo>
            </div>
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="loc-salvar" disabled="@Ocupado" @onclick="SalvarLocal"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

<Modal @bind-Aberto="_abertoTorre" Titulo="@($"Editar {_n.Torre.ToLower()}")" Tamanho="pequena">
    <ChildContent>
        @if (_torre is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Código" Classe="s4"><input value="@_torre.Codigo" disabled /></Campo>
                <Campo Rotulo="Nome" Obrigatorio Classe="s8"><input id="torre-nome" @bind="_nomeTorre" /></Campo>
            </div>
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="torre-salvar" disabled="@Ocupado" @onclick="SalvarTorre"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

<Modal @bind-Aberto="_abertoSpe" Titulo="SPE" Tamanho="media">
    <ChildContent>
        @if (_sp is not null)
        {
            <Erros Lista="ErrosForm" />
            <FormSpe Spe="_sp" Quadras="_quadras" Usuarios="_usuarios" />
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="spe2-salvar" disabled="@Ocupado" @onclick="SalvarSpe"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

<Confirmacao Pergunta="@PerguntaConfirmacao" AoSim="ConfirmacaoSim" AoNao="ConfirmacaoNao" />

@code {
    private sealed class TorreForm { public string Nome { get; set; } = ""; public Guid TipologiaId { get; set; } }

    private List<Spe> _spes = [];
