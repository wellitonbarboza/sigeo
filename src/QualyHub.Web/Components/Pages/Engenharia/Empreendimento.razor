        if (await Executar(async () => r = await Eng.SincronizarAsync(_obraId!.Value, ct: Cancelamento)))
        { Notif.Sucesso($"Sincronizado: {r!.Atualizados} locais atualizados, {r.Criados} criados."); await Carregar(); }
