    private async Task Recarregar()
    {
        if (_obraId is not { } o) return;
        await using var db = Fabrica.CriarLeitura();
        _versoes = await db.VersoesCronograma.AsNoTracking().Where(v => v.ObraId == o).OrderByDescending(v => v.Numero).ToListAsync(Cancelamento);
        _versaoId = _versaoId is { } atual && _versoes.Any(v => v.Id == atual) ? atual
            : (_versoes.FirstOrDefault(v => v.Status == StatusVersao.EmElaboracao) ?? _versoes.FirstOrDefault(v => v.Status == StatusVersao.EmAprovacao)
               ?? _versoes.FirstOrDefault(v => v.Status == StatusVersao.Vigente) ?? _versoes.FirstOrDefault())?.Id;
        _cal = await PlanejamentoServico.CalendarioAsync(db, o, Cancelamento);
        _feriados = await db.Feriados.AsNoTracking().Where(f => f.ObraId == null || f.ObraId == o).OrderBy(f => f.Data).ToListAsync(Cancelamento);
        await CarregarVersao(db);
    }

    private async Task CarregarVersao(IQualyHubDb db)
    {
        _versao = null; _linhas = []; _porLinha = [];
        if (_versaoId is not { } id) return;
        _versao = await db.VersoesCronograma.AsNoTracking().Include(v => v.Atividades).Include(v => v.Vinculos).AsSplitQuery().FirstAsync(v => v.Id == id, Cancelamento);
        var v = _versao;
        if (_versoes.FindIndex(x => x.Id == v.Id) is var iv and >= 0) _versoes[iv] = v; // resumo da lista acompanha a versão aberta
        _editavel = _podeEditar && v.Editavel;
        _redesVersao = await db.RedesPlanejamento.AsNoTracking().Include(r => r.Locais).Include(r => r.Pacotes).AsSplitQuery().Where(r => r.ObraId == v.ObraId).OrderBy(r => r.Ordem).ToListAsync(Cancelamento);
        var cores = _redesVersao.Select((r, i) => (r.Id, i % 5 + 1)).ToDictionary(x => x.Id, x => x.Item2);
        var (linhas, ids) = CronogramaVisao.Linhas(v, _cal, cores);
        _linhas = linhas;
        var porId = v.Atividades.ToDictionary(a => a.Id);
        _porLinha = ids.ToDictionary(x => x.Value, x => porId[x.Key]);
        var folhas = v.Atividades.Where(a => !a.Resumo).ToList();
        _folhas = folhas.Count;
        _criticas = folhas.Count(a => a.Critica);
        _avanco = folhas.Sum(a => a.Custo) is > 0 and var c ? folhas.Sum(a => a.Avanco * a.Custo) / c : folhas.Count == 0 ? 0 : folhas.Average(a => a.Avanco);
        _desvio = v.TerminoBase is { } tb && v.TerminoPrevisto is { } tp ? _cal.DiasUteisEntre(tb, tp) : null;
        _movidas = folhas.Count(a => a.InicioBase is { } b && b != a.Inicio);
        var datas = v.Atividades.SelectMany(a => new DateOnly?[] { a.Inicio, a.Termino, a.InicioBase, a.TerminoBase }).Where(d => d != null && d.Value != default).Select(d => d!.Value).ToList();
        var ini = datas.Count > 0 ? datas.Min() : v.InicioProjeto; var fim = datas.Count > 0 ? datas.Max() : v.InicioProjeto.AddMonths(6);
        _pIni = CronogramaVisao.Ini(ini.AddDays(-7)); _pFim = CronogramaVisao.Fim(fim.AddDays(21));
        _feriadosVisiveis = Enumerable.Range(ini.Year, fim.Year - ini.Year + 1).SelectMany(Calendario.FeriadosNacionais)
            .Concat(_feriados.Select(f => (f.Data, f.Nome))).Where(f => f.Item1 >= ini && f.Item1 <= fim)
            .Select(f => (CronogramaVisao.Ini(f.Item1), f.Item2)).ToList();
        _versaoChave++;
        if (!_mudouNoGantt) _ganttChave++;
        _mudouNoGantt = false;
        if (_sel is not null) Selecionar(v.Atividades.FirstOrDefault(a => a.Id == _sel.Id)); else NovaAtividade(false);
    }

