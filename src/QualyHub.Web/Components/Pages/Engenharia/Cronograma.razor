    private bool _scriptGantt;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender || _scriptGantt) return;
        try
        {
            // Estilo e script do Gantt juntos; o Gantt só aparece com os dois prontos (não abre sem formatação).
            await Task.WhenAll(
                JS.InvokeVoidAsync("qh.carregarCss", Assets["lib/syncfusion/tailwind3-lite-34.2.9.css"]).AsTask(),
                JS.InvokeVoidAsync("qh.carregarScript", "_content/Syncfusion.Blazor.Core/scripts/syncfusion-blazor.min.js").AsTask());
            _scriptGantt = true; StateHasChanged();
        }
        catch (JSException) { ErrosForm = ["Não foi possível carregar o componente do Gantt. Recarregue a página."]; StateHasChanged(); }
    }

