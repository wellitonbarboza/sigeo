@page "/engenharia/cronograma"
@using QualyHub.Domain.Planejamento
@using QualyHub.Web.Components.Pages.Engenharia.Partes
@using Syncfusion.Blazor.Gantt
@inherits PaginaBase
@inject PlanejamentoServico Plan
@inject IJSRuntime JS


<Pagina Titulo="Cronograma e reprogramação" AoAtualizar="Recarregar">
    <ChildContent>
        <div class="pagina toque plan">
            <div class="barra-filtro">
                @if (_pronto) { <SeletorObra Id="plan-obra" Valor="_obraId" ValorChanged="TrocarObra" Inicial="_obraInicial" /> }
                @if (_versoes.Count > 0)
                {
                    <label>Versão
                        <select id="plan-versao" value="@_versaoId" @onchange="e => AbrirVersao(Guid.Parse(e.Value!.ToString()!))">
                            @foreach (var v in _versoes) { <option value="@v.Id">@v.Codigo · @De(v.Status)@(v.Motivo is { Length: > 0 } m ? $" · {m}" : "")</option> }
                        </select>
                    </label>
                }
                <span class="esp"></span>
                @if (_obraId is { } ol)
                {
                    <a class="btn sec pq" id="ir-indicadores" href="@($"engenharia/planejamento?obra={ol}")"><Icone Nome="grafico" Tam="14" /> Indicadores</a>
                    <a class="btn sec pq" id="ir-lps" href="@($"engenharia/last-planner?obra={ol}")"><Icone Nome="alvo" Tam="14" /> Last Planner</a>
                }
            </div>

            @if (_obraId is null) { <div class="alerta info"><Icone Nome="info" /> Escolha a obra.</div> }
            else if (_versao is null)
            {
                <div class="alerta info"><Icone Nome="info" /> A obra ainda não tem cronograma.</div>
                @if (_podeEditar) { <button class="btn prim" id="plan-criar" disabled="@Ocupado" @onclick="CriarLb0"><Icone Nome="mais" Tam="14" /> Criar a linha de base (LB0)</button> }
            }
            else
            {
                var v = _versao;
                <div class="kpis">
                    <Kpi Rotulo="Término previsto" Valor="@Data(v.TerminoPrevisto)" Sub="@(v.TerminoBase is { } tb ? $"Base: {Data(tb)}" : "sem linha de base")" />
                    <Kpi Rotulo="Desvio vs base" Valor="@(_desvio is { } d ? (d > 0 ? $"+{d}" : d.ToString()) + " d.ú." : "—")" Sub="dias úteis no término" Tom="@(_desvio > 0 ? "erro" : _desvio < 0 ? "ok" : "")" />
                    <Kpi Rotulo="Custo orçado ligado" Valor="@v.CustoTotal.ToString("C0", Br)" Sub="@($"{_folhas} atividades")" />
                    <Kpi Rotulo="Avanço físico" Valor="@($"{_avanco:0.0}%")" Sub="ponderado pelo custo" />
                    <Kpi Rotulo="Atividades críticas" Valor="@_criticas" Sub="folga ≤ 0, não concluídas" Tom="@(_criticas > 0 ? "aviso" : "")" />
                </div>

                <div class="barra-botoes plan-acoes">
                    <Selo Texto="@($"{v.Codigo} · {De(v.Status)}")" Tom="@Tom(v.Status)" />
                    @if (v.MotivoDevolucao is { Length: > 0 } md) { <span class="alerta aviso pq"><Icone Nome="alerta" Tam="14" /> Devolvida: @md</span> }
                    <span class="esp"></span>
                    @if (_editavel)
                    {
                        <button class="btn sec" id="plan-gerar" disabled="@Ocupado" @onclick="Gerar"><Icone Nome="raio" Tam="14" /> Gerar pelas redes</button>
                        <button class="btn prim" id="plan-enviar" disabled="@Ocupado" @onclick="AbrirEnvio"><Icone Nome="enviar" Tam="14" /> Enviar para aprovação</button>
                    }
                    else if (_podeEditar && v.Status == StatusVersao.Vigente && !_versoes.Any(x => x.Status is StatusVersao.EmElaboracao or StatusVersao.EmAprovacao))
                    {
                        <button class="btn prim" id="plan-reprogramar" disabled="@Ocupado" @onclick="NovaReprogramacao"><Icone Nome="editar" Tam="14" /> Nova reprogramação</button>
                    }
                    <button class="btn sec" id="plan-excel" @onclick="@(() => Baixar("excel"))"><Icone Nome="excel" Tam="14" /> Excel</button>
                    <button class="btn sec" id="plan-msp" @onclick="@(() => Baixar("msproject"))"><Icone Nome="baixar" Tam="14" /> MS Project</button>
                    @if (_editavel)
                    {
                        <label class="btn sec" for="plan-msp-imp" title="Importar XML do MS Project (substitui as atividades desta versão)"><Icone Nome="upload" Tam="14" /> Importar MS Project</label>
                        <InputFile id="plan-msp-imp" class="oculto" accept=".xml" OnChange="ImportarMsProject" />
                    }
                    <button class="btn sec" id="plan-imprimir" @onclick="() => _abertoImpressao = true"><Icone Nome="impressora" Tam="14" /> PDF / imprimir</button>
                </div>
                <Erros Lista="ErrosForm" />
                <Abas Itens="_abas" Ativa="@_aba" AtivaChanged="TrocarAba" />

                @if (_aba == "crono")
                {
                    <div class="crono-modos">
                        <span class="grupo-btn" role="tablist" aria-label="Modo do cronograma">
                            <button class="btn @(_modoCrono == "ver" ? "prim" : "sec") pq" id="crono-ver" @onclick='() => _modoCrono = "ver"'>Gantt por local</button>
                            <button class="btn @(_modoCrono == "editar" ? "prim" : "sec") pq" id="crono-editar" @onclick='() => _modoCrono = "editar"'>Editar cronograma (redes e ligações)</button>
                            <button class="btn @(_modoCrono == "tabela" ? "prim" : "sec") pq" id="crono-tabela" @onclick='() => _modoCrono = "tabela"'>Tabela e Gantt detalhado</button>
                        </span>
                    </div>
                    @if (_modoCrono != "tabela")
                    {
                        <GanttPorLocal ObraId="_obraId!.Value" VersaoId="v.Id" Modo="@_modoCrono" PodeEditar="_podeEditar" Versao="_ganttChave"
                                       AoMudar="AoMudarGantt" AoSequencia="IrParaRedes" />
                    }
                    else {
                    <div class="barra-filtro plan-opcoes">
                        <label><input type="checkbox" @bind="_mostrarBase" /> Linha de base</label>
                        <label>Início do projeto <input type="date" id="plan-inicio" value="@v.InicioProjeto.ToString("yyyy-MM-dd")" disabled="@(!_editavel)" @onchange="e => MudarInicio(e.Value?.ToString(), null)" /></label>
                        <label>Data de status <input type="date" id="plan-status" value="@(v.DataStatus?.ToString("yyyy-MM-dd"))" disabled="@(!_editavel)" @onchange="e => MudarInicio(null, e.Value?.ToString())" /></label>
                        <span class="mudo">Arraste a barra para mover (vira folga no vínculo, sem restrição de data) · puxe a ponta para mudar a duração · clique na linha para editar.</span>
                    </div>
                    @if (_linhas.Count == 0)
                    {
                        <div class="alerta info"><Icone Nome="info" /> Sem atividades. Monte as redes (aba Redes) e clique em <b>Gerar pelas redes</b>, importe um XML do MS Project ou inclua atividades à mão.</div>
                    }
                    else if (!_scriptGantt)
                    {
                        <Esqueleto Linhas="12" />
                    }
                    else
                    {
                        <div class="plan-gantt" @key="_versaoChave">
                            <SfGantt @ref="_gantt" TValue="LinhaGantt" DataSource="_linhas" Height="600px" Width="100%" TreeColumnIndex="1"
                                     TaskMode="ScheduleMode.Manual" ProjectStartDate="_pIni" ProjectEndDate="_pFim" RenderBaseline="_mostrarBase" BaselineColor="#a5a8ee" HighlightWeekends="true"
                                     IncludeWeekend="false" RowHeight="32" TaskbarHeight="18"
                                     Toolbar="_toolbar" AllowSelection="true" AllowResizing="true">
                                <GanttTaskFields Id="Id" Name="Nome" StartDate="Inicio" EndDate="Termino" Progress="Avanco"
                                                 ParentID="PaiId" Dependency="Dependencia" BaselineStartDate="InicioBase" BaselineEndDate="TerminoBase" CssClass="Classe" />
                                <GanttEditSettings AllowTaskbarEditing="_editavel" AllowEditing="false" AllowAdding="false" AllowDeleting="false" />
                                <GanttSplitterSettings Position="50%" />
                                <GanttTimelineSettings TimelineViewMode="TimelineViewMode.Week" TimelineUnitSize="56">
                                    <GanttTopTierSettings Unit="TimelineViewMode.Month" FormatterTemplate="_fmtMes" />
                                    <GanttBottomTierSettings Unit="TimelineViewMode.Week" FormatterTemplate="_fmtDia" />
                                </GanttTimelineSettings>
                                <GanttHolidays>
                                    @foreach (var (data, nome) in _feriadosVisiveis) { <GanttHoliday From="@data" To="@data" Label="@nome" /> }
                                </GanttHolidays>
                                @if (v.DataStatus is { } st)
                                {
                                    <GanttEventMarkers><GanttEventMarker Day="@CronogramaVisao.Ini(st)" Label="Data de status" /></GanttEventMarkers>
                                }
                                <GanttEvents TValue="LinhaGantt" TaskbarEdited="AoEditarBarra" RowSelected="AoSelecionar" />
                                <GanttColumns>
                                    <GanttColumn Field="Eap" HeaderText="EAP" Width="78" />
                                    <GanttColumn Field="Nome" HeaderText="Atividade" Width="260" />
                                    <GanttColumn Field="Dias" HeaderText="Dur. (d.ú.)" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                                    <GanttColumn Field="Inicio" HeaderText="Início" Width="90" Format="dd/MM/yy" />
                                    <GanttColumn Field="Termino" HeaderText="Término" Width="90" Format="dd/MM/yy" />
                                    <GanttColumn Field="Predecessoras" HeaderText="Predecessoras" Width="140" />
                                    <GanttColumn Field="Avanco" HeaderText="%" Width="60" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                                    <GanttColumn Field="Folga" HeaderText="Folga" Width="70" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                                    <GanttColumn Field="Custo" HeaderText="Custo orçado" Width="120" Format="N0" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                                    <GanttColumn Field="Desvio" HeaderText="Δ base (d.ú.)" Width="96" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                                </GanttColumns>
                            </SfGantt>
                        </div>
                    }

                    <div class="cartao plan-edicao" id="plan-edicao">
                        <div class="cab-edicao">
                            <b>@(_sel is null ? "Nova atividade" : _sel.Resumo ? $"Agrupador {_sel.Eap}" : $"Atividade {_sel.Eap}")</b>
                            @if (_sel is not null) { <span class="mudo">@Data(_sel.Inicio) a @Data(_sel.Termino)@(_sel.Folga is { } f ? $" · folga {f} d.ú." : "")@(_sel.Critica ? " · crítica" : "")</span> }
                        </div>
                        <div class="form">
                            <Campo Rotulo="Nome" Classe="s5"><input id="at-nome" @bind="_fNome" disabled="@(!_editavel)" /></Campo>
                            @if (_sel?.Resumo != true)
                            {
                                <Campo Rotulo="Duração (d.ú.; 0 = marco)" Classe="s2"><input id="at-dur" type="number" min="0" @bind="_fDur" disabled="@(!_editavel)" /></Campo>
                                <Campo Rotulo="Avanço %" Classe="s1"><input id="at-avanco" type="number" min="0" max="100" step="5" @bind="_fAvanco" disabled="@(!_editavel)" /></Campo>
                                <Campo Rotulo="Início (mover)" Classe="s2"><input id="at-inicio" type="date" @bind="_fInicio" disabled="@(!_editavel || _sel is null)" /></Campo>
                                <Campo Rotulo="Predecessoras (EAP + TI/II/TT/IT ± folga)" Classe="s6" Ajuda="Ex.: 1.2.3TI+2; 4II; 2.1TT-1"><input id="at-pred" @bind="_fPred" disabled="@(!_editavel)" placeholder="1.2.3TI+2; 4II" /></Campo>
                            }
                        </div>
                        @if (_editavel)
                        {
                            <div class="barra-botoes">
                                <button class="btn prim" id="at-salvar" disabled="@Ocupado" @onclick="SalvarAtividade"><Icone Nome="check" Tam="14" /> @(_sel is null ? "Incluir" : "Salvar")</button>
                                <button class="btn sec" id="at-nova" @onclick="() => NovaAtividade(false)"><Icone Nome="mais" Tam="14" /> Atividade@(_sel?.Resumo == true ? $" em {_sel.Eap}" : "")</button>
                                <button class="btn sec" id="at-novo-grupo" @onclick="() => NovaAtividade(true)"><Icone Nome="mais" Tam="14" /> Agrupador</button>
                                @if (_sel is not null) { <button class="btn sec perigo" id="at-excluir" disabled="@Ocupado" @onclick="@(() => Confirmar($"Excluir {_sel.Eap} {_sel.Nome}{(_sel.Resumo ? " e tudo abaixo dele" : "")}?", ExcluirAtividade))">Excluir</button> }
                            </div>
                        }
                    </div>
                    }
                }
                else if (_aba == "redes")
                {
                    <EditorRedes ObraId="_obraId.Value" Editavel="_podeEditar" AoMudar="() => { _redesMudaram = true; return Task.CompletedTask; }" />
                    @if (_redesMudaram && _editavel)
                    {
                        <div class="alerta info mt-12"><Icone Nome="info" /> Redes alteradas. <button class="btn prim pq" id="plan-gerar2" disabled="@Ocupado" @onclick="Gerar">Gerar o cronograma de @v.Codigo pelas redes</button> (mantém avanço, linha de base e folgas ajustadas).</div>
                    }
                }
                else if (_aba == "versoes")
                {
                    <div class="tabela-rolavel"><table class="itens" id="tabela-versoes">
                        <thead><tr><th>Versão</th><th>Situação</th><th>Motivo / descrição</th><th>Término</th><th class="num">Δ base</th><th class="num">Custo</th><th>Enviado</th><th>Aprovado</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var x in _versoes)
                            {
                                <tr class="@(x.Id == _versaoId ? "sel" : "")">
                                    <td><b>@x.Codigo</b></td>
                                    <td><Selo Texto="@De(x.Status)" Tom="@Tom(x.Status)" /></td>
                                    <td>@x.Motivo@if (x.Descricao is { Length: > 0 }) { <div class="mudo">@x.Descricao</div> }@if (x.MotivoDevolucao is { Length: > 0 }) { <div class="neg">Devolvida: @x.MotivoDevolucao</div> }</td>
                                    <td>@Data(x.TerminoPrevisto)</td>
                                    <td class="num">@(x.TerminoBase is { } b && x.TerminoPrevisto is { } t ? _cal.DiasUteisEntre(b, t).ToString("+0;-0;0") : "—")</td>
                                    <td class="num">@x.CustoTotal.ToString("N0", Br)</td>
                                    <td>@(x.EnviadoPor is null ? "—" : $"{x.EnviadoPor} · {DataHora(x.EnviadoEm)}")</td>
                                    <td>@(x.AprovadoPor is null ? "—" : $"{x.AprovadoPor} · {DataHora(x.AprovadoEm)}")</td>
                                    <td class="nowrap">
                                        @if (x.Id != _versaoId) { <button class="btn sec pq" @onclick="() => AbrirVersao(x.Id)">Abrir</button> }
                                        @if (x.Status == StatusVersao.EmElaboracao && _podeEditar) { <button class="btn sec pq perigo" @onclick="@(() => Confirmar($"Descartar a versão {x.Codigo}?", () => Descartar(x.Id)))">Descartar</button> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <div class="cartao mt-12" id="plan-autorizacoes"><b>@v.Codigo</b>
                        <Autorizacoes Entidade="EntidadeAprovavel.Cronograma" EntidadeId="v.Id" Versao="_versaoChave" AoDecidir="Recarregar" />
                    </div>
                    <p class="mudo">O engenheiro responsável e o diretor técnico aprovam (alçadas em Sistema › Permissões). Aprovada, a versão vira vigente, grava o desembolso mensal e a anterior fica como substituída. A LB0 aprovada congela a linha de base.</p>
                }
                else if (_aba == "cal")
                {
                    <div class="grade-2">
                        <div>
                            <h4>Feriados municipais e paradas</h4>
                            <div class="tabela-rolavel"><table class="itens" id="feriados">
                                <thead><tr><th>Data</th><th>Nome</th><th>Vale para</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var f in _feriados)
                                    {
                                        <tr><td>@Data(f.Data)</td><td>@f.Nome</td><td>@(f.ObraId is null ? "todas as obras" : "esta obra")</td>
                                            <td>@if (_podeEditar) { <button class="icone-btn" title="Excluir" @onclick="() => ExcluirFeriado(f.Id)"><Icone Nome="lixeira" Tam="15" /></button> }</td></tr>
                                    }
                                    @if (_feriados.Count == 0) { <tr><td colspan="4" class="mudo">Nenhum. Inclua feriados municipais/estaduais e paradas (ex.: recesso de fim de ano).</td></tr> }
                                </tbody>
                            </table></div>
                            @if (_podeEditar)
                            {
                                <div class="form mt-6">
                                    <Campo Rotulo="Data" Classe="s4"><input id="fer-data" type="date" @bind="_fFerData" /></Campo>
                                    <Campo Rotulo="Nome" Classe="s5"><input id="fer-nome" @bind="_fFerNome" /></Campo>
                                    <Campo Rotulo="Só esta obra" Classe="s3"><input type="checkbox" @bind="_fFerObra" /></Campo>
                                </div>
                                <button class="btn sec" id="fer-add" disabled="@Ocupado" @onclick="AddFeriado"><Icone Nome="mais" Tam="14" /> Incluir</button>
                            }
                        </div>
                        <div>
                            <h4>Feriados nacionais (calculados)</h4>
                            <ul class="lista-simples">
                                @foreach (var (dataF, nomeF) in Calendario.FeriadosNacionais(Hoje.Year).Concat(Calendario.FeriadosNacionais(Hoje.Year + 1)).Where(f => f.Data >= Hoje).Take(16))
                                { <li>@Data(dataF) · @nomeF</li> }
                            </ul>
                            <p class="mudo">Semana de trabalho: segunda a sexta. Carnaval (segunda e terça), Sexta-feira Santa e Corpus Christi param a obra.</p>
                        </div>
                    </div>
                }
            }
        </div>
    </ChildContent>
</Pagina>

<Modal Titulo="@($"Enviar {_versao?.Codigo} para aprovação")" @bind-Aberto="_abertoEnvio">
    <ChildContent>
        @if (_versao is { } ve)
        {
            <div class="kpis">
                <Kpi Rotulo="Término" Valor="@Data(ve.TerminoPrevisto)" Sub="@(_desvio is { } d ? $"{d:+0;-0;0} d.ú. vs base" : "")" />
                <Kpi Rotulo="Custo orçado" Valor="@ve.CustoTotal.ToString("C0", Br)" />
                <Kpi Rotulo="Atividades movidas" Valor="@_movidas" Sub="início diferente da base" />
            </div>
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Motivo" Classe="s12" Obrigatorio>
                    <select id="env-motivo" @bind="_motivo">
                        @foreach (var m in Motivos) { <option>@m</option> }
                    </select>
                </Campo>
                <Campo Rotulo="O que mudou e ação de recuperação" Classe="s12"><textarea id="env-desc" rows="3" @bind="_descricao"></textarea></Campo>
            </div>
            <p class="mudo">Fluxo: engenheiro responsável → diretor técnico. Só depois da aprovação a versão vira vigente e o desembolso é atualizado.</p>
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="env-confirmar" disabled="@Ocupado" @onclick="Enviar"><Icone Nome="enviar" Tam="14" /> Enviar</button></Rodape>
</Modal>

<Modal Titulo="PDF / impressão do cronograma" @bind-Aberto="_abertoImpressao">
    <ChildContent>
        <div class="form">
            <Campo Rotulo="Folha" Classe="s3"><select id="imp-folha" @bind="_folha">@foreach (var f in new[] { "A0", "A1", "A2", "A3", "A4" }) { <option>@f</option> }</select></Campo>
            <Campo Rotulo="Orientação" Classe="s3"><select id="imp-orient" @bind="_orientacao"><option value="paisagem">Paisagem</option><option value="retrato">Retrato</option></select></Campo>
            <Campo Rotulo="Detalhe" Classe="s3"><select id="imp-nivel" @bind="_nivel"><option value="1">Redes</option><option value="2">Pacotes</option><option value="9">Todas as atividades</option></select></Campo>
            <Campo Rotulo="Linha de base" Classe="s3"><input type="checkbox" @bind="_impBase" /></Campo>
        </div>
        <p class="mudo">Abre em nova aba no tamanho da folha; use "Salvar como PDF" na janela de impressão. Para A0–A2 escolha esse tamanho também na impressora/plotter.</p>
    </ChildContent>
    <Rodape><a class="btn prim" id="imp-abrir" target="_blank" href="@($"engenharia/planejamento/imprimir?versao={_versaoId}&folha={_folha}&orientacao={_orientacao}&nivel={_nivel}&base={_impBase}")"><Icone Nome="impressora" Tam="14" /> Abrir para imprimir</a></Rodape>
</Modal>

<Confirmacao Pergunta="@PerguntaConfirmacao" AoSim="ConfirmacaoSim" AoNao="ConfirmacaoNao" />

@code {
    [SupplyParameterFromQuery(Name = "obra")] public Guid? ObraQuery { get; set; }
    [SupplyParameterFromQuery(Name = "aba")] public string? AbaQuery { get; set; }
    [SupplyParameterFromQuery(Name = "versao")] public Guid? VersaoQuery { get; set; }

    private static readonly string[] Motivos = ["Planejamento inicial", "Atraso de fornecedor", "Chuvas acima da média", "Mão de obra / produtividade", "Mudança de projeto", "Antecipação de etapa", "Ajuste de ritmo (linha de balanço)", "Outro"];
    private readonly List<(string, string)> _abas = [("crono", "Cronograma"), ("redes", "Redes"), ("versoes", "Versões e aprovação"), ("cal", "Calendário")];
    private readonly List<string> _toolbar = ["ExpandAll", "CollapseAll", "ZoomIn", "ZoomOut", "ZoomToFit", "PrevTimeSpan", "NextTimeSpan", "Search"];

    private SfGantt<LinhaGantt>? _gantt;
    // Rótulos da escala de tempo em português (o servidor roda com cultura invariante).
    private static readonly string[] MesesCurtos = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];
    private readonly RenderFragment<GanttTimelineFormatter> _fmtMes = f => @<text>@(MesesCurtos[f.Date.Month - 1])/@(f.Date.Year)</text>;
    private readonly RenderFragment<GanttTimelineFormatter> _fmtDia = f => @<text>@f.Date.ToString("dd")</text>;
    private Guid? _obraId, _versaoId;
    private string _aba = "crono";
    private string _modoCrono = "editar";
    private int _ganttChave;
    private bool _mudouNoGantt;
    private List<VersaoCronograma> _versoes = [];
    private VersaoCronograma? _versao;
    private Calendario _cal = new();
    private List<LinhaGantt> _linhas = [];
    private Dictionary<int, AtividadeCronograma> _porLinha = [];
    private List<(DateTime, string)> _feriadosVisiveis = [];
    private List<Feriado> _feriados = [];
    private List<RedePlanejamento> _redesVersao = [];
    private DateTime _pIni, _pFim;
    private bool _mostrarBase = true, _editavel, _podeEditar, _redesMudaram, _abertoEnvio, _abertoImpressao, _impBase = true, _fFerObra = true;
    private int? _desvio;
    private int _criticas, _folhas, _movidas, _versaoChave;
    private decimal _avanco;
    private AtividadeCronograma? _sel;
    private bool _novoResumo;
    private string _fNome = "";
    private int _fDur = 1;
    private decimal _fAvanco;
    private string? _fPred;
    private DateOnly? _fInicio;
    private string _motivo = Motivos[0];
