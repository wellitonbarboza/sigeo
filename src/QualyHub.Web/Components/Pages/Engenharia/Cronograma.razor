    private Guid? _paiNovo;
    private void NovaAtividade(bool resumo)
    {
        _paiNovo = _sel?.Resumo == true ? _sel.Id : _sel?.PaiId;
        _sel = null; _novoResumo = resumo; _fNome = ""; _fDur = resumo ? 0 : 5; _fAvanco = 0; _fPred = resumo ? null : ""; _fInicio = null;
    }

    private async Task SalvarAtividade()
    {
        if (_versao is not { } v) return;
        var e = new PlanejamentoServico.AtividadeEdicao(_sel?.Id, _sel is null ? _paiNovo : _sel.PaiId, _fNome, _fDur, _fAvanco, _fPred,
            _sel is not null && _fInicio is { } i && i != _sel.Inicio ? i : null, _sel?.Resumo ?? _novoResumo);
        Guid id = default;
        if (await Executar(async () => id = await Plan.SalvarAtividadeAsync(v.Id, e, Cancelamento), "Atividade salva e cronograma recalculado."))
        {
            await using var db = Fabrica.CriarLeitura();
            _sel = new AtividadeCronograma { Id = id };
            await CarregarVersao(db);
        }
    }

    private async Task ExcluirAtividade()
    {
        if (_versao is not { } v || _sel is not { } a) return;
        if (await Executar(() => Plan.ExcluirAtividadeAsync(v.Id, a.Id, Cancelamento), "Excluída e cronograma recalculado."))
        { _sel = null; await using var db = Fabrica.CriarLeitura(); await CarregarVersao(db); }
    }

    /// <summary>
    /// Barra editada no Gantt: decide pelo que mudou — arrastar (início e término andam juntos) só move (folga no vínculo);
    /// puxar uma ponta muda a duração; arrastar o progresso muda o avanço.
    /// </summary>
    private async Task AoEditarBarra(TaskbarEditedEventArgs<LinhaGantt> e)
    {
        if (_versao is not { } v || e.Data is not { } l || !_porLinha.TryGetValue(l.Id, out var a)) return;
        var ini = DateOnly.FromDateTime(l.Inicio); var fim = DateOnly.FromDateTime(l.Termino);
        var mudouIni = ini != a.Inicio; var mudouFim = fim != a.Termino;
        bool ok;
        if (!mudouIni && !mudouFim && l.Avanco != (int)Math.Round(a.Avanco))
            ok = await Executar(() => Plan.SalvarAtividadeAsync(v.Id, new PlanejamentoServico.AtividadeEdicao(a.Id, a.PaiId, a.Nome, a.Duracao, Math.Clamp(l.Avanco, 0, 100), null, null), Cancelamento));
        else if (!mudouIni && !mudouFim) return;
        else
        {
            var mesmaDuracao = a.Duracao == 0 || _cal.DiasUteisEntre(_cal.ProximoUtil(ini), fim) + (_cal.EhUtil(fim) ? 1 : 0) == a.Duracao;
            ok = await Executar(() => Plan.MoverAsync(v.Id, a.Id, ini, mudouIni && mudouFim && mesmaDuracao ? null : fim, Cancelamento));
        }
        _sel = a;
        await using var db = Fabrica.CriarLeitura();
        await CarregarVersao(db); // em caso de erro volta a barra para a posição calculada
        if (ok) Notif.Sucesso("Cronograma recalculado.");
    }

