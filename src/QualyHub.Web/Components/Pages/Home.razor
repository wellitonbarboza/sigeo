@page "/"
@inherits PaginaBase
@inject AprovacaoServico Aprov
@inject NavigationManager Nav

<PageTitle>Minhas pendências · QualyHub</PageTitle>
<div class="tela">
    <div class="topo"><h1>Minhas pendências</h1><div class="direita"><button class="btn sec pq" @onclick="AbrirDelegacao"><Icone Nome="pessoa" Tam="14" /> Delegar aprovações (férias/ausência)</button></div></div>
    <div class="miolo">
        <div class="pagina">
            <p style="margin:0 0 10px"><b>@Saudacao(), @Usuario.Nome.Split(' ')[0]</b> <span class="mudo">· @(Rotulos.De(Enum.TryParse<PerfilUsuario>(Usuario.Perfil, out var pf) ? pf : PerfilUsuario.Campo)) · @Usuario.EmpresaNome · @Data(Hoje)</span></p>
            <div class="kpis">
                <Kpi Rotulo="Aprovações pendentes" Valor="@_aprovar.Count" Sub="@($"{_aprovar.Count(a => a.Atrasada)} fora do prazo")" Tom="@(_aprovar.Count > 0 ? "aviso" : "ok")" />
                <Kpi Rotulo="Pagamentos a liberar" Valor="@_pagamentos.Count" Sub="@Moeda(_pagamentos.Sum(p => p.Valor))" Tom="info" />
                <Kpi Rotulo="Alertas" Valor="@_alertas.Sum(a => a.Qtd)" Sub="documentos, prazos e vencimentos" Tom="@(_alertas.Any(a => a.Tom == "erro") ? "erro" : "aviso")" />
                <Kpi Rotulo="Minhas tarefas" Valor="@_tarefas.Count" Sub="@($"{_tarefas.Count(t => t.Atrasada(Hoje))} atrasada(s)")" Tom="@(_tarefas.Any(t => t.Atrasada(Hoje)) ? "erro" : "info")" />
                <Kpi Rotulo="Minhas leituras" Valor="@_leituras.Count" Sub="@(_leituras.Count == 0 ? "em dia" : $"prazo {_leituras.Min(l => l.Prazo):dd/MM}")" />
            </div>
            <Abas Itens="Abas" @bind-Ativa="_aba" />
            @if (_aba == "aprovar" || _aba == "pagar")
            {
                var lista = _aba == "aprovar" ? _aprovar.Where(a => a.Entidade != EntidadeAprovavel.Pagamento).ToList() : _aprovar.Where(a => a.Entidade == EntidadeAprovavel.Pagamento).ToList();
                <table class="itens">
                    <thead><tr><th>Tipo</th><th>Título</th><th>Solicitante</th><th class="num">Valor</th><th>Aguardando há</th><th>Prazo</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in lista)
                        {
                            <tr style="cursor:pointer" @onclick="() => Ir(a.Entidade, a.EntidadeId)">
                                <td><Selo Texto="@De(a.Entidade)" Tom="info" /></td><td>@a.Titulo</td><td>@a.Solicitante</td><td class="num">@Moeda(a.Valor)</td>
                                <td>@Espera(a.Enviado)</td>
                                <td>@if (a.Prazo is { } pz) { <Selo Texto="@(a.Atrasada ? "atrasado" : pz.ToLocalTime().ToString("dd/MM HH:mm"))" Tom="@(a.Atrasada ? "erro" : "aviso")" /> }</td>
                                <td><button class="btn pq @(a.Entidade == EntidadeAprovavel.Pagamento ? "ok" : "prim")">@(a.Entidade == EntidadeAprovavel.Pagamento ? "Liberar" : "Abrir")</button></td>
                            </tr>
                        }
                        @if (lista.Count == 0) { <tr><td colspan="7" class="mudo">Nada pendente com você.</td></tr> }
                    </tbody>
                </table>
            }
            else if (_aba == "alertas")
            {
                <div class="alertas-home">
                    @foreach (var a in _alertas) { <a class="alerta @a.Tom" href="@a.Link"><Icone Nome="alerta" /> <b>&nbsp;@a.Qtd&nbsp;</b> @a.Texto</a> }
                    @if (_alertas.Count == 0) { <div class="alerta ok"><Icone Nome="check" /> Nenhum alerta. Tudo em dia.</div> }
                </div>
            }
            else if (_aba == "tarefas")
            {
                <table class="itens"><thead><tr><th>Nº</th><th>Título</th><th>Solicitante</th><th>Prioridade</th><th>Prazo</th><th>Status</th></tr></thead>
                    <tbody>@foreach (var t in _tarefas) { <tr style="cursor:pointer" @onclick='() => Nav.NavigateTo($"tarefas?id={t.Id}")'><td>@t.Numero</td><td>@t.Titulo @if (t.Leituras.Count == 0) { <Selo Texto="nova" Tom="info" /> }</td><td>@t.CriadoPor</td><td><Selo Texto="@De(t.Prioridade)" Tom="@Tom(t.Prioridade)" /></td><td class="@(t.Atrasada(Hoje) ? "texto-erro" : "")">@Data(t.Prazo)</td><td><Selo Texto="@De(t.Status)" Tom="@Tom(t.Status)" /></td></tr> }
                    @if (_tarefas.Count == 0) { <tr><td colspan="6" class="mudo">Nenhuma tarefa aberta para você.</td></tr> }</tbody></table>
            }
            else if (_aba == "leituras")
            {
                <table class="itens"><thead><tr><th>Documento</th><th>Prazo</th><th></th></tr></thead>
                    <tbody>@foreach (var l in _leituras) { <tr><td>@l.Documento</td><td>@Data(l.Prazo)</td><td><a class="btn pq prim" href="sgq/leituras">Ler</a></td></tr> }
                    @if (_leituras.Count == 0) { <tr><td colspan="3" class="mudo">Nenhuma leitura pendente.</td></tr> }</tbody></table>
            }
            else
            {
                <table class="itens"><thead><tr><th>Tipo</th><th>Título</th><th>Enviado</th><th>Etapa</th><th>Status</th></tr></thead>
                    <tbody>@foreach (var s in _meus) { <tr style="cursor:pointer" @onclick="() => Ir(s.Entidade, s.EntidadeId)"><td>@De(s.Entidade)</td><td>@s.Titulo</td><td>@DataHora(s.EnviadoEm)</td><td>@s.EtapaAtual de @s.Etapas.Count</td><td><Selo Texto="@De(s.Status)" Tom="@(s.Status == StatusAprovacao.Aprovado ? "ok" : s.Status == StatusAprovacao.Reprovado ? "erro" : "aviso")" /></td></tr> }
                    @if (_meus.Count == 0) { <tr><td colspan="5" class="mudo">Você não enviou nada para aprovação nos últimos 60 dias.</td></tr> }</tbody></table>
            }

            <div class="duas-caixas">
                <div class="caixa-sec"><div class="secao"><Icone Nome="pessoa" /> Delegação ativa</div>
                    @if (_delegacao is null) { <p style="font-size:13px">Nenhuma delegação ativa. Ao delegar, as aprovações do período vão para o substituto e o log registra "aprovado por X em nome de @Usuario.Nome".</p> }
                    else { <p style="font-size:13px">Suas aprovações estão com <b>@_delegacao.Value.Substituto</b> até <b>@_delegacao.Value.Fim.ToLocalTime().ToString("dd/MM/yyyy")</b>.</p> }
                </div>
                @if (_vazio)
                {
                    <div class="caixa-sec"><div class="secao"><Icone Nome="casa" /> Primeiros passos (banco zerado)</div>
                        <ol class="passos-iniciais">
                            <li><a href="cadastros/obras">Obras, centros de custo e locais</a></li>
                            <li><a href="sistema/usuarios">Usuários, limites e alçadas</a></li>
                            <li><a href="sistema/parametros">Parâmetros, listas e notificações</a></li>
                            <li><a href="fornecedores">Fornecedores</a> e <a href="fornecedores/qualificacao">qualificação</a></li>
                            <li><a href="obra/modelos/fvs">Modelos de FVS</a> e <a href="obra/modelos/fvm">FVM</a></li>
                            <li><a href="sst/exigencias">Matriz de exigências (validar com SST)</a> e <a href="sst/colaboradores">colaboradores</a></li>
                        </ol>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="faixa"><b>Tela 25 · Minhas pendências</b><span>Caixa de entrada por usuário: aprovar, liberar, alertas e leituras</span><span>Prazo por etapa (alçada)</span></div>
</div>

<Modal @bind-Aberto="_abertoDel" Titulo="Delegar minhas aprovações" Tamanho="media">
    <ChildContent>
        <Erros Lista="ErrosForm" />
        <div class="form">
            <Campo Rotulo="Quem delega" Classe="s6"><input readonly value="@Usuario.Nome" /></Campo>
            <Campo Rotulo="Substituto" Obrigatorio Classe="s6"><select @bind="_d.SubstitutoUsuarioId"><option value="@Guid.Empty">Selecione…</option>@foreach (var u in _usuarios.Where(u => u.Id != Usuario.UsuarioId)) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
            <Campo Rotulo="Início" Classe="s6"><input type="date" value="@_d.Inicio.ToString("yyyy-MM-dd")" @onchange="e => _d.Inicio = DateOnly.Parse(e.Value!.ToString()!).ToDateTime(TimeOnly.MinValue)" /></Campo>
            <Campo Rotulo="Fim" Classe="s6"><input type="date" value="@_d.Fim.ToString("yyyy-MM-dd")" @onchange="e => _d.Fim = DateOnly.Parse(e.Value!.ToString()!).ToDateTime(new TimeOnly(23, 59))" /></Campo>
            <Campo Rotulo="Etapas" Classe="s6"><select @bind="_d.Entidade"><option value="">Todas</option>@foreach (var e in Enum.GetValues<EntidadeAprovavel>()) { <option value="@e">@De(e)</option> }</select></Campo>
            <Campo Rotulo="Motivo" Obrigatorio Classe="s6"><input @bind="_d.Motivo" placeholder="Férias, viagem…" /></Campo>
        </div>
        <p class="mudo">Quem solicita ou elabora não aprova o próprio item, mesmo por delegação. A aprovação grava "em nome de".</p>
    </ChildContent>
    <Rodape><button class="btn prim" disabled="@Ocupado" @onclick="SalvarDelegacao"><Icone Nome="check" Tam="16" /> Salvar delegação</button></Rodape>
</Modal>

@code {
    private sealed record Pend(EntidadeAprovavel Entidade, Guid EntidadeId, string Titulo, string Solicitante, decimal Valor, DateTimeOffset Enviado, DateTimeOffset? Prazo, bool Atrasada);
    private List<Pend> _aprovar = [];
    private List<(decimal Valor, Guid Id)> _pagamentos = [];
    private List<(string Texto, int Qtd, string Tom, string Link)> _alertas = [];
    private List<(string Documento, DateOnly Prazo)> _leituras = [];
    private List<QualyHub.Domain.Colaboracao.Tarefa> _tarefas = [];
    private List<SolicitacaoAprovacao> _meus = [];
    private (string Substituto, DateTimeOffset Fim)? _delegacao;
    private List<Opcao> _usuarios = [];
    private DelegacaoAprovacao _d = new();
    private bool _vazio, _abertoDel;
    private string _aba = "aprovar";
    private List<(string, string)> Abas => [("aprovar", $"Aprovar ({_aprovar.Count(a => a.Entidade != EntidadeAprovavel.Pagamento)})"), ("pagar", $"Liberar pagamento ({_pagamentos.Count})"),
        ("tarefas", $"Tarefas ({_tarefas.Count})"), ("alertas", $"Alertas ({_alertas.Sum(a => a.Qtd)})"), ("leituras", $"Leituras ({_leituras.Count})"), ("meus", "Acompanhar (meus pedidos)")];
    private static string Saudacao() => DateTime.Now.Hour < 12 ? "Bom dia" : DateTime.Now.Hour < 18 ? "Boa tarde" : "Boa noite";
    private static string Espera(DateTimeOffset d) { var h = (DateTimeOffset.UtcNow - d).TotalHours; return h < 24 ? $"{h:0} h" : $"{h / 24:0} dia(s)"; }

    protected override async Task OnInitializedAsync() { _usuarios = await Cat.UsuariosAsync(); await Carregar(); }

    private async Task Carregar()
    {
        await using var db = Fabrica.Criar();
        var agora = DateTimeOffset.UtcNow;
        var alcadas = await db.Alcadas.AsNoTracking().ToListAsync();
        var abertas = await db.SolicitacoesAprovacao.AsNoTracking().Include(s => s.Etapas).Where(s => s.Status == StatusAprovacao.EmAprovacao).OrderBy(s => s.EnviadoEm).ToListAsync();
        _aprovar = [];
        if (Usuario.UsuarioId is not null)
            foreach (var s in abertas)
                if (await Aprov.PodeDecidirAsync(db, s))
                {
                    var horas = alcadas.FirstOrDefault(a => a.Entidade == s.Entidade && a.Ordem == s.EtapaAtual)?.PrazoHoras;
                    var desde = s.Etapas.Where(e => e.DecididoEm != null).Select(e => e.DecididoEm).Max() ?? s.EnviadoEm;
                    DateTimeOffset? prazo = horas is { } h ? desde.AddHours(h) : null;
                    _aprovar.Add(new Pend(s.Entidade, s.EntidadeId, s.Titulo, s.SolicitanteNome, s.Valor, s.EnviadoEm, prazo, prazo < agora));
                }
        _pagamentos = _aprovar.Where(a => a.Entidade == EntidadeAprovavel.Pagamento).Select(a => (a.Valor, a.EntidadeId)).ToList();
        var eu = Usuario.UsuarioId;
        _leituras = (await db.Ciencias.AsNoTracking().Include(c => c.Revisao).ThenInclude(r => r.Documento).Where(c => c.UsuarioId == eu && c.LidoEm == null).ToListAsync())
            .Select(c => ($"{c.Revisao.Documento.Codigo} {c.Revisao.Rotulo} – {c.Revisao.Documento.Titulo}", c.Prazo)).ToList();
        _tarefas = await db.Tarefas.AsNoTracking().Include(t => t.Leituras).Where(t => t.ResponsavelId == eu && (t.Status == StatusTarefa.Aberta || t.Status == StatusTarefa.EmAndamento))
                                   .OrderBy(t => t.Prazo).ToListAsync();
        var ha60 = agora.AddDays(-60);
        _meus = await db.SolicitacoesAprovacao.AsNoTracking().Include(s => s.Etapas).Where(s => s.SolicitanteUsuarioId == eu && s.EnviadoEm >= ha60).OrderByDescending(s => s.EnviadoEm).Take(50).ToListAsync();
        var del = await db.DelegacoesAprovacao.AsNoTracking().Where(d => d.TitularUsuarioId == eu && !d.Revogada && d.Inicio <= agora && d.Fim > agora).FirstOrDefaultAsync();
        _delegacao = del is null ? null : (_usuarios.FirstOrDefault(u => u.Id == del.SubstitutoUsuarioId)?.Texto ?? "?", del.Fim);

        var p = await ParametrosServico.CarregarAsync(db);
        _alertas = [];
        void A(int n, string texto, string tom, string link) { if (n > 0) _alertas.Add((texto, n, tom, link)); }
        A(await db.FornecedorDocumentos.CountAsync(d => d.Bloqueia && d.DataValidade != null && d.DataValidade < Hoje && d.Status != StatusDocumento.Reprovado), "documento(s) de fornecedor vencido(s) — pedidos e medições bloqueados", "erro", "fornecedores/documentos");
        A(await db.FornecedorDocumentos.CountAsync(d => d.Status == StatusDocumento.EmValidacao), "documento(s) enviados pelo portal aguardando validação", "aviso", "fornecedores/documentos");
        A(await db.Documentos.CountAsync(d => d.ProximaAnalise != null && d.ProximaAnalise < Hoje), "documento(s) do SGQ com análise crítica vencida", "erro", "sgq/documentos");
        A(await db.Copias.CountAsync(c => c.Status == StatusCopia.RecolhimentoPendente && c.PrazoRecolhimento < Hoje), "cópia(s) obsoleta(s) com recolhimento atrasado", "erro", "sgq/copias");
        A(await db.Grds.CountAsync(g => g.ConfirmadoEm == null && g.EnviadoEm < agora.AddDays(-1)), "GRD sem confirmação há mais de 1 dia", "aviso", "sgq/grd");
        A(await db.Fvss.CountAsync(f => f.Status == StatusFvs.Reprovada), "FVS reprovada(s) aguardando reinspeção", "aviso", "obra/fvs");
        A(await db.Fvss.CountAsync(f => f.Status == StatusFvs.Aprovada), "FVS aprovada(s) aguardando liberação do engenheiro", "info", "obra/fvs");
        A(await db.Rncs.CountAsync(r => (r.Status == StatusRnc.Aberta || r.Status == StatusRnc.EmTratamento) && r.Prazo < Hoje), "RNC vencida(s)", "erro", "obra/rnc");
        A(await db.AcoesCorretivas.CountAsync(a => a.Status == StatusAcaoCorretiva.AguardandoEficacia && a.DataEficacia <= Hoje), "ação(ões) corretiva(s) com eficácia a verificar", "aviso", "obra/acoes");
        A((await db.Equipamentos.AsNoTracking().ToListAsync()).Count(e => e.Status(Hoje, p.Int(Parametros.AlertaCalibracaoDias)) is StatusEquipamento.VenceEmBreve or StatusEquipamento.Bloqueado), "equipamento(s) de medição vencendo ou bloqueados", "aviso", "obra/equipamentos");
        A(await db.EnsaiosRecebimento.CountAsync(x => x.Situacao == SituacaoEnsaio.Aguardando && x.DataPrevista < Hoje), "ensaio(s) de recebimento com resultado atrasado", "erro", "recebimentos");
        A(await db.Tarefas.CountAsync(t => (t.Status == StatusTarefa.Aberta || t.Status == StatusTarefa.EmAndamento) && t.Prazo < Hoje), "tarefa(s) atrasada(s) na empresa", "erro", "tarefas");
        A(await db.PlanosAcao.CountAsync(x => x.Status != StatusPlanoAcao.Concluida && x.Prazo < Hoje), "plano(s) de ação de fornecedor vencido(s)", "erro", "fornecedores/planos");
        A(await db.Contratos.CountAsync(k => k.Status == StatusContrato.Ativo && k.VigenciaFim <= Hoje.AddDays(30)), "contrato(s) vencendo em 30 dias", "aviso", "contratos");
        A(await db.Colaboradores.CountAsync(c => c.Situacao == SituacaoColaborador.Bloqueado && (c.DataSaida == null || c.DataSaida > Hoje)), "colaborador(es) bloqueados (ASO/integração)", "erro", "sst/colaboradores");
        A(await db.DocumentosColaborador.CountAsync(d => d.Validacao == ValidacaoDoc.Aguardando), "documento(s) de colaborador aguardando validação do SST", "aviso", "sst/documentos");
        A(await db.PermissoesTrabalho.CountAsync(x => x.Status == StatusPermissaoTrabalho.Liberada && x.Fim < agora), "PT sem encerramento", "erro", "sst/pt");
        A(await db.Epis.CountAsync(e => e.Ativo && e.ValidadeCa <= Hoje.AddDays(p.Int(Parametros.AlertaCaDias))), "EPI com CA vencendo/vencido", "aviso", "sst/epi");
        _vazio = !await db.Obras.AnyAsync() || !await db.Fornecedores.AnyAsync();
    }

    private void Ir(EntidadeAprovavel e, Guid id)
    {
        var rota = e switch
        {
            EntidadeAprovavel.Requisicao => "requisicoes", EntidadeAprovavel.Cotacao => "cotacoes", EntidadeAprovavel.Pedido => "pedidos",
            EntidadeAprovavel.Contrato => "contratos", EntidadeAprovavel.Medicao => "medicoes", EntidadeAprovavel.Pagamento => "pagamentos",
            EntidadeAprovavel.Aditivo => "contratos", EntidadeAprovavel.DocumentoSgq => "sgq/documentos", _ => ""
        };
        Nav.NavigateTo(e == EntidadeAprovavel.Aditivo ? $"contratos?aditivo={id}" : $"{rota}?id={id}");
    }

    private void AbrirDelegacao()
    {
        _d = new DelegacaoAprovacao { TitularUsuarioId = Usuario.UsuarioId ?? Guid.Empty, Inicio = DateTimeOffset.Now.Date, Fim = DateTimeOffset.Now.Date.AddDays(15).AddHours(23) };
        ErrosForm = null; _abertoDel = true;
    }

    private async Task SalvarDelegacao()
    {
        if (await Executar(async () =>
        {
            var e = new List<string>();
            if (_d.SubstitutoUsuarioId == Guid.Empty) e.Add("Informe o substituto.");
            if (_d.Fim <= _d.Inicio) e.Add("Fim deve ser posterior ao início.");
            if (string.IsNullOrWhiteSpace(_d.Motivo)) e.Add("Informe o motivo.");
            ValidacaoException.Se(e);
            await using var db = Fabrica.Criar();
            db.DelegacoesAprovacao.Add(_d); await db.SaveChangesAsync();
        }, "Delegação registrada.")) { _abertoDel = false; await Carregar(); }
    }
}
