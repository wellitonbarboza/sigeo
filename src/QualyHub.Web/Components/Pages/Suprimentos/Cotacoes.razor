@page "/cotacoes"
@inherits PaginaBase
@inject SuprimentosServico Sup
@inject NavigationManager Nav
@inject IJSRuntime JS

<Pagina Titulo="Orçamentos (cotação)" Grade="_grade" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <Grade T="Linha" @ref="_grade" Itens="_itens" AoClicar="l => Abrir(l.Id)" NomeExportacao="cotacoes" CriadoPor="l => l.CriadoPor">
                <Colunas>
                    <Coluna T="Linha" Titulo="Número" Valor="l => l.Numero" Largura="90px" />
                    <Coluna T="Linha" Titulo="Nome" Valor="l => l.Nome" />
                    <Coluna T="Linha" Titulo="Obra" Valor="l => l.Obra" />
                    <Coluna T="Linha" Titulo="Tipo" Valor="l => l.Tipo" />
                    <Coluna T="Linha" Titulo="Propostas" Valor='l => $"{l.Recebidas}/{l.Exigidas}"' Alinhar="num" />
                    <Coluna T="Linha" Titulo="Valor estimado" Valor="l => l.Valor" Formato="C2" Alinhar="num" />
                    <Coluna T="Linha" Titulo="Vencedor" Valor="l => l.Vencedor" />
                    <Coluna T="Linha" Titulo="Status" Valor="l => l.Status"><Modelo><Selo Texto="@De(context.Status)" Tom="@Tom(context.Status)" /></Modelo></Coluna>
                    <Coluna T="Linha" Titulo="Criado em" Valor="l => l.CriadoEm" />
                </Colunas>
            </Grade>
        </div>
    </ChildContent>
    <Faixa><b>Orçamento</b><span>Até @Moeda(_p?[Parametros.LimiteUmOrcamento]) → 1 proposta; acima → @_p?.Int(Parametros.OrcamentosAcimaLimite) propostas</span><span>Vencedor precisa estar qualificado</span><span>Aprovação conforme alçada configurada</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_aberto" Titulo="@($"Cotação {_c?.Numero} — {_c?.Nome}")" Tamanho="grande">
    <ChildContent>
        @if (_c is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="kpis">
                <Kpi Rotulo="Valor estimado" Valor="@Moeda(_c.ValorEstimado)" Sub="@($"faixa {_c.FaixaAlcada(_p!)}")" />
                <Kpi Rotulo="Propostas" Valor="@($"{_c.PropostasRecebidas}/{_c.PropostasExigidas}")" Tom="@(_c.PropostasRecebidas >= _c.PropostasExigidas ? "ok" : "aviso")" Sub="recebidas / exigidas" />
                <Kpi Rotulo="Economia negociada" Valor="@Moeda(Econ.Negociada)" Sub="@($"{Econ.NegociadaPerc:0.0}% vs. ofertado")" Tom="ok" />
                <Kpi Rotulo="Economia vs. último preço" Valor="@(Econ.VsUltimo is { } u ? Moeda(u) : "—")" Sub="@(Econ.VsUltimoPerc is { } up ? $"{up:0.0}% vs. última compra" : "sem compra anterior")" Tom="@(Econ.VsUltimo is < 0 ? "erro" : "ok")" />
                <Kpi Rotulo="Economia vs. referência" Valor="@(Econ.VsReferencia is { } r ? Moeda(r) : "—")" Sub="@(Econ.VsReferenciaPerc is { } rp ? $"{rp:0.0}% vs. preço de referência" : "produto sem preço de referência")" Tom="@(Econ.VsReferencia is < 0 ? "erro" : "ok")" />
                <Kpi Rotulo="Status" Valor="@De(_c.Status)" />
            </div>
            @if (_c.FornecedorVencedorId is null) { <p class="mudo" style="margin-top:-6px">Economias calculadas sobre o menor preço de cada item até escolher o vencedor.</p> }

            <div class="secao"><Icone Nome="predio" /> Fornecedores convidados</div>
            <table class="itens">
                <thead><tr><th>Fornecedor</th><th>Qualificação na data</th><th>Status</th><th>Resposta</th><th>Condição pagto.</th><th>Validade proposta</th><th>Frete (R$)</th><th>Total</th><th>Link da proposta</th></tr></thead>
                <tbody>
                    @foreach (var f in _c.Fornecedores)
                    {
                        var total = Total(f.FornecedorId);
                        <tr class="@(f.FornecedorId == _c.FornecedorVencedorId ? "destaque" : "")">
                            <td><b>@Nome(f.FornecedorId)</b></td>
                            <td><Selo Texto="@De(f.QualificacaoNaData)" Tom="@Tom(f.QualificacaoNaData)" /></td>
                            <td>
                                <select @bind="f.Status" disabled="@(!Editavel)">@foreach (var s in Enum.GetValues<StatusConvite>()) { <option value="@s">@De(s)</option> }</select>
                            </td>
                            <td style="width:140px"><input type="date" @bind="f.DataResposta" disabled="@(!Editavel)" /></td>
                            <td><select @bind="f.CondicaoPagamento" disabled="@(!Editavel)"><option value="">—</option>@foreach (var c in _condicoes) { <option>@c</option> }</select></td>
                            <td style="width:140px"><input type="date" @bind="f.ValidadeProposta" disabled="@(!Editavel)" /></td>
                            <td style="width:110px"><input type="number" step="0.01" @bind="f.ValorFrete" disabled="@(!Editavel)" /></td>
                            <td class="num">@Moeda(total)</td>
                            <td>@if (Editavel) { <button class="btn sec pq" title="Copia o link para o fornecedor preencher preços, prazo e frete (sem login)" @onclick="() => CopiarLink(f)"><Icone Nome="enviar" Tam="14" /> Copiar link</button> }</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="secao"><Icone Nome="tabela" /> Mapa comparativo (valor unitário ofertado / negociado)</div>
            <div style="overflow:auto">
                <table class="itens mapa">
                    <thead>
                        <tr><th>Item</th><th>UN</th><th>Quant.</th><th title="Último preço unitário pago pelo mesmo produto">Último</th><th title="Preço de referência do cadastro do produto">Ref.</th>
                            @foreach (var f in _c.Fornecedores) { <th colspan="2" style="text-align:center">@Nome(f.FornecedorId)</th> }
                        </tr>
                        <tr><th></th><th></th><th></th><th></th><th></th>@foreach (var _ in _c.Fornecedores) { <th>Ofertado</th><th>Negociado</th> }</tr>
                    </thead>
                    <tbody>
                        @foreach (var g in _c.Itens.GroupBy(i => i.RequisicaoItemId))
                        {
                            var primeiro = g.First();
                            var menor = g.Where(i => i.ValorTotal > 0).Select(i => i.ValorTotal).DefaultIfEmpty(0).Min();
                            <tr>
                                <td>@primeiro.Descricao @if (primeiro.MaterialControlado) { <Selo Texto="controlado" Tom="info" /> }</td>
                                <td>@primeiro.Unidade</td><td class="num">@Num(primeiro.Quantidade, 3)</td>
                                <td class="num mudo">@(primeiro.PrecoUltimo is { } pu ? Moeda(pu) : "—")</td>
                                <td class="num mudo">@(primeiro.PrecoReferencia is { } pr ? Moeda(pr) : "—")</td>
                                @foreach (var f in _c.Fornecedores)
                                {
                                    var it = g.FirstOrDefault(i => i.FornecedorId == f.FornecedorId);
                                    if (it is null) { <td></td><td></td> continue; }
                                    <td class="@(it.ValorTotal > 0 && it.ValorTotal == menor ? "melhor" : "")" style="width:110px"><input type="number" step="0.01" @bind="it.ValorOfertado" @bind:after="Recalcular" disabled="@(!Editavel)" /></td>
                                    <td style="width:120px"><input type="number" step="0.01" @bind="it.ValorNegociado" @bind:after="Recalcular" disabled="@(!Editavel)" />
                                        @if (it.EconomiaVsUltimo is { } eu) { <span class="econ @(eu >= 0 ? "pos" : "neg")" title="vs. último preço">últ. @Moeda(eu)</span> }
                                        @if (it.EconomiaVsReferencia is { } er) { <span class="econ @(er >= 0 ? "pos" : "neg")" title="vs. referência">ref. @Moeda(er)</span> }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form" style="margin-top:14px">
                <Campo Rotulo="Fornecedor vencedor" Obrigatorio Classe="s4">
                    <select @bind="_c.FornecedorVencedorId" disabled="@(!Editavel)"><option value="">Selecione…</option>
                        @foreach (var f in _c.Fornecedores) { <option value="@f.FornecedorId">@Nome(f.FornecedorId) (@De(f.QualificacaoNaData))</option> }
                    </select>
                </Campo>
                <Campo Rotulo="Critério de seleção" Obrigatorio Classe="s3">
                    <select @bind="_c.CriterioSelecao" disabled="@(!Editavel)"><option value="">Selecione…</option>@foreach (var c in Enum.GetValues<CriterioSelecao>()) { <option value="@c">@De(c)</option> }</select>
                </Campo>
                <Campo Rotulo="Frete" Classe="s2"><select @bind="_c.Frete" disabled="@(!Editavel)"><option value="@TipoFrete.CIF">CIF</option><option value="@TipoFrete.FOB">FOB</option></select></Campo>
                <Campo Rotulo="Endereço de entrega" Classe="s3"><input @bind="_c.EnderecoEntrega" disabled="@(!Editavel)" /></Campo>
                @if (_c.PropostasRecebidas < _c.PropostasExigidas || _c.CriterioSelecao is not null and not CriterioSelecao.MenorPreco)
                {
                    <Campo Rotulo="Justificativa (propostas abaixo do mínimo / critério diferente de menor preço)" Classe="s12"><textarea @bind="_c.JustificativaPropostas" disabled="@(!Editavel)"></textarea></Campo>
                }
            </div>
            <Anexos Entidade="Cotacao" EntidadeId="_c.Id" Categoria="Proposta" Titulo="Propostas dos fornecedores" SomenteLeitura="!Editavel" />
            @if (_c.CriadoEm != default) { <Notas Entidade="Cotacao" EntidadeId="_c.Id" /> }
            <Autorizacoes Entidade="EntidadeAprovavel.Cotacao" EntidadeId="_c.Id" Versao="_versao" AoDecidir="Recarregar" />
        }
    </ChildContent>
    <Rodape>
        @if (_c is not null)
        {
            @if (_c.Status == StatusCotacao.Aprovado)
            {
                if (_c.Tipo == TipoRequisicao.Material) { <button class="btn laranja" disabled="@Ocupado" @onclick="GerarPedido"><Icone Nome="sacola" Tam="16" /> Gerar pedido</button> }
                else { <button class="btn laranja" disabled="@Ocupado" @onclick="GerarContrato"><Icone Nome="contrato" Tam="16" /> Gerar contrato</button> }
            }
            @if (Editavel)
            {
                <button class="btn ok" disabled="@Ocupado" @onclick="Enviar"><Icone Nome="enviar" Tam="16" /> Enviar p/ aprovação</button>
                <button class="btn prim" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="16" /> Salvar</button>
            }
        }
    </Rodape>
</Modal>

@code {
    private sealed record Linha(Guid Id, int Numero, string Nome, string Obra, TipoRequisicao Tipo, int Recebidas, int Exigidas, decimal Valor, string? Vencedor, StatusCotacao Status, string CriadoPor, DateTimeOffset CriadoEm);
    private Grade<Linha>? _grade;
    private List<Linha>? _itens;
    private Cotacao? _c;
    private bool _aberto;
    private int _versao;
    private ParametrosVigentes? _p;
    private Dictionary<Guid, string> _nomes = [];
    private List<string> _condicoes = [];

    private bool Editavel => _c is { Status: StatusCotacao.Aberto or StatusCotacao.AguardandoPropostas or StatusCotacao.EmAnalise or StatusCotacao.ReprovadoVoltaCotacao };
    private string Nome(Guid id) => _nomes.GetValueOrDefault(id, "?");
    private decimal Total(Guid f) => _c!.Itens.Where(i => i.FornecedorId == f).Sum(i => i.ValorTotal) + (_c.Fornecedores.First(x => x.FornecedorId == f).ValorFrete ?? 0);
    private void Recalcular() => _c!.Recalcular(_p!);

    /// <summary>Itens do vencedor (ou, sem vencedor, o menor preço de cada item) — base das 3 economias.</summary>
    private EconomiaCotacao Econ => EconomiaCotacao.Calcular(_c!.FornecedorVencedorId is { } v
        ? _c.Itens.Where(i => i.FornecedorId == v)
        : _c.Itens.Where(i => i.ValorUnitarioFinal > 0).GroupBy(i => i.RequisicaoItemId).Select(g => g.OrderBy(i => i.ValorTotal).First()));

    private async Task CopiarLink(CotacaoFornecedor f)
    {
        var url = $"{Nav.BaseUri}cotacao/{f.LinkResposta}";
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", url); Notif.Sucesso($"Link copiado para {Nome(f.FornecedorId)}. Envie por e-mail/WhatsApp."); }
        catch { Notif.Aviso($"Copie o link: {url}"); }
        if (f.Status == StatusConvite.Convidado && _c!.Status == StatusCotacao.Aberto) _c.Status = StatusCotacao.AguardandoPropostas;
    }

    protected override async Task OnInitializedAsync()
    {
        await using (var db = Fabrica.Criar()) _p = await ParametrosServico.CarregarAsync(db);
        _condicoes = await Cat.ListaAsync(TipoLista.CondicaoPagamento);
        await Carregar();
        if (Nav.Uri.Contains("?id=") && Guid.TryParse(Nav.Uri.Split("?id=")[1], out var id)) await Abrir(id);
    }

    private async Task Carregar()
    {
        await using var db = Fabrica.Criar();
        _itens = await db.Cotacoes.AsNoTracking().OrderByDescending(c => c.Numero)
            .Select(c => new Linha(c.Id, c.Numero, c.Nome, db.Obras.Where(o => o.Id == c.ObraId).Select(o => o.Nome).FirstOrDefault() ?? "", c.Tipo,
                c.PropostasRecebidas, c.PropostasExigidas, c.ValorEstimado, c.FornecedorVencedor != null ? c.FornecedorVencedor.RazaoSocial : null, c.Status, c.CriadoPor, c.CriadoEm)).ToListAsync();
    }

    private async Task Abrir(Guid id)
    {
        await using var db = Fabrica.Criar();
        _c = await db.Cotacoes.AsNoTracking().Include(c => c.Fornecedores).Include(c => c.Itens).FirstAsync(c => c.Id == id);
        var ids = _c.Fornecedores.Select(f => f.FornecedorId).ToList();
        _nomes = await db.Fornecedores.AsNoTracking().Where(f => ids.Contains(f.Id)).ToDictionaryAsync(f => f.Id, f => f.NomeFantasia ?? f.RazaoSocial);
        _c.Recalcular(_p!);
        await SuprimentosServico.PrecosReferenciaAsync(db, _c);
        ErrosForm = null; _versao++; _aberto = true;
    }

    private async Task Recarregar() { if (_c is not null) await Abrir(_c.Id); await Carregar(); }

    private async Task Salvar()
    {
        if (_c!.Status == StatusCotacao.AguardandoPropostas && _c.Fornecedores.Any(f => f.Status != StatusConvite.Convidado)) _c.Status = StatusCotacao.EmAnalise;
        if (await Executar(() => Sup.SalvarCotacaoAsync(_c!), "Cotação salva.")) await Recarregar();
    }

    private async Task Enviar()
    {
        if (await Executar(async () => { await Sup.SalvarCotacaoAsync(_c!); await Sup.EnviarCotacaoAprovacaoAsync(_c!.Id); }, "Cotação enviada para aprovação.")) await Recarregar();
    }

    private async Task GerarPedido()
    {
        Guid id = default;
        if (await Executar(async () => id = await Sup.GerarPedidoAsync(_c!.Id), "Pedido gerado.")) { _aberto = false; Nav.NavigateTo($"pedidos?id={id}"); }
    }

    private async Task GerarContrato()
    {
        Guid id = default;
        if (await Executar(async () => id = await Sup.GerarContratoAsync(_c!.Id), "Minuta de contrato gerada.")) { _aberto = false; Nav.NavigateTo($"contratos?id={id}"); }
    }
}
