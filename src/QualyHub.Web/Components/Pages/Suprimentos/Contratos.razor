@page "/contratos"
@inherits PaginaBase
@using QualyHub.Application.Comum
@inject ContratosServico ContratosSrv
@inject NavigationManager Nav

<Pagina Titulo="Contratos" Grade="_grade" AoNovo="Novo" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="kpis">
                <Kpi Rotulo="Ativos" Valor="@_itens?.Count(c => c.Status == StatusContrato.Ativo)" Tom="ok" />
                <Kpi Rotulo="Em elaboração" Valor="@_itens?.Count(c => c.Status == StatusContrato.EmElaboracao)" />
                <Kpi Rotulo="Aguard. aprovação/assinatura" Valor="@_itens?.Count(c => c.Status is StatusContrato.AguardandoAprovacaoDiretoria or StatusContrato.AguardandoAssinaturas)" Tom="aviso" />
                <Kpi Rotulo="Vencendo em 30 dias" Valor="@_itens?.Count(c => c.Status == StatusContrato.Ativo && c.Fim <= Hoje.AddDays(30))" Tom="erro" />
            </div>
            <Grade T="Linha" @ref="_grade" Itens="_itens" Limite="LimiteGrade" AoCarregarTudo="async () => { ListaCompleta = true; await Carregar(); }" AoClicar="l => Abrir(l.Id)" NomeExportacao="contratos" CriadoPor="l => l.CriadoPor">
                <Colunas>
                    <Coluna T="Linha" Titulo="Número" Valor="l => l.Numero" Largura="120px" />
                    <Coluna T="Linha" Titulo="Obra" Valor="l => l.Obra" />
                    <Coluna T="Linha" Titulo="Fornecedor" Valor="l => l.Fornecedor" />
                    <Coluna T="Linha" Titulo="Categoria" Valor="l => l.Categoria" />
                    <Coluna T="Linha" Titulo="Objeto" Valor="l => l.Objeto" />
                    <Coluna T="Linha" Titulo="Valor" Valor="l => l.Valor" Formato="C2" Alinhar="num" />
                    <Coluna T="Linha" Titulo="Fim vigência" Valor="l => l.Fim" />
                    <Coluna T="Linha" Titulo="Status" Valor="l => l.Status"><Modelo><Selo Texto="@De(context.Status)" Tom="@Tom(context.Status)" /></Modelo></Coluna>
                </Colunas>
            </Grade>
        </div>
    </ChildContent>
    <Faixa><b>Contrato</b><span>Escopo claro + especificações + requisitos (laboratório, desempenho NBR 15575, locação)</span><span>Serviço de obra: ITS vinculadas</span><span>Aprovação da Diretoria + assinaturas → Ativo</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_aberto" Titulo="@(string.IsNullOrEmpty(_k?.Numero) ? "Novo contrato" : $"Contrato {_k.Numero}")" Tamanho="grande">
    <ChildContent>
        @if (_k is not null)
        {
            <Erros Lista="ErrosForm" />
            <Abas Itens="_abas" @bind-Ativa="_aba" />
            @if (_aba == "dados")
            {
                <div class="form">
                    <Campo Rotulo="Obra" Obrigatorio Classe="s4"><select @bind="_k.ObraId" disabled="@(!Editavel)"><option value="@Guid.Empty">Selecione…</option>@foreach (var o in _obras) { <option value="@o.Id">@o.Texto</option> }</select></Campo>
                    @if (_spes.Any(s => s.Extra == _k.ObraId.ToString()))
                    {
                        <Campo Rotulo="SPE contratante (CNPJ da NF)" Classe="s6"><select @bind="_k.SpeId" disabled="@(!Editavel)"><option value="">—</option>@foreach (var s in _spes.Where(s => s.Extra == _k.ObraId.ToString())) { <option value="@s.Id">@s.Texto</option> }</select></Campo>
                    }
                    <Campo Rotulo="Fornecedor" Obrigatorio Classe="s5"><select @bind="_k.FornecedorId" disabled="@(!Editavel)"><option value="@Guid.Empty">Selecione…</option>@foreach (var f in _fornecedores) { <option value="@f.Id">@f.Texto (@(Enum.TryParse<StatusQualificacao>(f.Extra, out var s) ? De(s) : ""))</option> }</select></Campo>
                    <Campo Rotulo="Centro de custo" Classe="s3"><select @bind="_k.CentroCustoId" disabled="@(!Editavel)"><option value="">—</option>@foreach (var c in _ccs) { <option value="@c.Id">@c.Texto</option> }</select></Campo>
                    <Campo Rotulo="Categoria" Obrigatorio Classe="s4"><select @bind="_k.Categoria" disabled="@(!Editavel)"><option value="">Selecione…</option>@foreach (var c in _categorias) { <option>@c</option> }</select></Campo>
                    <Campo Rotulo="Formalização" Classe="s3"><select @bind="_k.Formalizacao" disabled="@(!Editavel)">@foreach (var f in Enum.GetValues<FormalizacaoContrato>()) { <option value="@f">@De(f)</option> }</select></Campo>
                    <Campo Rotulo="Início" Classe="s2"><input type="date" @bind="_k.VigenciaInicio" disabled="@(!Editavel)" /></Campo>
                    <Campo Rotulo="Fim" Classe="s2"><input type="date" @bind="_k.VigenciaFim" disabled="@(!Editavel)" /></Campo>
                    <Campo Rotulo="Retenção %" Classe="s1"><input type="number" step="0.01" @bind="_k.RetencaoPerc" disabled="@(!Editavel)" /></Campo>
                    <Campo Rotulo="Objeto / escopo" Obrigatorio Classe="s12"><textarea @bind="_k.Objeto" disabled="@(!Editavel)"></textarea></Campo>
                    @if (Contrato.Contem(_k.Categoria, "laborat"))
                    {
                        <Campo Rotulo="Requisitos do laboratório (acreditação, competência, prazos, normas, equipamentos)" Obrigatorio Classe="s12"><textarea @bind="_k.RequisitosLaboratorio" disabled="@(!Editavel)"></textarea></Campo>
                    }
                    @if (Contrato.Contem(_k.Categoria, "especializado"))
                    {
                        <Campo Rotulo="Requisitos de desempenho (NBR 15575)" Obrigatorio Classe="s12"><textarea @bind="_k.RequisitosDesempenho" disabled="@(!Editavel)"></textarea></Campo>
                    }
                    @if (Contrato.Contem(_k.Categoria, "loca"))
                    {
                        <Campo Rotulo="Requisitos do equipamento" Obrigatorio Classe="s12"><textarea @bind="_k.RequisitosEquipamento" disabled="@(!Editavel)"></textarea></Campo>
                    }
                </div>
                @if (_k.Status is StatusContrato.AguardandoAssinaturas or StatusContrato.Ativo)
                {
                    <div class="secao"><Icone Nome="contrato" /> Assinaturas</div>
                    <div class="form">
                        <Campo Rotulo="Assinatura empresa" Classe="s3"><input type="date" @bind="_assEmpresa" disabled="@(_k.Status == StatusContrato.Ativo)" /></Campo>
                        <Campo Rotulo="Assinatura fornecedor" Classe="s3"><input type="date" @bind="_assFornecedor" disabled="@(_k.Status == StatusContrato.Ativo)" /></Campo>
                        <Campo Rotulo="Enviado ao fornecedor" Classe="s3"><input readonly value="@DataHora(_k.EnviadoFornecedorEm)" /></Campo>
                    </div>
                }
                <div class="secao"><Icone Nome="calendario" /> Cobrança recorrente (locação, serviço contínuo, manutenção)</div>
                <div class="form">
                    <Campo Rotulo="" Classe="s12"><label class="check"><input id="ct-recorrente" type="checkbox" @bind="_k.Recorrente" disabled="@(!Editavel)" /> Contrato recorrente — gera parcelas por período e recebe a nota de cada uma (almoxarife / SIEG)</label></Campo>
                    @if (_k.Recorrente)
                    {
                        <Campo Rotulo="Forma de cobrança" Classe="s3">
                            <select id="ct-forma" @bind="_k.FormaCobranca" disabled="@(!Editavel)">
                                <option value="@FormaCobranca.ValorFixo">Valor fixo por período</option>
                                <option value="@FormaCobranca.Diaria">Diária (equipamento locado)</option>
                                <option value="@FormaCobranca.Uso">Por uso (lançamentos)</option>
                                <option value="@FormaCobranca.Medicao">Medição (tradicional)</option>
                            </select>
                        </Campo>
                        <Campo Rotulo="Periodicidade" Classe="s3">
                            <select id="ct-period" @bind="_k.Periodicidade" disabled="@(!Editavel)">@foreach (var p in Enum.GetValues<Periodicidade>()) { <option value="@p">@De(p)</option> }</select>
                        </Campo>
                        @if (_k.Periodicidade == Periodicidade.Mensal) { <Campo Rotulo="Dia de corte" Classe="s2"><input type="number" min="1" max="31" @bind="_k.DiaCorte" disabled="@(!Editavel)" /></Campo> }
                        <Campo Rotulo="Dia de vencimento" Classe="s2"><input type="number" min="1" max="31" @bind="_k.DiaVencimento" disabled="@(!Editavel)" /></Campo>
                        <Campo Rotulo="Tolerância NF × previsto (%)" Classe="s2"><input type="number" step="0.1" @bind="_k.ToleranciaPerc" disabled="@(!Editavel)" /></Campo>
                        @if (_k.Periodicidade == Periodicidade.DatasCombinadas)
                        {
                            <Campo Rotulo="Datas combinadas (dd/mm/aaaa; …)" Classe="s12"><input @bind="_k.DatasCombinadas" placeholder="15/07/2026; 20/08/2026" disabled="@(!Editavel)" /></Campo>
                        }
                        <Campo Rotulo="Reajuste" Classe="s8"><input @bind="_k.Reajuste" placeholder="Ex.: IPCA anual na data-base" disabled="@(!Editavel)" /></Campo>
                        <Campo Rotulo="" Classe="s4"><label class="check"><input type="checkbox" @bind="_k.ExigeOsPorVisita" disabled="@(!Editavel)" /> Exige OS da visita para aprovar</label></Campo>
                    }
                </div>
            }
            else if (_aba == "itens")
            {
                <div class="secao"><Icone Nome="tabela" /> Planilha de itens (base da medição)
                    @if (Editavel) { <span class="acao"><button class="btn sec pq" @onclick="AddItem"><Icone Nome="mais" Tam="14" /> Item</button></span> }
                </div>
                <table class="itens">
                    <thead><tr><th>Item</th><th>Descrição</th><th>Serviço controlado (ITS)</th><th>UN</th><th class="num">Quant.</th><th class="num">Preço unit.</th>@if (Diaria) { <th class="num">Teto mensal</th> }<th class="num">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var i in _k.Itens.OrderBy(i => i.Item))
                        {
                            var locaisItem = i.Locais.Count > 0 ? _arvore.Situar(i.Locais.Select(l => (l.LocalId, l.Quantidade))) : null;
                            var aberto = locaisItem is not null && _abertos.Contains(i.Id);
                            <tr @key="i" class="@(aberto ? "com-locais" : "")">
                                <td class="larg-70"><input @bind="i.Item" disabled="@(!Editavel)" /></td>
                                <td><input @bind="i.Descricao" disabled="@(!Editavel)" />
                                    @if (locaisItem is not null)
                                    {
                                        <button type="button" class="pl-toggle" aria-expanded="@(aberto ? "true" : "false")" @onclick="() => AlternarLocais(i.Id)">@(aberto ? "▾" : "▸") <span class="pl-ico">▦</span> Locais (medição por local): @QuadroLocais.Resumo(locaisItem, i.Unidade)</button>
                                    }</td>
                                <td><select @bind="i.ServicoControladoId" disabled="@(!Editavel)"><option value="">—</option>@foreach (var s in _servicos) { <option value="@s.Id">@s.Texto</option> }</select></td>
                                <td class="larg-70"><input @bind="i.Unidade" disabled="@(!Editavel)" /></td>
                                <td class="larg-100"><input type="number" step="0.001" @bind="i.Quantidade" disabled="@(!Editavel)" /></td>
                                <td class="larg-120"><input type="number" step="0.01" @bind="i.PrecoUnitario" disabled="@(!Editavel)" /></td>
                                @if (Diaria) { <td class="larg-120"><input type="number" step="0.01" @bind="i.PrecoMensal" disabled="@(!Editavel)" title="Diária limitada a este valor por mês" /></td> }
                                <td class="num">@Moeda(i.Total)</td>
                                <td>@if (Editavel) { <button class="icone-btn" @onclick="() => _k.Itens.Remove(i)"><Icone Nome="lixeira" Tam="16" /></button> }</td>
                            </tr>
                            @if (aberto) { <tr class="linha-locais" @key="(i, 1)"><td colspan="@(Diaria ? 9 : 8)"><PainelLocais Linhas="locaisItem!" Unidade="@i.Unidade" /></td></tr> }
                        }
                        <tr class="total"><td colspan="@(Diaria ? 7 : 6)">Valor total</td><td class="num">@Moeda(_k.ValorTotal)</td><td></td></tr>
                    </tbody>
                </table>
            }
            else if (_aba == "its")
            {
                <p class="mudo">ITS (instruções técnicas de serviço) enviadas ao prestador junto com o contrato.</p>
                <div class="checks grade-checks">
                    @foreach (var s in _servicos)
                    {
                        <label><input type="checkbox" disabled="@(!Editavel)" checked="@_k.ServicosVinculados.Any(v => v.ServicoControladoId == s.Id)" @onchange="e => AlternarIts(s.Id, (bool)e.Value!)" /> @s.Texto</label>
                    }
                </div>
            }
            else if (_aba == "anexos" && !string.IsNullOrEmpty(_k.Numero))
            {
                <Anexos Entidade="Contrato" EntidadeId="_k.Id" Categoria="Contrato" Titulo="Contrato assinado, proposta, projetos e memoriais" SomenteLeitura="false" />
                @if (_k.CriadoEm != default) { <Notas Entidade="Contrato" EntidadeId="_k.Id" /> }
            }
            else if (_aba == "aditivos")
            {
                @if (_ad is null)
                {
                    <table class="itens">
                        <thead><tr><th>Nº</th><th>Tipo</th><th>Justificativa</th><th class="num">Valor</th><th class="num">% acumulado</th><th>Nova vigência</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var a in _aditivos) { <tr class="clicavel" @onclick="() => AbrirAditivo(a.Id)"><td>@a.Numero</td><td>@De(a.Tipo)</td><td>@a.Justificativa</td><td class="num">@Moeda(a.Valor)</td><td class="num">@a.PercAcumulado.ToString("0.##")%</td><td>@Data(a.NovaVigencia)</td><td><Selo Texto="@De(a.Status)" Tom="@Tom(a.Status)" /></td></tr> }
                            @if (_aditivos.Count == 0) { <tr><td colspan="7" class="mudo">Nenhum aditivo.</td></tr> }
                        </tbody>
                    </table>
                    @if (_k.Status == StatusContrato.Ativo) { <button class="btn sec mt-8" disabled="@Ocupado" @onclick="NovoAditivo"><Icone Nome="mais" Tam="14" /> Novo aditivo</button> }
                }
                else
                {
                    var editaAd = _ad.Status == StatusAditivo.EmElaboracao;
                    <div class="cabecalho-doc"><b>@_ad.Numero</b><Selo Texto="@De(_ad.Status)" Tom="@Tom(_ad.Status)" /><button class="btn sec pq" @onclick="() => _ad = null">‹ voltar à lista</button></div>
                    <div class="form">
                        <Campo Rotulo="Tipo" Obrigatorio Classe="s3"><select @bind="_ad.Tipo" disabled="@(!editaAd)">@foreach (var t in Enum.GetValues<TipoAditivo>()) { <option value="@t">@De(t)</option> }</select></Campo>
                        <Campo Rotulo="Origem" Classe="s6"><input @bind="_ad.Origem" placeholder="ex.: medição 03, projeto revisado" disabled="@(!editaAd)" /></Campo>
                        <Campo Rotulo="Nova vigência" Classe="s3"><input type="date" @bind="_ad.NovaVigencia" disabled="@(!editaAd || !_ad.AlteraPrazo)" /></Campo>
                        <Campo Rotulo="Justificativa" Obrigatorio Classe="s12"><textarea @bind="_ad.Justificativa" disabled="@(!editaAd)"></textarea></Campo>
                    </div>
                    @if (_ad.AlteraValor)
                    {
                        <div class="secao"><Icone Nome="tabela" /> Itens alterados
                            @if (editaAd) { <span class="acao"><select @bind="_itemAd" class="max-260"><option value="">Item existente…</option>@foreach (var ci in _k.Itens.Where(ci => _ad.Itens.All(x => x.ContratoItemId != ci.Id))) { <option value="@ci.Id">@ci.Item – @ci.Descricao</option> }</select>
                                <button class="btn sec pq" @onclick="IncluirItemAditivo"><Icone Nome="mais" Tam="14" /></button> <button class="btn sec pq" @onclick="ItemNovoAditivo">Item novo</button></span> }
                        </div>
                        <table class="itens">
                            <thead><tr><th>Item</th><th>Serviço</th><th>UN</th><th class="num">Qtd original</th><th>Acréscimo (−supressão)</th><th class="num">Nova qtd</th><th>Preço unit.</th><th class="num">Valor do aditivo</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var i in _ad.Itens)
                                {
                                    var ci = _k.Itens.FirstOrDefault(x => x.Id == i.ContratoItemId);
                                    <tr @key="i">
                                        <td>@if (ci is null) { <input @bind="i.Item" class="larg-60" disabled="@(!editaAd)" /> } else { @ci.Item }</td>
                                        <td>@if (ci is null) { <input @bind="i.Descricao" disabled="@(!editaAd)" /> } else { @ci.Descricao }</td>
                                        <td>@(ci?.Unidade ?? i.Unidade)</td>
                                        <td class="num">@Num(ci?.Quantidade ?? 0, 3)</td>
                                        <td class="larg-120"><input type="number" step="0.001" @bind="i.QtdDelta" disabled="@(!editaAd)" /></td>
                                        <td class="num">@Num((ci?.Quantidade ?? 0) + i.QtdDelta, 3)</td>
                                        <td class="larg-110"><input type="number" step="0.01" @bind="i.PrecoUnitario" disabled="@(!editaAd)" /></td>
                                        <td class="num">@Moeda(((ci?.Quantidade ?? 0) + i.QtdDelta) * i.PrecoUnitario - (ci?.Quantidade ?? 0) * (ci?.PrecoUnitario ?? 0))</td>
                                        <td>@if (editaAd) { <button class="icone-btn" @onclick="() => _ad.Itens.Remove(i)"><Icone Nome="lixeira" Tam="16" /></button> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="duas-caixas">
                        <div class="caixa-sec compacta">
                            @{ var orig = _k.ValorTotal - _aditivos.Where(a => a.Status == StatusAditivo.Vigente).Sum(a => a.Valor); var ant = _aditivos.Where(a => a.Status == StatusAditivo.Vigente && a.Id != _ad.Id).Sum(a => a.Valor);
                               var este = _ad.Itens.Sum(i => { var ci = _k.Itens.FirstOrDefault(x => x.Id == i.ContratoItemId); return ((ci?.Quantidade ?? 0) + i.QtdDelta) * i.PrecoUnitario - (ci?.Quantidade ?? 0) * (ci?.PrecoUnitario ?? 0); });
                               var perc = orig == 0 ? 0 : 100m * (ant + este) / orig; }
                            Valor original: <b>@Moeda(orig)</b><br />Aditivos anteriores: <b>@Moeda(ant)</b><br />Este aditivo: <b>@Moeda(este) (@((orig == 0 ? 0 : 100m * este / orig).ToString("0.0"))%)</b><br />Novo valor do contrato: <b>@Moeda(orig + ant + este)</b>
                            @if (perc > _limiteAditivo) { <div class="alerta aviso"><Icone Nome="alerta" /> Aditivos acumulados (@perc.ToString("0.0")%) passam do limite de @_limiteAditivo.ToString("0")%.</div> }
                        </div>
                        <div class="caixa-sec compacta">Aprovação: regra de alçada (Aditivo)<br />Assinaturas: empresa e fornecedor<br />Após assinado: itens e saldo da medição atualizados; ITS revisadas seguem por GRD
                            @if (_ad.Status == StatusAditivo.AguardandoAssinaturas)
                            {
                                <div class="form mt-8"><Campo Rotulo="Assinatura empresa" Classe="s6"><input type="date" @bind="_adAssEmp" /></Campo><Campo Rotulo="Assinatura fornecedor" Classe="s6"><input type="date" @bind="_adAssForn" /></Campo></div>
                                <button class="btn ok pq" disabled="@Ocupado" @onclick="AssinarAditivo">Registrar assinaturas e aplicar</button>
                            }
                        </div>
                    </div>
                    @if (_ad.CriadoEm != default) { <Autorizacoes Entidade="EntidadeAprovavel.Aditivo" EntidadeId="_ad.Id" Versao="_versao" AoDecidir="() => AbrirAditivo(_ad.Id)" /> }
                    @if (editaAd)
                    {
                        <div class="acoes-dir">
                            <button class="btn prim" disabled="@Ocupado" @onclick="SalvarAditivo"><Icone Nome="check" Tam="16" /> Salvar aditivo</button>
                            @if (_ad.CriadoEm != default) { <button class="btn ok" disabled="@Ocupado" @onclick="EnviarAditivo"><Icone Nome="enviar" Tam="16" /> Enviar p/ aprovação</button> }
                        </div>
                    }
                }
            }
            else if (_aba == "medicoes")
            {
                <table class="itens">
                    <thead><tr><th>Nº</th><th>Período</th><th class="num">Valor</th><th class="num">Acumulado</th><th class="num">Nota</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var m in _medicoes)
                        {
                            <tr class="clicavel" @onclick='() => Nav.NavigateTo($"medicoes?id={m.Id}")'><td>@m.NumeroMedicao.ToString("00")</td><td>@DataCurta(m.PeriodoInicio) a @DataCurta(m.PeriodoFim)</td>
                                <td class="num">@Moeda(m.ValorPeriodo)</td><td class="num">@Moeda(m.ValorAcumulado)</td><td class="num">@Num(m.NotaFinal)</td><td><Selo Texto="@De(m.Status)" Tom="@Tom(m.Status)" /></td></tr>
                        }
                        @if (_medicoes.Count == 0) { <tr><td colspan="6" class="mudo">Nenhuma medição.</td></tr> }
                    </tbody>
                </table>
            }
            @if (!string.IsNullOrEmpty(_k.Numero))
            {
                <Autorizacoes Entidade="EntidadeAprovavel.Contrato" EntidadeId="_k.Id" Versao="_versao" AoDecidir="Recarregar" />
            }
        }
    </ChildContent>
    <Rodape>
        @if (_k is not null)
        {
            @if (_k.Status == StatusContrato.Ativo)
            {
                @if (_k.Recorrente && _k.FormaCobranca != FormaCobranca.Medicao)
                {
                    <button class="btn laranja" id="ct-parcelas" @onclick='() => Nav.NavigateTo($"contratos/parcelas?contrato={_k.Id}")'><Icone Nome="calendario" Tam="16" /> Parcelas</button>
                }
                else
                {
                    <button class="btn laranja" @onclick='() => Nav.NavigateTo($"medicoes?contrato={_k.Id}")'><Icone Nome="regua" Tam="16" /> Nova medição</button>
                }
                @if (_k.EnviadoFornecedorEm is null) { <button class="btn ok" disabled="@Ocupado" @onclick="RegistrarEnvio"><Icone Nome="enviar" Tam="16" /> Registrar envio ao fornecedor</button> }
            }
            @if (_k.Status == StatusContrato.AguardandoAssinaturas) { <button class="btn ok" disabled="@Ocupado" @onclick="Ativar"><Icone Nome="check" Tam="16" /> Ativar contrato</button> }
            @if (Editavel && !string.IsNullOrEmpty(_k.Numero)) { <button class="btn ok" disabled="@Ocupado" @onclick="Enviar"><Icone Nome="enviar" Tam="16" /> Enviar p/ aprovação</button> }
            @if (Editavel) { <BotaoExcluir Tipo="typeof(Contrato)" Id="@(_k?.CriadoEm == default ? Guid.Empty : _k.Id)" IdBotao="exc-k" AoExcluir="async () => { _aberto = false; await Carregar(); }" />
            <button class="btn prim" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="16" /> Salvar</button> }
        }
    </Rodape>
</Modal>

@code {
    private Dictionary<Guid, string> _locCod = [];
    private ArvoreLocais _arvore = ArvoreLocais.Vazia;
    private readonly HashSet<Guid> _abertos = [];
    private void AlternarLocais(Guid id) { if (!_abertos.Remove(id)) _abertos.Add(id); }
    private sealed record Linha(Guid Id, string Numero, string Obra, string Fornecedor, string Categoria, string Objeto, decimal Valor, DateOnly Fim, StatusContrato Status, string CriadoPor);
    private Grade<Linha>? _grade;
    private List<Linha>? _itens;
    private Contrato? _k;
    private List<Medicao> _medicoes = [];
    private bool _aberto;
    private int _versao;
    private string _aba = "dados";
    private DateOnly? _assEmpresa, _assFornecedor;
    private List<Opcao> _spes = [];
    private List<Opcao> _obras = [], _fornecedores = [], _ccs = [], _servicos = [];
    private List<string> _categorias = [];
    private static readonly List<(string, string)> _abas = [("dados", "Dados gerais"), ("itens", "Itens"), ("its", "ITS vinculadas"), ("anexos", "Anexos"), ("aditivos", "Aditivos"), ("medicoes", "Medições")];

    private bool Editavel => _k is { Status: StatusContrato.EmElaboracao };
    private bool Diaria => _k is { Recorrente: true, FormaCobranca: FormaCobranca.Diaria };
    private List<Aditivo> _aditivos = [];
    private Aditivo? _ad;
    private Guid? _itemAd;
    private DateOnly? _adAssEmp, _adAssForn;
    private decimal _limiteAditivo = 25;

    private async Task NovoAditivo()
    {
        Aditivo? a = null;
        if (await Executar(async () => a = await ContratosSrv.NovoAditivoAsync(_k!.Id, Cancelamento))) _ad = a;
    }

    private void ItemNovoAditivo() => _ad!.Itens.Add(new AditivoItem { AditivoId = _ad.Id, Unidade = "un" });

    private void IncluirItemAditivo()
    {
        var ci = _k!.Itens.FirstOrDefault(x => x.Id == _itemAd);
        if (ci is not null) _ad!.Itens.Add(new AditivoItem { AditivoId = _ad.Id, ContratoItemId = ci.Id, QtdOriginal = ci.Quantidade, PrecoOriginal = ci.PrecoUnitario, PrecoUnitario = ci.PrecoUnitario });
        _itemAd = null;
    }

    private async Task AbrirAditivo(Guid id)
    {
        await using var db = Fabrica.CriarLeitura();
        _ad = await db.Aditivos.AsNoTracking().Include(a => a.Itens).FirstAsync(a => a.Id == id, Cancelamento);
        _aditivos = await db.Aditivos.AsNoTracking().Where(a => a.ContratoId == _ad.ContratoId).OrderBy(a => a.Numero).ToListAsync(Cancelamento);
        _adAssEmp = _adAssForn = Hoje; _versao++;
    }

    private async Task SalvarAditivo()
    {
        Guid id = default;
        if (await Executar(async () => id = await ContratosSrv.SalvarAditivoAsync(_ad!, Cancelamento), "Aditivo salvo.")) await AbrirAditivo(id);
    }

    private async Task EnviarAditivo()
    {
        if (await Executar(async () => { await ContratosSrv.SalvarAditivoAsync(_ad!, Cancelamento); await ContratosSrv.EnviarAditivoAsync(_ad!.Id, Cancelamento); }, "Aditivo enviado para aprovação.")) await AbrirAditivo(_ad!.Id);
    }

    private async Task AssinarAditivo()
    {
        if (_adAssEmp is null || _adAssForn is null) { Notif.Erro("Informe as duas assinaturas."); return; }
        if (await Executar(() => ContratosSrv.AssinarAditivoAsync(_ad!.Id, _adAssEmp.Value, _adAssForn.Value, Cancelamento), "Aditivo vigente — itens e vigência do contrato atualizados."))
        { var id = _ad!.Id; await Abrir(_k!.Id); _aba = "aditivos"; await AbrirAditivo(id); }
    }

    protected override async Task OnInitializedAsync()
    {
        _obras = await Cat.ObrasAsync(); _spes = await Cat.SpesAsync(); _fornecedores = await Cat.FornecedoresAsync(); _ccs = await Cat.CentrosCustoAsync(); _servicos = await Cat.ServicosAsync();
        _categorias = await Cat.ListaAsync(TipoLista.CategoriaServico);
        await Carregar();
        if (Nav.Uri.Contains("?id=") && Guid.TryParse(Nav.Uri.Split("?id=")[1], out var id)) await Abrir(id);
        else if (Nav.Uri.Contains("?aditivo=") && Guid.TryParse(Nav.Uri.Split("?aditivo=")[1], out var aid))
        {
            await using var db = Fabrica.CriarLeitura();
            var cid = await db.Aditivos.Where(a => a.Id == aid).Select(a => a.ContratoId).FirstOrDefaultAsync(Cancelamento);
            if (cid != Guid.Empty) { await Abrir(cid); _aba = "aditivos"; await AbrirAditivo(aid); }
        }
    }

    private async Task Carregar()
    {
        await using var db = Fabrica.CriarLeitura();
        var lista = await db.Contratos.AsNoTracking().Include(k => k.Itens).Include(k => k.Fornecedor).OrderByDescending(k => k.CriadoEm).Take(LimiteAtual).ToListAsync(Cancelamento);
        var obras = await db.Obras.AsNoTracking().ToDictionaryAsync(o => o.Id, o => o.Nome, Cancelamento);
        _itens = lista.Select(k => new Linha(k.Id, k.Numero, obras.GetValueOrDefault(k.ObraId, ""), k.Fornecedor.NomeExibicao, k.Categoria, k.Objeto, k.ValorTotal, k.VigenciaFim, k.Status, k.CriadoPor)).ToList();
    }

    private void Novo()
    {
        _k = new Contrato { VigenciaInicio = Hoje, VigenciaFim = Hoje.AddMonths(6), ObraId = _obras.Count == 1 ? _obras[0].Id : Guid.Empty };
        _medicoes = []; _aba = "dados"; ErrosForm = null; _aberto = true;
    }

    private async Task Abrir(Guid id)
    {
        await using var db = Fabrica.CriarLeitura();
        _k = await db.Contratos.AsNoTracking().Include(k => k.Itens).ThenInclude(i => i.Locais).Include(k => k.ServicosVinculados).FirstAsync(k => k.Id == id, Cancelamento);
        var locs = await db.Locais.AsNoTracking().Where(l => l.ObraId == _k.ObraId).ToListAsync(Cancelamento);
        _locCod = locs.ToDictionary(l => l.Id, l => l.Codigo);
        _arvore = new ArvoreLocais(locs);
        _medicoes = await db.Medicoes.AsNoTracking().Where(m => m.ContratoId == id).OrderBy(m => m.NumeroMedicao).ToListAsync(Cancelamento);
        _aditivos = await db.Aditivos.AsNoTracking().Where(a => a.ContratoId == id).OrderBy(a => a.Numero).ToListAsync(Cancelamento);
        _limiteAditivo = (await ParametrosServico.CarregarAsync(db, Cancelamento))[Parametros.LimiteAditivoPerc];
        _ad = null;
        _assEmpresa = _k.AssinaturaEmpresa ?? Hoje; _assFornecedor = _k.AssinaturaFornecedor ?? Hoje;
        ErrosForm = null; _versao++; _aberto = true;
    }

    private async Task Recarregar() { if (_k is not null) await Abrir(_k.Id); await Carregar(); }

    private void AddItem() => _k!.Itens.Add(new ContratoItem { ContratoId = _k.Id, Item = $"1.{_k.Itens.Count + 1}", Quantidade = 1 });

    private void AlternarIts(Guid id, bool marcado)
    {
        var v = _k!.ServicosVinculados.FirstOrDefault(x => x.ServicoControladoId == id);
        if (marcado && v is null) _k.ServicosVinculados.Add(new ContratoServico { ContratoId = _k.Id, ServicoControladoId = id });
        else if (!marcado && v is not null) _k.ServicosVinculados.Remove(v);
    }

    private async Task Salvar()
    {
        var faltam = new List<string>();
        if (_k!.ObraId == Guid.Empty) faltam.Add("Informe a obra.");
        if (_k.FornecedorId == Guid.Empty) faltam.Add("Informe o fornecedor.");
        if (faltam.Count > 0) { ErrosForm = faltam; Notif.Erro(faltam[0]); return; }
        Guid id = default;
        if (await Executar(async () => id = await ContratosSrv.SalvarContratoAsync(_k, Cancelamento), "Contrato salvo.")) { await Abrir(id); await Carregar(); }
    }

    private async Task Enviar()
    {
        if (await Executar(async () => { await ContratosSrv.SalvarContratoAsync(_k!, Cancelamento); await ContratosSrv.EnviarContratoAprovacaoAsync(_k!.Id, Cancelamento); }, "Contrato enviado para aprovação da Diretoria.")) await Recarregar();
    }

    private async Task Ativar()
    {
        if (_assEmpresa is null || _assFornecedor is null) { Notif.Erro("Informe as duas datas de assinatura."); return; }
        if (await Executar(() => ContratosSrv.AtivarContratoAsync(_k!.Id, _assEmpresa.Value, _assFornecedor.Value, Cancelamento), "Contrato ativo.")) await Recarregar();
    }

    private async Task RegistrarEnvio()
    {
        if (await Executar(() => ContratosSrv.RegistrarEnvioContratoAsync(_k!.Id, Cancelamento), "Envio registrado.")) await Recarregar();
    }
}
