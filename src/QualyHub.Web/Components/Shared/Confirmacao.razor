@* Confirmação de ação destrutiva/irreversível. Uso: <Confirmacao Pergunta="@PerguntaConfirmacao" AoSim="ConfirmacaoSim" AoNao="ConfirmacaoNao" /> *@
<Modal Aberto="@(Pergunta is not null)" AbertoChanged="Fechou" Titulo="@Titulo" Tamanho="pequena">
    <ChildContent><p class="m-0">@Pergunta</p></ChildContent>
    <Rodape>
        <button class="btn sec" id="conf-nao" @onclick="AoNao">Cancelar</button>
        <button class="btn perigo" id="conf-sim" @onclick="AoSim"><Icone Nome="check" Tam="16" /> @TextoSim</button>
    </Rodape>
</Modal>
@code {
    [Parameter] public string? Pergunta { get; set; }
    [Parameter] public string Titulo { get; set; } = "Confirmar";
    [Parameter] public string TextoSim { get; set; } = "Confirmar";
    [Parameter] public EventCallback AoSim { get; set; }
    [Parameter] public EventCallback AoNao { get; set; }
    private Task Fechou(bool aberto) => aberto ? Task.CompletedTask : AoNao.InvokeAsync();
}
