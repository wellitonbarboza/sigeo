@* Leitura da NF-e no recebimento pela câmera do tablet/celular. 1º o código de barras do DANFE (sem custo); se não sair,
   o botão "Ler com IA" usa a mesma foto (Document Intelligence + modelo, conta no limite mensal). Só devolve o que leu:
   quem preenche o recebimento é a tela, e a pessoa confere. *@
@using QualyHub.Application.Fiscal
@inject LeituraNotaServico Leitura

<div class="leitura-nota">
    <label class="btn laranja arquivo cursor-mao" title="Fotografe o DANFE com o código de barras visível">
        <Icone Nome="camera" Tam="16" /> @(_estado == Estado.Codigo ? "Lendo o código…" : _foto is null ? "Ler nota pela câmera" : "Tirar outra foto")
        <InputFile OnChange="Fotografar" accept="image/*" capture="environment" class="so-leitor" disabled="@Ocupado" />
    </label>
    @if (_semCodigo && _foto is not null && Leitura.IaDisponivel)
    {
        <button type="button" class="btn sec" disabled="@Ocupado" @onclick="LerComIa"><Icone Nome="lupa" Tam="16" /> @(_estado == Estado.Ia ? "Lendo com IA…" : "Ler com IA")</button>
    }
    <div aria-live="polite">
        @if (_mensagem is not null) { <div class="alerta aviso mt-6" role="alert"><Icone Nome="exclamacao" /> @_mensagem</div> }
        @if (_lida is { } n)
        {
            <div class="caixa-sec mt-6 fonte-13">
                <b>NF @n.Numero</b>@(n.Serie is null ? "" : $"/{n.Serie}") · @(n.Fornecedor ?? n.Emitente ?? "emitente não cadastrado")
                · lida por @n.Origem @(n.NotaId is null ? "· não importada" : "· importada")
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Nota lida e a foto (JPEG reduzido) para guardar como anexo do recebimento.</summary>
    public sealed record NotaFotografada(NotaLidaNoRecebimento Nota, byte[]? Foto);

    [Parameter] public EventCallback<NotaFotografada> AoLer { get; set; }
    [Parameter] public Guid? ReferenciaId { get; set; }

    private enum Estado { Livre, Codigo, Ia }
    private Estado _estado;
    private bool Ocupado => _estado != Estado.Livre;
    private byte[]? _foto;
    private bool _semCodigo;
    private string? _mensagem;
    private NotaLidaNoRecebimento? _lida;

    private async Task Fotografar(InputFileChangeEventArgs e)
    {
        _estado = Estado.Codigo; _mensagem = null; _lida = null; _semCodigo = false; _foto = null;
        try
        {
            if (e.File.Size > LeituraNotaServico.LimiteFotoBytes) { _mensagem = "Foto acima de 20 MB."; return; }
            // O navegador reduz antes de enviar (menos dados no 4G da obra) e já aplica a orientação da câmera.
            IBrowserFile arq = e.File;
            try { arq = await e.File.RequestImageFileAsync("image/jpeg", 2400, 2400); } catch (Exception) { /* formato que o navegador não converte: vai a original */ }
            using var ms = new MemoryStream();
            await using (var s = arq.OpenReadStream(LeituraNotaServico.LimiteFotoBytes)) await s.CopyToAsync(ms);
            _foto = ms.ToArray();
            var n = await Leitura.LerCodigoAsync(_foto);
            if (n is null)
            {
                _semCodigo = true;
                _mensagem = Leitura.IaDisponivel
                    ? "Código de barras não lido. Tire outra foto mais perto do código, ou use \"Ler com IA\"."
                    : "Código de barras não lido. Tire outra foto mais perto do código, ou digite a chave.";
                return;
            }
            await Entregar(n);
        }
        catch (QualyHub.Domain.Aprovacoes.RegraDeNegocioException ex) { _mensagem = ex.Message; }
        catch (IOException) { _mensagem = "A foto não chegou inteira. Tente de novo."; }
        finally { _estado = Estado.Livre; }
    }

    private async Task LerComIa()
    {
        if (_foto is null) return;
        _estado = Estado.Ia; _mensagem = null;
        try { await Entregar(await Leitura.LerComIaAsync(_foto, ReferenciaId)); _semCodigo = false; }
        catch (QualyHub.Domain.Aprovacoes.RegraDeNegocioException ex) { _mensagem = ex.Message; }
        finally { _estado = Estado.Livre; }
    }

    private async Task Entregar(NotaLidaNoRecebimento n)
    {
        _lida = n;
        await AoLer.InvokeAsync(new NotaFotografada(n, _foto));
    }
}
