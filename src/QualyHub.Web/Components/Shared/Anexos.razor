@* Anexos de qualquer registro (proposta, contrato assinado, evidência, fotos, ata…). Arquivo com hash SHA-256. *@
@inject FabricaDb Fabrica
@inject IArmazenamento Armazenamento
@inject Notificacoes Notif

<div class="secao"><Icone Nome="clipe" /> @Titulo <span class="acao">
    @if (!SomenteLeitura)
    {
        <label class="btn sec pq" style="cursor:pointer"><Icone Nome="upload" Tam="14" /> Anexar<InputFile OnChange="Enviar" multiple style="display:none" /></label>
    }
</span></div>
@if (_itens.Count == 0) { <div class="mudo" style="padding:4px 2px 8px">Nenhum anexo.</div> }
else
{
    <table class="itens">
        <thead><tr><th>Arquivo</th><th>Categoria</th><th>Tamanho</th><th>SHA-256</th><th>Enviado por / em</th></tr></thead>
        <tbody>
            @foreach (var a in _itens)
            {
                <tr>
                    <td><a href="arquivos/anexo/@a.Id" target="_blank"><Icone Nome="clipe" Tam="14" /> @a.NomeOriginal</a></td>
                    <td>@a.Categoria</td>
                    <td>@(a.TamanhoBytes / 1024) KB</td>
                    <td class="mudo">@a.ArquivoHashSha256[..12]…</td>
                    <td>@a.CriadoPor · @Rotulos.DataHora(a.CriadoEm)</td>
                </tr>
            }
        </tbody>
    </table>
}
@code {
    [Parameter] public string Entidade { get; set; } = "";
    [Parameter] public Guid EntidadeId { get; set; }
    [Parameter] public string Categoria { get; set; } = "Geral";
    [Parameter] public string Titulo { get; set; } = "Anexos";
    [Parameter] public bool SomenteLeitura { get; set; }
    [Parameter] public EventCallback AoMudar { get; set; }
    private List<Anexo> _itens = [];

    protected override async Task OnParametersSetAsync() => await Carregar();

    private async Task Carregar()
    {
        await using var db = Fabrica.Criar();
        _itens = await db.Anexos.AsNoTracking().Where(a => a.Entidade == Entidade && a.EntidadeId == EntidadeId && a.Categoria == Categoria)
                                .OrderByDescending(a => a.CriadoEm).ToListAsync();
    }

    private async Task Enviar(InputFileChangeEventArgs e)
    {
        await using var db = Fabrica.Criar();
        foreach (var f in e.GetMultipleFiles(10))
        {
            if (f.Size > 25 * 1024 * 1024) { Notif.Erro($"{f.Name}: limite de 25 MB."); continue; }
            await using var s = f.OpenReadStream(25 * 1024 * 1024);
            var salvo = await Armazenamento.SalvarAsync(s, f.Name, Entidade.ToLowerInvariant(), f.ContentType);
            db.Anexos.Add(new Anexo { Entidade = Entidade, EntidadeId = EntidadeId, Categoria = Categoria, NomeOriginal = f.Name, ArquivoBlob = salvo.Blob, ArquivoHashSha256 = salvo.Hash, ContentType = f.ContentType, TamanhoBytes = salvo.Tamanho });
        }
        await db.SaveChangesAsync();
        Notif.Sucesso("Anexo registrado.");
        await Carregar();
        await AoMudar.InvokeAsync();
    }
}
