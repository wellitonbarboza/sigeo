@* Fotos compactas de um item (FVS, FVM, inspeção). Câmera do celular via accept=image/* capture. Hash SHA-256 no anexo. *@
@inject FabricaDb Fabrica
@inject IArmazenamento Armazenamento
@inject Notificacoes Notif

<span class="fotos">
    @foreach (var a in _itens)
    {
        <a href="arquivos/anexo/@a.Id" target="_blank" title="@a.NomeOriginal · @a.CriadoPor · @Rotulos.DataHora(a.CriadoEm)" class="foto-mini"><Icone Nome="camera" Tam="14" /></a>
    }
    @if (!SomenteLeitura)
    {
        <label class="foto-add" title="Foto"><Icone Nome="mais" Tam="12" /><Icone Nome="camera" Tam="14" /><InputFile OnChange="Enviar" accept="image/*" capture="environment" multiple style="display:none" /></label>
    }
    @if (Obrigatoria && _itens.Count == 0) { <small class="texto-erro">foto obrigatória</small> }
</span>

@code {
    [Parameter] public string Entidade { get; set; } = "FvsItem";
    [Parameter] public Guid EntidadeId { get; set; }
    [Parameter] public bool SomenteLeitura { get; set; }
    [Parameter] public bool Obrigatoria { get; set; }
    private List<Anexo> _itens = [];
    private Guid _carregado;

    protected override async Task OnParametersSetAsync()
    {
        if (_carregado == EntidadeId) return;
        _carregado = EntidadeId;
        await Carregar();
    }

    private async Task Carregar()
    {
        await using var db = Fabrica.Criar();
        _itens = await db.Anexos.AsNoTracking().Where(a => a.Entidade == Entidade && a.EntidadeId == EntidadeId).OrderBy(a => a.CriadoEm).ToListAsync();
    }

    private async Task Enviar(InputFileChangeEventArgs e)
    {
        await using var db = Fabrica.Criar();
        foreach (var f in e.GetMultipleFiles(6))
        {
            if (f.Size > 15 * 1024 * 1024) { Notif.Erro($"{f.Name}: limite de 15 MB."); continue; }
            await using var s = f.OpenReadStream(15 * 1024 * 1024);
            var salvo = await Armazenamento.SalvarAsync(s, f.Name, "fotos", f.ContentType);
            db.Anexos.Add(new Anexo { Entidade = Entidade, EntidadeId = EntidadeId, Categoria = "Foto", NomeOriginal = f.Name, ArquivoBlob = salvo.Blob, ArquivoHashSha256 = salvo.Hash, ContentType = f.ContentType, TamanhoBytes = salvo.Tamanho });
        }
        await db.SaveChangesAsync();
        await Carregar();
    }
}
