<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Telas que rodam no navegador (WebAssembly) e componentes de apresentação compartilhados com o servidor
       (layout, ícones, selos, KPIs, moldura de página). Fala com o servidor só pela API (/api/...). -->
  <ItemGroup>
    <ProjectReference Include="..\Groundkey.Contratos\Groundkey.Contratos.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.12" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <!-- pt-BR nas telas: precisa dos dados de cultura no navegador (formatação de moeda e data). -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <RootNamespace>Groundkey.Web.Client</RootNamespace>
  </PropertyGroup>
</Project>
