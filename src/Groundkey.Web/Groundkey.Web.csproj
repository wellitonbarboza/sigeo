<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Groundkey.Infrastructure\Groundkey.Infrastructure.csproj" />
    <ProjectReference Include="..\Groundkey.Web.Client\Groundkey.Web.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Syncfusion.Blazor.Gantt" Version="34.2.9" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Groundkey.Contratos" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Recursos\syncfusion-pt-BR.json" LogicalName="syncfusion-pt-BR.json" />
  </ItemGroup>
</Project>
