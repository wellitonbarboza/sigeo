@typeparam T
@code {
    [CascadingParameter] public Grade<T> Grade { get; set; } = default!;
    [Parameter] public string Titulo { get; set; } = "";
    /// <summary>Valor bruto (ordenação, exportação e filtro).</summary>
    [Parameter] public Func<T, object?>? Valor { get; set; }
    /// <summary>Formato .NET (ex.: "N2", "dd/MM/yy", "C2").</summary>
    [Parameter] public string? Formato { get; set; }
    [Parameter] public RenderFragment<T>? Modelo { get; set; }
    [Parameter] public string? Largura { get; set; }
    [Parameter] public string Alinhar { get; set; } = "";
    [Parameter] public bool Ordenavel { get; set; } = true;
    [Parameter] public bool Agrupavel { get; set; } = true;
    [Parameter] public bool Visivel { get; set; } = true;

    public string? Filtro { get; set; }
    private static readonly System.Globalization.CultureInfo Br = new("pt-BR");

    protected override void OnInitialized() => Grade.Registrar(this);

    public string Texto(T i)
    {
        var v = Valor?.Invoke(i);
        return v switch
        {
            null => "",
            IFormattable f when Formato is not null => f.ToString(Formato, Br),
            decimal d => d.ToString("N2", Br),
            DateOnly d => d.ToString("dd/MM/yyyy", Br),
            DateTimeOffset d => d.ToLocalTime().ToString("dd/MM/yy HH:mm", Br),
            DateTime d => d.ToString("dd/MM/yy HH:mm", Br),
            bool b => b ? "Sim" : "Não",
            Enum e => Groundkey.Web.Servicos.Rotulos.De(e),
            _ => v.ToString() ?? ""
        };
    }

    public IComparable Chave(T i) => Valor?.Invoke(i) switch
    {
        null => "",
        Enum e => Groundkey.Web.Servicos.Rotulos.De(e),
        IComparable c => c,
        var o => o.ToString() ?? ""
    };
}
