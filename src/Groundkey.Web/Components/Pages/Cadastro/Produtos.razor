@page "/cadastros/produtos"
@inherits PaginaBase
@inject Groundkey.Application.IA.AnalisesIaServico Ia
@inject Groundkey.Application.IA.IAssistenteIa Assistente
@inject Groundkey.Infrastructure.Importacao.ImportadorProdutosExpertData ImpProd
@inject CodigosProdutoServico Codigos
@inject CadastrosServico Cad
@inject IJSRuntime JS
@inject MarcasServico MarcasSrv

@* Catálogo com milhares de itens: a lista é paginada no banco (a Grade filtra/agrupa em memória, por isso não é usada aqui). *@
<Pagina Titulo="Produtos (insumos)" AoNovo="Novo" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <div class="kpis">
                <Kpi Rotulo="Produtos ativos" Valor="@_resumo?.Ativos" />
                <Kpi Rotulo="A classificar" Valor="@_resumo?.AClassificar" Sub="grupo 'A Cadastrar' ou vazio" Tom="aviso" />
                <Kpi Rotulo="Sem NCM" Valor="@_resumo?.SemNcm" Sub="não casa com a NF-e" Tom="aviso" />
                <Kpi Rotulo="Vinculados a controlado" Valor="@_resumo?.Vinculados" Tom="ok" />
            </div>
            <div class="barra-acoes">
                <a class="btn sec pq" href="cadastros/categorias"><Icone Nome="lista" Tam="14" /> Categorias e siglas</a>
                <button class="btn sec pq" disabled="@Ocupado" @onclick="PreverPadronizacao" title="Aplica o padrão GRUPO-SUBGRUPO-0000 aos produtos ainda não usados"><Icone Nome="atualizar" Tam="14" /> Padronizar códigos</button>
                <label class="btn sec pq arquivo cursor-mao" title="Planilha 'Export Produto Genérico' do ExpertData (.xlsx)"><Icone Nome="upload" Tam="14" /> Importar planilha (ExpertData)<InputFile OnChange="Prever" accept=".xlsx" class="so-leitor" /></label>
                <button class="btn sec pq" disabled="@Ocupado" @onclick="Exportar" title="Exporta todos os produtos do filtro atual (não só a página)"><Icone Nome="excel" Tam="14" /> Exportar Excel</button>
            </div>
            <div class="barra-filtro">
                <label>Buscar (código ou nome) <input type="search" @bind="_fTexto" @bind:after="Filtrar" placeholder="Digite e tecle Enter" /></label>
                <label>Grupo <select @bind="_fGrupo" @bind:after="Filtrar"><option value="">Todos</option>@foreach (var g in _grupos) { <option value="@g">@g</option> }</select></label>
                <label>Situação <select @bind="_fAtivo" @bind:after="Filtrar"><option value="">Todos</option><option value="sim">Ativos</option><option value="nao">Inativos</option></select></label>
                <span class="mudo" role="status">@(_pagina is null ? "Carregando…" : $"{_pagina.Total} registro(s)")</span>
            </div>
            @if (_pagina is not null)
            {
                <table class="itens">
                    <thead><tr>
                        <th class="larg-130" aria-sort="@AriaOrdem(OrdemProdutos.Codigo)"><button type="button" class="cab-ordena" @onclick="() => Ordenar(OrdemProdutos.Codigo)">Código @Seta(OrdemProdutos.Codigo)</button></th>
                        <th aria-sort="@AriaOrdem(OrdemProdutos.Nome)"><button type="button" class="cab-ordena" @onclick="() => Ordenar(OrdemProdutos.Nome)">Nome @Seta(OrdemProdutos.Nome)</button></th>
                        <th class="larg-60">UN</th><th>Grupo</th><th>Subgrupo</th><th class="larg-100">NCM</th>
                        <th class="num">Lead time (dias)</th><th class="num">Preço ref.</th><th>Material controlado</th><th>Ativo</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var p in _pagina.Itens)
                        {
                            <tr @key="p.Id" class="clicavel" tabindex="0" role="button" aria-label="@($"Abrir produto {p.Codigo} {p.Nome}")"
                                @onclick="() => Abrir(p.Id)" @onkeydown="e => Tecla(e, p.Id)">
                                <td>@p.Codigo</td><td>@p.Nome</td><td>@p.Unidade</td><td>@p.Grupo</td><td>@p.SubGrupo</td><td>@p.Ncm</td>
                                <td class="num">@p.LeadTimeDias</td><td class="num">@p.PrecoReferencia?.ToString("C2")</td><td>@p.MaterialControlado</td><td>@(p.Ativo ? "Sim" : "Não")</td>
                            </tr>
                        }
                        @if (_pagina.Total == 0) { <tr><td colspan="10" class="mudo">Nenhum produto encontrado com esse filtro.</td></tr> }
                    </tbody>
                </table>
                <Paginacao Total="_pagina.Total" Pagina="_pagina.Pagina" Tamanho="TamPagina" AoMudar="IrPara" />
            }
        </div>
    </ChildContent>
    <Faixa><b>Produtos</b><span>Vincule ao material controlado para herdar especificação e documentos exigidos na requisição</span><span>Lead time alimenta o alerta de cronograma</span></Faixa>
</Pagina>

@* Rótulo que envolve o InputFile: o input real continua focável (Tab + Enter/Espaço abre o seletor) e o foco aparece no botão. *@

<Modal @bind-Aberto="_aberto" Titulo="Produto" Tamanho="media">
    <ChildContent>
        @if (_p is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Código" Classe="s3" Ajuda="@(_p.CriadoEm == default ? "Gerado ao salvar: GRUPO-SUBGRUPO-0000" : _p.CodigoAnterior is null ? "Fixo após o 1º uso" : $"Anterior: {_p.CodigoAnterior}")"><input readonly value="@(string.IsNullOrEmpty(_p.Codigo) ? "(automático)" : _p.Codigo)" /></Campo>
                <Campo Rotulo="Descrição genérica" Obrigatorio Classe="s7" Ajuda="Nunca coloque a marca na descrição genérica."><input @bind="_p.Nome" /></Campo>
                <Campo Rotulo="Unidade" Obrigatorio Classe="s2"><input @bind="_p.Unidade" list="unidades" /><datalist id="unidades">@foreach (var u in Groundkey.Domain.Cadastros.UnidadesPadrao.Lista) { <option>@u</option> }</datalist></Campo>
                <Campo Rotulo="Descrição completa" Classe="s12"><textarea @bind="_p.DescricaoCompleta" rows="2"></textarea></Campo>
                <Campo Rotulo="Grupo" Classe="s4"><input @bind="_p.Grupo" list="grupos" /><datalist id="grupos">@foreach (var g in _grupos) { <option>@g</option> }</datalist></Campo>
                <Campo Rotulo="Subgrupo" Classe="s4"><input @bind="_p.SubGrupo" list="subgrupos" /><datalist id="subgrupos">@foreach (var g in _subgrupos.Where(x => x.Grupo == _p.Grupo)) { <option>@g.Sub</option> }</datalist></Campo>
                <Campo Rotulo="Tipo de custo" Classe="s4" Ajuda="Curva ABC e custo realizado por tipo"><select id="prod-tipo-custo" value="@(_p.TipoCusto?.ToString() ?? "")" @onchange="e => _p.TipoCusto = Enum.TryParse<TipoCusto>(e.Value?.ToString(), out var t) ? t : null"><option value="">(não informado)</option>@foreach (var t in Groundkey.Domain.Engenharia.TiposCusto.Todos) { <option value="@t">@Groundkey.Domain.Engenharia.TiposCusto.Nome(t)</option> }</select></Campo>
                @if (Assistente.Configurado)
                {
                    <div class="s12" aria-live="polite">
                        <button type="button" class="btn sec pq" id="prod-ia" disabled="@_iaOcupado" @onclick="ClassificarIa"><Icone Nome="lupa" Tam="14" /> @(_iaOcupado ? "Classificando…" : "Sugerir grupo e verificar duplicados (IA)")</button>
                        @if (_iaMsg is not null) { <span class="fonte-13 mudo">&nbsp;@_iaMsg</span> }
                    </div>
                }
                <Campo Rotulo="NCM" Classe="s2" Ajuda="8 dígitos"><input @bind="_p.Ncm" maxlength="10" inputmode="numeric" /></Campo>
                <Campo Rotulo="Qtd. por embalagem" Classe="s2" Ajuda="Pacote/caixa"><input type="number" step="0.001" @bind="_p.QuantidadePorEmbalagem" /></Campo>
                <Campo Rotulo="Marca de referência" Classe="s4" Ajuda="Do cadastro de marcas (a requisição sugere esta)"><input id="prod-marca" @bind="_p.Marca" list="marcas-prod" /><datalist id="marcas-prod">@foreach (var m in _marcas) { <option>@m</option> }</datalist></Campo>
                <Campo Rotulo="Referência do fabricante" Classe="s4"><input @bind="_p.Referencia" /></Campo>
                <Campo Rotulo="EAN (código de barras)" Classe="s4"><input @bind="_p.Ean" maxlength="14" inputmode="numeric" /></Campo>
                <Campo Rotulo="Lead time (dias)" Classe="s3"><input type="number" @bind="_p.LeadTimeDias" /></Campo>
                <Campo Rotulo="Preço de referência (R$/un)" Classe="s3"><input type="number" step="0.01" @bind="_p.PrecoReferencia" /></Campo>
                <Campo Rotulo="Material controlado" Classe="s9"><select @bind="_p.MaterialControladoId"><option value="">(não controlado)</option>@foreach (var m in _materiais) { <option value="@m.Id">@m.Texto</option> }</select></Campo>
                <Campo Rotulo="" Classe="s12"><label><input type="checkbox" @bind="_p.Ativo" /> Ativo</label></Campo>
            </div>
            @if (_compras.Count > 0)
            {
                <div class="secao"><Icone Nome="grafico" /> Compras por marca</div>
                <table class="itens" id="prod-marcas">
                    <thead><tr><th>Marca</th><th class="num">Pedidos</th><th class="num">Quantidade</th><th class="num">Preço médio</th><th class="num">Último preço</th><th>Última compra</th><th class="num">Menor cotado</th></tr></thead>
                    <tbody>
                        @foreach (var c in _compras)
                        {
                            <tr><td>@c.Marca</td><td class="num">@c.Pedidos</td><td class="num">@c.Quantidade.ToString("N2", Br)</td><td class="num">@c.PrecoMedio.ToString("N2", Br)</td>
                                <td class="num">@c.UltimoPreco.ToString("N2", Br)</td><td>@DataHora(c.UltimaCompra)</td><td class="num">@(c.MenorCotado?.ToString("N2", Br) ?? "—")</td></tr>
                        }
                    </tbody>
                </table>
            }
        }
    </ChildContent>
    <Rodape><BotaoExcluir Tipo="typeof(Produto)" Id="@(_p?.CriadoEm == default ? Guid.Empty : _p.Id)" IdBotao="exc-p" AoExcluir="async () => { _aberto = false; await Carregar(); }" />
            <button class="btn prim" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

<Modal @bind-Aberto="_abertoPad" Titulo="Padronizar códigos de produto" Tamanho="media">
    <ChildContent>
        @if (_pad is not null)
        {
            <div class="kpis">
                <Kpi Rotulo="Recodificar" Valor="@_pad.Recodificados" Tom="info" Sub="GRUPO-SUBGRUPO-0000" />
                <Kpi Rotulo="Provisórios" Valor="@_pad.Provisorios" Tom="aviso" Sub="TMP- (sem classificação)" />
                <Kpi Rotulo="Mantidos (já usados)" Valor="@_pad.MantidosPorUso" Sub="código congelado" />
            </div>
            <div class="alerta info"><Icone Nome="info" /> O código anterior fica guardado no produto. A sequência continua do último código de cada categoria. Revise as siglas em "Categorias e siglas" antes, se quiser.</div>
            @if (_pad.Amostra.Count > 0)
            {
                <table class="itens"><thead><tr><th>De</th><th>Para</th><th>Produto</th></tr></thead>
                    <tbody>@foreach (var a in _pad.Amostra) { <tr><td class="mudo">@a.De</td><td><b>@a.Para</b></td><td>@a.Produto</td></tr> }</tbody></table>
            }
        }
    </ChildContent>
    <Rodape>@if (_pad is not null && _pad.Recodificados + _pad.Provisorios > 0) { <button class="btn prim" disabled="@Ocupado" @onclick="AplicarPadronizacao"><Icone Nome="check" Tam="16" /> Padronizar @(_pad.Recodificados + _pad.Provisorios) código(s)</button> }</Rodape>
</Modal>

<Modal @bind-Aberto="_abertoImp" Titulo="Importar produtos — planilha ExpertData (produto genérico)" Tamanho="grande">
    <ChildContent>
        @if (_previa is not null)
        {
            <div class="kpis">
                <Kpi Rotulo="Novos" Valor="@_previa.Novos" Tom="ok" Sub="código HID-CNX-0001 (ou TMP-)" />
                <Kpi Rotulo="Atualizar" Valor="@_previa.Atualizar" Tom="info" Sub="NCM, descrição, classificação" />
                <Kpi Rotulo="Duplicados no arquivo" Valor="@_previa.Duplicados" Tom="aviso" Sub="mesma descrição + unidade" />
                <Kpi Rotulo="A classificar" Valor="@_previa.AClassificar" Tom="aviso" Sub="grupo 'A Cadastrar'" />
                <Kpi Rotulo="Vínculo automático" Valor="@_previa.Controlados" Tom="ok" Sub="material controlado" />
            </div>
            @if (_previa.UnidadesConvertidas.Count > 0)
            {
                <div class="alerta info"><Icone Nome="info" /> Unidades padronizadas: @string.Join(" · ", _previa.UnidadesConvertidas.Select(kv => $"{kv.Key} → {kv.Value}"))</div>
            }
            <div class="filtros-rapidos">@foreach (var f in new[] { "Todos", "Inserir", "Atualizar", "Duplicado", "Erro" }) { <label><input type="radio" name="fprod" checked="@(_filtroImp == f)" @onchange="() => _filtroImp = f" /> @f</label> }</div>
            <div class="rolagem-360">
                <table class="itens"><thead><tr><th>Linha</th><th>Descrição genérica</th><th>UN</th><th>Grupo › Subgrupo</th><th>Ação</th><th>Detalhe</th></tr></thead>
                    <tbody>@foreach (var l in _previa.Linhas.Where(l => _filtroImp == "Todos" || l.Acao == _filtroImp).Take(500))
                    {
                        <tr><td>@l.Linha</td><td>@l.Nome</td><td>@l.Unidade</td><td>@l.Grupo › @l.SubGrupo</td><td><Selo Texto="@l.Acao" Tom="@(l.Acao switch { "Inserir" => "ok", "Atualizar" => "info", "Erro" => "erro", "Duplicado" => "aviso", _ => "neutro" })" /></td><td class="mudo">@l.Detalhe</td></tr>
                    }</tbody></table>
                @if (_previa.Linhas.Count(l => _filtroImp == "Todos" || l.Acao == _filtroImp) > 500) { <p class="mudo">Mostrando as primeiras 500 linhas.</p> }
            </div>
        }
    </ChildContent>
    <Rodape>
        @if (_previa is not null && _previa.Novos + _previa.Atualizar > 0) { <button class="btn prim" disabled="@Ocupado" @onclick="ConfirmarImportacao"><Icone Nome="check" Tam="16" /> Importar @(_previa.Novos + _previa.Atualizar) produto(s)</button> }
    </Rodape>
</Modal>

@code {
    private const int TamPagina = 50;
    // Cabeçalho ordenável é um botão (teclado e leitor de tela), mas com a aparência do título da coluna.
    private PaginaProdutos? _pagina;
    private int _paginaAtual;
    private ResumoProdutos? _resumo;
    private string? _fTexto, _fGrupo, _fAtivo;
    private OrdemProdutos _ordem = OrdemProdutos.Codigo;
    private bool _desc;
    private Produto? _p;
    private bool _aberto;
    private List<Opcao> _materiais = [];

    private bool _abertoPad;
    private ResultadoPadronizacao? _pad;
    private async Task PreverPadronizacao() { if (await Executar(async () => _pad = await Codigos.PadronizarAsync(false, Cancelamento))) _abertoPad = true; }
    private async Task AplicarPadronizacao()
    {
        ResultadoPadronizacao? r = null;
        if (await Executar(async () => r = await Codigos.PadronizarAsync(true, Cancelamento)))
        { Notif.Sucesso($"{r!.Recodificados + r.Provisorios} código(s) padronizado(s)."); _abertoPad = false; await Carregar(); }
    }
    private List<string> _grupos = [];
    private List<(string? Grupo, string Sub)> _subgrupos = [];
    private bool _abertoImp;
    private byte[]? _arquivoImp;
    private Groundkey.Infrastructure.Importacao.PreviaImportacaoProdutos? _previa;
    private string _filtroImp = "Todos";

    protected override async Task OnInitializedAsync() { _materiais = await Cat.MateriaisAsync(); await Carregar(); }

    private async Task Prever(InputFileChangeEventArgs e)
    {
        await Executar(async () =>
        {
            if (e.File.Size > 30 * 1024 * 1024) throw new RegraDeNegocioException("Planilha acima de 30 MB.");
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(30 * 1024 * 1024, Cancelamento).CopyToAsync(ms, Cancelamento);
            _arquivoImp = ms.ToArray();
            _previa = await ImpProd.PreverAsync(new MemoryStream(_arquivoImp), Cancelamento);
            _filtroImp = "Todos"; _abertoImp = true;
        });
    }

    private async Task ConfirmarImportacao()
    {
        (int Inseridos, int Atualizados) r = default;
        if (await Executar(async () => r = await ImpProd.ImportarAsync(new MemoryStream(_arquivoImp!), Cancelamento)))
        {
            Notif.Sucesso($"{r.Inseridos} produto(s) incluído(s) e {r.Atualizados} atualizado(s).");
            _abertoImp = false; _previa = null; _arquivoImp = null;
            await Carregar();
        }
    }

    private FiltroProdutos Filtro => new(_fTexto, string.IsNullOrEmpty(_fGrupo) ? null : _fGrupo,
        _fAtivo switch { "sim" => true, "nao" => false, _ => null }, _ordem, _desc);

    /// <summary>Recarrega indicadores, grupos e a página atual (após salvar, importar ou padronizar).</summary>
    private async Task Carregar()
    {
        Cat.InvalidarProdutos(); // produto/controlado mudou: a busca de produtos de todos relê o catálogo
        _resumo = await Cad.ResumoProdutosAsync(Cancelamento);
        (_grupos, _subgrupos) = await Cad.GruposProdutoAsync(Cancelamento);
        await CarregarPagina();
    }

    private async Task CarregarPagina()
    {
        _pagina = await Cad.ListarProdutosAsync(Filtro, _paginaAtual, TamPagina, Cancelamento);
        _paginaAtual = _pagina.Pagina; // o serviço ajusta quando o total encolheu (ex.: produto inativado na última página)
    }

    private Task Filtrar() { _paginaAtual = 0; return CarregarPagina(); }
    private Task IrPara(int p) { _paginaAtual = p; return CarregarPagina(); }

    private Task Ordenar(OrdemProdutos o)
    {
        _desc = _ordem == o && !_desc;
        _ordem = o;
        return Filtrar();
    }
    private string Seta(OrdemProdutos o) => _ordem != o ? "" : _desc ? "▼" : "▲";
    private string AriaOrdem(OrdemProdutos o) => _ordem != o ? "none" : _desc ? "descending" : "ascending";

    private async Task Tecla(KeyboardEventArgs e, Guid id)
    {
        if (e.Key is "Enter" or " " or "Spacebar") await Abrir(id);
    }

    /// <summary>Planilha com o filtro inteiro (todas as páginas), montada no servidor a partir do serviço.</summary>
    private async Task Exportar()
    {
        await Executar(async () =>
        {
            var linhas = await Cad.ExportarProdutosAsync(Filtro, Cancelamento);
            using var wb = new ClosedXML.Excel.XLWorkbook();
            var ws = wb.AddWorksheet("Produtos");
            string[] titulos = ["Código", "Nome", "UN", "Grupo", "Subgrupo", "NCM", "Descrição completa", "Marca", "Referência", "EAN", "Qtd/emb.",
                                "Código anterior", "Origem", "Lead time (dias)", "Preço ref.", "Material controlado", "Ativo"];
            for (var c = 0; c < titulos.Length; c++) { ws.Cell(1, c + 1).Value = titulos[c]; ws.Cell(1, c + 1).Style.Font.Bold = true; }
            var r = 2;
            foreach (var l in linhas)
            {
                ws.Cell(r, 1).Value = l.Codigo; ws.Cell(r, 2).Value = l.Nome; ws.Cell(r, 3).Value = l.Unidade; ws.Cell(r, 4).Value = l.Grupo;
                ws.Cell(r, 5).Value = l.SubGrupo; ws.Cell(r, 6).Value = l.Ncm; ws.Cell(r, 7).Value = l.DescricaoCompleta; ws.Cell(r, 8).Value = l.Marca;
                ws.Cell(r, 9).Value = l.Referencia; ws.Cell(r, 10).Value = l.Ean; ws.Cell(r, 11).Value = l.QuantidadePorEmbalagem;
                ws.Cell(r, 12).Value = l.CodigoAnterior; ws.Cell(r, 13).Value = l.OrigemSistema; ws.Cell(r, 14).Value = l.LeadTimeDias;
                ws.Cell(r, 15).Value = l.PrecoReferencia; ws.Cell(r, 16).Value = l.MaterialControlado; ws.Cell(r, 17).Value = l.Ativo ? "Sim" : "Não";
                r++;
            }
            ws.Column(15).Style.NumberFormat.Format = "#,##0.00";
            ws.Columns().AdjustToContents(8, 60);
            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            await JS.InvokeVoidAsync("qh.baixar", Cancelamento, $"produtos-{Relogio.GetLocalNow():yyyyMMdd-HHmm}.xlsx", Convert.ToBase64String(ms.ToArray()),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        });
    }

    private List<string> _marcas = [];
    private List<MarcasServico.CompraPorMarca> _compras = [];
    private void Novo() { _p = new Produto(); _compras = []; ErrosForm = null; _iaMsg = null; _aberto = true; }

    private bool _iaOcupado;
    private string? _iaMsg;

    /// <summary>IA sugere grupo/subgrupo (só os existentes) e aponta possíveis duplicados; preenche só campos vazios.</summary>
    private async Task ClassificarIa()
    {
        _iaOcupado = true; _iaMsg = null;
        try
        {
            var r = await Ia.ClassificarProdutoAsync(_p!.Nome, _p.DescricaoCompleta, _p.CriadoEm == default ? null : _p.Id, Cancelamento);
            if (string.IsNullOrWhiteSpace(_p.Grupo) || _p.AClassificar) { _p.Grupo = r.Grupo; _p.SubGrupo = r.SubGrupo; }
            else if (string.IsNullOrWhiteSpace(_p.SubGrupo) && r.Grupo == _p.Grupo) _p.SubGrupo = r.SubGrupo;
            if (_p.CriadoEm == default && !string.IsNullOrWhiteSpace(r.Unidade) && _p.Unidade == "UN") _p.Unidade = r.Unidade!;
            _iaMsg = $"Sugestão: {r.Grupo ?? "—"} › {r.SubGrupo ?? "—"}{(r.PossiveisDuplicados.Count > 0 ? $" · possível duplicado: {string.Join(", ", r.PossiveisDuplicados)}" : " · sem duplicado aparente")}. {r.Observacao}";
        }
        catch (RegraDeNegocioException e) { _iaMsg = e.Message; }
        finally { _iaOcupado = false; }
    }

    private async Task Abrir(Guid id)
    {
        Produto? p = null;
        if (!await Executar(async () => p = await Cad.ObterProdutoAsync(id, Cancelamento))) return;
        if (p is null) { Notif.Erro("Produto não encontrado (pode ter sido excluído)."); await CarregarPagina(); return; }
        _p = p; ErrosForm = null; _iaMsg = null; _aberto = true;
        _marcas = await Cat.MarcasAsync();
        _compras = await MarcasSrv.ComprasPorMarcaAsync(p.Id, Cancelamento);
    }

    private async Task Salvar()
    {
        if (await Executar(() => Cad.SalvarProdutoAsync(_p!, Cancelamento), "Produto salvo.")) { _aberto = false; await Carregar(); }
    }
}
