@page "/cotacao/{Token:guid}"
@attribute [AllowAnonymous]
@layout LayoutPublico
@inject PortalServico Portal
@using Groundkey.Application.Comum

<PageTitle>Proposta de cotação · Groundkey</PageTitle>
<div class="@(NaArea ? "portal-embutido" : "portal")">
    @if (_carregando) { <p class="mudo">Carregando…</p> }
    else if (_s is null)
    {
        <div class="caixa"><h2>@(NaArea ? "Cotação indisponível" : "Link inválido")</h2><p>@(NaArea ? "Volte à lista de cotações e tente de novo." : "Entre pela Área do Fornecedor (CNPJ + código) ou solicite um novo link ao setor de Suprimentos.")</p></div>
    }
    else
    {
        <header class="portal-topo">
            <div><small>Proposta de cotação · @_s.EmpresaNome</small><h1>@_s.FornecedorNome</h1>
                <span class="mudo">Cotação nº @_s.CotacaoNumero — @_s.CotacaoNome · frete @Rotulos.De(_s.Frete)@(string.IsNullOrWhiteSpace(_s.EnderecoEntrega) ? "" : $" · entrega em {_s.EnderecoEntrega}")</span>
                @if (_s.FaturarPara is not null) { <div id="faturar-para"><b>Faturar para:</b> @_s.FaturarPara</div> }
                @if (_s.Destino is not null) { <div id="destino"><b>Destino / identificar na NF:</b> @_s.Destino</div> }</div>
        </header>
        @if (_msg is not null) { <div class="alerta @(_ok ? "ok" : "erro")">@_msg</div> }
        @if (_erros is { Count: > 0 }) { <div class="alerta erro"><ul class="sem-margem">@foreach (var e in _erros) { <li>@e</li> }</ul></div> }
        @if (!_s.Aberta)
        {
            <div class="alerta aviso"><Icone Nome="alerta" /> Esta cotação não está mais recebendo propostas. @(_s.Convite.DataResposta is { } d ? $"Sua proposta foi registrada em {d:dd/MM/yyyy}." : "")</div>
        }
        else if (_s.Convite.DataResposta is { } dr)
        {
            <div class="alerta info"><Icone Nome="info" /> Proposta recebida em @dr.ToString("dd/MM/yyyy"). Você pode corrigir e reenviar enquanto a cotação estiver aberta.</div>
        }
        <div class="tabela-rolavel">
            <table class="itens">
                <thead><tr><th>Item</th><th>UN</th><th class="num">Quant.</th><th>Preço unitário (R$)</th>@if (_s.Material) { <th>Marca <span class="req">*</span></th> }<th>Entrega</th><th class="num">Total</th></tr></thead>
                <tbody>
                    @foreach (var l in _linhas)
                    {
                        var ls = _s.Locais.TryGetValue(l.Id, out var x) && x.Count > 0 ? x : null;
                        var aberto = ls is not null && _abertos.Contains(l.Id);
                        <tr @key="l.Id" class="@(aberto ? "com-locais" : "")">
                            <td><b>@l.Descricao</b>
                                @if (ls is not null)
                                {
                                    <br /><button type="button" class="pl-toggle" aria-expanded="@(aberto ? "true" : "false")" @onclick="() => { if (!_abertos.Remove(l.Id)) _abertos.Add(l.Id); }">@(aberto ? "▾" : "▸") <span class="pl-ico">▦</span> Locais: @QuadroLocais.Resumo(ls, l.Unidade)</button>
                                }
                                @if (_s.MarcasPedidas.TryGetValue(l.Id, out var mp)) { <br /><small class="mudo">Marca pedida: @mp.Marca@(mp.Somente ? " (somente esta)" : " ou similar")</small> }</td><td>@l.Unidade</td><td class="num">@Rotulos.Num(l.Quantidade, 3)</td>
                            <td class="larg-150"><input type="number" step="0.01" min="0" @bind="l.Valor" disabled="@(!_s.Aberta)" /></td>
                            @if (_s.Material) { <td class="larg-160"><input @bind="l.Marca" maxlength="120" placeholder="marca do item" aria-label="@($"Marca – {l.Descricao}")" disabled="@(!_s.Aberta)" /></td> }
                            <td class="larg-150"><input type="date" @bind="l.Entrega" disabled="@(!_s.Aberta)" /></td>
                            <td class="num">@Rotulos.Moeda(Math.Round(l.Valor * l.Quantidade, 2))</td>
                        </tr>
                        @if (aberto) { <tr class="linha-locais" @key="(l.Id, 1)"><td colspan="@(_s.Material ? 7 : 6)"><PainelLocais Linhas="ls!" Unidade="@l.Unidade" /></td></tr> }
                    }
                    @if (_linhas.Count == 0) { <tr><td colspan="@(_s.Material ? 7 : 6)" class="mudo">Nenhum item nesta cotação para a sua empresa.</td></tr> }
                </tbody>
                <tfoot><tr><td colspan="@(_s.Material ? 6 : 5)" class="num"><b>Total dos itens</b></td><td class="num"><b>@Rotulos.Moeda(_linhas.Sum(l => Math.Round(l.Valor * l.Quantidade, 2)))</b></td></tr></tfoot>
            </table>
        </div>
        <div class="form mt-12">
            @if (_s.Frete != TipoFrete.NaoSeAplica) { <div class="campo s3"><label>Frete (R$)</label><input type="number" step="0.01" min="0" @bind="_frete" disabled="@(!_s.Aberta)" /></div> }
            <div class="campo s3"><label>Prazo de entrega (geral)</label><input type="date" @bind="_prazo" disabled="@(!_s.Aberta)" /></div>
            <div class="campo s3"><label>Condição de pagamento</label><input @bind="_condicao" placeholder="ex.: 28 dias" maxlength="100" disabled="@(!_s.Aberta)" /></div>
            <div class="campo s3"><label>Validade da proposta</label><input type="date" @bind="_validade" disabled="@(!_s.Aberta)" /></div>
        </div>
        @if (_s.Aberta)
        {
            <p class="mudo">Os preços ficam registrados com data e hora. Documentos (proposta assinada, catálogos, laudos) podem ser enviados ao comprador junto com o pedido.</p>
            <button class="btn prim" disabled="@_enviando" @onclick="Enviar"><Icone Nome="enviar" Tam="16" /> Enviar proposta</button>
        }
    }
</div>

@code {
    [Parameter] public Guid Token { get; set; }
    /// <summary>Dentro da Área do Fornecedor (sessão por código): sem a moldura e os dados do link.</summary>
    [Parameter] public bool NaArea { get; set; }
    private PropostaPortal? _s;
    private bool _carregando = true, _enviando, _ok;
    private string? _msg, _condicao;
    private IReadOnlyList<string>? _erros;
    private decimal? _frete;
    private DateOnly? _prazo, _validade;
    private List<LinhaProp> _linhas = [];
    private readonly HashSet<Guid> _abertos = [];

    private sealed class LinhaProp
    {
        public Guid Id { get; init; }
        public string Descricao { get; init; } = "";
        public string Unidade { get; init; } = "";
        public decimal Quantidade { get; init; }
        public decimal Valor { get; set; }
        public DateOnly? Entrega { get; set; }
        public string? Marca { get; set; }
    }

    protected override async Task OnInitializedAsync() => await Abrir();

    private async Task Abrir()
    {
        _s = await Portal.AbrirPropostaAsync(Token);
        if (_s is not null)
        {
            _linhas = _s.Itens.Select(i => new LinhaProp { Id = i.Id, Descricao = i.Descricao, Unidade = i.Unidade, Quantidade = i.Quantidade, Valor = i.ValorOfertado, Entrega = i.Entrega, Marca = i.Marca }).ToList();
            _frete = _s.Convite.ValorFrete; _prazo = _s.Convite.PrazoEntregaOfertado; _condicao = _s.Convite.CondicaoPagamento; _validade = _s.Convite.ValidadeProposta;
        }
        _carregando = false;
    }

    private async Task Enviar()
    {
        _enviando = true; _msg = null; _erros = null;
        try
        {
            await Portal.EnviarPropostaAsync(Token, _linhas.Select(l => new ItemPropostaPortal(l.Id, l.Valor, l.Entrega, l.Marca)).ToList(), _frete, _condicao, _validade, _prazo);
            _ok = true; _msg = "Proposta enviada. Obrigado! O comprador já pode ver seus preços.";
            await Abrir();
        }
        catch (ValidacaoException v) { _erros = v.Erros; }
        catch (RegraDeNegocioException e) { _ok = false; _msg = e.Message; }
        finally { _enviando = false; }
    }
}
