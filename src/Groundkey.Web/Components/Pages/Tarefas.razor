@page "/tarefas"
@inherits PaginaBase
@inject ColaboracaoServico Colab
@inject NavigationManager Nav

<Pagina Titulo="Tarefas" Grade="_grade" AoNovo="Nova" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina toque">
            <div class="kpis">
                <Kpi Rotulo="Minhas abertas" Valor="@_itens?.Count(t => t.ResponsavelId == Usuario.UsuarioId && !t.Encerrada)" Tom="info" />
                <Kpi Rotulo="Atrasadas" Valor="@_itens?.Count(t => t.Atrasada(Hoje))" Tom="erro" Sub="prazo vencido" />
                <Kpi Rotulo="Vencem em 3 dias" Valor="@_itens?.Count(t => !t.Encerrada && t.DiasRestantes(Hoje) is >= 0 and <= 3)" Tom="aviso" />
                <Kpi Rotulo="Não lidas pelo responsável" Valor="@_itens?.Count(t => !t.Encerrada && t.Leituras.Count == 0)" Sub="sem confirmação de leitura" />
                <Kpi Rotulo="Prorrogadas" Valor="@_itens?.Count(t => t.Prorrogacoes.Count > 0 && !t.Encerrada)" />
            </div>
            <div class="filtros-rapidos">
                <label><input type="radio" name="ft" checked="@(_filtro == "minhas")" @onchange='() => Filtrar("minhas")' /> Minhas</label>
                <label><input type="radio" name="ft" checked="@(_filtro == "enviadas")" @onchange='() => Filtrar("enviadas")' /> Que eu criei</label>
                <label><input type="radio" name="ft" checked="@(_filtro == "abertas")" @onchange='() => Filtrar("abertas")' /> Todas abertas</label>
                <label><input type="radio" name="ft" checked="@(_filtro == "todas")" @onchange='() => Filtrar("todas")' /> Todas</label>
            </div>
            @if (_itens?.Count >= Limite) { <div class="alerta info"><Icone Nome="info" /> Exibindo as @Limite tarefas mais recentes — tarefas mais antigas não entram nos números acima.</div> }
            <Grade T="Tarefa" @ref="_grade" Itens="_visiveis" AoClicar="t => Abrir(t.Id)" NomeExportacao="tarefas" CriadoPor="t => t.CriadoPor">
                <Colunas>
                    <Coluna T="Tarefa" Titulo="Nº" Valor="t => t.Numero" Largura="70px" />
                    <Coluna T="Tarefa" Titulo="Título" Valor="t => t.Titulo" />
                    <Coluna T="Tarefa" Titulo="Tipo" Valor="t => t.Tipo" />
                    <Coluna T="Tarefa" Titulo="Responsável" Valor="t => t.ResponsavelNome" />
                    <Coluna T="Tarefa" Titulo="Solicitante" Valor="t => t.CriadoPor" />
                    <Coluna T="Tarefa" Titulo="Prioridade" Valor="t => t.Prioridade"><Modelo><Selo Texto="@De(context.Prioridade)" Tom="@Tom(context.Prioridade)" /></Modelo></Coluna>
                    <Coluna T="Tarefa" Titulo="Prazo" Valor="t => t.Prazo"><Modelo><span class="@(context.Atrasada(Hoje) ? "texto-erro" : "")">@Data(context.Prazo)@(context.Prorrogacoes.Count > 0 ? $" ({context.Prorrogacoes.Count}× prorrogada)" : "")</span></Modelo></Coluna>
                    <Coluna T="Tarefa" Titulo="Dias" Valor="t => t.Encerrada ? (int?)null : t.DiasRestantes(Hoje)" Alinhar="num" />
                    <Coluna T="Tarefa" Titulo="Lida" Valor='t => t.Leituras.Count > 0 ? "Sim" : "Não"' />
                    <Coluna T="Tarefa" Titulo="Origem" Valor="t => t.OrigemDescricao" />
                    <Coluna T="Tarefa" Titulo="Status" Valor="t => t.Status"><Modelo><Selo Texto="@De(context.Status)" Tom="@Tom(context.Status)" /></Modelo></Coluna>
                </Colunas>
            </Grade>
        </div>
    </ChildContent>
    <Faixa><b>Tarefas internas</b><span>Prazo, responsável e prioridade</span><span>Prorrogação só com justificativa (prazo original guardado)</span><span>Leitura confirmada quando o responsável abre</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_aberto" Titulo="@(_t?.Numero > 0 ? $"Tarefa {_t.Numero} — {_t.Titulo}" : "Nova tarefa")" Tamanho="media toque">
    <ChildContent>
        @if (_t is not null)
        {
            <Erros Lista="ErrosForm" />
            @if (_t.Numero > 0)
            {
                <div class="kpis">
                    <Kpi Rotulo="Status" Valor="@De(_t.Status)" Tom="@Tom(_t.Status)" />
                    <Kpi Rotulo="Prazo" Valor="@Data(_t.Prazo)" Sub="@(_t.Encerrada ? "" : _t.Atrasada(Hoje) ? $"atrasada {-_t.DiasRestantes(Hoje)} dia(s)" : $"faltam {_t.DiasRestantes(Hoje)} dia(s)")" Tom="@(_t.Atrasada(Hoje) ? "erro" : "ok")" />
                    <Kpi Rotulo="Prazo original" Valor="@Data(_t.PrazoOriginal)" Sub="@($"{_t.Prorrogacoes.Count} prorrogação(ões)")" />
                    <Kpi Rotulo="Leitura" Valor="@(_t.Leituras.Count > 0 ? "Confirmada" : "Pendente")" Sub="@(_t.Leituras.FirstOrDefault() is { } l ? $"{l.Nome} · {DataHora(l.LidaEm)}" : "responsável ainda não abriu")" Tom="@(_t.Leituras.Count > 0 ? "ok" : "aviso")" />
                </div>
            }
            <div class="form">
                <Campo Rotulo="Título" Obrigatorio Classe="s8"><input @bind="_t.Titulo" maxlength="200" disabled="@_t.Encerrada" /></Campo>
                <Campo Rotulo="Tipo" Classe="s4"><select @bind="_t.Tipo" disabled="@_t.Encerrada"><option value="">—</option>@foreach (var x in _tipos) { <option>@x</option> }</select></Campo>
                <Campo Rotulo="Descrição" Classe="s12"><textarea @bind="_t.Descricao" rows="3" disabled="@_t.Encerrada"></textarea></Campo>
                <Campo Rotulo="Responsável" Obrigatorio Classe="s4"><select @bind="_t.ResponsavelId" disabled="@_t.Encerrada"><option value="@Guid.Empty">Selecione…</option>@foreach (var u in _usuarios) { <option value="@u.Id">@u.Texto</option> }</select></Campo>
                <Campo Rotulo="Prioridade" Classe="s2"><select @bind="_t.Prioridade" disabled="@_t.Encerrada">@foreach (var p in Enum.GetValues<PrioridadeTarefa>()) { <option value="@p">@De(p)</option> }</select></Campo>
                <Campo Rotulo="Prazo" Obrigatorio Classe="s3"><input type="date" @bind="_t.Prazo" disabled="@(_t.Numero > 0)" /></Campo>
                <Campo Rotulo="Obra" Classe="s3"><select @bind="_t.ObraId" disabled="@_t.Encerrada"><option value="">—</option>@foreach (var o in _obras) { <option value="@o.Id">@o.Texto</option> }</select></Campo>
                @if (_t.OrigemDescricao is not null)
                {
                    <Campo Rotulo="Origem" Classe="s12"><div class="pt-6">@if (LinkOrigem(_t) is { } href) { <a href="@href">@_t.OrigemDescricao</a> } else { @_t.OrigemDescricao }</div></Campo>
                }
                @if (_t.Encerrada) { <Campo Rotulo="Resolução" Classe="s12"><textarea readonly>@_t.Resolucao</textarea></Campo> }
            </div>

            @if (_t.Numero > 0 && !_t.Encerrada)
            {
                <div class="duas-caixas">
                    <div class="caixa-sec"><div class="secao"><Icone Nome="relogio" /> Prorrogar prazo</div>
                        <div class="form">
                            <Campo Rotulo="Novo prazo" Classe="s5"><input type="date" @bind="_novoPrazo" /></Campo>
                            <Campo Rotulo="Justificativa" Classe="s12"><textarea @bind="_justif" rows="2" placeholder="Obrigatória (mín. 10 caracteres)"></textarea></Campo>
                        </div>
                        <button class="btn sec" disabled="@Ocupado" @onclick="Prorrogar"><Icone Nome="relogio" Tam="14" /> Prorrogar</button>
                    </div>
                    <div class="caixa-sec"><div class="secao"><Icone Nome="check" /> Concluir</div>
                        <div class="form"><Campo Rotulo="Resolução / o que foi feito" Classe="s12"><textarea @bind="_resolucao" rows="3"></textarea></Campo></div>
                        <button class="btn ok" disabled="@Ocupado" @onclick="Concluir"><Icone Nome="check" Tam="14" /> Concluir tarefa</button>
                        <button class="btn sec" disabled="@Ocupado" @onclick="Cancelar" title="Usa o texto da resolução como motivo">Cancelar tarefa</button>
                    </div>
                </div>
            }
            @if (_t.Prorrogacoes.Count > 0)
            {
                <div class="secao"><Icone Nome="relogio" /> Histórico de prorrogações</div>
                <div class="tabela-rolavel"><table class="itens"><thead><tr><th>Em</th><th>Por</th><th>De</th><th>Para</th><th class="num">Dias</th><th>Justificativa</th></tr></thead>
                    <tbody>@foreach (var p in _t.Prorrogacoes.OrderBy(p => p.Em)) { <tr><td>@DataHora(p.Em)</td><td>@p.Usuario</td><td>@Data(p.PrazoAnterior)</td><td>@Data(p.NovoPrazo)</td><td class="num">@p.Dias</td><td>@p.Justificativa</td></tr> }</tbody></table></div>
            }
            @if (_t.Numero > 0)
            {
                <Anexos Entidade="Tarefa" EntidadeId="_t.Id" Categoria="Geral" Titulo="Anexos" SomenteLeitura="_t.Encerrada" />
                <Notas Entidade="Tarefa" EntidadeId="_t.Id" Titulo="Notas / respostas" />
            }
        }
    </ChildContent>
    <Rodape>
        @if (_t is not null && !_t.Encerrada) { <button class="btn prim" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="16" /> Salvar</button> }
    </Rodape>
</Modal>

@code {
    private const int Limite = 2000;
    private Grade<Tarefa>? _grade;
    private List<Tarefa>? _itens, _visiveis;
    private Tarefa? _t;
    private bool _aberto;
    private string _filtro = "minhas";
    private List<Opcao> _usuarios = [], _obras = [];
    private List<string> _tipos = [];
    private DateOnly? _novoPrazo;
    private string? _justif, _resolucao;

    protected override async Task OnInitializedAsync()
    {
        _usuarios = await Cat.UsuariosAsync(); _obras = await Cat.ObrasAsync(); _tipos = await Cat.ListaAsync(TipoLista.TipoTarefa);
        await Carregar();
        var q = new Uri(Nav.Uri).Query;
        var args = System.Web.HttpUtility.ParseQueryString(q);
        if (Guid.TryParse(args["id"], out var id)) await Abrir(id);
        else if (args["origem"] is { Length: > 0 } origem && Guid.TryParse(args["origemId"], out var oid))
        {
            Nova();
            _t!.OrigemEntidade = origem; _t.OrigemId = oid; _t.OrigemDescricao = args["desc"] ?? origem;
            _t.Titulo = args["titulo"] ?? ""; _t.Tipo = args["tipo"];
        }
    }

    private async Task Carregar()
    {
        await using var db = Fabrica.CriarLeitura();
        _itens = await db.Tarefas.AsNoTracking().Include(t => t.Prorrogacoes).Include(t => t.Leituras).OrderByDescending(t => t.Numero).Take(Limite).ToListAsync(Cancelamento);
        Filtrar(_filtro);
    }

    private void Filtrar(string f)
    {
        _filtro = f;
        var me = Usuario.UsuarioId;
        _visiveis = _itens?.Where(t => f switch
        {
            "minhas" => t.ResponsavelId == me && !t.Encerrada,
            "enviadas" => t.CriadoPor == Usuario.Nome,
            "abertas" => !t.Encerrada,
            _ => true
        }).OrderBy(t => t.Encerrada).ThenBy(t => t.Prazo).ToList();
    }

    private static string? LinkOrigem(Tarefa t) => Groundkey.Application.Comum.RotasRegistro.Link(t.OrigemEntidade, t.OrigemId);

    private void Nova()
    {
        ErrosForm = null; _novoPrazo = null; _justif = null; _resolucao = null;
        _t = new Tarefa { Prazo = Hoje.AddDays(7), Prioridade = PrioridadeTarefa.Normal };
        _aberto = true;
    }

    private async Task Abrir(Guid id)
    {
        ErrosForm = null; _novoPrazo = null; _justif = null; _resolucao = null;
        _t = await Colab.CarregarTarefaAsync(id, registrarLeitura: true, ct: Cancelamento);
        _aberto = true;
        await Carregar();
    }

    private async Task Salvar()
    {
        Guid id = default;
        if (await Executar(async () => id = await Colab.SalvarTarefaAsync(_t!, ct: Cancelamento), "Tarefa salva.")) { await Abrir(id); }
    }

    private async Task Prorrogar()
    {
        if (await Executar(() => Colab.ProrrogarAsync(_t!.Id, _novoPrazo ?? default, _justif ?? "", ct: Cancelamento), "Prazo prorrogado.")) await Abrir(_t!.Id);
    }

    private async Task Concluir()
    {
        if (await Executar(() => Colab.ConcluirAsync(_t!.Id, _resolucao ?? "", ct: Cancelamento), "Tarefa concluída.")) await Abrir(_t!.Id);
    }

    private async Task Cancelar()
    {
        if (await Executar(() => Colab.CancelarAsync(_t!.Id, _resolucao ?? "", ct: Cancelamento), "Tarefa cancelada.")) await Abrir(_t!.Id);
    }
}
