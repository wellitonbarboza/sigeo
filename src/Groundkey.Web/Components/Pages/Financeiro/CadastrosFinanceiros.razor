@page "/financeiro/cadastros"
@inherits PaginaBase
@using Groundkey.Domain.Financeiro
@inject FinanceiroServico Fin

<Pagina Titulo="Plano de contas e condições de pagamento" AoNovo="Novo" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <Abas Itens="_abas" @bind-Ativa="_aba" />
            @if (_aba == "plano")
            {
                <p class="mudo fonte-13">Plano gerencial da construtora (empresa — sem contas pessoais). Lança-se nas contas sem filhas; os níveis de cima somam no DRE.</p>
                <table class="itens" id="pc-tabela">
                    <thead><tr><th>Código</th><th>Conta</th><th>Natureza</th><th>Ativa</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in _contas)
                        {
                            var conta = c;
                            <tr class="@(conta.Ativa ? "" : "mudo")"><td>@conta.Codigo</td><td style="padding-left:@((conta.Nivel - 1) * 18 + 8)px">@if (conta.Nivel == 1) { <b>@conta.Nome</b> } else { @conta.Nome }</td>
                                <td>@(conta.Natureza == NaturezaConta.Receita ? "Receita" : "Despesa")</td><td>@(conta.Ativa ? "Sim" : "Não")</td>
                                <td><button class="btn sec pq" @onclick="() => { ErrosForm = null; _c = conta; _abertoConta = true; }">Editar</button></td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="mudo fonte-13">Entrada (%) + prazos em dias. Ex.: "30;60;90" ou "1+3" = entrada 25% + 30;60;90. Usadas para gerar as parcelas dos títulos.</p>
                <table class="itens" id="cp-tabela">
                    <thead><tr><th>Condição</th><th class="num">Entrada</th><th>Prazos (dias)</th><th>Ativa</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in _conds)
                        {
                            var cond = c;
                            <tr><td>@cond.Nome</td><td class="num">@(cond.EntradaPerc > 0 ? cond.EntradaPerc.ToString("N2", Br) + "%" : "—")</td><td>@cond.Prazos</td><td>@(cond.Ativa ? "Sim" : "Não")</td>
                                <td><button class="btn sec pq" @onclick="() => { ErrosForm = null; _cp = cond; _abertoCond = true; }">Editar</button></td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </ChildContent>
</Pagina>

<Modal @bind-Aberto="_abertoConta" Titulo="Conta gerencial" Tamanho="pequena">
    <ChildContent>
        @if (_c is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Código" Obrigatorio Classe="s4" Ajuda="Ex.: 3.9"><input id="pc-codigo" @bind="_c.Codigo" maxlength="30" /></Campo>
                <Campo Rotulo="Nome" Obrigatorio Classe="s8"><input id="pc-nome" @bind="_c.Nome" maxlength="150" /></Campo>
                <Campo Rotulo="Natureza" Classe="s6"><select @bind="_c.Natureza"><option value="@NaturezaConta.Despesa">Despesa</option><option value="@NaturezaConta.Receita">Receita</option></select></Campo>
                <Campo Rotulo="" Classe="s6"><label><input type="checkbox" @bind="_c.Ativa" /> Ativa</label></Campo>
            </div>
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="pc-salvar" disabled="@Ocupado" @onclick="SalvarConta"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

<Modal @bind-Aberto="_abertoCond" Titulo="Condição de pagamento" Tamanho="pequena">
    <ChildContent>
        @if (_cp is not null)
        {
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Nome" Obrigatorio Classe="s12"><input id="cp-nome" @bind="_cp.Nome" maxlength="60" /></Campo>
                <Campo Rotulo="Entrada (%)" Classe="s4"><input type="number" step="0.01" @bind="_cp.EntradaPerc" /></Campo>
                <Campo Rotulo="Prazos (dias)" Classe="s8" Ajuda="Separados por ;"><input id="cp-prazos" @bind="_cp.Prazos" maxlength="200" /></Campo>
                <Campo Rotulo="" Classe="s12"><label><input type="checkbox" @bind="_cp.Ativa" /> Ativa</label></Campo>
                <Campo Rotulo="Exemplo para R$ 1.000,00 hoje" Classe="s12">
                    <span class="mudo">@string.Join(" · ", _cp.Gerar(1000, Hoje).Select(p => $"{p.Vencimento:dd/MM} {p.Valor:N2}"))</span>
                </Campo>
            </div>
        }
    </ChildContent>
    <Rodape><button class="btn prim" id="cp-salvar" disabled="@Ocupado" @onclick="SalvarCond"><Icone Nome="check" Tam="16" /> Salvar</button></Rodape>
</Modal>

@code {
    private string _aba = "plano";
    private readonly List<(string, string)> _abas = [("plano", "Plano de contas"), ("cond", "Condições de pagamento")];
    private List<ContaGerencial> _contas = [];
    private List<CondicaoPagamento> _conds = [];
    private ContaGerencial? _c;
    private CondicaoPagamento? _cp;
    private bool _abertoConta, _abertoCond;

    protected override Task OnInitializedAsync() => Carregar();

    private async Task Carregar()
    {
        _contas = await Fin.ContasGerenciaisAsync(false, Cancelamento);
        _conds = await Fin.CondicoesAsync(Cancelamento);
    }

    private void Novo()
    {
        ErrosForm = null;
        if (_aba == "plano") { _c = new ContaGerencial(); _abertoConta = true; }
        else { _cp = new CondicaoPagamento { Prazos = "30" }; _abertoCond = true; }
    }

    private async Task SalvarConta()
    {
        if (_c is null) return;
        if (await Executar(() => Fin.SalvarContaGerencialAsync(_c, Cancelamento), "Conta salva.")) { _abertoConta = false; await Carregar(); }
    }

    private async Task SalvarCond()
    {
        if (_cp is null) return;
        if (await Executar(() => Fin.SalvarCondicaoAsync(_cp, Cancelamento), "Condição salva.")) { _abertoCond = false; await Carregar(); }
    }
}
