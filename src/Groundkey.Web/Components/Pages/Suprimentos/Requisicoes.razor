@page "/requisicoes"
@inherits PaginaBase
@inject RequisicoesServico RequisicoesSrv
@inject CotacoesServico CotacoesSrv
@inject OrcamentoServico Orc
@inject FornecedoresServico Forn
@inject NavigationManager Nav
@inject EstoqueServico EstoqueSrv
@using Groundkey.Application.Comum

<Pagina Titulo="Requisição de compras" Grade="_grade" AoNovo="Novo" AoAtualizar="Carregar">
    <ChildContent>
        <div class="pagina">
            <Grade T="Linha" @ref="_grade" Itens="_itens" Limite="LimiteGrade" AoCarregarTudo="async () => { ListaCompleta = true; await Carregar(); }" AoClicar="l => Abrir(l.Id)" NomeExportacao="requisicoes" CriadoPor="l => l.CriadoPor">
                <Acoes><button title="Abrir" @onclick="() => Abrir(context.Id)"><Icone Nome="prancheta" Tam="16" /></button></Acoes>
                <Colunas>
                    <Coluna T="Linha" Titulo="Número" Valor="l => l.Numero" Largura="90px" />
                    <Coluna T="Linha" Titulo="Obra" Valor="l => l.Obra" />
                    <Coluna T="Linha" Titulo="Tipo" Valor="l => l.Tipo" />
                    <Coluna T="Linha" Titulo="Atividade" Valor="l => l.Atividade" />
                    <Coluna T="Linha" Titulo="Centro de custo" Valor="l => l.CentroCusto" />
                    <Coluna T="Linha" Titulo="Entrega" Valor="l => l.Entrega" />
                    <Coluna T="Linha" Titulo="Itens" Valor="l => l.Itens" Alinhar="num" />
                    <Coluna T="Linha" Titulo="Status" Valor="l => l.Status"><Modelo><Selo Texto="@De(context.Status)" Tom="@Tom(context.Status)" /></Modelo></Coluna>
                    <Coluna T="Linha" Titulo="Criado por" Valor="l => l.CriadoPor" />
                    <Coluna T="Linha" Titulo="Criado em" Valor="l => l.CriadoEm" />
                </Colunas>
            </Grade>
        </div>
    </ChildContent>
    <Faixa><b>Requisição</b><span>Solicitação de material ou serviço</span><span>Aprovação em 2 níveis: Engenheiro da SPE → Diretor Técnico</span><span>Na 1ª aprovação o solicitante pode voltar para edição</span><span>Só vai para cotação após as duas aprovações</span></Faixa>
</Pagina>

<Modal @bind-Aberto="_aberto" Titulo="@(_r?.Numero > 0 ? $"Requisição {_r.Numero}" : "Nova requisição")">
    <ChildContent>
        @if (_r is not null)
        {
            <Etapas Itens="Passos()" />
            <Erros Lista="ErrosForm" />
            <div class="form">
                <Campo Rotulo="Empresa" Classe="s6"><input readonly value="@Usuario.EmpresaNome" /></Campo>
                <Campo Rotulo="Obra / empreendimento" Obrigatorio Classe="s4">
                    <select @key="_versaoObra" value="@_r.ObraId" @onchange="TrocarObra" disabled="@(!Editavel)"><option value="@Guid.Empty">Selecione…</option>@foreach (var o in _obras) { <option value="@o.Id">@o.Texto</option> }</select>
                </Campo>
                <Campo Rotulo="Tipo" Obrigatorio Classe="s2">
                    <select @bind="_r.Tipo" disabled="@(!Editavel)">@foreach (var t in Enum.GetValues<TipoRequisicao>()) { <option value="@t">@De(t)</option> }</select>
                </Campo>
                <Campo Rotulo="Atividade" Obrigatorio Classe="s4">
                    <select @bind="_r.Atividade" disabled="@(!Editavel)"><option value="">Selecione…</option>@foreach (var a in _atividades) { <option>@a</option> }</select>
                </Campo>
                <Campo Rotulo="Centro de custo" Classe="s4">
                    <select @bind="_r.CentroCustoId" disabled="@(!Editavel)"><option value="">—</option>@foreach (var c in _ccs) { <option value="@c.Id">@c.Texto</option> }</select>
                </Campo>
                <Campo Rotulo="Faturar para (CNPJ que compra)" Obrigatorio Classe="s6" Ajuda="Padrão de material: quem fatura (fábrica de pré-moldados)">
                    <select id="req-fat" @bind="_r.EstabelecimentoFaturamentoId" disabled="@(!Editavel)"><option value="">Selecione…</option>@foreach (var x in _estabs) { <option value="@x.Id">@x.Texto</option> }</select>
                </Campo>
                @if (SpesDaObra.Any())
                {
                    <Campo Rotulo="SPE beneficiária (destino do custo)" Obrigatorio Classe="s6" Ajuda="@(TemLocais ? "Definida pelos locais dos itens" : "Ou puxe os itens do orçamento pelos locais")">
                        <select id="req-spe" @bind="_r.SpeId" disabled="@(!Editavel || TemLocais)"><option value="">Selecione…</option>@foreach (var s in SpesDaObra) { <option value="@s.Id">@s.Texto</option> }</select>
                    </Campo>
                }
                else if (_obraPropria)
                {
                    <Campo Rotulo="Destino do custo" Classe="s6" Ajuda="Obra própria: sem SPE, o custo fica no CNPJ da construtora"><input id="req-propria" readonly value="Construtora (obra própria)" /></Campo>
                }
                <Campo Rotulo="Data de entrega" Obrigatorio Classe="s2"><input type="date" @bind="_r.DataEntrega" disabled="@(!Editavel)" /></Campo>
                <Campo Rotulo="Prazo cronograma (dias)" Classe="s2" Ajuda="Maior lead time dos itens"><input readonly value="@_r.PrazoCronogramaDias" /></Campo>
                @if (_r.Tipo == TipoRequisicao.Servico)
                {
                    <Campo Rotulo="Categoria do serviço" Obrigatorio Classe="s4">
                        <select @bind="_r.CategoriaServico" disabled="@(!Editavel)"><option value="">Selecione…</option>@foreach (var c in _categorias) { <option>@c</option> }</select>
                    </Campo>
                }
                <Campo Rotulo="Endereço de entrega" Classe="@(_r.Tipo == TipoRequisicao.Servico ? "s8" : "s12")"><input @bind="_r.EnderecoEntrega" disabled="@(!Editavel)" /></Campo>
            </div>
            @if (_r.AlertaCronograma(Hoje) is { } alerta)
            {
                <div class="alerta aviso"><Icone Nome="alerta" /> @alerta</div>
            }
            else if (_r.PrazoCronogramaDias > 0)
            {
                <div class="alerta aviso"><Icone Nome="alerta" /> Data de entrega respeita o cronograma de suprimentos (maior prazo entre os itens: @_r.PrazoCronogramaDias dias).</div>
            }

            <div class="secao"><Icone Nome="lista" /> Itens
                @if (Editavel)
                {
                    <span class="acao">
                        <button class="btn sec pq" id="req-orc" disabled="@(_r.ObraId == Guid.Empty)" @onclick="AbrirOrcamento"><Icone Nome="predio" Tam="14" /> Puxar do orçamento (por local)</button>
                        <button class="btn sec pq" @onclick="AddItem"><Icone Nome="mais" Tam="14" /> Item</button>
                    </span>
                }
            </div>
            @if (_r.Tipo == TipoRequisicao.Material && Editavel)
            {
                <div class="barra-filtro"><label>Categoria (grupo do catálogo) <select @bind="_grupoFiltro"><option value="">Todas</option>@foreach (var g in _grupos) { <option>@g.Texto</option> }</select></label><span class="mudo">Filtra a busca de produto; a categoria de cada item vem do produto.</span></div>
            }
            <table class="itens">
                <thead><tr>
                    <th class="min-220">@(_r.Tipo == TipoRequisicao.Material ? "Produto" : "Serviço (ITS) / descrição")</th><th>UN</th><th>Quant.</th>@if (_r.Tipo == TipoRequisicao.Material) { <th title="Opcional. Marque 'só esta' quando não aceitar similar">Marca (opcional)</th> }
                    <th>Material controlado</th><th>Especificação técnica</th><th>Documentos exigidos</th><th>Status</th><th></th>
                </tr></thead>
                <tbody>
                    @foreach (var i in _r.Itens)
                    {
                        var locaisItem = i.Locais.Count > 0 ? _arvore.Situar(i.Locais.Select(l => (l.LocalId, l.Quantidade))) : null;
                        var aberto = locaisItem is not null && _abertos.Contains(i.Id);
                        <tr @key="i" class="@(aberto ? "com-locais" : "")">
                            <td>
                                @if (_r.Tipo == TipoRequisicao.Material)
                                {
                                    <BuscaProduto Produtos="_produtos" Valor="i.ProdutoId" Grupo="@_grupoFiltro" Desabilitado="!Editavel" AoEscolher="p => EscolherProduto(i, p.Id.ToString())" />
                                }
                                else
                                {
                                    <select @bind="i.ServicoControladoId" disabled="@(!Editavel)"><option value="">(serviço não controlado)</option>@foreach (var s in _servicos) { <option value="@s.Id">@s.Texto</option> }</select>
                                    <input class="mt-4" placeholder="Descrição" @bind="i.Descricao" disabled="@(!Editavel)" />
                                }
                                @if (locaisItem is not null)
                                {
                                    <button type="button" class="pl-toggle" aria-expanded="@(aberto ? "true" : "false")" @onclick="() => AlternarLocais(i.Id)">@(aberto ? "▾" : "▸") <span class="pl-ico">▦</span> Locais (orçado): @QuadroLocais.Resumo(locaisItem, i.Unidade)</button>
                                }
                            </td>
                            <td class="larg-70"><input @bind="i.Unidade" disabled="@(!Editavel)" /></td>
                            <td class="larg-110"><input type="number" step="0.001" @bind="i.Quantidade" disabled="@(!Editavel)" />
                                @if (i.ProdutoId is { } pe && (_saldoObra.ContainsKey(pe) || _saldoCentral.ContainsKey(pe)))
                                {
                                    <div class="saldo-estoque" title="Saldo disponível em estoque">Estoque: obra @_saldoObra.GetValueOrDefault(pe).ToString("0.##", Br)@(_central is null ? "" : $" · central {_saldoCentral.GetValueOrDefault(pe).ToString("0.##", Br)}")</div>
                                }
                            </td>
                            @if (_r.Tipo == TipoRequisicao.Material)
                            {
                                <td class="larg-160"><input list="req-marcas" aria-label="Marca" @bind="i.Marca" disabled="@(!Editavel)" placeholder="@(_prodMarca.GetValueOrDefault(i.ProdutoId ?? Guid.Empty) ?? "qualquer")" />
                                    <label class="check fonte-12" title="Não aceita similar: a cotação tem de vir nesta marca"><input type="checkbox" @bind="i.MesmaMarca" disabled="@(!Editavel || string.IsNullOrWhiteSpace(i.Marca))" /> só esta</label></td>
                            }
                            <td>@if (i.MaterialControlado) { <Selo Texto="Sim" Tom="info" /> } else { <Selo Texto="Não" /> }</td>
                            <td><input @bind="i.EspecificacaoTecnica" disabled="@(!Editavel)" placeholder="@(i.MaterialControlado ? "obrigatória" : "—")" /></td>
                            <td><input @bind="i.DocumentosExigidos" disabled="@(!Editavel)" /></td>
                            <td><Selo Texto="@De(i.Status)" /></td>
                            <td>@if (Editavel) { <button class="icone-btn" title="Remover" @onclick="() => _r.Itens.Remove(i)"><Icone Nome="lixeira" Tam="16" /></button> }</td>
                        </tr>
                        @if (aberto) { <tr class="linha-locais" @key="(i, 1)"><td colspan="@(_r.Tipo == TipoRequisicao.Material ? 9 : 8)"><PainelLocais Linhas="locaisItem!" Unidade="@i.Unidade" /></td></tr> }
                    }
                    @if (_r.Itens.Count == 0) { <tr><td colspan="@(_r.Tipo == TipoRequisicao.Material ? 9 : 8)" class="mudo">Inclua os itens.</td></tr> }
                </tbody>
            </table>

            <div class="form mt-14">
                <Campo Rotulo="Observação" Classe="s8"><textarea @bind="_r.Observacao" disabled="@(!Editavel)"></textarea></Campo>
                <Campo Rotulo="Sem orçamento (compra direta)" Classe="s4">
                    <div class="checks"><label><input type="checkbox" @bind="_r.SemOrcamento" disabled="@(!Editavel)" /> Compra sem orçamento</label></div>
                    @if (_r.SemOrcamento) { <input placeholder="Justificativa (obrigatória)" @bind="_r.JustificativaSemOrcamento" disabled="@(!Editavel)" /> }
                </Campo>
                @if (_r.Itens.Any(i => i.Locais.Count > 0 && i.Quantidade > i.Locais.Sum(l => l.Quantidade) + 0.001m))
                {
                    <Campo Rotulo="Justificativa — quantidade acima do saldo orçado" Obrigatorio Classe="s12"><input id="req-just-orc" @bind="_r.JustificativaAcimaOrcado" disabled="@(!Editavel)" /></Campo>
                }
                @if (!string.IsNullOrEmpty(_r.MotivoReprovacao)) { <div class="campo s12"><div class="alerta erro"><Icone Nome="x-circulo" /> Motivo da reprovação/devolução: @_r.MotivoReprovacao</div></div> }
            </div>

            @if (_r.Numero > 0)
            {
                @if (_r.Tipo == TipoRequisicao.Servico) { <Anexos Entidade="Requisicao" EntidadeId="_r.Id" Categoria="Escopo" Titulo="Edital / escopo (projetos, memoriais, croquis, ITS)" SomenteLeitura="!Editavel" /> }
                @if (_r.CriadoEm != default) { <Notas Entidade="Requisicao" EntidadeId="_r.Id" /> }
                @if (_r.Status is StatusRequisicao.EmCotacao or StatusRequisicao.PedidoEmitido or StatusRequisicao.Concluida) { <FornecedoresCotacao RequisicaoId="_r.Id" Versao="_versao" /> }
                <Autorizacoes Entidade="EntidadeAprovavel.Requisicao" EntidadeId="_r.Id" Versao="_versao" AoDecidir="Recarregar" />
            }
        }
    </ChildContent>
    <Rodape>
        <datalist id="req-marcas">@foreach (var m in _marcas) { <option>@m</option> }</datalist>
        @if (_r is not null)
        {
            @if (_central is not null && _almoxObra is not null && _r.Numero > 0 && _r.Status is not (StatusRequisicao.Cancelada or StatusRequisicao.Concluida or StatusRequisicao.NaoAutorizada)
                 && _r.Itens.Any(i => i.ProdutoId is { } p && _saldoCentral.GetValueOrDefault(p) > 0))
            {
                <button class="btn sec" id="req-central" disabled="@Ocupado" @onclick="AtenderDoCentral" title="Cria uma transferência do almoxarifado central com o que houver em estoque"><Icone Nome="caixa" Tam="16" /> Atender do estoque central</button>
            }
            @if (_r.Status == StatusRequisicao.Autorizada) { <button class="btn laranja" @onclick="AbrirCotacao"><Icone Nome="calculadora" Tam="16" /> Gerar cotação</button> }
            @if (PodeVoltar) { <button class="btn sec" id="req-voltar" disabled="@Ocupado" @onclick="VoltarEdicao"><Icone Nome="editar" Tam="16" /> Voltar para edição</button> }
            @if (PodeExcluir) { <button class="btn perigo" id="req-excluir" disabled="@Ocupado" @onclick="Excluir"><Icone Nome="lixeira" Tam="16" /> Excluir requisição</button> }
            @if (Editavel && _r.Numero > 0) { <button class="btn ok" disabled="@Ocupado" @onclick="Enviar"><Icone Nome="enviar" Tam="16" /> Enviar p/ aprovação</button> }
            @if (Editavel) { <button class="btn prim" disabled="@Ocupado" @onclick="Salvar"><Icone Nome="check" Tam="16" /> Salvar</button> }
        }
    </Rodape>
</Modal>

<Modal @bind-Aberto="_abertoOrc" Titulo="Puxar itens do orçamento por local" Tamanho="grande">
    <ChildContent>
        <Erros Lista="ErrosForm" />
        <SeletorDemanda Servicos="_compsOrc" Locais="_locaisSel" ServicosSelecionados="_selComp" LocaisSelecionados="_selLoc" Demanda="_demanda"
                        AoMudarSelecao="() => _demanda = null" AoCalcular="PreviaOrc" Ocupado="Ocupado"
                        IdCalcular="orc-previa" IdTabela="orc-demanda" Casas="3"
                        TituloServicos="@($"1. Serviços ({(_r?.Tipo == TipoRequisicao.Material ? "os materiais saem das composições" : "serviços a contratar")})")"
                        TituloLocais="2. Locais (quantos pavimentos/apartamentos)" TextoCalcular="Calcular quantidades"
                        RotuloItem="@(_r?.Tipo == TipoRequisicao.Material ? "Material" : "Serviço")" RotuloSaldo="Saldo (vai para a requisição)"
                        TextoSemServicos="@(_compsObra == 0 ? "A obra ainda não tem orçamento gerado (Engenharia › Orçamento)." : null)"
                        TextoSemDemanda="@($"Nada orçado para esses serviços nesses locais{(_r?.Tipo == TipoRequisicao.Material ? " (a composição tem materiais do cadastro?)" : "")}.")" />
    </ChildContent>
    <Rodape>@if (_demanda is { Count: > 0 }) { <button class="btn prim" id="orc-incluir" disabled="@Ocupado" @onclick="IncluirOrc"><Icone Nome="check" Tam="16" /> Incluir @_demanda.Count(d => d.Saldo > 0) item(ns)</button> }</Rodape>
</Modal>

<Modal @bind-Aberto="_cotar" Titulo="Gerar cotação — convidar fornecedores" Tamanho="media">
    <ChildContent>
        <p class="mudo">Convide os fornecedores. A situação de qualificação na data fica registrada; fornecedor não qualificado pode ser convidado, mas não pode vencer.
            <b>Sugeridos</b> = atendem os grupos do catálogo (ou as ITS) dos itens.</p>
        <table class="itens">
            <thead><tr><th></th><th>Fornecedor</th><th>Qualificação</th></tr></thead>
            <tbody>
                @foreach (var f in _fornecedores)
                {
                    <tr @key="f.Id"><td class="larg-30"><input type="checkbox" checked="@_convidados.Contains(f.Id)" @onchange="e => { if ((bool)e.Value!) _convidados.Add(f.Id); else _convidados.Remove(f.Id); }" /></td>
                        <td>@f.Texto @if (_sugeridos.Contains(f.Id)) { <Selo Texto="sugerido" Tom="info" /> }</td><td>@if (Enum.TryParse<StatusQualificacao>(f.Extra, out var st)) { <Selo Texto="@De(st)" Tom="@Tom(st)" /> }</td></tr>
                }
            </tbody>
        </table>
    </ChildContent>
    <Rodape><button class="btn prim" disabled="@(_convidados.Count == 0 || Ocupado)" @onclick="GerarCotacao"><Icone Nome="calculadora" Tam="16" /> Criar cotação (@_convidados.Count)</button></Rodape>
</Modal>

<Confirmacao Pergunta="@PerguntaConfirmacao" AoSim="ConfirmacaoSim" AoNao="ConfirmacaoNao" />

@code {
    private sealed record Linha(Guid Id, int Numero, string Obra, TipoRequisicao Tipo, string Atividade, string? CentroCusto, DateOnly Entrega, int Itens, StatusRequisicao Status, string CriadoPor, DateTimeOffset CriadoEm);
    private Grade<Linha>? _grade;
    private List<Linha>? _itens;
    private Requisicao? _r;
    private bool _aberto, _cotar;
    private int _versao;
    private List<Opcao> _spes = [];
    private IEnumerable<Opcao> SpesDaObra => _r is null ? [] : _spes.Where(s => s.Extra == _r.ObraId.ToString());
    private List<Opcao> _obras = [], _ccs = [], _servicos = [], _fornecedores = [], _estabs = [], _grupos = [];
    private List<ServicoOrcado> _compsOrc = [];
    private List<ProdutoBusca> _produtos = [];
    private string? _grupoFiltro;
    private bool _abertoOrc;
    private int _compsObra;
    private readonly HashSet<Guid> _selComp = [];
    private HashSet<Guid> _selLoc = [];
    private List<LinhaDemanda>? _demanda;
    private HashSet<Guid> _sugeridos = [];
    private bool TemLocais => _r?.Itens.Any(i => i.Locais.Count > 0) == true;
    private List<Local> _locaisObraLista = [];
    private Dictionary<Guid, string> _nomeLocal = [];
    /// <summary>Locais da obra da requisição; ao trocar a lista, refaz o dicionário de nomes.</summary>
    private List<Local> _locaisObra { get => _locaisObraLista; set { _locaisObraLista = value; _locaisSel = value.Select(LocalOrcamento.De).ToList(); _nomeLocal = value.ToDictionary(l => l.Id, l => l.Codigo); _arvore = new ArvoreLocais(value); } }
    private List<LocalOrcamento> _locaisSel = [];
    private ArvoreLocais _arvore = ArvoreLocais.Vazia;
    private readonly HashSet<Guid> _abertos = [];
    private void AlternarLocais(Guid id) { if (!_abertos.Remove(id)) _abertos.Add(id); }
    private int _versaoObra;
    private List<string> _atividades = [], _categorias = [];
    private readonly HashSet<Guid> _convidados = [];

    private bool Editavel => _r is { Status: StatusRequisicao.Rascunho or StatusRequisicao.DevolvidaAjuste };
    private bool Solicitante => _r is not null && _r.SolicitanteUsuarioId == Usuario.UsuarioId;
    /// <summary>Solicitante pode retirar da aprovação enquanto ninguém decidiu (1ª aprovação).</summary>
    private bool PodeVoltar => _r is { Status: StatusRequisicao.AguardandoEngenheiro } && Solicitante;
    private bool PodeExcluir => Editavel && _r!.Numero > 0 && (Solicitante || Perfil());

    protected override async Task OnInitializedAsync()
    {
        _obras = await Cat.ObrasAsync(); _spes = await Cat.SpesAsync(); _ccs = await Cat.CentrosCustoAsync(); _produtos = await Cat.ProdutosBuscaAsync(); _servicos = await Cat.ServicosAsync();
        _estabs = await Cat.EstabelecimentosAsync(); _grupos = await Cat.GruposProdutoAsync();
        _marcas = await Cat.MarcasAsync();
        await using (var dbm = Fabrica.CriarLeitura())
            _prodMarca = await dbm.Produtos.AsNoTracking().Where(p => p.Marca != null).ToDictionaryAsync(p => p.Id, p => p.Marca, Cancelamento);
        _atividades = await Cat.ListaAsync(TipoLista.Atividade); _categorias = await Cat.ListaAsync(TipoLista.CategoriaServico);
        await Carregar();
        if (Nav.Uri.Contains("?id=") && Guid.TryParse(Nav.Uri.Split("?id=")[1], out var id)) await Abrir(id);
    }

    private async Task Carregar()
    {
        await using var db = Fabrica.CriarLeitura();
        _itens = await db.Requisicoes.AsNoTracking().OrderByDescending(r => r.Numero).Take(LimiteAtual)
            .Select(r => new Linha(r.Id, r.Numero, db.Obras.Where(o => o.Id == r.ObraId).Select(o => o.Nome).FirstOrDefault() ?? "",
                r.Tipo, r.Atividade, r.CentroCusto != null ? r.CentroCusto.Nome : null, r.DataEntrega, r.Itens.Count, r.Status, r.CriadoPor, r.CriadoEm)).ToListAsync(Cancelamento);
    }

    private async Task Novo()
    {
        _r = new Requisicao { DataEntrega = Hoje.AddDays(15), ObraId = _obras.Count == 1 ? _obras[0].Id : Guid.Empty };
        await CarregarEstoque();
        if (_r.ObraId != Guid.Empty) await EnderecoDaObra();
        _locaisObra = [];
        if (SpesDaObra.Count() == 1) _r.SpeId = SpesDaObra.First().Id;
        ErrosForm = null; _aberto = true;
    }

    private Dictionary<Guid, decimal> _saldoObra = [], _saldoCentral = [];
    private bool _obraPropria;
    private List<string> _marcas = [];
    private Dictionary<Guid, string?> _prodMarca = [];
    private Almoxarifado? _central, _almoxObra;

    /// <summary>Saldo em estoque (obra e central) para mostrar ao lado de cada item: o comprador vê se dá para atender por transferência.</summary>
    private async Task CarregarEstoque()
    {
        _saldoObra = []; _saldoCentral = []; _almoxObra = null;
        if (_r is null || _r.ObraId == Guid.Empty) { _obraPropria = false; return; }
        await using var db = Fabrica.CriarLeitura();
        _obraPropria = await db.Obras.AsNoTracking().AnyAsync(o => o.Id == _r.ObraId && o.DonoCusto == DonoCustoObra.Construtora, Cancelamento);
        _central = await db.Almoxarifados.AsNoTracking().FirstOrDefaultAsync(a => a.Tipo == TipoAlmoxarifado.Central && a.Ativo, Cancelamento);
        _almoxObra = await db.Almoxarifados.AsNoTracking().FirstOrDefaultAsync(a => a.ObraId == _r.ObraId, Cancelamento);
        if (_almoxObra is { } ao) _saldoObra = await db.SaldosEstoque.AsNoTracking().Where(x => x.AlmoxarifadoId == ao.Id && x.Disponivel > 0).ToDictionaryAsync(x => x.ProdutoId, x => x.Disponivel, Cancelamento);
        if (_central is { } c) _saldoCentral = await db.SaldosEstoque.AsNoTracking().Where(x => x.AlmoxarifadoId == c.Id && x.Disponivel > 0).ToDictionaryAsync(x => x.ProdutoId, x => x.Disponivel, Cancelamento);
    }

    private void AtenderDoCentral()
    {
        var itens = _r!.Itens.Where(i => i.ProdutoId is { } p && _saldoCentral.GetValueOrDefault(p) > 0 && i.Quantidade > 0)
            .GroupBy(i => i.ProdutoId!.Value).Select(g => new EstoqueServico.ItemSolicitado(g.Key, Math.Min(g.Sum(i => i.Quantidade), _saldoCentral[g.Key]))).ToList();
        Confirmar($"Criar transferência do central para a obra com {itens.Count} item(ns) em estoque? Depois ajuste a requisição para comprar só o que faltar.", async () =>
        {
            Guid t = default;
            if (await Executar(async () => t = await EstoqueSrv.SolicitarTransferenciaAsync(_central!.Id, _almoxObra!.Id, itens, $"Requisição {_r!.Numero} atendida pelo estoque", Cancelamento), "Transferência criada."))
                Nav.NavigateTo($"/transferencias?id={t}");
        });
    }

    private async Task Abrir(Guid id)
    {
        await using var db = Fabrica.CriarLeitura();
        _r = await db.Requisicoes.AsNoTracking().Include(r => r.Itens).ThenInclude(i => i.Locais).FirstAsync(r => r.Id == id, Cancelamento);
        _locaisObra = await db.Locais.AsNoTracking().Where(l => l.ObraId == _r.ObraId).ToListAsync(Cancelamento);
        await CarregarEstoque();
        ErrosForm = null; _versao++; _aberto = true;
    }

    private async Task Recarregar() { if (_r is not null) await Abrir(_r.Id); await Carregar(); }

    private List<Etapas.Passo> Passos()
    {
        var r = _r!;
        string Est(bool feito, bool atual) => feito ? "feita" : atual ? "atual" : "pendente";
        var reprov = r.Status == StatusRequisicao.NaoAutorizada;
        return
        [
            new("Solicitação", r.Numero == 0 ? Usuario.Nome : r.SolicitanteNome, r.Numero == 0 ? "atual" : "feita"),
            new("Aprov. Engenheiro", r.AprovadoEngenheiroEm is { } e ? Rotulos.DataHora(e) : r.Status == StatusRequisicao.AguardandoEngenheiro ? "pendente" : "—",
                reprov && r.AprovadoEngenheiroEm is null ? "erro" : Est(r.AprovadoEngenheiroEm is not null, r.Status == StatusRequisicao.AguardandoEngenheiro)),
            new("Aprov. Diretor Técnico", r.AprovadoDiretorEm is { } d ? Rotulos.DataHora(d) : r.Status == StatusRequisicao.AguardandoDiretorTecnico ? "pendente" : "—",
                reprov && r.AprovadoEngenheiroEm is not null ? "erro" : Est(r.AprovadoDiretorEm is not null, r.Status == StatusRequisicao.AguardandoDiretorTecnico)),
            new("Cotação", "Comprador", Est(r.Status is StatusRequisicao.EmCotacao or StatusRequisicao.PedidoEmitido or StatusRequisicao.Concluida, r.Status == StatusRequisicao.Autorizada)),
        ];
    }

    private async Task EnderecoDaObra()
    {
        var spes = SpesDaObra.ToList();
        if (_r!.SpeId is { } sp && !spes.Any(s => s.Id == sp)) _r.SpeId = null;
        if (spes.Count == 1) _r.SpeId = spes[0].Id;
        await using var db = Fabrica.CriarLeitura();
        var obra = await db.Obras.AsNoTracking().Where(o => o.Id == _r!.ObraId).Select(o => new { o.EnderecoEntrega, o.DonoCusto, o.EstabelecimentoDonoId }).FirstOrDefaultAsync(Cancelamento);
        _obraPropria = obra?.DonoCusto == DonoCustoObra.Construtora;
        if (_obraPropria && _r!.EstabelecimentoFaturamentoId is null) _r.EstabelecimentoFaturamentoId = obra!.EstabelecimentoDonoId;
        if (string.IsNullOrWhiteSpace(_r!.EnderecoEntrega)) _r.EnderecoEntrega = obra?.EnderecoEntrega;
    }

    private async Task AbrirOrcamento()
    {
        await using var db = Fabrica.CriarLeitura();
        var usados = await db.ServicosLocais.AsNoTracking().Where(s => s.ObraId == _r!.ObraId).Select(s => s.ComposicaoId).Distinct().ToListAsync(Cancelamento);
        _compsObra = usados.Count;
        _compsOrc = await db.Composicoes.AsNoTracking().Where(c => c.Ativa && usados.Contains(c.Id)).OrderBy(c => c.Grupo).ThenBy(c => c.Codigo)
            .Select(c => new ServicoOrcado(c.Id, c.Codigo, c.Descricao, c.Unidade, c.Grupo)).ToListAsync(Cancelamento);
        _locaisObra = await db.Locais.AsNoTracking().Where(l => l.ObraId == _r!.ObraId).ToListAsync(Cancelamento);
        _selComp.Clear(); _selLoc = []; _demanda = null; ErrosForm = null; _abertoOrc = true;
    }

    private async Task PreviaOrc() =>
        await Executar(async () => _demanda = DescontarItensDaTela(await Orc.DemandaAsync(_r!.ObraId, _selComp, _selLoc, _r.Tipo, _r.CriadoEm == default ? null : _r.Id, Cancelamento)));

    /// <summary>
    /// A demanda do banco não enxerga os itens desta requisição (nova, ou excluída da conta quando já salva):
    /// desconta o que já está nos itens da tela (mesmo produto/serviço × local) para não puxar em dobro.
    /// </summary>
    private List<LinhaDemanda> DescontarItensDaTela(List<LinhaDemanda> demanda)
    {
        var ja = new Dictionary<(Guid? Produto, Guid? Comp, Guid Local), decimal>();
        foreach (var i in _r!.Itens)
            foreach (var x in i.Locais)
            {
                var k = (i.ProdutoId, x.ComposicaoId ?? i.ComposicaoId, x.LocalId);
                ja[k] = ja.GetValueOrDefault(k) + x.Quantidade;
            }
        if (ja.Count == 0) return demanda;
        return demanda.Select(d =>
        {
            decimal extra = 0;
            var locais = d.Locais.Select(x =>
            {
                if (!ja.TryGetValue((d.ProdutoId, x.ComposicaoId, x.LocalId), out var q)) return x;
                extra += q;
                return x with { Requisitado = x.Requisitado + q };
            }).ToList();
            return extra == 0 ? d : d with { Locais = locais, Requisitado = d.Requisitado + extra };
        }).ToList();
    }

    private async Task TrocarObra(ChangeEventArgs e)
    {
        var nova = Guid.TryParse(e.Value?.ToString(), out var g) ? g : Guid.Empty;
        if (nova == _r!.ObraId) return;
        if (TemLocais)
            Confirmar("Os itens têm quebra por local da obra atual. Trocar de obra remove essa quebra (as quantidades dos itens ficam). Continuar?",
                () => AplicarObra(nova), () => { _versaoObra++; return Task.CompletedTask; });
        else await AplicarObra(nova);
    }

    private async Task AplicarObra(Guid obra)
    {
        _r!.ObraId = obra;
        foreach (var i in _r.Itens) i.Locais.Clear();
        _selComp.Clear(); _selLoc = []; _demanda = null;
        await using (var db = Fabrica.CriarLeitura())
            _locaisObra = obra == Guid.Empty ? [] : await db.Locais.AsNoTracking().Where(l => l.ObraId == obra).ToListAsync(Cancelamento);
        await EnderecoDaObra();
        await CarregarEstoque();
    }

    private async Task IncluirOrc()
    {
        if (!await Executar(async () =>
        {
            var spe = await Orc.SpeDosLocaisAsync(_r!.ObraId, _selLoc, Cancelamento);
            if (TemLocais && spe is not null && _r.SpeId is { } atual && atual != spe) throw new RegraDeNegocioException("Os locais são de outra SPE: faça outra requisição.");
            await using var db = Fabrica.CriarLeitura();
            var ids = _demanda!.Where(d => d.ProdutoId != null).Select(d => d.ProdutoId!.Value).ToList();
            var prods = await db.Produtos.AsNoTracking().Include(p => p.MaterialControlado).Where(p => ids.Contains(p.Id)).ToDictionaryAsync(p => p.Id, Cancelamento);
            foreach (var i in OrcamentoServico.Itens(_r.Id, _demanda!, prods)) _r.Itens.Add(i);
            if (spe is not null) _r.SpeId = spe;
            _r.RecalcularPrazo();
        })) return;
        _abertoOrc = false;
        Notif.Sucesso("Itens incluídos com a quebra por local. Salve a requisição.");
    }

    private void AddItem() => _r!.Itens.Add(new RequisicaoItem { RequisicaoId = _r.Id, Quantidade = 1 });

    private async Task EscolherProduto(RequisicaoItem i, string? valor)
    {
        if (!Guid.TryParse(valor, out var pid)) { i.ProdutoId = null; return; }
        await using var db = Fabrica.CriarLeitura();
        var p = await db.Produtos.AsNoTracking().Include(x => x.MaterialControlado).FirstAsync(x => x.Id == pid, Cancelamento);
        i.EspecificacaoTecnica = null; i.DocumentosExigidos = null;
        i.HerdarDoProduto(p);
        _r!.RecalcularPrazo();
    }

    private async Task Salvar()
    {
        if (await Executar(async () => { var id = await RequisicoesSrv.SalvarRequisicaoAsync(_r!, Cancelamento); await AbrirSilencioso(id); }, "Requisição salva."))
            await Carregar();
    }

    private async Task AbrirSilencioso(Guid id)
    {
        await using var db = Fabrica.CriarLeitura();
        _r = await db.Requisicoes.AsNoTracking().Include(r => r.Itens).ThenInclude(i => i.Locais).FirstAsync(r => r.Id == id, Cancelamento);
        _versao++;
    }

    private async Task Enviar()
    {
        if (await Executar(async () => { await RequisicoesSrv.SalvarRequisicaoAsync(_r!, Cancelamento); await RequisicoesSrv.EnviarRequisicaoAsync(_r!.Id, Cancelamento); }, "Enviada para aprovação do engenheiro responsável da SPE."))
            await Recarregar();
    }

    private void VoltarEdicao() =>
        Confirmar($"Retirar a requisição {_r!.Numero} da aprovação e voltar para edição?", async () =>
        {
            if (await Executar(() => RequisicoesSrv.VoltarParaEdicaoAsync(_r!.Id, Cancelamento), "Requisição voltou para edição.")) await Recarregar();
        });

    private void Excluir() =>
        Confirmar($"Excluir a requisição {_r!.Numero}? Ela sai da lista (fica no histórico de auditoria).", async () =>
        {
            if (await Executar(() => RequisicoesSrv.ExcluirRequisicaoAsync(_r!.Id, Perfil(), Cancelamento), "Requisição excluída.")) { _aberto = false; _r = null; await Carregar(); }
        });

    private async Task AbrirCotacao()
    {
        await using var db = Fabrica.CriarLeitura();
        (_fornecedores, _sugeridos) = await SugestaoFornecedores.ParaAsync(db, Forn, _r!.Tipo, _r.Itens, Cancelamento);
        _convidados.Clear();
        foreach (var f in _sugeridos.Where(id => _fornecedores.Any(x => x.Id == id))) _convidados.Add(f);
        _cotar = true;
    }

    private async Task GerarCotacao()
    {
        Guid id = default;
        if (await Executar(async () => id = await CotacoesSrv.GerarCotacaoAsync(_r!.Id, _convidados, Cancelamento), "Cotação criada."))
        { _cotar = false; _aberto = false; Nav.NavigateTo($"cotacoes?id={id}"); }
    }
}
