@* Folhas da programação semanal (uma por semana, segunda a sábado): local, atividade/serviço, avanço previsto na semana e dias pintados. Usada na tela e na impressão. *@
@if (Dados is null || Dados.Semanas.Count == 0) { <p class="mudo">Escolha as datas para gerar as semanas.</p> }
else
{
    @foreach (var s in Dados.Semanas)
    {
        var linhas = Agrupar == "macro" ? s.Linhas.OrderBy(l => l.Macroetapa).ThenBy(l => l.Local).ToList() : s.Linhas.ToList();
        <div class="pg-folha">
            <h4><span>PROGRAMAÇÃO SEMANAL · @Dados.Obra</span><span>Semana @s.Segunda.ToString("dd/MM") a @s.Segunda.AddDays(5).ToString("dd/MM/yyyy")</span></h4>
            <div class="sub2"><span>Cronograma @Dados.Versao · SPE: @(Dados.Spe ?? "todas")</span><span>Emitido @Emitido.ToString("dd/MM/yyyy")@(Emissor is { Length: > 0 } ? $" · {Emissor}" : "")</span></div>
            <table>
                <thead><tr>
                    @if (Agrupar == "macro") { <th>Macroetapa</th> }
                    <th>Local</th><th>Atividade / serviço</th><th class="pg-av">Avanço previsto<br />na semana</th>
                    @for (var i = 0; i < 6; i++) { <th class="pg-av" style="width:44px">@Dias[i]<br /><span style="font-weight:400">@s.Segunda.AddDays(i).ToString("dd/MM")</span></th> }
                </tr></thead>
                <tbody>
                    @foreach (var l in linhas)
                    {
                        <tr class="@(l.Restricao is not null ? "r" : "")">
                            @if (Agrupar == "macro") { <td>@l.Macroetapa</td> }
                            <td><b>@l.Local</b></td>
                            <td>@l.Servico@if (l.Restricao is { } r) { <br /><b style="font-size:10px">Restrição: @r</b> }</td>
                            <td class="pg-av">@l.De.ToString("0")% → <b>@l.Ate.ToString("0")%</b><br /><span style="color:#64748b">+@((l.Ate - l.De).ToString("0")) p.p.</span></td>
                            @for (var i = 0; i < 6; i++) { <td class="dia @(l.Dias[i] ? "on" : "") @(l.Restricao is not null ? "r" : "")"></td> }
                        </tr>
                    }
                    @if (linhas.Count == 0) { <tr><td colspan="@(Agrupar == "macro" ? 10 : 9)" style="color:#64748b">Nenhuma atividade programada nesta semana.</td></tr> }
                </tbody>
            </table>
            <div class="leg"><span><i style="background:#c7d2fe"></i>dia programado</span><span><i style="background:#fecaca"></i>programado com restrição aberta</span><span>Conferir clima e efetivo no diário de obra.</span></div>
            <div class="ass"><span>Engenheiro(a) da obra</span><span>Mestre de obras</span><span>Empreiteiro(s)</span></div>
        </div>
    }
}

@code {
    [Parameter] public Groundkey.Application.Servicos.AcompanhamentoServico.Programacao? Dados { get; set; }
    [Parameter] public string Agrupar { get; set; } = "local";
    [Parameter] public DateTime Emitido { get; set; } = DateTime.Today;
    [Parameter] public string? Emissor { get; set; }
    private static readonly string[] Dias = ["SEG", "TER", "QUA", "QUI", "SEX", "SÁB"];
}
