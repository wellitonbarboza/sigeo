{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SIGEO (site local)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "compilar",
      "program": "${workspaceFolder}/src/Sigeo.Web/bin/Debug/net10.0/Sigeo.Web.dll",
      "cwd": "${workspaceFolder}/src/Sigeo.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5144"
      },
      "serverReadyAction": { "action": "openExternally", "pattern": "Now listening on:\\s+(https?://\\S+)" },
      "stopAtEntry": false
    }
  ]
}
